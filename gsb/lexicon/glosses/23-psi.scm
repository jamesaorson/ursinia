;; Greek Source Bible concordance, lemmas beginning with ψ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ψαλτήριον" (sense psaltery (gloss "psaltery" "psalteries") (why "(LXX, supplied.) A stringed instrument, the psaltery (Genesis 4:21); the word behind \"Psalter\".")))

(lemma "ψέλιον" (sense bracelet (gloss "bracelet" "bracelets") (why "(LXX, supplied.) A bracelet, armlet (Genesis 24:22, 30, 47, two bracelets for Rebekah's hands).")))

(lemma "ψευδής" (sense false (gloss "false") (why "False.")))

(lemma "ψευδομαρτυρέω" (sense bear-false-witness (gloss "bear false witness" "bore false witness" "bears false witness" "bearing false witness") (why "To bear false witness (Exodus 20:16; Matthew 19:18).")))

(lemma "ψηλαφάω" (sense feel (gloss "feel" "felt" "feels" "feeling") (verb "feel" "felt" "felt") (why "To feel, touch, grope for (Genesis 27:12, 21-22, Isaac feeling Jacob; Luke 24:39; Acts 17:27; 1 John 1:1). Kept apart from ἅπτω. (LXX form supplied.)")))

(lemma "ψῆφος" (sense pebble (gloss "pebble" "pebbles") (why "A small smooth stone, pebble, also one used in voting (Acts 26:10; Revelation 2:17); in Exodus 4:25 the stone, a flint, with which Zipporah circumcised her son. \"Pebble\" keeps it apart from λίθος \"stone\".")))

(lemma "ψόγος" (sense blame (gloss "blame") (why "(LXX, supplied.) Blame, a censure or bad report (Genesis 37:2, κατήνεγκαν δὲ Ἰωσὴφ ψόγον πονηρὸν πρὸς Ἰσραήλ). The adjective ἄμεμπτος is \"blameless\", from another root.")))

(lemma "Ψονθομφανήχ" (sense name (gloss "Zaphenath-paneah") (why "(LXX, supplied.) The Egyptian name Pharaoh gave Joseph (Genesis 41:45), Greek Ψονθομφανήχ for the Hebrew Zaphenath-paneah: the same name in another transcription, so the traditional English form.")))

(lemma "ψυχή"
  (sense soul
    (gloss "soul" "souls")
    (why "Soul, the life of a living being, a living being itself. \"Soul\" everywhere in both layers, including the animals of Genesis 1 (ψυχὴ ζῶσα \"living soul\", 1:20-24, 30): the Greek uses the same phrase for animals and for the human in 2:7, and Paul quotes 2:7 in 1 Corinthians 15:45 (\"the first human, Adam, came to be into a living soul\"). \"Creature\" or \"being\" would hide that. \"Life\" (Matthew 16:25) is the owner's call when the New Testament is translated.")))

(lemma "ψῦχος" (sense cold (gloss "cold") (why "Cold (Genesis 8:22, cold and heat; John 18:18; 2 Corinthians 11:27).")))
