;; Greek Source Bible concordance, lemmas beginning with μ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Μαγώγ" (sense name (gloss "Magog") (why "Japheth's son (Genesis 10:2; Revelation 20:8, Gog and Magog), traditional English Magog.")))

(lemma "Μαδαί" (sense name (gloss "Madai") (why "(LXX, supplied.) Japheth's son (Genesis 10:2), traditional English Madai.")))

(lemma "Μαδαίμ" (sense name (gloss "Medan") (why "(LXX, supplied.) A son of Abraham and Keturah (Genesis 25:2); Greek Μαδαίμ for the Hebrew Medan, traditional English Medan.")))

(lemma "Μαδιάμ" (sense name (gloss "Midian") (why "A son of Abraham and Keturah (Genesis 25:2, 4), and the land of his descendants (Exodus 2:15; Acts 7:29, γῇ Μαδιάμ); traditional English Midian.")))

(lemma "Μαδιηναῖος" (sense name (person) (gloss "Midianite" "Midianites") (why "(LXX, supplied.) A Midianite, one of the people of Μαδιάμ (Midian, Acts 7:29): the traders who drew Joseph out of the pit and sold him in Egypt (Genesis 37:28, 36). Traditional English Midianites.")))

(lemma "Μαελέθ" (sense name (gloss "Mahalath") (why "(LXX, supplied.) Ishmael's daughter, Esau's wife (Genesis 28:9); Greek Μαελέθ, traditional English Mahalath (the same name in the Hebrew).")))

(lemma "Μαζάρ" (sense name (gloss "Mibzar") (why "(LXX, supplied.) A chief of Esau (Genesis 36:42); Swete's Μαζάρ is the Hebrew Mibzar shortened, the same name, so the traditional English Mibzar (rule 8).")))

(lemma "Μαθουσαλά"(sense name (gloss "Methuselah") (why "The Greek of Genesis 4:18 spells Cain's descendant exactly as Seth's descendant of 5:21 (Luke 3:37): Μαθουσαλά, \"Methuselah\". The Hebrew has two names (Methushael, Methuselah); we translate the Greek and note the difference.")))

(lemma "μαῖα" (sense midwife (person) (gloss "midwife" "midwives") (why "(LXX, supplied.) A midwife (Genesis 35:17, Rachel's midwife; 38:28). The Hebrew word is the same as in Exodus 1:15-21.")))

(lemma "Μαιήλ"(sense name (gloss "Mehujael") (why "(LXX, supplied.) Genesis 4:18, traditional English Mehujael.")))

(lemma "μακαρίζω" (sense call-happy (verb "call happy" "called happy" "called happy") (gloss "call happy" "called happy" "calls happy" "calling happy") (why "To count or call someone happy (μακάριος) (Genesis 30:13, Leah: μακαρίζουσίν με πᾶσαι αἱ γυναῖκες; Luke 1:48; James 5:11). \"Call happy\" keeps the link with μακάριος \"happy\".")))

(lemma "μακάριος" (sense happy (gloss "happy") (why "Happy, fortunate, blessed in the sense of well off (Genesis 30:13 Μακαρία ἐγώ; Matthew 5:3-11; Psalm 1:1). \"Happy\" keeps it apart from εὐλογητός \"blessed\" and the verb εὐλογέω \"bless\", which name a blessing spoken; the readable layer may choose \"blessed\".")))

(lemma "μακράν" (sense far-off (gloss "far off") (why "Far, far off, at a distance (Genesis 44:4 οὐκ ἀπέσχον μακράν, \"they were not distant far off\"; Luke 15:20; Acts 2:39). The adverb of μακρός; \"far off\" keeps it apart from μακρόθεν \"from afar\".")))

(lemma "μακρόθεν" (sense from-afar (gloss "from afar") (why "From afar, at a distance.")))

(lemma "μακρός" (sense farther (gloss "farther") (why "Long, far. The comparative neuter μακρότερον as an adverb, \"farther\" (Genesis 21:16). The adjective \"long\", \"distant\" (Luke 15:13 εἰς χώραν μακράν) will need its own sense.")))

(lemma "μακροχρόνιος" (sense long-lived (gloss "long-lived") (why "(LXX.) Long-lived (Exodus 20:12; Ephesians 6:3 quotes it).")))

(lemma "μαλακία" (sense sickness (gloss "sickness" "sicknesses") (why "(LXX form supplied.) Softness, weakness, sickness (Genesis 44:29 συμβῇ αὐτῷ μαλακία ἐν τῇ ὁδῷ; Matthew 4:23 πᾶσαν νόσον καὶ πᾶσαν μαλακίαν). \"Sickness\" keeps it apart from νόσος \"disease\" and ἀσθένεια \"weakness\".")))

(lemma "μαλακίζομαι" (sense fall-sick (voice active) (verb "fall sick" "fell sick" "fallen sick") (gloss "fall sick" "fell sick" "fallen sick" "falls sick" "falling sick") (why "(LXX, supplied.) To become weak, fall sick (Genesis 42:38 συμβήσεται αὐτὸν μαλακισθῆναι ἐν τῇ ὁδῷ, Jacob's fear for Benjamin). The verb of μαλακία \"sickness\"; the passive form is intransitive in sense.")))

(lemma "Μαλελεήλ" (sense name (gloss "Mahalalel") (why "Kenan's son (Genesis 5:12-17; Luke 3:37), Greek Μαλελεήλ (Maleleel, as KJV Luke). The English follows the traditional Old Testament form Mahalalel, as Ἐνώς is \"Enosh\"; whether to follow the Greek (\"Maleleel\") in both testaments is for the owner.")))

(lemma "μᾶλλον" (sense more (gloss "more") (why "More, rather; μᾶλλον ἤ, \"more than\" (Genesis 19:9 σὲ κακώσομεν μᾶλλον ἢ ἐκείνους; John 3:19; Acts 5:29). \"More\" because ἀλλά has \"rather\".")))

(lemma "Μαμβρή" (sense name (gloss "Mamre") (why "(LXX, supplied.) The place (or owner) of the oak by which Abraham lived (Genesis 13:18; 18:1); traditional English Mamre. Indeclinable.")))

(lemma "Μαμφείν" (sense name (gloss "Muppim") (why "(LXX, supplied.) A son of Benjamin's line (Genesis 46:21), Greek Μαμφείν, standing where the Hebrew has Muppim; traditional English Muppim.")))

(lemma "Μανασσῆ" (sense name (gloss "Manasseh") (why "Joseph's firstborn (Genesis 41:51; 46:20; 48:1-20), indeclinable; Swete spells Μανασσή and Μαννασσή. The same name as King Manasseh (Matthew 1:10) and the tribe (Revelation 7:6); traditional English Manasseh.")))
(lemma "μανδραγόρας" (sense mandrake (gloss "mandrake" "mandrakes") (why "(LXX, supplied.) The mandrake, a plant whose fruit was thought to help conception (Genesis 30:14-16, μῆλα μανδραγόρου, Reuben's find).")))

(lemma "Μαννάχαθ" (sense name (gloss "Manahath") (why "(LXX, supplied.) A son of Shobal the Horite (Genesis 36:23), Greek Μαννάχαθ; traditional English Manahath.")))

(lemma "μάρσιππος"(sense sack (gloss "sack" "sacks") (why "(LXX, supplied.) A bag, sack (Genesis 43:12-44:12, the brothers' grain sacks with the silver and the goblet in them). Kept apart from σάκκος \"sackcloth\" and βαλλάντιον \"purse\" (Luke 10:4).")))

(lemma "μαρτυρέω" (sense testify (gloss "testify" "testified" "testifies" "testifying") (why "To bear witness, testify (Genesis 31:48, 52 Ὁ βουνὸς οὗτος μαρτυρεῖ; John 1:7-8, 15). \"Testify\" keeps it apart from μαρτύριον \"witness\".")))

(lemma "μαρτυρία" (sense testimony (gloss "testimony") (why "Testimony, witness borne.")))

(lemma "Μάσεκ" (sense name (gloss "Masek") (why "(LXX, supplied.) Genesis 15:2 ὁ δὲ υἱὸς Μάσεκ τῆς οἰκογενοῦς μου, \"the son of Masek my house-born\": the Greek takes the Hebrew ben-meshek (\"son of possession\", the heir) as a name, Masek, the mother of Eliezer. The English follows the Greek name.")))

(lemma "Μασέκκα" (sense name (gloss "Masrekah") (why "(LXX, supplied.) The town of Samlah, king of Edom (Genesis 36:36 ἐκ Μασέκκας); Swete's Μασέκκα for the Hebrew Masrekah, the same name: traditional English Masrekah.")))

(lemma "Μασσηέ"(sense name (gloss "Mesha") (why "(LXX, supplied.) The starting point of the residence of Joktan's sons (Genesis 10:30), Greek Μασσηέ; traditional English Mesha.")))

(lemma "μαρτύριον" (sense witness (with-preposition "εἰς" for) (gloss "witness" "witnesses") (why "A witness, a testimony given or kept (Genesis 21:30 εἰς μαρτύριον; 31:44; Matthew 8:4 εἰς μαρτύριον αὐτοῖς; Acts 7:44 ἡ σκηνὴ τοῦ μαρτυρίου, \"the tent of witness\"). \"Witness\" keeps it apart from μαρτυρία \"testimony\"; μάρτυς, the person, should share \"witness\" only if the owner accepts it.")))

(lemma "μάρτυς" (sense testifier (person) (gloss "testifier" "testifiers") (why "A witness, one who testifies (Genesis 31:44 ἴδε ὁ θεὸς μάρτυς; 31:47 Βουνὸς μάρτυς; Matthew 18:16; Acts 1:8). \"Witness\" is μαρτύριον's, whose entry asks the owner before μάρτυς shares it; so for now the person is \"testifier\", beside μαρτυρέω \"testify\". For the owner: \"witness\" for both if accepted.")))

(lemma "Μασεμμάθ" (sense name (gloss "Basemath") (why "(LXX, supplied.) Esau's wife, daughter of Elon (Genesis 26:34). Swete's Μασεμμάθ differs a little from the Hebrew Basemath (μ for β); traditional English Basemath.")))

(lemma "Μασμά" (sense name (gloss "Mishma") (why "(LXX, supplied.) A son of Ishmael (Genesis 25:14), traditional English Mishma.")))

(lemma "Μασσάμ" (sense name (gloss "Mibsam") (why "(LXX, supplied.) A son of Ishmael (Genesis 25:13); Greek Μασσάμ for the Hebrew Mibsam, traditional English Mibsam.")))

(lemma "Μασσή" (sense name (gloss "Massa") (why "(LXX, supplied.) A son of Ishmael (Genesis 25:14); Greek Μασσή for the Hebrew Massa, traditional English Massa.")))

(lemma "μαστός" (sense breast (gloss "breast" "breasts") (why "(LXX form supplied.) The breast that nurses (Genesis 49:25 εὐλογίας μαστῶν καὶ μήτρας; Luke 11:27; 23:29). στῆθος also has \"breast\"; στῆθος is the chest (Luke 18:13), and the owner may move it to \"chest\".")))

(lemma "μάταιος" (sense vain (gloss "vain") (why "Empty, vain, futile (Exodus 20:7 ἐπὶ ματαίῳ \"upon [a] vain [thing]\"; 1 Corinthians 15:17).")))

(lemma "Ματραείθ" (sense name (gloss "Matred") (why "(LXX, supplied.) Mother (in the Greek, father: θυγάτηρ Ματραεὶθ υἱοῦ Μεζοόβ) of Mehetabel, the wife of Hadar (Genesis 36:39), Greek Ματραείθ; traditional English Matred.")))

(lemma "μάχαιρα"(sense knife (gloss "knife" "knives") (why "A large knife, a short sword. Here the knife of sacrifice (Genesis 22:6, 10). The weapon of the New Testament (Matthew 26:47-52) will need its own sense, apart from ῥομφαία \"sword\"."))
  (sense short-sword (gloss "short sword" "short swords") (why "The blade as a weapon (Genesis 27:40 ἐπὶ τῇ μαχαίρῃ σου ζήσῃ, Esau living by it; Matthew 26:51-52; Ephesians 6:17). \"Short sword\", as the note at ῥομφαία proposes, keeps it apart from ῥομφαία \"sword\"; for the owner: whether the two should share \"sword\". Chosen by word override.")))

(lemma "Μαχείρ" (sense name (gloss "Machir") (why "(LXX, supplied.) The son of Manasseh, father of Gilead (Genesis 46:20, one of the Septuagint's additions to the list), Greek Μαχείρ; traditional English Machir.")))

(lemma "μάχη" (sense quarrel (gloss "quarrel" "quarrels") (why "A fight, quarrel, strife (Genesis 13:7-8, between the herdsmen of Abram and of Lot; 2 Corinthians 7:5; James 4:1). \"Quarrel\" keeps it apart from πόλεμος \"war\".")))

(lemma "μάχομαι" (sense fight (dative "with") (gloss "fight" "fought" "fights" "fighting") (why "To fight, quarrel (Genesis 26:20, 22, the herdsmen fought over the wells; John 6:52; James 4:2). Kept apart from μάχη \"quarrel\", the noun.")))

(lemma "μεγαλύνω" (sense magnify (gloss "magnify" "magnified" "magnifies" "magnifying") (why "To make great, magnify (Genesis 12:2, \"I will magnify your name\"; Luke 1:46, My soul magnifies the Lord). The verb of μέγας \"great\".")))

(lemma "μέγας"
  (sense great
    (comparative "greater")
    (gloss "great" "greater")
    (why "Great, large. The comparative μείζων is \"greater\" (Genesis 4:13).")))

(lemma "Μεζοόβ" (sense name (gloss "Mezahab") (why "(LXX, supplied.) Grandparent of Mehetabel, the wife of Hadar king of Edom (Genesis 36:39), Greek Μεζοόβ for the Hebrew Mezahab, the same name: traditional English Mezahab.")))

(lemma "μεθύσκω"(sense get-drunk (voice active) (gloss "get drunk" "got drunk" "gotten drunk" "gets drunk" "getting drunk") (why "To make drunk; the passive, to get drunk (Genesis 9:21, Noah ἐμεθύσθη; Luke 12:45; Ephesians 5:18). The passive is rendered as the intransitive \"get drunk\".")))

(lemma "μέλι" (sense honey (gloss "honey") (why "Honey (Genesis 43:11, among the gifts; Matthew 3:4; Revelation 10:9). (LXX form supplied.)")))

(lemma "μέλλω" (sense be-about (verb "be about" "was about" "been about") (gloss "be about" "is about" "was about" "were about" "been about" "being about") (why "To be about to, be going to, with an infinitive (Genesis 25:22 Εἰ οὕτως μοι μέλλει γίνεσθαι, \"If thus to me it is about to come to be\"; Matthew 2:13; Romans 8:18).")))

(lemma "Μελχά" (sense name (gloss "Milcah") (why "(LXX, supplied.) Haran's daughter, Nahor's wife (Genesis 11:29), traditional English Milcah.")))

(lemma "Μελχιήλ" (sense name (gloss "Malchiel") (why "(LXX, supplied.) A son of Beriah, Asher's grandson (Genesis 46:17), Greek Μελχιήλ; traditional English Malchiel.")))

(lemma "Μελχισέδεκ" (sense name (gloss "Melchizedek") (why "King of Salem and priest of God the most high (Genesis 14:18; Hebrews 5-7); traditional English Melchizedek.")))

(lemma "μέν" (sense on-one-hand (gloss "on one hand") (why "The particle that sets up a contrast, usually answered by δέ \"but\" (Genesis 18:12 Οὔπω μέν μοι γέγονεν ... ὁ δὲ κύριός μου; Matthew 3:11). \"On one hand\" so the particle is always rendered (rule 9); a μέν with no answering δέ may need its own sense (\"indeed\" is δή's).")))

(lemma "μένω" (sense stay (gloss "stay" "stayed" "stays" "staying") (why "To stay, remain, abide (Genesis 24:55, Μεινάτω ἡ παρθένος μεθ' ἡμῶν; John 1:38-39; 15:4). \"Stay\" keeps it apart from καταμένω \"remain\".")))

(lemma "Μεραρεί" (sense name (gloss "Merari") (why "(LXX, supplied.) A son of Levi (Genesis 46:11), Greek Μεραρεί; traditional English Merari.")))

(lemma "μερίς" (sense portion (gloss "portion" "portions") (why "A part, portion, share (Genesis 14:24, they will take a portion; Luke 10:42; Colossians 1:12).")))

(lemma "μέρος" (sense part (gloss "part" "parts") (why "A part, share (Genesis 47:24 τὸ πέμπτον μέρος, the fifth part to Pharaoh, τὰ τέσσερα μέρη the four parts; Luke 15:12; John 13:8; 1 Corinthians 13:9-12). \"Part\" keeps it apart from μερίς \"portion\"; the verb διαστέλλω's \"part\" is the same English spelling as another part of speech. (LXX form supplied.)")))

(lemma "μεσημβρία" (sense midday (genitive "at") (dative "at") (gloss "midday") (why "Midday, noon; also the south (Acts 8:26). The genitive of Genesis 18:1 is the time when, \"at midday\" (Acts 22:6 περὶ μεσημβρίαν).")))

(lemma "Μεσοποταμία" (sense name (gloss "Mesopotamia") (why "\"Between the rivers\", the Greek name for the land of Haran, where the Hebrew has Aram-naharaim (Genesis 24:10) and Paddan-aram (Genesis 28:2, 5-7, Μεσοποταμία Συρίας). The Greek gives a different name from the Hebrew, so the English follows the Greek, as in Acts 2:9 and 7:2.")))

(lemma "μέσος"
  (sense between
    (gloss "between")
    (why "In ἀνὰ μέσον (\"in the middle of\"), the compound preposition \"between\"; ἀνά is aligned with it and unrendered."))
  (sense midst
    (gloss "midst")
    (why "ἐν μέσῳ, \"in [the] midst\" (Genesis 1:6; 2:9; 3:3, 8; Revelation 2:7; 22:2). \"Midst\" rather than \"middle\" to match the traditional New Testament phrase."))
  (sense in-middle
    (gloss "in middle")
    (why "The neuter plural μέσα as an adverb, through the middle: Genesis 15:10 διεῖλεν αὐτὰ μέσα, \"divided them in middle\". No article is supplied (rule 16a).")))

(lemma "Μεσράιν" (sense name (gloss "Mizraim") (why "(LXX, supplied.) Ham's son (Genesis 10:6, 13), the ancestor of Egypt; Greek Μεσράιν, traditional English Mizraim. Elsewhere the Greek says Αἴγυπτος \"Egypt\".")))

(lemma "μετά"
  (sense with
    (gloss "with")
    (why "With the genitive: accompaniment, \"with\" (Genesis 3:6, 12). It shares \"with\" with πρός in John 1:1; the alignment shows which Greek word stands behind it. With the accusative (\"after\") it is a separate sense."))
  (sense after
    (object-case "A")
    (gloss "after")
    (why "With the accusative: \"after\" (Genesis 4:3 μεθ’ ἡμέρας, \"after days\"; Matthew 26:2). The generator picks it for an accusative object.")))

(lemma "μεταπέμπω" (sense send-for (gloss "send for" "sent for" "sends for" "sending for") (why "Middle: to send for, summon (Genesis 27:45 ἀποστείλασα μεταπέμψομαί σε ἐκεῖθεν; Acts 10:5, 22; 24:24). The middle is rendered active. (LXX form supplied.)")))

(lemma "μετατίθημι" (sense transfer (verb "transfer" "transferred" "transferred") (gloss "transfer" "transferred" "transfers" "transferring") (why "To move from one place to another, transfer (Genesis 5:24, God transferred Enoch; Hebrews 11:5 quotes it, where the KJV has \"translated\"; Acts 7:16).")))

(lemma "Μετεβεήλ" (sense name (gloss "Mehetabel") (why "(LXX, supplied.) The wife of Hadar, king of Edom (Genesis 36:39), Greek Μετεβεήλ; traditional English Mehetabel.")))

(lemma "Μετοδιήλ" (sense name (gloss "Magdiel") (why "(LXX, supplied.) A chief of Edom (Genesis 36:43); Swete's Μετοδιήλ is a variant spelling of the Hebrew Magdiel, the same name, so the traditional English Magdiel (rule 8).")))

(lemma "μέτρον"(sense measure (gloss "measure" "measures") (why "A measure (Genesis 18:6 τρία μέτρα σεμιδάλεως \"three measures of fine flour\", as Matthew 13:33 has σάτα τρία; Matthew 7:2).")))

(lemma "μή"
  (sense not
    (gloss "not")
    (why "The negative of the non-indicative moods (infinitive, subjunctive, participle): \"not\", like οὐ."))
  (sense at-all
    (gloss "at all")
    (why "In οὐ μή and οὐδὲ μή with the aorist subjunctive, the strongest Greek negation (Genesis 3:1, 3; John 6:37). The second negative is rendered \"at all\" so both words show: \"not at all will you eat\"."))
  (sense lest
    (gloss "lest")
    (why "Introducing a feared possibility, \"lest\" (μή ποτε, Genesis 3:22; Matthew 4:6, where it is printed as one word μήποτε)."))
  (sense question
    (gloss "")
    (why "Opening a question, μή marks it as expecting the answer \"no\" (Genesis 18:14 μὴ ἀδυνατεῖ παρὰ τῷ θεῷ ῥῆμα; \"Is utterance impossible beside God?\"; 4:9; John 4:29). English has no word for it: it is not \"not\", which would turn the question into one expecting \"yes\" or into a statement, so the literal layer writes a plain yes/no question (auxiliary before the subject, as the KJV does) and aligns μή with it unrendered.")))

(lemma "μηδαμῶς" (sense by-no-means (gloss "by no means") (why "By no means, not at all (Genesis 18:25, twice; Acts 10:14; 11:8, Peter's \"By no means, Lord\").")))

(lemma "μηδέ" (sense nor (gloss "nor") (why "μή plus δέ: and not, nor, joining a further negative (Genesis 21:23 μὴ ἀδικήσειν με μηδὲ τὸ σπέρμα μου; 22:12; Matthew 6:25). It shares \"nor\" with οὐδέ and οὔτε, the same word with the other negative.")))

(lemma "μηδείς" (sense nothing (gloss "nothing") (why "No one, nothing: the neuter μηδέν, \"nothing\" (Genesis 22:12 μηδὲ ποιήσῃς αὐτῷ μηδέν; Luke 3:13; Mark 5:26). The masculine \"no one\" will need its own sense."))
  (sense anything (gloss "anything") (why "The neuter μηδέν after another negative, which it strengthens in Greek (Genesis 19:8 μὴ ποιήσητε μηδὲν ἄδικον): English cannot stack the negatives without reversing the sense, so \"do not do anything\". Chosen by word override.")))

(lemma "μῆκος" (sense length (gloss "length") (why "Length (Genesis 6:15; Revelation 21:16).")))

(lemma "μῆλον" (sense apple (gloss "apple" "apples") (why "(LXX, supplied.) An apple, or any tree fruit of its kind (Genesis 30:14 μῆλα μανδραγόρου, the mandrake's fruit).")))

(lemma "μήν" (sense month (gloss "month" "months") (why "(LXX, supplied.) A month (Genesis 7:11; 8:4-5, 13-14; Luke 1:24, 26). The table's lemma is \"μήν (II)\", to keep it apart from the particle μήν (Hebrews 6:14), which will be its own entry or sense.")))

(lemma "μήν (I)" (sense surely (gloss "surely") (why "The particle of strong affirmation; in the oath formula εἰ μήν, \"surely\" (Genesis 22:17, quoted in Hebrews 6:14). Not μήν (II), \"month\".")))

(lemma "μῆνις" (sense rage (gloss "rage") (why "(LXX, supplied.) Lasting anger, rage (Genesis 49:7 ἡ μῆνις αὐτῶν ὅτι ἐσκληρύνθη). \"Rage\" because ὀργή has \"wrath\" and θυμός \"fury\".")))

(lemma "μηρός" (sense thigh (gloss "thigh" "thighs") (why "The thigh (Genesis 24:2, 9, the hand put under Abraham's thigh in swearing; Revelation 19:16).")))

(lemma "μήτηρ"
  (sense mother
    (person)
    (gloss "mother" "mothers")
    (why "Mother.")))

(lemma "μήτρα" (sense womb (gloss "womb" "wombs") (why "The womb (Genesis 20:18 συνέκλεισεν ... πᾶσαν μήτραν; Luke 2:23; Romans 4:19). Kept apart from κοιλία \"belly\".")))

(lemma "μιαίνω" (sense defile (gloss "defile" "defiled" "defiles" "defiling") (why "To defile, stain.")))

(lemma "μίγνυμι" (sense mix (gloss "mix" "mixed" "mixes" "mixing") (why "To mix, mingle (Genesis 30:40, Jacob οὐκ ἔμιξεν αὐτὰ εἰς τὰ πρόβατα Λαβάν; Matthew 27:34; Revelation 8:7).")))

(lemma "μικρός" (sense small (comparative "smaller") (gloss "small" "smaller") (why "Small, little (Genesis 19:11 ἀπὸ μικροῦ ἕως μεγάλου, from small to great; 19:20; Matthew 10:42; Acts 8:10). The opposite of μέγας \"great\"."))
  (sense almost (gloss "almost") (why "The genitive μικροῦ used as an adverb, \"by a little\", almost (Genesis 26:10 μικροῦ ἐκοιμήθη τις, \"almost someone lay\"). Chosen by a word override, since μικροῦ is also the plain genitive \"of small\".")))

(lemma "μιμνῄσκω" (sense remember (voice active) (genitive "") (gloss "remember" "remembered" "remembers" "remembering") (why "Middle/passive: to remember (Exodus 20:8 Μνήσθητι).")))

(lemma "μισέω" (sense hate (gloss "hate" "hated" "hates" "hating") (why "To hate.")))

(lemma "μισθόω" (sense hire (gloss "hire" "hired" "hires" "hiring") (why "To let for hire; middle, to hire (Genesis 30:16, Leah: μεμίσθωμαί σε ἀντὶ τῶν μανδραγορῶν; Matthew 20:1, 7). The verb of μισθός \"wage\".")))

(lemma "μισητός" (sense hateful (gloss "hateful") (why "(LXX, supplied.) Hated, hateful (Genesis 34:30, Μισητόν με πεποιήκατε, you have made me hateful). The adjective of μισέω.")))

(lemma "μισθός" (sense wage (gloss "wage" "wages") (why "Pay, wage, reward (Genesis 15:1 ὁ μισθός σου πολύς; Matthew 5:12; Luke 10:7). \"Wage\" for the literal layer, which keeps the idea of pay; the readable layer may say \"reward\".")))

(lemma "μνημεῖον" (sense tomb (gloss "tomb" "tombs") (why "A memorial, and so a tomb (Genesis 23:6, 9; Matthew 27:52-60; John 11:17). \"Tomb\" keeps it apart from τάφος \"grave\" and μνημόσυνον \"memorial\".")))

(lemma "μνησικακέω" (sense hold-malice (dative "against") (verb "hold malice" "held malice" "held malice") (gloss "hold malice" "held malice" "holds malice" "holding malice") (why "(LXX, supplied.) To remember wrongs, bear a grudge, with the dative (Genesis 50:15, Μή ποτε μνησικακήσῃ ἡμῖν Ἰωσήφ).")))

(lemma "Μοζέ" (sense name (gloss "Mizzah") (why "(LXX, supplied.) A son of Reuel, Esau's grandson, and a chief (Genesis 36:13, 17), Greek Μοζέ; traditional English Mizzah.")))

(lemma "μοιχεύω"(sense commit-adultery (gloss "commit adultery" "committed adultery" "commits adultery" "committing adultery") (why "To commit adultery.")))

(lemma "μολύνω" (sense stain (gloss "stain" "stained" "stains" "staining") (why "To stain, soil, defile (Genesis 37:31, ἐμόλυναν τὸν χιτῶνα αἵματι, \"they stained the tunic with blood\"; 1 Corinthians 8:7; Revelation 3:4; 14:4). \"Stain\" keeps it apart from μιαίνω \"defile\".")))

(lemma "μόνιμος" (sense lasting (gloss "lasting") (why "(LXX, supplied.) Staying, steadfast, lasting (Genesis 49:26 ὀρέων μονίμων, \"of lasting mountains\").")))

(lemma "μόνος"
  (sense alone
    (gloss "alone")
    (why "Alone, only. \"Alone\" covers both Genesis 2:18 (\"for the human to be alone\") and 3:11, 17 (\"of this alone\"); \"only\" (John 17:3) will be checked against it when John 17 is translated."))
  (sense only
    (gloss "only")
    (why "The neuter μόνον as an adverb, only, just (Genesis 27:13 μόνον ὑπάκουσον τῆς φωνῆς μου; 24:8; Matthew 9:21; Galatians 2:10). Chosen in the form row for the adverb.")))

(lemma "Μόσοχ" (sense name (gloss "Meshech") (why "(LXX, supplied.) Japheth's son (Genesis 10:2), traditional English Meshech. In 10:23 the Greek gives Μόσοχ again as Aram's son, where the Hebrew has Mash; the English follows the Greek name.")))

(lemma "μοσχάριον" (sense young-calf (gloss "young calf" "young calves") (why "(LXX, supplied.) The diminutive of μόσχος \"calf\" (Genesis 18:7-8). \"Young calf\" keeps both the link and the diminutive.")))

(lemma "μόσχος" (sense calf (gloss "calf" "calves") (why "Calf, young bull.")))

(lemma "μυελός" (sense marrow (gloss "marrow") (why "Marrow, and so the richest part (Genesis 45:18, you will eat the marrow of the land; Hebrews 4:12).")))

(lemma "μουσικός" (sense musician (person) (gloss "musician" "musicians") (why "Skilled in music; as a noun, a musician (Genesis 31:27 μετὰ μουσικῶν, τυμπάνων καὶ κιθάρας; Revelation 18:22).")))

(lemma "μυριάς" (sense myriad (gloss "myriad" "myriads") (why "Ten thousand, a myriad (Genesis 24:60, εἰς χιλιάδας μυριάδων, \"into thousands of myriads\"; Luke 12:1; Revelation 5:11).")))

(lemma "Μωάβ" (sense name (gloss "Moab") (why "(LXX, supplied.) The elder daughter's son (Genesis 19:37) and the people and land named after him; traditional English Moab.")))

(lemma "Μωαβίτης" (sense name (person) (gloss "Moabite" "Moabites") (why "(LXX, supplied.) The people descended from Μωάβ (Genesis 19:37 πατὴρ Μωαβιτῶν); traditional English Moabites.")))

(lemma "μώλωψ" (sense stripe (gloss "stripe" "stripes") (why "A weal, the mark of a blow: Genesis 4:23; 1 Peter 2:24 (\"by whose stripe\").")))

(lemma "Μωϋσῆς" (sense name (gloss "Moses") (why "Traditional English form; Swete spells Μωυσῆς and Μωσῆς.")))

(lemma "Μωχά" (sense name (gloss "Maacah") (why "(LXX, supplied.) Son of Nahor and Reumah (Genesis 22:24); the Greek form of the Hebrew Maacah. Traditional English Maacah.")))
