;; Greek Source Bible concordance, lemmas beginning with δ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Δαιδάν" (sense name (gloss "Dedan") (why "(LXX, supplied.) A son of Jokshan (Genesis 25:3), traditional English Dedan. Swete spells him Δαιδάν here; Δαδάν (Genesis 10:7) is Dedan son of Raamah, with the same English name as in the Hebrew.")))

(lemma "δάκνω" (sense bite (verb "bite" "bit" "bitten") (gloss "bite" "bit" "bitten" "bites" "biting") (why "(LXX form supplied.) To bite (Genesis 49:17, the snake biting the horse's heel; Galatians 5:15).")))

(lemma "Δαμασκός" (sense name (gloss "Damascus") (why "Damascus (Genesis 14:15; Acts 9:2).")))

(lemma "Δάν" (sense name (gloss "Dan") (why "(LXX, supplied.) Dan, the place in the far north (Genesis 14:14), named after Jacob's son Dan (Genesis 30:6); traditional English.")))

(lemma "δάμαλις" (sense heifer (gloss "heifer" "heifers") (why "(LXX, supplied.) A heifer, young cow (Genesis 15:9; Hebrews 9:13).")))

(lemma "Δαδάν" (sense name (gloss "Dedan") (why "(LXX, supplied.) A son of Raamah (Genesis 10:7), Greek Δαδάν; traditional English Dedan.")))

(lemma "Δασά" (sense name (gloss "Lasha") (why "(LXX, supplied.) The limit of the Canaanite border (Genesis 10:19). Swete's Δασά has Δ where the Hebrew has Lasha, the letters Λ and Δ being alike; taken as the same place and given its traditional English name. The owner may prefer the Greek \"Dasa\".")))

(lemma "Δάσεμ" (sense name (gloss "Resen") (why "(LXX, supplied.) A city built by Asshur, between Nineveh and Calah (Genesis 10:12). Swete's Δάσεμ has Δ where the Hebrew has Resen; taken as the same city and given its traditional English name. The owner may prefer the Greek \"Dasem\".")))

(lemma "δασύς" (sense hairy (gloss "hairy") (why "(LXX, supplied.) Shaggy, hairy (Genesis 27:11 Ἠσαὺ ... ἀνὴρ δασύς, against Jacob ἀνὴρ λεῖος; 27:23 the hands χεῖρες δασεῖαι).")))

(lemma "δέ"
  (sense but
    (gloss "but")
    (why "The commonest Greek connective after καί, mildly contrastive or simply marking a new step. Always rendered, as the owner requires, and always \"but\" so it can never be confused with καί \"and\". Alternatives considered: \"now\" (collides with νῦν), \"and\" (collides with καί). The cost is that \"but\" overstates the contrast in narrative (Matthew 1:2-16); the owner is asked to rule (Genesis book notes). Placed first in its English clause, though the Greek puts it second.")))

(lemma "Δεββωρά" (sense name (gloss "Deborah") (why "(LXX, supplied.) Rebekah's nurse, buried below Bethel (Genesis 35:8), traditional English Deborah.")))

(lemma "δείκνυμι"(sense show (gloss "show" "showed" "shown" "shows" "showing") (why "To show, point out (Genesis 12:1, \"the land which I will show you\", quoted in Acts 7:3; Matthew 4:8). It shares \"show\" with καταδείκνυμι (Genesis 4:21), the compound; the alignment shows which.")))

(lemma "δείλη" (sense afternoon (gloss "afternoon") (why "(LXX, supplied.) The afternoon, the later part of the day (Genesis 24:63, πρὸς δείλης, \"toward afternoon\"). It shares \"afternoon\" with its adjective δειλινός (Genesis 3:8), the same root; ἑσπέρα keeps \"evening\".")))

(lemma "δειλινός"
  (sense afternoon
    (gloss "afternoon")
    (why "(LXX, supplied.) Of the afternoon or early evening; τὸ δειλινόν (Genesis 3:8) is an accusative of time, \"in the afternoon\", where translations from the Hebrew have \"in the cool (wind) of the day\".")))

(lemma "Δείνα" (sense name (gloss "Dinah") (why "(LXX, supplied.) Jacob's daughter by Leah (Genesis 30:21; 34), Greek Δείνα, declined (genitive Δείνας, accusative Δείναν; Swete once prints the accusative Δεινά, Genesis 34:26); traditional English Dinah.")))

(lemma "δέκα" (sense ten (gloss "ten") (why "The numeral ten (Genesis 5:10, δέκα πέντε \"ten five\" = fifteen, kept word for word; Matthew 25:1).")))

(lemma "δέκατος" (sense tenth (gloss "tenth") (why "(LXX, supplied.) The ordinal \"tenth\" (Genesis 8:5, the tenth month; Revelation 21:20).")))

(lemma "δεξιός" (sense right (gloss "right") (why "Right, the right hand or side (Genesis 13:9, εἰς δεξιά \"into right [parts]\"; Matthew 5:29).")))

(lemma "Δεκλά" (sense name (gloss "Diklah") (why "(LXX, supplied.) A son of Joktan (Genesis 10:27), Greek Δεκλά; traditional English Diklah.")))

(lemma "δένδρον" (sense tree (gloss "tree" "trees") (why "A (growing) tree (Genesis 18:4, 8, ὑπὸ τὸ δένδρον; Matthew 3:10; 7:17). It shares \"tree\" with ξύλον, which keeps \"tree\" for the tree of life and the cross: English has no second plain word, and the alignment shows which Greek word stands behind it.")))

(lemma "Δεννάβα" (sense name (gloss "Dinhabah") (why "(LXX, supplied.) The city of Balak (Bela), king of Edom (Genesis 36:32), Greek Δεννάβα; traditional English Dinhabah.")))

(lemma "δέομαι"(sense beg (genitive "") (gloss "beg" "begged" "begs" "begging") (why "To ask urgently, beg, entreat (Genesis 19:18 Δέομαι, κύριε; Luke 5:12; 8:38). \"Beg\" keeps it apart from αἰτέω \"ask\" and παρακαλέω.")))

(lemma "δέρμα" (sense skin (gloss "skin" "skins") (why "A skin, hide (Genesis 27:16 τὰ δέρματα τῶν ἐρίφων; Hebrews 11:37 ἐν αἰγείοις δέρμασιν). Root of δερμάτινος \"of skin\". (LXX form supplied.)")))

(lemma "δερμάτινος"
  (sense leather
    (gloss "leather")
    (why "(Supplied in Genesis 3:21.) Made of skin or hide, leather (Mark 1:6; Matthew 3:4, John's leather belt). Same gloss in both.")))

(lemma "δεῦρο" (sense come-here (gloss "come here") (why "Hither, come! (Genesis 19:32 δεῦρο οὖν ποτίσωμεν, before a first plural subjunctive; Matthew 19:21; John 11:43). The singular of δεῦτε, which shares \"come here\": one adverb in two numbers.")))

(lemma "δεσμεύω" (sense bind (verb "bind" "bound" "bound") (gloss "bind" "bound" "binds" "binding") (why "(LXX form supplied.) To tie up, bind, fetter (Genesis 49:11, binding his colt to the vine; Matthew 23:4; Acts 22:4). \"Bind\" is free here; if δέω later needs it, one of the two takes \"tie\".")))

(lemma "δεσμωτήριον" (sense prison (gloss "prison" "prisons") (why "A place of bonds, a prison (Genesis 39:22-23; 40:3, 5; Matthew 11:2; Acts 5:21, 23; 16:26).")))

(lemma "δεσμώτης" (sense prisoner (person) (gloss "prisoner" "prisoners") (why "One in bonds, a prisoner (Genesis 39:20, the king's prisoners; Acts 27:1, 42).")))

(lemma "δεσπότης" (sense master (person) (gloss "Master" "master" "masters") (why "Master, owner with full authority (Genesis 15:2, 8 Δέσποτα Κύριε; Luke 2:29; Acts 4:24). \"Master\" against κύριος \"lord\".")))

(lemma "δεῦτε" (sense come-here (gloss "come here") (why "The plural of δεῦρο, an exhortation, \"hither!\", \"come!\" (Genesis 11:3, 4, 7, before a first plural subjunctive; Matthew 11:28; 28:6). \"Come here\" keeps it apart from the verbs ἔρχομαι and ἥκω \"come\".")))

(lemma "δεύτερος"
  (sense second
    (gloss "second")
    (why "The ordinal \"second\".")))

(lemma "δέχομαι" (sense receive (gloss "receive" "received" "receives" "receiving") (why "To receive, welcome.")))

(lemma "δή" (sense indeed (gloss "indeed") (why "The particle of emphasis or urgency, \"indeed, now\", often in requests (Genesis 18:4 λημφθήτω δὴ ὕδωρ \"let water indeed be taken\"; Luke 2:15; Acts 13:2). \"Indeed\" because \"now\" is νῦν's.")))

(lemma "Δησών" (sense name (gloss "Dishon") (why "(LXX, supplied.) A son of Seir the Horite and a son of Anah (Genesis 36:21, 25-26, 30), Greek Δησών; traditional English Dishon.")))

(lemma "διά"
  (sense through
    (gloss "through")
    (why "With the genitive: agency or means passing through someone or something. With the accusative (\"because of\") it is a separate sense."))
  (sense because-of
    (object-case "A")
    (gloss "because of")
    (why "With the accusative: the reason, \"because of\" (Genesis 11:9, διὰ τοῦτο \"because of this\"; 12:13, 16, διὰ σέ, δι’ αὐτήν; Matthew 24:9). The generator takes it for an accusative object, as the entry for \"through\" foresaw.")))

(lemma "διαβοάω" (sense noise-abroad (verb "noise abroad" "noised abroad" "noised abroad") (gloss "noise abroad" "noised abroad" "noises abroad" "noising abroad") (why "(LXX, supplied.) To cry through, spread a report abroad; passive, to be noised abroad (Genesis 45:16, the voice was noised abroad into Pharaoh's house).")))

(lemma "διαβουλεύομαι" (sense deliberate (gloss "deliberate" "deliberated" "deliberates" "deliberating") (why "(LXX, supplied.) To take counsel together, deliberate, plot (Genesis 49:23, the archers deliberating against Joseph). Kept apart from βουλεύω \"plan\".")))

(lemma "διαθήκη" (sense covenant (gloss "covenant" "covenants") (why "Covenant, the arrangement God sets up (Genesis 6:18; 9:9-17; Luke 1:72; Hebrews 8). \"Covenant\" in both testaments; Hebrews 9:16-17 (a will) will be discussed there.")))

(lemma "διαιρέω" (sense divide (gloss "divide" "divided" "divides" "dividing") (why "To divide, distribute (1 Corinthians 12:11). Genesis 4:7 μὴ διέλῃς, \"[if] you do not divide\" (the offering rightly).")))

(lemma "διακόσιοι" (sense two-hundred (gloss "two hundred") (why "The numeral two hundred (Genesis 5; John 6:7).")))

(lemma "διάλευκος" (sense white-flecked (gloss "white-flecked") (why "(LXX, supplied.) Marked through with white, flecked with white (Genesis 30:33-35, 39-40; 31:10-12, Jacob's wage among Laban's flocks). A compound of λευκός \"white\"; \"white-flecked\" keeps it apart from ῥαντός \"speckled\" and ποικίλος \"many-colored\".")))

(lemma "διαμαρτυρία" (sense warning (dative "with") (gloss "warning" "warnings") (why "(LXX, supplied.) A solemn protest, warning (Genesis 43:3 Διαμαρτυρίᾳ διαμεμαρτύρηται ἡμῖν, \"With warning he has warned us\", the Greek echoing the Hebrew doubled verb). The noun of διαμαρτύρομαι \"warn\".")))

(lemma "διαμαρτύρομαι" (sense warn (dative "") (gloss "warn" "warned" "warns" "warning") (why "(LXX form supplied.) To call to witness, protest, warn solemnly (Genesis 43:3, Joseph's warning to the brothers; Luke 16:28 ὅπως διαμαρτύρηται αὐτοῖς; Acts 20:24 \"testify solemnly\"). \"Warn\" for the Genesis use; the dative is the one warned. The New Testament's \"testify solemnly\" may become its own sense.")))

(lemma "διαμερίζω" (sense divide-up (gloss "divide up" "divided up" "divides up" "dividing up") (why "To divide up, distribute in parts (Genesis 10:25, in Peleg's days ἡ γῆ διεμερίσθη; Luke 11:17; 23:34; Acts 2:3). \"Divide up\" so as not to share bare \"divide\" with διαιρέω.")))

(lemma "διαναπαύω" (sense relieve (gloss "relieve" "relieved" "relieves" "relieving") (why "(LXX, supplied.) To give rest, refresh, relieve (Genesis 5:29, Lamech on Noah: \"This one will relieve us from our works\"; the name Noah sounds like the Hebrew for rest). \"Relieve\" because \"rest\" is καταπαύω's English and \"give rest\" cannot take its object (ἡμᾶς) in English order; the owner may prefer another word.")))

(lemma "διανοέομαι" (sense think-through (gloss "think through" "thought through" "thinks through" "thinking through") (why "(LXX, supplied.) To think over, have in mind, consider (Genesis 6:5-6). \"Think through\" renders the δια- and keeps it apart from ἐνθυμέομαι \"ponder\"; the noun διάνοια will take \"mind\" or \"understanding\".")))

(lemma "διάνοια" (sense mind (gloss "mind" "minds") (why "The faculty of thinking, the mind, and what it devises (Genesis 8:21, the mind of the human is intent on evil things; Matthew 22:37, with all your mind; Ephesians 4:18). \"Mind\", as διανοέομαι's entry foresaw; νοῦς will need its own English or a note when it comes.")))

(lemma "διανοίγω"
  (sense open
    (gloss "open" "opened" "opens" "opening")
    (why "(Supplied in Genesis 3:5.) To open fully, of eyes (Genesis 3:5, 7; Luke 24:31, their eyes were opened), ears, the womb, the Scriptures. \"Open\", against ἀνοίγω, which will need its own gloss or a note.")))

(lemma "διάραντος" (sense dappled (gloss "dappled") (why "(LXX, supplied.) Sprinkled all over with spots, dappled (Genesis 30:32, πᾶν διάραντον among the goats). A compound of ῥαντός \"speckled\"; \"dappled\" keeps the two apart.")))

(lemma "διαρπάζω" (sense plunder (gloss "plunder" "plundered" "plunders" "plundering") (why "To seize as spoil, plunder thoroughly (Genesis 34:27, 29, Jacob's sons plundered the city; Matthew 12:29; Mark 3:27).")))

(lemma "διαρρήγνυμι" (sense tear-apart (verb "tear apart" "tore apart" "torn apart") (gloss "tear apart" "tore apart" "torn apart" "tears apart" "tearing apart") (why "(LXX form supplied.) To tear through, rend (Genesis 44:13 διέρρηξαν τὰ ἱμάτια αὐτῶν, the brothers tearing their garments; Matthew 26:65, the high priest; Luke 5:6, the nets). \"Tear apart\" keeps it apart from ῥήγνυμι.")))

(lemma "διασάφησις" (sense explanation (gloss "explanation" "explanations") (why "(LXX, supplied.) A making clear, explanation (Genesis 40:8, of dreams); the noun of διασαφέω \"make clear\" (Matthew 13:36; 18:31). Kept apart from σύγκρισις \"interpretation\".")))

(lemma "διασκεδάζω" (sense break-up (gloss "break up" "broke up" "broken up" "breaks up" "breaking up") (verb "break up" "broke up" "broken up") (why "(LXX, supplied.) To scatter, break up, and so make void (Genesis 17:14 τὴν διαθήκην μου διεσκέδασεν \"he/she/it broke up my covenant\"). \"Break up\" keeps the picture of scattering; \"break\" alone is kept free for other verbs.")))

(lemma "διαστέλλω" (sense part (gloss "part" "parted" "parts" "parting") (why "To set apart, divide, separate (Genesis 25:23, the two peoples \"will be parted\" from Rebekah's womb). \"Part\" keeps it apart from διαχωρίζω \"separate\" and διαιρέω. The New Testament's middle \"give orders, charge\" (Mark 7:36) will be its own sense."))
  (sense specify (gloss "specify" "specified" "specifies" "specifying") (why "To set out distinctly, define (Genesis 30:28 διάστειλον τὸν μισθόν σου πρὸς μέ, Laban to Jacob: name the wage). \"Part your wage\" would read as sharing it.")))

(lemma "διασῴζω" (sense rescue (gloss "rescue" "rescued" "rescues" "rescuing") (why "To bring safely through, rescue; passive, escape to safety (Genesis 19:19 οὐ δυνήσομαι διασωθῆναι εἰς τὸ ὄρος; Acts 27:44; 28:1; 1 Peter 3:20). \"Rescue\" keeps it apart from σῴζω \"save\".")))

(lemma "διατηρέω" (sense maintain (gloss "maintain" "maintained" "maintains" "maintaining") (why "To keep carefully, keep up (Genesis 17:9-10, the covenant; Luke 2:51; Acts 15:29). \"Maintain\" keeps it apart from τηρέω \"keep\" and φυλάσσω \"guard\".")))

(lemma "διασπείρω" (sense scatter (gloss "scatter" "scattered" "scatters" "scattering") (why "To sow throughout, scatter, disperse (Genesis 11:4, 8, 9, the dispersal from Babel; Acts 8:1, 4, the church scattered).")))

(lemma "διατίθημι" (sense arrange (gloss "arrange" "arranged" "arranges" "arranging") (why "Middle: to arrange, dispose; with διαθήκη, to make a covenant (Genesis 21:27, 32 διέθεντο διαθήκην; Hebrews 8:10 ἡ διαθήκη ἣν διαθήσομαι, Luke 22:29). \"Arrange\" keeps the root visible: \"arranged a covenant\" (διαθήκη is itself the arrangement); not \"make\", which is ποιέω.")))

(lemma "διατρέφω" (sense sustain (gloss "sustain" "sustained" "sustains" "sustaining") (why "(LXX, supplied.) To keep fed through a time, sustain, keep alive (Genesis 7:3, διαθρέψαι σπέρμα, to sustain seed on all the earth). \"Sustain\" keeps it apart from τρέφω \"nourish\".")))

(lemma "διαφαύσκω" (sense grow-light (intransitive) (verb "grow light" "grew light" "grown light") (gloss "grow light" "grew light" "grown light" "grows light" "growing light") (why "(LXX, supplied.) Of the day: to dawn, grow light (Genesis 44:3 τὸ πρωὶ διέφαυσεν, \"the morning grew light\"). \"Grow light\" keeps it apart from the noun ὄρθρος \"dawn\"; the cognate διαυγάζω (2 Peter 1:19) is another word.")))

(lemma "διαφυλάσσω" (sense preserve (gloss "preserve" "preserved" "preserves" "preserving") (why "To guard carefully, keep safe (Genesis 28:15, 20, God keeping Jacob on the road; Luke 4:10 quotes Psalm 91:11). \"Preserve\" keeps it apart from φυλάσσω \"guard\".")))

(lemma "διαχωρίζω"
  (sense separate
    (gloss "separate" "separated" "separates" "separating")
    (why "(Supplied in Genesis 1, where the forms are LXX-only.) To divide, separate one thing from another (Luke 9:33, middle: \"part from\"). \"Separate\" in all five uses of Genesis 1. ἀφορίζω takes \"set apart\".")))

(lemma "δίδραχμον" (sense didrachm (gloss "didrachm" "didrachms") (why "A double drachma, a silver coin of two drachmas (Genesis 20:14, 16 χίλια δίδραχμα; Matthew 17:24, the didrachm tax). Kept as the coin's name.")))

(lemma "δίδυμος" (sense twin (gloss "twin" "twins") (why "(LXX, supplied.) Twin, double; neuter plural δίδυμα, \"twins\" (Genesis 25:24, Rebekah's twins; 38:27). Thomas's name Δίδυμος (John 11:16) is the same word.")))

(lemma "δίδωμι"
  (sense give
    (gloss "give" "gave" "given" "gives" "giving")
    (why "To give. Perfect δέδωκα (Genesis 1:29) is \"I have given\".")))

(lemma "διέρχομαι" (sense go-through (gloss "go through" "went through" "goes through" "going through") (why "To go through, pass through. Genesis 4:8 Διέλθωμεν, \"Let us go through\" into the plain.")))

(lemma "διηγέομαι" (sense relate (gloss "relate" "related" "relates" "relating") (why "To set out in detail, relate, recount (Genesis 24:66; Mark 5:16; Luke 8:39). \"Relate\" keeps it apart from λέγω \"say\" and the report-verbs ἀναγγέλλω \"declare\", ἀπαγγέλλω \"report\".")))

(lemma "δίκαιος" (sense righteous (gloss "righteous") (why "Righteous, just (Genesis 6:9, Noah; Matthew 1:19; Hebrews 11:4, 7). \"Righteous\" so ἀδικία \"unrighteousness\" and δικαιοσύνη stay visibly related.")))

(lemma "δικαιοσύνη" (sense righteousness (gloss "righteousness") (why "Righteousness, justice (Genesis 15:6, quoted in Romans 4:3; 18:19 ποιεῖν δικαιοσύνην καὶ κρίσιν). The noun of δίκαιος \"righteous\".")))

(lemma "δικαιόω" (sense justify (gloss "justify" "justified" "justifies" "justifying") (why "To declare or show righteous, justify; passive, to be justified, cleared (Genesis 38:26 Δεδικαίωται Θαμάρ; 44:16 τί δικαιωθῶμεν, \"how may we be justified\"; Romans 3:24-28). The verb of δίκαιος \"righteous\", δικαιοσύνη \"righteousness\".")))

(lemma "δικαίωμα" (sense statute (gloss "statute" "statutes") (why "What is laid down as right, a righteous requirement, statute (Genesis 26:5, Abraham kept God's statutes; Luke 1:6; Romans 1:32; Hebrews 9:1). \"Statute\" keeps it apart from πρόσταγμα \"ordinance\" and ἐντολή \"commandment\" in the lists where all three stand together.")))

(lemma "δικαίως" (sense justly (gloss "justly") (why "Justly, rightly (Genesis 27:36 Δικαίως ἐκλήθη τὸ ὄνομα αὐτοῦ Ἰακώβ; Luke 23:41; 1 Thessalonians 2:10). The adverb of δίκαιος.")))

(lemma "διοδεύω" (sense travel-through (gloss "travel through" "traveled through" "travels through" "traveling through") (why "To travel through, pass along (Genesis 12:6; Luke 8:1; Acts 17:1). \"Travel through\" keeps it apart from διέρχομαι \"go through\".")))

(lemma "διότι" (sense since (gloss "since") (why "Because, since: διὰ τοῦτο ὅτι (Genesis 5:24, quoted in Hebrews 11:5; Luke 1:13). \"Since\" to keep it apart from ὅτι \"because\".")))

(lemma "διπλοῦς" (sense double (gloss "double") (why "Double, twofold (Genesis 23:9-19; 25:9, τὸ σπήλαιον τὸ διπλοῦν, the double cave of Machpelah; Matthew 23:15; 1 Timothy 5:17).")))

(lemma "δίς" (sense twice (gloss "twice") (why "Twice (Genesis 43:10 ἤδη ἂν ὑπεστρέψαμεν δίς, \"already we would have returned twice\"; Mark 14:30; Luke 18:12).")))

(lemma "δισσός" (sense twofold (gloss "twofold") (why "(LXX, supplied.) Double, twofold (Genesis 43:12 τὸ ἀργύριον δισσὸν λάβετε, \"take the silver twofold\", where 43:15 has διπλοῦν). \"Twofold\" keeps it apart from διπλοῦς \"double\".")))

(lemma "διώκω" (sense pursue (gloss "pursue" "pursued" "pursues" "pursuing") (why "To pursue, chase; also persecute (Genesis 14:15; Matthew 5:10-12). \"Pursue\" for the chase; \"persecute\" may become its own sense. Kept apart from καταδιώκω \"chase\".")))

(lemma "διχοτόμημα" (sense half (gloss "half" "halves") (why "(LXX, supplied.) A piece cut in two, a half (Genesis 15:11, 17, the halves of the animals cut for the covenant; the verb διχοτομέω, Matthew 24:51).")))

(lemma "διώροφος" (sense two-storied (gloss "two-storied") (why "(LXX, supplied.) Having two stories or decks (Genesis 6:16).")))

(lemma "δοκέω" (sense seem (gloss "seem" "seemed" "seems" "seeming") (why "To seem, appear; to think (Genesis 19:14 ἔδοξεν δὲ γελοιάζειν, he seemed to be jesting; Luke 10:36; Acts 25:27). \"Think\" (Matthew 3:9) may become its own sense.")))

(lemma "δοκός" (sense beam (gloss "beam" "beams") (why "(LXX form supplied.) A beam of timber (Genesis 19:8 ὑπὸ τὴν στέγην τῶν δοκῶν μου, under the roof of my beams; Matthew 7:3-5).")))

(lemma "δόλος" (sense deceit (gloss "deceit") (why "Craft, deceit (Genesis 27:35 μετὰ δόλου; Mark 14:1; John 1:47 ἐν ᾧ δόλος οὐκ ἔστιν, of a true Israelite, against Jacob's deceit here).")))

(lemma "δόκιμος" (sense approved (gloss "approved") (why "Tested and found genuine, approved (Genesis 23:16, silver δοκίμου ἐμπόροις, \"approved to merchants\", current money; Romans 16:10; 2 Timothy 2:15).")))

(lemma "δόμα" (sense present (gloss "present" "presents") (why "A thing given, a present (Genesis 25:6, Abraham's presents to the sons of the concubines; Matthew 7:11; Ephesians 4:8). \"Present\" keeps it apart from δῶρον \"gift\".")))

(lemma "δόξα" (sense glory (gloss "glory") (why "Glory, honor, splendor (Genesis 31:1; 45:13, all my glory in Egypt; John 1:14; Romans 3:23).")))

(lemma "δορά" (sense pelt (gloss "pelt" "pelts") (why "(LXX, supplied.) A flayed skin, hide, pelt (Genesis 25:25, Esau \"whole as if [a] hairy pelt\"). \"Pelt\" keeps it apart from δέρμα \"skin\" and from the verb \"hide\" (κρύπτω).")))

(lemma "δόσις" (sense allowance (gloss "allowance" "allowances") (why "A giving, and the thing given as a regular portion, an allowance (Genesis 47:22, the priests ate the allowance Pharaoh gave them; Philippians 4:15; James 1:17, \"giving\"). \"Allowance\" keeps it apart from δόμα \"present\" (in the same verse) and δῶρον \"gift\".")))

(lemma "δουλεία" (sense slavery (gloss "slavery") (why "Slavery, bondage (Exodus 20:2 \"house of slavery\"; Romans 8:15). Swete spells δουλία.")))

(lemma "δουλεύω" (sense slave (dative "for") (gloss "slave" "slaved" "slaves" "slaving") (why "To be a slave, serve as a slave (Genesis 14:4, they were slaving for Chedorlaomer; 15:13; Matthew 6:24). \"Slave\" as a verb, beside δουλεία \"slavery\", keeps it apart from λατρεύω \"serve\".")))

(lemma "δουλόω" (sense enslave (gloss "enslave" "enslaved" "enslaves" "enslaving") (why "To make a slave of, enslave (Genesis 15:13, quoted in Acts 7:6; Romans 6:18).")))

(lemma "δοχή" (sense reception (gloss "reception" "receptions") (why "A receiving of guests, a reception, a banquet (Genesis 21:8 δοχὴν μεγάλην, as Luke 5:29 and 14:13). \"Reception\" keeps the root δέχομαι visible and leaves \"feast\" for ἑορτή.")))

(lemma "δραχμή" (sense drachma (gloss "drachma" "drachmas") (why "(LXX form supplied.) A drachma, a silver coin and a weight (Genesis 24:22, a ring ἀνὰ δραχμὴν ὁλκῆς, \"a drachma of weight\"; Luke 15:8-9). Kept as the coin's name, like δίδραχμον \"didrachm\".")))

(lemma "δρόσος" (sense dew (gloss "dew") (why "(LXX, supplied.) Dew (Genesis 27:28, 39, ἀπὸ τῆς δρόσου τοῦ οὐρανοῦ, Isaac's blessings).")))

(lemma "δρῦς" (sense oak (gloss "oak" "oaks") (why "(LXX, supplied.) An oak (Genesis 18:1 πρὸς τῇ δρυὶ τῇ Μαμβρή, \"by the oak of Mamre\").")))
(lemma "δύναμαι" (sense be-able (verb "be able" "was able" "been able") (gloss "be able" "able") (why "To be able, can (Genesis 13:6, 16; Matthew 6:24). \"Be able\" so every tense can be formed (\"were able\", \"is able\").")))

(lemma "δύνω" (sense set (gloss "set" "sets") (why "Of the sun, to go down, set (Genesis 28:11 ἔδυ γὰρ ὁ ἥλιος; Mark 1:32; Luke 4:40). Its noun δυσμή is \"setting\". (LXX form supplied.)")))

(lemma "δύναμις" (sense power (gloss "power" "powers") (why "Power, might (Matthew 22:29; Luke 1:35).")) (sense army (gloss "army" "armies") (why "An armed force, an army, as often in the Septuagint (Genesis 21:22, 32 ὁ ἀρχιστράτηγος τῆς δυνάμεως αὐτοῦ; Exodus 14:4).")))

(lemma "δυνάστης" (sense potentate (person) (gloss "potentate" "potentates") (why "(LXX form supplied.) A man of power, a court grandee (Genesis 50:4, Pharaoh's δυνάσται; 49:24 δυνάστου Ἰακώβ, of God; Luke 1:52; Acts 8:27; 1 Timothy 6:15). \"Potentate\" keeps it apart from ἄρχων \"ruler\".")))

(lemma "δυνατός" (sense mighty (comparative "mightier") (gloss "mighty" "mightier") (why "Able, powerful, mighty (Genesis 26:16 δυνατώτερος ἡμῶν ἐγένου σφόδρα, \"mightier than us\"; Luke 1:49; Romans 4:21). A \"possible\" sense (Mark 9:23) becomes its own sense when met.")))

(lemma "δύο"
  (sense two
    (gloss "two")
    (why "The numeral. οἱ δύο, \"the two\", in Genesis 2:24-25 and 3:7, is kept because the New Testament quotes it (Matthew 19:5; Mark 10:8; 1 Corinthians 6:16; Ephesians 5:31).")))

(lemma "δυσμή" (sense setting (gloss "setting" "settings") (why "The setting of the sun, hence the west: περὶ ἡλίου δυσμάς, πρὸς δυσμαῖς (Genesis 15:12, 17), plural as Swete prints it. \"West\" (Matthew 8:11, ἀπὸ ἀνατολῶν καὶ δυσμῶν) will be its own sense.")))

(lemma "δυστοκέω" (sense have-hard-labor (verb "have hard labor" "had hard labor" "had hard labor") (gloss "have hard labor" "had hard labor" "has hard labor" "having hard labor") (why "(LXX, supplied.) To be in hard labor, to give birth with difficulty (Genesis 35:16-17, Rachel bearing Benjamin; δυσ- \"ill\" + τόκος \"birth\").")))

(lemma "δώδεκα"(sense twelve (gloss "twelve") (why "The numeral twelve (Genesis 5:8; Matthew 10:1).")))

(lemma "δωρεάν" (sense freely (gloss "freely") (why "As a gift, for nothing, freely (Genesis 29:15, Laban: you will not slave for me δωρεάν; Matthew 10:8; John 15:25 \"without cause\"). The accusative of δωρεά \"gift\" used as an adverb.")))

(lemma "δωρέομαι" (sense bestow (gloss "bestow" "bestowed" "bestows" "bestowing") (why "To give as a gift, bestow (Genesis 30:20 Δεδώρηται ὁ θεός μοι δῶρον καλόν; Mark 15:45; 2 Peter 1:3-4). \"Bestow\" keeps it apart from δίδωμι \"give\"; its noun δῶρον is \"gift\".")))

(lemma "δῶρον" (sense gift (gloss "gift" "gifts") (why "Gift, offering (Matthew 5:23; Hebrews 11:4, Abel's gifts).")))
