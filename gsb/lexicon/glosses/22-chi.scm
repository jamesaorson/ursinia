;; Greek Source Bible concordance, lemmas beginning with χ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "χαβραθά" (sense chabratha (gloss "chabratha") (why "(LXX, supplied.) A Hebrew word for a stretch of land, kept untranslated by the Greek and printed lowercase by Swete (Genesis 35:16 ἤγγισεν χαβραθὰ εἰς γῆν; 48:7 κατὰ τὸν ἱππόδρομον χαβραθὰ τῆς γῆς). The English transliterates it as the Greek does, lowercase, since it is not a name.")))

(lemma "χαίρω" (sense rejoice (gloss "rejoice" "rejoiced" "rejoices" "rejoicing") (why "To rejoice, be glad (Genesis 45:16, Pharaoh rejoiced; Luke 1:14; John 3:29). The greeting χαῖρε will be its own sense. It shares \"rejoice\" with συγχαίρω \"rejoice with\", which adds \"with\".")))

(lemma "χάλαζα" (sense hail (gloss "hail" "hails") (why "Hail (Exodus 9:18-34, the seventh plague; 10:5, 12, 15; Revelation 8:7; 11:19; 16:21).")))

(lemma "Χαλαννή" (sense name (gloss "Calneh") (why "(LXX, supplied.) A city of Nimrod's kingdom (Genesis 10:10), Greek Χαλαννή; traditional English Calneh.")))

(lemma "Χάλαχ" (sense name (gloss "Calah") (why "(LXX, supplied.) A city built by Asshur (Genesis 10:11-12), Greek Χάλαχ; traditional English Calah.")))

(lemma "χαλάω" (sense slacken (voice active) (intransitive) (gloss "slacken" "slackened" "slackens" "slackening") (why "To slacken, loosen, let down; passive, to come loose (Exodus 39:21 ἵνα μὴ χαλᾶται τὸ λόγιον ἀπὸ τῆς ἐπωμίδος, that the oracle may not slacken from the shoulder-piece). The passive is rendered active, \"slacken\"; ἐκλύω has \"loosen\". The active \"let down\" the nets or the bed (Mark 2:4; Luke 5:4-5) will be its own sense. (LXX form supplied.)")))

(lemma "χαλβάνη" (sense galbanum (gloss "galbanum") (why "(LXX, supplied.) Galbanum, a bitter gum resin, an ingredient of the incense (Exodus 30:34 χαλβάνην ἡδυσμοῦ). The English word is the Greek one; tabernacle term.")))

(lemma "Χαλδαῖος" (sense name (person) (gloss "Chaldean" "Chaldeans") (why "A Chaldean (Genesis 11:28, 31, \"the country of the Chaldeans\"; Acts 7:4), traditional English.")))

(lemma "χαλκεύς" (sense smith (person) (gloss "smith" "smiths") (why "A metalworker, smith (2 Timothy 4:14).")))

(lemma "χαλκός" (sense bronze (dative "with") (gloss "bronze") (why "Copper, bronze (Revelation 18:12).")))

(lemma "χαλκοῦς" (sense bronze (gloss "bronze") (why "Of bronze, brazen (Exodus 26:11, 37; 27:3-4, 10-19, the clasps, bases, utensils, grate and pegs; Revelation 9:20). It shares \"bronze\" with the noun χαλκός, as ἀργυροῦς and ἀργύριον share \"silver\"; the alignment shows which Greek word stands behind it.")))

(lemma "Χάμ" (sense name (gloss "Ham") (why "(LXX, supplied.) Noah's son (Genesis 5:32; 6:10), traditional English Ham.")))

(lemma "Χανάαν" (sense name (gloss "Canaan") (why "Ham's son and the land named after him (Genesis 9:18; 11:31; 12:5; Acts 7:11), traditional English Canaan.")))

(lemma "Χαναναῖος" (sense name (person) (gloss "Canaanite" "Canaanites") (why "A Canaanite (Genesis 12:6; Matthew 15:22, the feminine), traditional English.")))

(lemma "Χανανῖτις" (sense name (person) (gloss "Canaanitess") (why "(LXX, supplied.) A Canaanite woman, the feminine of Χαναναῖος (Genesis 46:10, the son of the Canaanitess). One word for one Greek word; Matthew 15:22 has the adjective γυνὴ Χαναναία.")))

(lemma "χάρις" (sense grace (gloss "grace") (why "Favor, grace (Genesis 6:8, Noah found grace; Luke 1:30; John 1:14-17). \"Grace\" in both testaments so \"found grace\" (Genesis 6:8; Luke 1:30) stays recognizable.")))

(lemma "χαροποιός" (sense gladdening (gloss "gladdening") (why "(LXX, supplied.) Making glad, gladdening, bright (Genesis 49:12 χαροποιοὶ οἱ ὀφθαλμοὶ αὐτοῦ ὑπὲρ οἶνον).")))

(lemma "Χαρμί" (sense name (gloss "Carmi") (why "(LXX, supplied.) A son of Reuben (Genesis 46:9), Greek Χαρμί; traditional English Carmi.")))

(lemma "Χαρράν" (sense name (gloss "Haran") (why "The city in Mesopotamia (Genesis 11:31-32; 12:4-5; Acts 7:2, 4, KJV \"Charran\"), traditional English Haran. It shares \"Haran\" with Ἁρράν, Terah's son, as English Bibles do (Hebrew Ḥaran / Haran); the Greek on hover tells them apart.")))

(lemma "Χασβί" (sense name (gloss "Chezib") (why "(LXX, supplied.) The place where Shua's daughter bore Shelah (Genesis 38:5), Greek Χασβί for the Hebrew Chezib; traditional English Chezib.")))

(lemma "Χάσζαδ" (sense name (gloss "Chesed") (why "(LXX, supplied.) Nahor's son (Genesis 22:22); the Greek form of the Hebrew Chesed. Traditional English Chesed.")))

(lemma "χάσκω" (sense gape (gloss "gape" "gaped" "gapes" "gaping") (why "(LXX, supplied.) To gape, open the mouth wide: the earth that gaped its mouth to receive Abel's blood (Genesis 4:11).")))

(lemma "Χασμωνιείμ" (sense name (person) (plural "Casluhim") (gloss "Casluhim") (why "(LXX, supplied.) A people descended from Mizraim, from whom the Philistines came (Genesis 10:14). Swete's Χασμωνιείμ stands where the Hebrew has Casluhim; taken as the same name and given its traditional English form.")))

(lemma "Χαφθοριείμ" (sense name (person) (plural "Caphtorim") (gloss "Caphtorim") (why "(LXX, supplied.) A people descended from Mizraim (Genesis 10:14), Greek Χαφθοριείμ; traditional English Caphtorim.")))

(lemma "Χεβρών" (sense name (gloss "Hebron") (why "(LXX, supplied.) Hebron (Genesis 13:18, the oak of Mamre which was in Hebron); traditional English.")))

(lemma "χεῖλος" (sense lip (gloss "lip" "lips") (why "Lip, and so speech, language (Genesis 11:1, 6, 9, \"one lip\"; Matthew 15:8; Romans 3:13). \"Lip\" kept word for word; γλῶσσα is \"tongue\".")))

(lemma "χείμαρρος" (sense torrent (gloss "torrent" "torrents") (why "A winter-flowing stream, torrent, wadi (Genesis 32:23 διέβη τὸν χειμάρρουν, the Jabbok; John 18:1 πέραν τοῦ χειμάρρου τῶν Κέδρων). Swete's accusative χειμάρρουν is the contracted form.")))

(lemma "χείρ"
  (sense hand
    (gloss "hand" "hands")
    (why "Hand. Greek often has the article where English has a possessive (τὴν χεῖρα, Genesis 3:22): the literal layer keeps \"the hand\".")))

(lemma "Χερούβ"
  (sense cherub
    (gloss "cherub" "cherubim")
    (why "(Supplied in Genesis 3:24; Swete prints τὰ χερουβίν.) The Hebrew loanword, lemmatized as in the New Testament table (Hebrews 9:5); \"cherubim\" for the plural form.")))

(lemma "Χέτ" (sense name (gloss "Heth") (why "(LXX, supplied.) The ancestor of the Hittites, Canaan's son (Genesis 10:15; 23:3-20 οἱ υἱοὶ Χέτ; 27:46 αἱ θυγατέρες τῶν υἱῶν Χέτ); traditional English Heth.")))

(lemma "Χετταῖος" (sense name (person) (gloss "Hittite" "Hittites") (why "(LXX, supplied.) The Hittites (Genesis 15:20; 23:10), by the traditional English name.")))

(lemma "Χεττούρα" (sense name (gloss "Keturah") (why "(LXX, supplied.) Abraham's wife after Sarah (Genesis 25:1, 4), declined in the Greek (Χεττούρας); traditional English Keturah.")))

(lemma "χήρευσις" (sense widowhood (gloss "widowhood") (why "(LXX, supplied.) Widowhood, the state of a widow (Genesis 38:14, 19, τὰ ἱμάτια τῆς χηρεύσεως, Tamar's widow's clothes). Kept with χῆρος \"widow\".")))

(lemma "χῆρος" (sense widow (person) (gloss "widow" "widows") (why "Bereaved; as a noun χήρα, a widow (Genesis 38:11, Κάθου χήρα, Judah to Tamar; Mark 12:42; Acts 6:1). The New Testament table lemmatizes χήρα under χῆρος.")))

(lemma "χιλίαρχος" (sense commander-of-thousands (person) (plural "commanders of thousands") (gloss "commander of thousands" "commanders of thousands") (why "Commander of a thousand (Exodus 18:21, 25, the highest rank of judges Moses set over the people; Mark 6:21; Acts 21:31, the Roman tribune). Each rank \"commander of\" its number, with ἑκατοντάρχης, πεντηκόνταρχος and δεκάδαρχος; \"commander\" alone would not say which. (LXX form supplied.)")))

(lemma "χιλιάς" (sense thousand (gloss "thousand" "thousands") (why "A thousand.")))

(lemma "χίλιοι" (sense thousand (gloss "thousand") (why "The numeral adjective, a thousand (Genesis 20:16 χίλια δίδραχμα; Revelation 20:2-7). It shares \"thousand\" with the noun χιλιάς: English has one word for both.")))

(lemma "χιτών"
  (sense tunic
    (gloss "tunic" "tunics")
    (why "The tunic, the garment worn next to the skin (Genesis 3:21; John 19:23). Against ἱμάτιον, which will take \"garment\" or \"cloak\".")))

(lemma "χιών" (sense snow (gloss "snow") (why "Snow (Exodus 4:6, Moses' hand ὡσεὶ χιών; Matthew 28:3; Revelation 1:14).")))

(lemma "χλωρός"
  (sense green
    (gloss "green")
    (why "Green, pale green (Genesis 1:30; 2:5; Mark 6:39); \"pale\" of the horse in Revelation 6:8 may be its own sense.")))

(lemma "Χόβωρ" (sense name (gloss "Heber") (why "(LXX, supplied.) A son of Beriah, Asher's grandson (Genesis 46:17), Greek Χόβωρ; traditional English Heber. Swete prints the same name for Benjamin's second son (46:21), where the Hebrew has Becher: the Greek gives the name Heber, so the English follows it (rule 8, as Μαθουσαλά).")))

(lemma "Χοδδάν" (sense name (gloss "Hadad") (why "(LXX, supplied.) A son of Ishmael (Genesis 25:15); Swete's Χοδδάν for the Hebrew Hadad, traditional English Hadad.")))

(lemma "Χοδολλογόμορ" (sense name (gloss "Chedorlaomer") (why "(LXX, supplied.) King of Elam (Genesis 14:1-17; Swete spells Χοδαλλογόμορ at 14:17); traditional English Chedorlaomer.")))

(lemma "χονδρίτης" (sense groat-cake (gloss "groat cake" "groat cakes") (why "(LXX, supplied.) Bread or cake of groats, coarse-ground grain (χόνδρος), Genesis 40:16, the baker's three baskets of them.")))

(lemma "χορός" (sense dance (gloss "dance" "dances") (why "A dance, dancing (Exodus 15:20, the women went out with drums and dances; Luke 15:25).")))

(lemma "Χορραῖος" (sense name (person) (gloss "Horite" "Horites") (why "(LXX, supplied.) The Horites of Mount Seir (Genesis 14:6); traditional English Horite.")))

(lemma "Χορρεί" (sense name (gloss "Hori") (why "(LXX, supplied.) Hori, a son of Lotan (Genesis 36:22); at 36:29-30 ἡγεμόνες Χορρεί, where the Hebrew has \"the Horite\", the Greek gives the same name, so \"chiefs of Hori\". Traditional English Hori; the people are Χορραῖος \"Horite\".")))

(lemma "χόρτασμα"(sense fodder (gloss "fodder" "fodders") (why "Food for animals, fodder (Genesis 24:25, 32; Acts 7:11, the food the fathers could not find). Kept apart from χόρτος \"grass\".")))

(lemma "χόρτος"
  (sense grass
    (gloss "grass")
    (why "Grass, green plants (Genesis 1:11-12, 29-30; Matthew 6:30).")))

(lemma "χοῦς"
  (sense dust
    (gloss "dust")
    (why "Dust, loose soil (Genesis 2:7; Mark 6:11). Related to χοϊκός, \"made of dust\" (1 Corinthians 15:47-49), which will take \"dusty\" or \"of dust\".")))

(lemma "Χούς" (sense name (gloss "Cush") (why "(LXX, supplied.) Ham's son, Nimrod's father (Genesis 10:6-8), Greek Χούς; traditional English Cush. Where the Greek says Αἰθιοπία (2:13) the English follows the Greek; here it gives the name itself.")))

(lemma "χράομαι" (sense use (dative "") (gloss "use" "used" "uses" "using") (why "To use, deal with, with the dative (Genesis 12:16, τῷ Ἀβρὰμ εὖ ἐχρήσαντο, \"they used Abram well\", treated him well; Acts 27:3, 17; 1 Corinthians 7:31).")))

(lemma "χρήσιμος" (sense useful (gloss "useful") (why "Useful, profitable (Genesis 37:26, Judah: Τί χρήσιμον ἐὰν ἀποκτείνωμεν τὸν ἀδελφὸν ἡμῶν; 2 Timothy 2:14).")))

(lemma "χρίσις" (sense anointment (gloss "anointment" "anointments") (why "(LXX, supplied.) The act of anointing: τὸ ἔλαιον τῆς χρίσεως \"the oil of the anointment\" (Exodus 29:21; 30:25; 31:11). \"Anointment\" keeps it apart from χρῖσμα \"anointing\" (29:7 τοῦ ἐλαίου τοῦ χρίσματος), the two nouns of χρίω \"anoint\". Use this English in every tabernacle chapter.")))

(lemma "χρῖσμα" (sense anointing (gloss "anointing" "anointings") (why "An anointing, the oil or ointment applied (1 John 2:20, 27): τοῦ ἐλαίου τοῦ χρίσματος \"of the oil of the anointing\" (Exodus 29:7; 30:25). Kept apart from χρίσις \"anointment\". Use this English in every tabernacle chapter.")))

(lemma "χρίω" (sense anoint (gloss "anoint" "anointed" "anoints" "anointing") (why "To anoint with oil for an office (Luke 4:18 quoting Isaiah 61:1; Acts 10:38; Hebrews 1:9): χρίσεις αὐτούς \"you will anoint them\", of Aaron and his sons (Exodus 28:41; 29:7, 36; 30:26, 30), and the root of Χριστός. It shares \"anoint\" with ἀλείφω, unavoidably, though that entry asked for another word: English has no second verb for anointing, and \"smear\" or \"christen\" would mislead; the alignment shows which Greek word stands behind it. For the owner to confirm.")))

(lemma "χρόα" (sense color (gloss "color" "colors") (why "(LXX, supplied.) The skin, its color, complexion: Exodus 4:7, the hand restored εἰς τὴν χρόαν τῆς σαρκὸς αὐτῆς.")))

(lemma "χρονίζω" (sense delay (gloss "delay" "delayed" "delays" "delaying") (why "To spend time, delay, linger (Genesis 34:19, the young man did not delay to do the thing; Matthew 24:48; 25:5; Hebrews 10:37). The verb of χρόνος \"time\".")))

(lemma "χρόνος" (sense time (gloss "time" "times") (why "Time, a stretch of time (Genesis 26:1, 15 ἐν τῷ χρόνῳ τοῦ Ἀβραάμ, \"in the time of Abraham\"; Luke 1:57; Galatians 4:4). Kept apart from καιρός \"season\".")))

(lemma "χρυσίον"
  (sense gold
    (dative "with")
    (gloss "gold")
    (why "Gold. χρυσός will share \"gold\" with a note if needed.")))

(lemma "χρυσόλιθος" (sense chrysolite (gloss "chrysolite" "chrysolites") (why "Chrysolite, \"gold stone\" (Revelation 21:20), the first stone of the oracle's fourth row (Exodus 28:20; 36:20). The stones of the oracle keep the names the Greek gives them, in their English forms.")))

(lemma "χρυσοτόρευτος" (sense gold-embossed (gloss "gold-embossed") (why "(LXX, supplied.) Worked in relief in gold (χρυσός + τορευτός \"embossed\"): δύο χερουβεὶμ χρυσοτορευτά, the two cherubim of the propitiatory (Exodus 25:18).")))

(lemma "χρυσοῦς" (sense golden (gloss "golden") (why "Made of gold.")))

(lemma "χρυσόω" (sense gild (dative "with") (verb "gild" "gilded" "gilded") (gloss "gild" "gilded" "gilds" "gilding") (why "To overlay with gold, gild (Exodus 26:32, 37, the columns κεχρυσωμένων χρυσίῳ; Revelation 17:4; 18:16). Kept beside καταχρυσόω \"gild over\". Tabernacle term.")))

(lemma "χρῶμα" (sense hue (gloss "hue" "hues") (why "(LXX, supplied.) Color, the coloring of a surface: ἡ ὄψις τοῦ χρώματος τοῦ προσώπου αὐτοῦ (Exodus 34:29-30), the look of the skin of Moses' face, glorified. \"Hue\" because χρόα has \"color\" and χρώς \"skin\".")))

(lemma "χρώς" (sense skin (gloss "skin" "skins") (why "(LXX, supplied.) The skin, the surface of the body: καλύψαι ἀσχημοσύνην χρωτὸς αὐτῶν \"to cover shame of their skin\" (Exodus 28:42). It shares \"skin\" with δέρμα, unavoidably: \"flesh\" is σάρξ's and \"body\" σῶμα's; χρόα is \"color\".")))

(lemma "Χωβάλ" (sense name (gloss "Hobah") (why "(LXX, supplied.) Genesis 14:15, the place on the left of Damascus, Greek Χωβάλ for the Hebrew Hobah; traditional English Hobah, the same place in a Greek spelling.")))

(lemma "χυδαῖος" (sense teeming (gloss "teeming") (why "(LXX, supplied.) Poured out, abundant, numerous (Exodus 1:7 καὶ χυδαῖοι ἐγένοντο, the sons of Israel came to be teeming). From χέω \"pour\"; \"teeming\" keeps it apart from πολύς \"many\" and πλῆθος \"multitude\".")))

(lemma "χῶμα" (sense soil (gloss "soil" "soils") (why "(LXX, supplied.) Heaped-up earth, loose soil, dust (χώννυμι \"heap up\"): Exodus 8:16-17, Aaron struck τὸ χῶμα τῆς γῆς and it became gnats. \"Soil\" because \"dust\" is χοῦς's and \"earth\" γῆ's.")))

(lemma "χώνευσις" (sense smelting (gloss "smelting" "smeltings") (why "(LXX, supplied.) A melting, casting of metal (χωνεύω \"mold\"): the hundred talents of silver went εἰς τὴν χώνευσιν of the hundred capitals (Exodus 38:27). \"Smelting\" because κυμάτιον has \"molding\" and βάλλω \"cast\".")))

(lemma "χωνευτός" (sense molded (gloss "molded") (why "(LXX, supplied.) Cast in a mold, molten (Exodus 32:4, 8, μόσχον χωνευτόν, the golden calf). The verbal adjective of χωνεύω \"mold\", so \"molded\"; traditional \"molten\".")))

(lemma "χωνεύω" (sense mold (gloss "mold" "molded" "molds" "molding") (why "(LXX, supplied.) To melt, cast metal in a mold (χέω \"pour\"): the bronze bases χωνεύσεις (Exodus 26:37; 25:12; 36-38); the calf of 32:4 is χωνευτός. \"Mold\" keeps it apart from ἐπιβάλλω and βάλλω \"cast\".")))

(lemma "χώρα" (sense country (gloss "country" "countries") (why "A land, region, country (Genesis 11:28, 31, \"the country of the Chaldeans\"; Luke 15:13). \"Country\" keeps it apart from γῆ \"land/earth\".")))

(lemma "χωρέω" (sense contain (gloss "contain" "contained" "contains" "containing") (why "To make room for, hold, contain (Genesis 13:6, the land was not containing them; John 2:6; 21:25). \"Contain\" for the transitive sense; the intransitive \"go, advance\" (Matthew 15:17) will be its own sense.")))

(lemma "Χωρήβ" (sense name (gloss "Horeb") (why "(LXX, supplied.) Horeb, the mountain of God (Exodus 3:1; 17:6, the rock struck for water). Greek Χωρήβ, indeclinable; traditional English Horeb.")))

(lemma "χωρίς"
  (sense apart-from
    (gloss "apart from")
    (why "Separation: \"apart from\", not \"without\", which is kept for ἄνευ.")))
