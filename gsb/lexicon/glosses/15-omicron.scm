;; Greek Source Bible concordance, lemmas beginning with ο (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ὁ"
  (sense the
    (gloss "the")
    (why "The article, rendered \"the\" wherever English can carry it, including with abstract nouns (\"the tree of the life\") in the literal layer."))
  (sense unrendered
    (gloss "")
    (why "English puts no article before \"God\" or a personal name (\"Adam\"), so the Greek article there is aligned with the noun and left unrendered. The alignment colors still show that the Greek has it; the literal layer does not invent a distinction English cannot hear (\"the God\")."))
  (sense attributive
    (gloss "")
    (why "The repeated article of the Greek attributive pattern \"the X the Y\" (τοὺς φωστῆρας τοὺς μεγάλους, \"the great luminaries\"; τὸ ὕδωρ τὸ ὑποκάτω τοῦ οὐρανοῦ, \"the water under the heaven\"). English says \"the\" once, so the second article is aligned with the word it marks and left unrendered."))
  (sense infinitive
    (gloss "")
    (why "The article before an infinitive (πρὸ τοῦ γενέσθαι, τοῦ γινώσκειν) marks the infinitive as a noun; English has no article for that, so it is aligned with the infinitive and left unrendered. A genitive τοῦ's \"of\" goes with the infinitive's segment."))
  (sense absorbed
    (gloss "")
    (why "English drops the article when a possessive pronoun or a demonstrative stands with the noun: τὰ ἔργα αὐτοῦ \"his works\", τῆς γῆς ἐκείνης \"that land\". The article is aligned with its noun and left unrendered rather than keeping \"the works of him\". The owner may prefer the fuller \"the works of him\"."))
  (sense pronoun
    (gloss "he" "she" "it" "they")
    (why "ὁ δέ, ἡ δέ, οἱ δέ: the article standing alone before δέ is a pronoun, \"but he\" (Genesis 4:9). English pronoun by the article's gender and number.")))

(lemma "ὀγδοήκοντα" (sense eighty (gloss "eighty") (why "The numeral eighty (Genesis 5:25-28; Luke 2:37).")))

(lemma "ὄγδοος" (sense eighth (gloss "eighth") (why "The ordinal \"eighth\" (Genesis 17:12, 14, circumcision on the eighth day; Luke 1:59; Philippians 3:5).")))

(lemma "ὅδε" (sense this (gloss "this" "these") (why "This (here), pointing forward: τάδε \"these [things]\" (Exodus 20:22).")))

(lemma "ὁδοιπόρος" (sense traveler (person) (gloss "traveler" "travelers") (why "(LXX, supplied.) A wayfarer, one going on the road (ὁδός + πορεύομαι): Genesis 37:25, ὁδοιπόροι Ἰσμαηλεῖται, \"Ishmaelite travelers\".")))

(lemma "Ὀδολλαμίτης" (sense name (person) (gloss "Adullamite" "Adullamites") (why "(LXX, supplied.) A man of Adullam, said of Judah's friend Hirah (Genesis 38:1, 12, 20); Swete prints Ὀδολλαμίτην and Ὀδολλαμείτης. Traditional English Adullamite.")))

(lemma "Ὁδορρά" (sense name (gloss "Hadoram") (why "(LXX, supplied.) A son of Joktan (Genesis 10:27), Greek Ὁδορρά; traditional English Hadoram.")))

(lemma "ὁδός"
  (sense way
    (gloss "way" "ways")
    (why "A road, path, way, and so a way of life (Genesis 3:24, \"the way of the tree of the life\"; John 14:6, \"I am the way\"). \"Way\" everywhere; \"road\" or \"journey\" only in the readable layer.")))

(lemma "ὀδύνη" (sense anguish (gloss "anguish" "anguishes") (why "(LXX, supplied.) Pain of body or mind, anguish (Genesis 44:31 μετ’ ὀδύνης εἰς ᾅδου, beside 44:29 μετὰ λύπης; Romans 9:2; 1 Timothy 6:10). \"Anguish\" keeps it apart from λύπη.")))

(lemma "ὀδούς" (sense tooth (plural "teeth") (gloss "tooth" "teeth") (why "(LXX form supplied.) A tooth (Genesis 49:12, his teeth white rather than milk; Matthew 5:38; 8:12, the gnashing of teeth).")))

(lemma "ὅθεν" (sense from-where (gloss "from where") (why "From where, whence (Genesis 10:14, ὅθεν ἐξῆλθεν ἐκεῖθεν, \"from where came forth from there\"; Matthew 12:44; Hebrews 11:19). \"From where\" rather than archaic \"whence\".")))

(lemma "οἶδα"
  (sense know
    (gloss "know" "knew" "known" "knows" "knowing")
    (why "To know (a perfect with present meaning; ᾔδει, Genesis 3:5, is its past, \"knew\"). It shares \"know\" with γινώσκω; see that entry.")))

(lemma "οἰκέτης" (sense house-servant (person) (gloss "house servant" "house servants") (why "A household servant, domestic (Genesis 9:25, παῖς οἰκέτης; Luke 16:13; Acts 10:7; 1 Peter 2:18). \"House servant\" renders οἶκος and keeps it apart from παῖς \"servant\" and δοῦλος.")))

(lemma "οἰκέω" (sense dwell (gloss "dwell" "dwelt" "dwells" "dwelling") (why "To dwell, inhabit. Kept apart from κατοικίζω \"settle\" and κατοικέω.")))

(lemma "οἰκία" (sense house (gloss "house" "houses") (why "House, household. Shares \"house\" with οἶκος; the alignment shows which.")))

(lemma "οἰκοδομέω"
  (sense build
    (gloss "build" "built" "builds" "building")
    (why "To build (Genesis 2:22, the side built into a woman; Matthew 16:18). Figurative \"edify\" (1 Corinthians 8:1) keeps \"build\" (\"build up\").")))

(lemma "οἰκογενής" (sense home-born (gloss "home-born") (why "(LXX, supplied.) Born in the house, of a slave born in the household (Genesis 17:12-27, beside the ἀργυρώνητος \"bought with silver\"). \"Home-born\" renders οἶκος + γίνομαι.")))

(lemma "οἶκος" (sense house (gloss "house" "houses") (why "House, household (\"house of slavery\", \"house of Jacob\").")))

(lemma "οἶνος" (sense wine (gloss "wine" "wines") (why "Wine (Genesis 9:21, 24, Noah's wine; John 2:3-10).")))

(lemma "οἰνοχοέω" (sense pour-wine (gloss "pour wine" "poured wine" "pours wine" "pouring wine") (why "(LXX, supplied.) To pour wine, serve as cupbearer (Genesis 40:13 ὡς ἦσθα οἰνοχοῶν); the verb of ἀρχιοινοχόος \"chief cupbearer\".")))

(lemma "οἴομαι" (sense suppose (gloss "suppose" "supposed" "supposes" "supposing") (why "To think, suppose, imagine (Genesis 40:16 ᾤμην, the baker in his dream; John 21:25 οἶμαι; Philippians 1:17). Kept apart from δοκέω.")))

(lemma "οἷος" (sense such-as (gloss "such as") (why "Of what kind, such as (Genesis 44:15 ἄνθρωπος οἷος ἐγώ, \"human such as I\"; Matthew 24:21; 2 Corinthians 10:11). \"Such as\" keeps it apart from τοιοῦτος \"such\" and ὅσος.")))

(lemma "οἴχομαι" (sense go-along (gloss "go along" "went along" "gone along" "goes along" "going along") (why "(LXX, supplied.) To go, be on one's way (Genesis 12:4, \"and Lot was going along with him\"). \"Go along\" keeps it apart from πορεύομαι \"go\" and ἀποίχομαι \"go off\".")))

(lemma "οἰωνίζομαι" (sense take-omens (verb "take omens" "took omens" "taken omens") (gloss "take omens" "took omens" "taken omens" "takes omens" "taking omens") (why "(LXX, supplied.) To read omens from birds (οἰωνός), to divine (Genesis 30:27, Laban: οἰωνισάμην ἄν; 44:5, 15, Joseph's cup). \"Take omens\" keeps the root's picture.")))

(lemma "οἰωνισμός" (sense augury (dative "with") (gloss "augury" "auguries") (why "(LXX, supplied.) The taking of omens, augury (Genesis 44:5, 15 οἰωνισμῷ οἰωνίζεται, \"he takes omens with augury\", the Greek echoing the Hebrew doubled verb). The noun of οἰωνίζομαι \"take omens\".")))

(lemma "ὀκτακόσιοι" (sense eight-hundred (gloss "eight hundred") (why "(LXX, supplied.) The numeral eight hundred (Genesis 5:17, 19).")))

(lemma "ὀκτώ" (sense eight (gloss "eight") (why "The numeral eight (Genesis 5:28; 1 Peter 3:20, the eight souls saved in the ark).")))

(lemma "Ὀλιβεμά" (sense name (gloss "Oholibamah") (why "(LXX, supplied.) Esau's wife, daughter of Anah (Genesis 36:2, 5, 14, 18, 25), and a chief of Esau (36:41); Swete prints Ὀλιβεμά, Ἐλιβέμας and Ἐλιβεμᾶς. Traditional English Oholibamah.")))

(lemma "ὀλίγος"(sense few (gloss "few") (why "Few, little (Matthew 7:14; 9:37). Genesis 34:30 ὀλιγοστός, its superlative, \"most few\" (fewest) in number.")))

(lemma "ὁλκή" (sense weight (gloss "weight" "weights") (why "(LXX, supplied.) A drawing down of the scale, weight (Genesis 24:22, a ring of a drachma's weight and bracelets of ten gold [pieces] their weight).")))

(lemma "ὁλοκάρπωσις" (sense whole-offering (with-preposition "εἰς" for) (gloss "whole offering" "whole offerings") (why "(LXX, supplied.) An offering given whole, the Septuagint's word in Genesis 8:20 (and elsewhere) for the burnt offering: ὅλος \"whole\" with καρπόω \"offer as fruit, burn\". \"Whole offering\" keeps it apart from ὁλοκαύτωμα \"whole burnt offering\".")))

(lemma "ὁλοκαύτωμα" (sense whole-burnt-offering (gloss "whole burnt offering" "whole burnt offerings") (why "A whole burnt offering (Hebrews 10:6).")))

(lemma "ὅλος" (sense whole (gloss "whole") (why "Whole, entire, all of (Genesis 25:25, Esau came out ὅλος ὡσεὶ δορὰ δασύς, \"whole as if [a] hairy pelt\"; Matthew 4:23; John 4:53). \"Whole\" keeps it apart from πᾶς \"all\".")))

(lemma "ὀμνύω" (sense swear (gloss "swear" "swore" "sworn" "swears" "swearing") (why "To swear an oath (Genesis 21:23-31, 22:16 Κατ' ἐμαυτοῦ ὤμοσα, quoted in Hebrews 6:13; Matthew 5:34). The one sworn by is in the accusative (ὄμοσόν μοι τὸν θεόν) or after κατά.")))

(lemma "ὅμοιος"
  (sense like
    (dative "")
    (gloss "like")
    (why "Like, resembling (Genesis 2:20, a helper like him; Matthew 13:31). Against ὡς \"as\".")))

(lemma "ὁμοιότης"
  (sense similarity
    (with-preposition "εἰς" for)
    (gloss "similarity")
    (why "Similarity, resemblance (Genesis 1:11-12; Hebrews 4:15; 7:15). Kept apart from ὁμοίωσις (\"likeness\", Genesis 1:26; James 3:9) and ὁμοίωμα (Romans 8:3; Philippians 2:7), which will need its own gloss.")))

(lemma "ὁμοιόω" (sense make-like (dative "") (verb "make like" "made like" "made like") (gloss "make like" "made like" "makes like" "making like") (why "To make like; passive, to be made like, become like, with the dative (Genesis 34:15, 22-23, ὁμοιωθησόμεθα ὑμῖν \"we will be made like you\"; Matthew 6:8; Hebrews 2:17). The verb of ὅμοιος.")))

(lemma "ὁμοίωμα" (sense resemblance (gloss "resemblance" "resemblances") (why "A likeness, form (Exodus 20:4; Romans 1:23; Philippians 2:7). \"Resemblance\" so as not to share \"likeness\" with ὁμοίωσις.")))

(lemma "ὁμοίωσις"
  (sense likeness
    (gloss "likeness")
    (why "Likeness (Genesis 1:26; James 3:9, people \"who have come to be according to [the] likeness of God\"). One gloss keeps James's echo of Genesis visible.")))

(lemma "ὁμομήτριος" (sense same-mother (gloss "same-mother") (why "(LXX, supplied.) Born of the same mother (Genesis 43:16, 29, Benjamin τὸν ἀδελφὸν αὐτοῦ τὸν ὁμομήτριον, Joseph's brother by Rachel). The hyphen keeps the one Greek word one English word.")))

(lemma "ὄνειδος" (sense reproach (gloss "reproach" "reproaches") (why "Reproach, disgrace (Genesis 30:23, Rachel: Ἀφεῖλεν ὁ θεός μου τὸ ὄνειδος; 34:14; Luke 1:25, Elizabeth's same words).")))

(lemma "ὄνομα"
  (sense name
    (gloss "name" "names")
    (why "A name.")))

(lemma "ὀνομάζω" (sense call-by-name (gloss "call by name" "called by name" "calls by name" "calling by name") (why "To give a name to, call by name (Genesis 26:18, the names ἃ ὠνόμασεν Ἀβραάμ; Luke 6:13-14; Ephesians 1:21). \"Call by name\" keeps it apart from ἐπονομάζω \"name\" and καλέω \"call\" in the same verse.")))

(lemma "ὀνομαστός" (sense renowned (gloss "renowned") (why "(LXX, supplied.) Named, famous, renowned (Genesis 6:4, οἱ ἄνθρωποι οἱ ὀνομαστοί).")))

(lemma "ὄνος" (sense donkey (gloss "donkey" "donkeys") (why "A donkey, ass, male or female (Genesis 12:16; Matthew 21:2-7; John 12:15).")))

(lemma "ὄπισθεν" (sense at-back (gloss "at back") (why "Behind, at the back, with the genitive (Genesis 18:10 οὖσα ὄπισθεν αὐτοῦ \"being at back of him\", the genitive giving \"of\"; Matthew 9:20, she came from behind and touched). \"At back\" keeps it apart from ὀπίσω \"behind\".")))

(lemma "ὀπισθοφανής" (sense backward (gloss "backward") (why "(LXX, supplied.) Looking backward, with the back turned (Genesis 9:23: the brothers walked ὀπισθοφανῶς, the adverb, filed here, and their face was ὀπισθοφανές). One English word for the adjective and its adverb, as the Greek has one stem.")))

(lemma "ὀπίσω" (sense behind (gloss "behind") (why "Behind, after (Genesis 8:8, he sent the dove behind it, after the raven; Matthew 4:19, come behind me). \"Behind\" keeps it apart from μετά \"after\".")))

(lemma "ὀπτάω" (sense bake (gloss "bake" "baked" "bakes" "baking") (why "(LXX, supplied.) To roast, bake (Genesis 11:3, \"let us bake them with fire\", of bricks).")))

(lemma "ὅπως" (sense in-order-that (gloss "in order that") (why "Purpose: \"in order that\", kept apart from ἵνα \"so that\".")))

(lemma "ὅραμα" (sense vision (gloss "vision" "visions") (why "A thing seen, a vision (Genesis 15:1 ἐν ὁράματι; Acts 9:10; 10:3). \"Vision\" against ὅρασις, the act of seeing.")))

(lemma "ὅρασις"
  (sense sight
    (with-preposition "εἰς" for)
    (gloss "sight")
    (why "Seeing, sight, appearance (Genesis 2:9, \"beautiful for sight\"; Revelation 4:3). Visions (Acts 2:17) may become their own sense; ὅραμα will take \"vision\".")))

(lemma "ὁράω"
  (sense see
    (gloss "see" "saw" "seen" "sees" "seeing")
    (why "To see. The table lemmatizes εἶδον (Swete's ἴδεν) and ἰδεῖν under ὁράω; in Genesis 1 the unlemmatized ἴδεν is supplied as ὁράω."))
  (sense appear
    (voice active)
    (gloss "appear" "appeared" "appears" "appearing")
    (why "The aorist passive (ὤφθη, ὀφθήτω): to appear, be seen (Genesis 1:9; 1 Corinthians 15:5-8). \"Appear\" because English \"was seen\" loses the sense of showing itself."))
  (sense behold
    (gloss "behold")
    (why "The particle ἰδού, which the table lemmatizes under ὁράω: \"behold\" everywhere (Genesis 1:29, 31; 3:22; Matthew 1:20), never dropped and never \"look\" or \"see\", so it is recognizable at every use.")))

(lemma "Ὀρέχ" (sense name (gloss "Erech") (why "(LXX, supplied.) A city of Nimrod's kingdom (Genesis 10:10), Greek Ὀρέχ; traditional English Erech.")))

(lemma "ὀρεινός" (sense hill-country (gloss "hill country") (why "Mountainous; ἡ ὀρεινή (γῆ), the hill country (Genesis 14:10, the ones left fled into the hill country; Luke 1:39, 65). Swete spells it ὀρινή.")))

(lemma "ὀρθόω" (sense set-upright (verb "set upright" "set upright" "set upright") (gloss "set upright" "sets upright" "setting upright") (why "(LXX, supplied.) To set upright, make straight; passive, to be set upright, stand straight (Genesis 37:7, Joseph's sheaf ἀνέστη ... καὶ ὠρθώθη, \"stood up and was set upright\"). The compound ἀνορθόω is Luke 13:13.")))

(lemma "ὀρθρίζω" (sense rise-early (verb "rise early" "rose early" "risen early") (gloss "rise early" "rose early" "risen early" "rises early" "rising early") (why "To rise at dawn, get up early (Genesis 19:2, 27; 20:8; Luke 21:38, the people came early in the morning). The verb of ὄρθρος \"dawn\".")))

(lemma "ὄρθρος" (sense dawn (gloss "dawn") (why "Daybreak, dawn (Genesis 19:15 ἡνίκα δὲ ὄρθρος ἐγίνετο; Luke 24:1; John 8:2).")))

(lemma "ὀργή" (sense wrath (gloss "wrath") (why "Anger, wrath (Genesis 27:45 τὸν θυμὸν καὶ τὴν ὀργὴν τοῦ ἀδελφοῦ σου; Romans 1:18; 2:8 ὀργὴ καὶ θυμός). \"Wrath\" keeps it apart from θυμός \"fury\" and θυμόω \"anger\". (LXX form supplied.)")))

(lemma "ὀργίζω" (sense become-angry (voice active) (dative "with")(verb "become angry" "became angry" "become angry") (gloss "become angry" "became angry" "becomes angry" "becoming angry") (why "Passive: to be made angry, become angry (Genesis 40:2 ὠργίσθη Φαραώ; 41:10; Matthew 5:22; 18:34). The verb of ὀργή \"wrath\"; \"become angry\" keeps it apart from θυμόω \"anger\".")))

(lemma "ὀρθῶς" (sense rightly (gloss "rightly") (why "Rightly, correctly (Luke 7:43).")))

(lemma "ὁρκίζω" (sense swear-in(gloss "swear in" "swore in" "sworn in" "swears in" "swearing in") (why "To make someone swear, put under oath (Genesis 24:37, ὥρκισέν με ὁ κύριός μου; Mark 5:7; 1 Thessalonians 5:27, where it is \"adjure\"). \"Swear in\" keeps it apart from ἐξορκίζω \"adjure\" and ὀμνύω \"swear\"; the object stands before the particle (\"swore me in\").")))

(lemma "ὁρκισμός" (sense oath-taking (gloss "oath-taking") (why "(LXX, supplied.) A swearing, the taking of an oath (Genesis 21:31 Φρέαρ ὁρκισμοῦ, the Greek for Beersheba; 26:3). \"Oath-taking\" keeps it apart from ὅρκος \"oath\" and from \"swearing\", the participle of ὀμνύω.")))

(lemma "ὅρκος" (sense oath (gloss "oath" "oaths") (why "An oath (Genesis 21:14, 31-33 τὸ φρέαρ τοῦ ὅρκου, the Greek for Beersheba; 26:3; Luke 1:73; Hebrews 6:16-17).")))

(lemma "ὅριον" (sense border (gloss "border" "borders") (why "A boundary; in the plural the borders, the territory they enclose (Genesis 10:19, τὰ ὅρια Χαναναίων; Matthew 2:16; 4:13). \"Borders\" keeps the plural visible; \"region\" is a reading.")))

(lemma "ὁρμάω" (sense rush (gloss "rush" "rushed" "rushes" "rushing") (why "To set off, rush (Genesis 31:21 ὥρμησεν εἰς τὸ ὄρος Γαλαάδ; Mark 5:13; Acts 7:57).")))

(lemma "ὁρμίσκος" (sense necklace (gloss "necklace" "necklaces") (why "(LXX, supplied.) A small chain or cord worn round the neck (diminutive of ὅρμος), one of the three pledges Judah gave Tamar (Genesis 38:18, 25).")))

(lemma "ὅρμος" (sense anchorage (gloss "anchorage" "anchorages") (why "(LXX, supplied.) A roadstead, anchorage, harbor (Genesis 49:13, Zebulun παρ’ ὅρμον πλοίων). Kept apart from λιμήν, which will take \"harbor\".")))

(lemma "ὄρνεον" (sense fowl (gloss "fowl" "fowls") (why "A bird (Genesis 6:20; Revelation 18:2; 19:17, 21). \"Fowl\" to keep it apart from πετεινός \"bird\", which follows it in Genesis 6:20 (τῶν ὀρνέων τῶν πετεινῶν).")))

(lemma "ὄρος" (sense mountain (gloss "mountain" "mountains") (why "Mountain.")))

(lemma "ὀρύσσω" (sense dig (gloss "dig" "dug" "digs" "digging") (why "To dig (Genesis 21:30, 26:15-32 the wells; Matthew 21:33, 25:18).")))

(lemma "ὅς"
  (sense which
    (gloss "which" "who" "whom" "whose")
    (why "The relative pronoun. The English form follows the referent: \"who/whom\" for persons, \"which\" for things.")))

(lemma "ὀσμή" (sense odor (gloss "odor" "odors") (why "A smell, odor (Genesis 8:21, ὀσμὴ εὐωδίας, an odor of fragrance; John 12:3; 2 Corinthians 2:14-16; Ephesians 5:2). Kept apart from εὐωδία \"fragrance\".")))

(lemma "ὅσος"
  (sense as-many-as
    (gloss "as many as" "as much as")
    (why "As many as, as much as (Genesis 1:31, \"all the [things] as many as he made\"; John 1:12, \"as many as received him\").")))

(lemma "ὀστέον"
  (sense bone
    (gloss "bone" "bones")
    (why "Bone (Genesis 2:23; Luke 24:39). The contracted form ὀστοῦν is the same lemma.")))

(lemma "ὅστις" (sense who (gloss "who") (why "The indefinite or qualitative relative, here simply \"who\" (Exodus 20:2).")))

(lemma "ὀσφραίνομαι" (sense smell (gloss "smell" "smelled" "smells" "smelling") (why "(LXX, supplied.) To smell, catch the scent of (Genesis 8:21, the Lord God smelled an odor of fragrance). The aorist is passive in form, deponent in sense. The noun ὄσφρησις (1 Corinthians 12:17) will need its own English.")))

(lemma "ὀσφῦς" (sense loin (gloss "loin" "loins") (why "(LXX form supplied.) The loins, the hips, as the seat of procreation (Genesis 35:11 βασιλεῖς ἐκ τῆς ὀσφύος σου ἐξελεύσονται; Hebrews 7:5, 10; Acts 2:30).")))

(lemma "ὅταν"(sense whenever (gloss "whenever") (why "When, whenever, ὅτε with ἄν, with the subjunctive (Genesis 40:14 ὅταν εὖ σοι γένηται; Matthew 5:11; 6:2). \"Whenever\" keeps it apart from ὅτε and ἡνίκα \"when\".")))

(lemma "ὅτε"
  (sense when
    (gloss "when")
    (why "The temporal conjunction \"when\".")))

(lemma "ὅτι"
  (sense that
    (gloss "that")
    (why "Introducing what is seen, known or said: \"that\" (Genesis 1:4, God saw ... that [it was] good)."))
  (sense because
    (gloss "because")
    (why "Causal: \"because\" (Genesis 2:3, 23; 3:10, 14, 17, 19, 20). \"For\" is kept for γάρ, so causal ὅτι takes \"because\"."))
  (sense why
    (gloss "why")
    (why "Interrogative, for τί ὅτι: \"why\" (Genesis 18:13 Ὅτι ἐγέλασεν Σάρρα; Mark 2:16, 9:11). Chosen by word override.")))

(lemma "οὐ"
  (sense not
    (gloss "not")
    (why "The plain negative of fact, always \"not\". English needs \"do\" to negate a simple past (\"did not overtake\"); that \"did\" is part of the verb's tense, aligned with the verb, not a supplied word.")))

(lemma "οὗ"
  (sense where
    (gloss "where")
    (why "The adverb \"where\", lemmatized separately from the relative pronoun ὅς as in the New Testament table (Matthew 2:9). Genesis 2:11 has the table's guess ὅς overridden to οὗ.")))

(lemma "οὐδέ"
  (sense not-even
    (gloss "not even")
    (why "οὐ plus δέ. With a numeral or a single word it is emphatic, \"not even\" (John 1:3)."))
  (sense nor
    (gloss "nor")
    (why "Joining a further negative clause: \"nor\" (Genesis 3:3; Matthew 6:26).")))

(lemma "οὐδείς" (sense no-one (person) (gloss "no one") (why "No one, nobody (Genesis 19:31 οὐδείς ἐστιν ἐπὶ τῆς γῆς; 20:9 ἔργον ὃ οὐδεὶς ποιήσει; John 1:18). The neuter οὐδέν, \"nothing\", will be its own sense."))
  (sense nothing (gloss "nothing") (why "The neuter οὐδέν (Swete also οὐθέν), nothing (Genesis 39:6, 8, 9, 23; 40:15 οὐκ ἐποίησα οὐδέν; John 5:19). Shares \"nothing\" with μηδέν, the same word with μή: one English for the pair, as for οὐ and μή \"not\"."))
  (sense anyone (person) (gloss "anyone") (why "After another negative in its clause (καὶ οὐ παριστήκει οὐδείς, Genesis 45:1), the Greek doubles the negation for strength; English takes one, so the verb keeps \"not\" and οὐδείς is \"anyone\" (\"had not stood by anyone\"). \"No one\" there would cancel the \"not\" and reverse the sense. Chosen by override."))
  (sense anything (gloss "anything") (why "The neuter οὐδέν (οὐθέν) after another negative, as the sense anyone for persons (Genesis 39:9 οὐχ ὑπερέχει ... οὐθέν, οὐδὲ ὑπεξῄρηται ... οὐδέν): English takes one negation, \"nothing does not surpass\" would reverse it. Shares \"anything\" with μηδέν, the same word with μή, as \"nothing\" does. Chosen by override.")))

(lemma "Οὐκάν" (sense name (gloss "Akan") (why "(LXX, supplied.) A son of Ezer, the Horite Σάαρ (Genesis 36:27), Greek Οὐκάν; traditional English Akan. See Ἰωυκάμ.")))

(lemma "Οὖλ"(sense name (gloss "Hul") (why "(LXX, supplied.) A son of Aram (Genesis 10:23), Greek Οὖλ; traditional English Hul.")))

(lemma "Οὐλαμμαύς" (sense name (gloss "Ulammaus") (why "(LXX, supplied.) Genesis 28:19, the former name of the city at Bethel. The Hebrew reads \"Luz\" (ulam Luz, \"but Luz\"); the Greek took the words as one name, Οὐλαμμαύς. The Greek gives a different name, so the English follows the Greek, as Θόβελ is \"Tubal\". For the owner: \"Luz\" if the traditional name is preferred.")))

(lemma "οὖν" (sense therefore (gloss "therefore") (why "The inferential particle, \"therefore\" (Genesis 6:14; Matthew 3:8). Always rendered and placed first in its English clause, as with γάρ and δέ.")))

(lemma "οὔπω" (sense not-yet (gloss "not yet") (why "Not yet (Genesis 18:12 Οὔπω μέν μοι γέγονεν ἕως τοῦ νῦν; John 2:4).")))

(lemma "οὐρανός"
  (sense heaven
    (gloss "heaven" "heavens")
    (why "Heaven, the sky. Singular \"heaven\", plural \"heavens\", following the Greek number: Genesis 1 in the Septuagint is singular throughout (Hebrew has a plural-form noun), while Matthew often has the plural. \"Sky\" is not used, so the one word can be traced from \"the birds of the heaven\" to \"the kingdom of the heavens\".")))

(lemma "οὖς" (sense ear (gloss "ear" "ears") (why "The ear (Genesis 20:8 εἰς τὰ ὦτα αὐτῶν; Matthew 11:15; Luke 1:44).")))

(lemma "οὔτε" (sense nor (gloss "nor") (why "Neither, nor; shares \"nor\" with οὐδέ.")))

(lemma "οὗτος"
  (sense this
    (gloss "this" "these")
    (why "The near demonstrative. Used alone of a person, English needs a noun after it, supplied in brackets: \"this [one]\". Never turned into \"he\" or \"she\" (owner's rule): Genesis 2:23 and 3:12, 20 αὕτη is \"this [one]\".")))

(lemma "οὕτω"
  (sense so
    (gloss "so")
    (why "Thus, so. καὶ ἐγένετο οὕτως, \"and it came to be so\" (Genesis 1).")))

(lemma "Οὐφείρ" (sense name (gloss "Ophir") (why "(LXX, supplied.) A son of Joktan (Genesis 10:29), Greek Οὐφείρ; traditional English Ophir.")))

(lemma "οὐχί" (sense no (gloss "no") (why "The emphatic form of οὐ. Standing alone as an answer it is \"No\" (Genesis 18:15 Οὐχί, ἀλλὰ ἐγέλασας; Luke 1:60; John 9:9). In a question expecting \"yes\" (Matthew 5:46) it will be its own sense, \"not\"."))
  (sense not (gloss "not") (why "In a question expecting \"yes\", \"not\" (Genesis 40:8 Οὐχὶ διὰ τοῦ θεοῦ ἡ διασάφησις αὐτῶν ἐστίν; Matthew 5:46-47; Luke 4:22). Shares \"not\" with οὐ, of which it is the emphatic form. Chosen by word override.")))

(lemma "ὀφθαλμός"
  (sense eye
    (gloss "eye" "eyes")
    (why "Eye.")))

(lemma "Ὀφιμίν" (sense name (gloss "Huppim") (why "(LXX, supplied.) A son of Benjamin's line (Genesis 46:21), Greek Ὀφιμίν, standing where the Hebrew has Huppim; traditional English Huppim.")))

(lemma "ὄφις"
  (sense serpent
    (gloss "serpent" "serpents")
    (why "A snake, serpent (Genesis 3; Matthew 10:16; 2 Corinthians 11:3; Revelation 12:9). \"Serpent\" rather than \"snake\" for the link with Revelation's \"the ancient serpent\".")))

(lemma "Ὀχοζάθ" (sense name (gloss "Ahuzzath") (why "(LXX, supplied.) Abimelech's νυμφαγωγός (Genesis 21:22, 32; 26:26). The Hebrew text names Ahuzzath only at 26:26; the Greek has him here as well. Ὀχοζάθ is the same name, so the traditional English Ahuzzath.")))

(lemma "ὀχύρωμα" (sense stronghold (gloss "stronghold" "strongholds") (why "A fortified place, stronghold; in Genesis 39:20-40:14 the prison where the king's prisoners are held (2 Corinthians 10:4, figurative). The literal \"stronghold\" is kept.")))

(lemma "ὀψέ" (sense late (gloss "late") (why "Late, late in the day (Genesis 24:11, τὸ πρὸς ὀψέ, \"toward late\", toward evening; Mark 11:19; 13:35).")))

(lemma "ὄψις" (sense aspect (dative "in") (gloss "aspect" "aspects")(why "The look of a thing, appearance, aspect (Genesis 24:16, καλὴ τῇ ὄψει, \"beautiful in aspect\"; John 7:24; 11:44, the face). \"Aspect\" keeps it apart from εἰδέα \"appearance\" and ὅρασις \"sight\".")))
