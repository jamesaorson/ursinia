;; Greek Source Bible concordance, lemmas beginning with φ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "φαίνω"
  (sense shine
    (gloss "shine" "shines" "shining" "shone")
    (why "Active: to shine, give light. Passive \"appear\" becomes its own sense. The present is rendered with the English progressive (\"is shining\") to keep its ongoing aspect apart from the aorist; an infinitive is plain \"to shine\" (Genesis 1:15, 17)."))
  (sense appear
    (voice active)
    (gloss "appear" "appeared" "appears" "appearing")
    (why "Passive: to appear, to seem (Genesis 21:11 σκληρὸν δὲ ἐφάνη τὸ ῥῆμα, \"hard the utterance appeared\"; Matthew 1:20, 2:13 ἐφάνη κατ' ὄναρ). It shares \"appear\" with ὁράω's passive (ὤφθη); English has no second plain word (δοκέω has \"seem\"), and the alignment shows which Greek word stands behind it. Chosen by a form row or word override.")))

(lemma "φαιός" (sense gray (gloss "gray") (why "(LXX, supplied.) Dusky, gray (Genesis 30:32-35, every φαιὸν among the lambs, Jacob's wage). Kept apart from σποδοειδής \"ash-colored\".")))

(lemma "φακός" (sense lentil (gloss "lentil" "lentils") (why "(LXX, supplied.) The lentil (Genesis 25:34 ἕψεμα φακοῦ, \"stew of lentil\"; 2 Kingdoms 17:28).")))

(lemma "Φαλδάς" (sense name (gloss "Pildash") (why "(LXX, supplied.) Nahor's son (Genesis 22:22); the Greek form of the Hebrew Pildash. Traditional English Pildash.")))

(lemma "Φάλεκ" (sense name (gloss "Peleg") (why "Eber's son (Genesis 10:25; 11:16-19; Luke 3:35, Φάλεκ, KJV \"Phalec\"), traditional Old Testament English Peleg.")))

(lemma "Φαλλούδ" (sense name (gloss "Pallu") (why "(LXX, supplied.) A son of Reuben (Genesis 46:9), Greek Φαλλούδ; traditional English Pallu.")))

(lemma "φανερός" (sense apparent (gloss "apparent") (why "Visible, plain, known (Genesis 42:16 ἕως τοῦ φανερὰ γενέσθαι τὰ ῥήματα ὑμῶν; Mark 4:22; Romans 1:19). \"Apparent\" keeps it apart from διάδηλος \"evident\" and the verb ἐμφανίζω.")))

(lemma "φάραγξ" (sense ravine (gloss "ravine" "ravines") (why "A ravine, gorge, valley (Genesis 14:3, the salty ravine; Luke 3:5 quoting Isaiah 40:4). Kept apart from κοιλάς \"valley\".")))

(lemma "Φαράν" (sense name (gloss "Paran") (why "(LXX, supplied.) The wilderness of Paran (Genesis 21:21); traditional English Paran. Indeclinable.")))

(lemma "Φαραώ" (sense name (person) (gloss "Pharaoh") (why "The title of Egypt's king, used as a name (Genesis 12:15-20; Acts 7:10; Romans 9:17), traditional English Pharaoh.")))

(lemma "Φάρες" (sense name (gloss "Perez") (why "(LXX, supplied.) Judah's son by Tamar, named at the breach (Genesis 38:29; 46:12); Matthew 1:3 and Luke 3:33 Φαρές. Traditional English Perez (KJV Pharez), indeclinable in Greek.")))

(lemma "φαρέτρα" (sense quiver (gloss "quiver") (why "(LXX, supplied.) A quiver for arrows (Genesis 27:3, Esau's hunting gear).")))

(lemma "φάσκω" (sense claim (gloss "claim" "claimed" "claims" "claiming") (why "To say, assert, claim (Genesis 26:20 φάσκοντες αὐτῶν εἶναι τὸ ὕδωρ, the herdsmen claiming the water was theirs; Acts 24:9; 25:19; Romans 1:22). \"Claim\" keeps it apart from λέγω \"say\" and φημί.")))

(lemma "φαυλίζω" (sense slight (gloss "slight" "slighted" "slights" "slighting") (why "(LXX, supplied.) To think little of, make light of, slight (Genesis 25:34 ἐφαύλισεν Ἠσαὺ τὰ πρωτοτοκεῖα; compare Hebrews 12:16). From φαῦλος \"worthless\"; kept apart from καταφρονέω.")))

(lemma "φαῦσις"
  (sense illumination
    (with-preposition "εἰς" for)
    (gloss "illumination")
    (why "(LXX, supplied.) A giving of light, illumination (Genesis 1:14-15). Not in the New Testament.")))

(lemma "φείδομαι" (sense spare (genitive "") (gloss "spare" "spared" "spares" "sparing") (why "To spare, hold back (genitive): Genesis 22:12, 16 οὐκ ἐφείσω τοῦ υἱοῦ σου, echoed in Romans 8:32 τοῦ ἰδίου υἱοῦ οὐκ ἐφείσατο; 2 Peter 2:4-5.")))

(lemma "Φεισών"
  (sense name
    (gloss "Pishon")
    (why "(LXX, supplied.) The first river of Genesis 2:11, given its traditional English name; the Greek spells it Φεισών (Pheison).")))

(lemma "Φερεζαῖος" (sense name (person) (gloss "Perizzite" "Perizzites") (why "(LXX, supplied.) The Perizzites, a people of Canaan (Genesis 13:7; 15:20), by the traditional English name.")))

(lemma "φερνή" (sense dowry (gloss "dowry") (why "(LXX, supplied.) The bride-price, dowry (Genesis 34:12, πληθύνατε τὴν φερνήν, multiply the dowry).")))

(lemma "φέρω" (sense carry (gloss "carry" "carried" "carries" "carrying") (why "To carry, bear. \"Carry\" because \"bring\" is ἄγω's and \"bear\" τίκτω's; Genesis 4:3-4, Cain and Abel carried [offerings].")))

(lemma "φεύγω" (sense flee (verb "flee" "fled" "fled") (gloss "flee" "fled" "flees" "fleeing") (why "To flee, run away (Genesis 14:10, the king of Sodom fled; Matthew 2:13).")))

(lemma "φημί" (sense affirm (gloss "affirm" "affirmed" "affirms" "affirming") (why "To declare, say (Genesis 24:47, ἡ δὲ ἔφη; Matthew 4:7; Acts 26:24). \"Affirm\" keeps it apart from λέγω \"say\", λαλέω \"speak\" and ἀναγγέλλω \"declare\"; the readable layer may say \"said\".")))

(lemma "φθείρω" (sense corrupt (gloss "corrupt" "corrupted" "corrupts" "corrupting") (why "To corrupt, spoil, ruin (Genesis 6:11, the earth was corrupted; 1 Corinthians 15:33; 2 Corinthians 11:3). Kept apart from καταφθείρω \"ruin\" (6:12-17).")))

(lemma "Φικόλ" (sense name (gloss "Phicol") (why "(LXX, supplied.) Abimelech's army commander (Genesis 21:22, 32; 26:26); traditional English Phicol.")))

(lemma "φιλέω"
  (sense like
    (gloss "like" "liked" "likes" "liking")
    (why "To be fond of, like, love as a friend (Genesis 27:4, 9, 14, the delicacies Isaac likes; John 11:3; 21:15-17). \"Like\" keeps it apart from ἀγαπάω \"love\"; in John 21 the readable layer may need \"love\" for both."))
  (sense kiss
    (gloss "kiss" "kissed" "kisses" "kissing")
    (why "To kiss (Genesis 27:26-27, Isaac kissing Jacob; Matthew 26:48; Luke 22:47). The aorist forms of Genesis 27 carry this sense in the form rows.")))

(lemma "Φινές" (sense name (gloss "Pinon") (why "(LXX, supplied.) A chief of Esau (Genesis 36:41); Swete's Φινές for the Hebrew Pinon, a variant of the same name, so the traditional English Pinon (rule 8). It is not the Φινεές (Phinehas) of Exodus 6:25.")))

(lemma "φλόγινος"
  (sense flaming
    (gloss "flaming")
    (why "(LXX, supplied.) Flaming, fiery (Genesis 3:24). φλόξ \"flame\" is in the New Testament (Acts 7:30).")))

(lemma "φλόξ" (sense flame (gloss "flame" "flames") (why "A flame (Genesis 15:17 φλὸξ ἐγένετο; Luke 16:24; Acts 7:30). Genesis 3:24 has the flaming sword (φλογίνην).")))

(lemma "φοβερός" (sense fearful (gloss "fearful") (why "Fearful, to be feared, dreadful (Genesis 28:17 Ὡς φοβερὸς ὁ τόπος οὗτος; Hebrews 10:27, 31; 12:21). The adjective of φόβος. (LXX form supplied.)")))

(lemma "φοβέω"
  (sense fear
    (gloss "fear" "feared" "fears" "fearing")
    (why "(Supplied in Genesis 3:10.) Lemma form as in the New Testament table. Middle/passive: to fear, be afraid (Genesis 3:10, \"I feared\"). \"Fear\" also for reverence (Luke 1:50).")))

(lemma "φόβος" (sense fear (gloss "fear" "fears") (why "Fear; the noun of φοβέω.")))

(lemma "Φόγωρ" (sense name (gloss "Peor") (why "(LXX, supplied.) The city of Hadar, king of Edom (Genesis 36:39), where the Hebrew has Pau. The Greek gives a different name, the Φογώρ (Peor) of Numbers 23:28, so the English follows the Greek name (as Αἰθιοπία for Cush).")))

(lemma "φονεύω"(sense murder (gloss "murder" "murdered" "murders" "murdering") (why "To murder (Exodus 20:13; Matthew 19:18).")))

(lemma "φραγμός" (sense fence (gloss "fence" "fences") (why "A fence, hedge, partition (Genesis 38:29, Τί διεκόπη διὰ σὲ φραγμός; at Perez's birth; Matthew 21:33; Ephesians 2:14).")))

(lemma "φρέαρ" (sense well (gloss "well" "wells") (why "A well, a dug water-pit (Genesis 16:14; 21:19; John 4:11-12). It shares the spelling \"well\" with the adverb εὖ; the alignment shows which.")))

(lemma "Φουά" (sense name (gloss "Puvah") (why "(LXX, supplied.) A son of Issachar (Genesis 46:13), Greek Φουά; traditional English of Genesis, Puvah.")))

(lemma "Φούδ" (sense name (gloss "Put") (why "(LXX, supplied.) Ham's son (Genesis 10:6), Greek Φούδ; traditional English Put.")))

(lemma "φρόνιμος"
  (sense prudent
    (gloss "prudent")
    (why "(Supplied in Genesis 3:1, a superlative.) Prudent, sensible, shrewd. Genesis 3:1 calls the serpent φρονιμώτατος, \"most prudent\", where translations from the Hebrew have \"crafty\"; Matthew 10:16 (\"be prudent as the serpents\") uses the same word. One gloss keeps the echo.")))

(lemma "φυλακή" (sense custody (gloss "custody") (why "Guarding, custody, and the place of it (Genesis 40:3-7; 41:10 ἐν φυλακῇ; Matthew 14:3; Acts 12:4). \"Custody\" keeps it apart from δεσμωτήριον \"prison\" and φύλαξ \"guard\"; a watch of the night (Matthew 14:25) will be its own sense.")))

(lemma "φύλαξ" (sense guard (person) (gloss "guard" "guards") (why "A guard, keeper (Acts 5:23): the noun of φυλάσσω \"guard\". Genesis 4:9 \"Am I the guard of my brother?\".")))

(lemma "φυλάσσω"
  (sense guard
    (gloss "guard" "guards" "guarded" "guarding")
    (why "To guard, keep watch over (Genesis 2:15; 3:24; Luke 2:8). \"Guard\" so that τηρέω can keep \"keep\" / \"watch\". Keeping commandments (Matthew 19:20) will be checked against it.")))

(lemma "φυλή" (sense tribe (gloss "tribe" "tribes") (why "A tribe, clan (Genesis 12:3, \"all the tribes of the earth\"; Matthew 19:28; 24:30).")))

(lemma "Φυλιστιείμ" (sense name (person) (plural "Philistines") (gloss "Philistines") (why "(LXX, supplied.) Genesis 10:14, the people who came out from the Casluhim; Greek Φυλιστιείμ, the Hebrew plural, indeclinable. Traditional English Philistines (KJV here \"Philistim\").")))

(lemma "φύλλον"
  (sense leaf
    (gloss "leaf" "leaves")
    (why "A leaf (Genesis 3:7; Revelation 22:2).")))

(lemma "φυράω" (sense knead (gloss "knead" "kneaded" "kneads" "kneading") (why "(LXX, supplied.) To mix, knead dough (Genesis 18:6 φύρασον τρία μέτρα σεμιδάλεως). The noun φύραμα \"lump\" (Romans 9:21; 1 Corinthians 5:6-7) is from the same root.")))

(lemma "φυτεύω"
  (sense plant
    (gloss "plant" "plants" "planted" "planting")
    (why "To plant (Genesis 2:8; 1 Corinthians 3:6, Paul planted).")))

(lemma "φυτόν" (sense plant (gloss "plant" "plants") (why "(LXX, supplied.) A plant, something grown (Genesis 22:13 ἐν φυτῷ σαβέκ; Isaiah 5:7). The noun shares \"plant\" with the verb φυτεύω, its own root; English uses one word for both.")))

(lemma "φωνή"
  (sense voice
    (gloss "voice" "voices")
    (why "Voice, sound. \"Voice\" in Genesis 3:8-17 (also \"the voice of your woman\", 3:17). \"Sound\" (John 3:8) may become its own sense.")))

(lemma "φῶς"
  (sense light
    (gloss "light" "lights")
    (why "Light itself; φωστήρ (a light-giver, a luminary, Genesis 1:14) gets its own gloss.")))

(lemma "φωστήρ"
  (sense luminary
    (gloss "luminary" "luminaries")
    (why "(Some forms supplied.) A light-giver, a luminary (Genesis 1:14-16; Philippians 2:15, \"you shine as luminaries in the world\"). Kept apart from φῶς \"light\" in both layers.")))
