(lemma "Ἰαβόκ" (sense name (gloss "Jabbok") (why "(LXX, supplied.) The torrent Jabbok, east of the Jordan (Genesis 32:22); Greek Ἰαβόκ, traditional English Jabbok.")))

(lemma "Ἰακώβ" (sense name (gloss "Jacob") (why "Traditional English form.")))

(lemma "Ἰαμείν" (sense name (gloss "Jamin") (why "(LXX, supplied.) Genesis 36:24, ὃς εὗρεν τὸν Ἰαμείν ἐν τῇ ἐρήμῳ: the Greek takes the Hebrew word there (of uncertain sense) as a name, the same spelling as Simeon's son Jamin (Genesis 46:10); the English follows the Greek, traditional English Jamin.")))

(lemma "ἰάομαι"(sense heal (gloss "heal" "healed" "heals" "healing") (why "To heal (Genesis 20:17, God healed Abimelech; Matthew 8:8; Luke 9:2).")))

(lemma "Ἰάραδ" (sense name (gloss "Jerah") (why "(LXX, supplied.) A son of Joktan (Genesis 10:26), Greek Ἰάραδ; traditional English Jerah. Not Ἰάρεδ \"Jared\" of Genesis 5.")))

(lemma "Ἰάρεδ" (sense name (gloss "Jared") (why "(LXX spelling supplied.) Genesis 5:15-20, traditional English Jared; Luke 3:37 spells Ἰάρετ.")))

(lemma "Ἰασούφ" (sense name (gloss "Jashub") (why "(LXX, supplied.) A son of Issachar (Genesis 46:13), Greek Ἰασούφ. The Hebrew of Genesis has Iob here but Jashub in Numbers 26:24 and 1 Chronicles 7:1; the Greek gives Jashub, so the English follows it (rule 8).")))

(lemma "Ἰάφεθ" (sense name (gloss "Japheth") (why "(LXX, supplied.) Noah's son (Genesis 5:32; 6:10), traditional English Japheth.")))

(lemma "Ἰαχείμ" (sense name (gloss "Jachin") (why "(LXX, supplied.) A son of Simeon (Genesis 46:10), Greek Ἰαχείμ; traditional English Jachin.")))

(lemma "ἴδιος" (sense own (gloss "own") (why "One's own (Genesis 14:14, his own home-born; John 1:11).")))

(lemma "Ἰδουμά" (sense name (gloss "Dumah") (why "(LXX, supplied.) A son of Ishmael (Genesis 25:14); the Greek Ἰδουμά for the Hebrew Dumah, traditional English Dumah. Not Ἰδουμαία, Idumea (Edom).")))

(lemma "Ἰδουμαία" (sense name (gloss "Idumea") (why "(LXX, supplied.) The Greek name of the land of Edom (Genesis 36:16 ἐν γῇ Ἰδουμαίᾳ, where the Hebrew has Edom; Mark 3:8). The Greek gives its own name, so the English follows it, as in the New Testament: Idumea.")))

(lemma "ἱδρώς"
  (sense sweat
    (gloss "sweat")
    (why "(Supplied in Genesis 3:19.) Sweat. Luke 22:44 (Jesus' sweat like drops of blood) is the only New Testament use.")))

(lemma "ἱερεύς" (sense priest (person) (gloss "priest" "priests") (why "Priest (Genesis 14:18, Melchizedek priest of God the most high; Hebrews 7:1).")))

(lemma "Ἱεροσόλυμα" (sense name (gloss "Jerusalem") (why "Jerusalem. The concordance lemma of the New Testament table for Ἰερουσαλήμ as well as Ἱεροσόλυμα. Genesis 36:31, Swete's text has πρὸ τοῦ βασιλεῦσαι βασιλέα ἐν Ἰερουσαλήμ, where the Hebrew has Israel. Traditional English Jerusalem.")))

(lemma "Ἰεβέρ" (sense name (gloss "Jetheth") (why "(LXX, supplied.) A chief of Esau (Genesis 36:40); Swete's Ἰεβέρ is a variant spelling of the Hebrew Jetheth, the same name, so the traditional English Jetheth (rule 8).")))

(lemma "Ἰεβουσαῖος"(sense name (person) (gloss "Jebusite" "Jebusites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:16), traditional English Jebusite.")))

(lemma "Ἰεγλόμ" (sense name (gloss "Jalam") (why "(LXX, supplied.) A son of Esau by Oholibamah, and a chief (Genesis 36:5, 14, 18), Greek Ἰεγλόμ; traditional English Jalam.")))

(lemma "Ἰεθράν" (sense name (gloss "Ithran") (why "(LXX, supplied.) A son of Dishon (Genesis 36:26), Greek Ἰεθράν; traditional English Ithran.")))

(lemma "Ἰεκτάν"(sense name (gloss "Joktan") (why "(LXX, supplied.) Eber's son, Peleg's brother (Genesis 10:25-29), Greek Ἰεκτάν; traditional English Joktan.")))

(lemma "Ἰελδάφ" (sense name (gloss "Jidlaph") (why "(LXX, supplied.) Nahor's son (Genesis 22:22); the Greek form of the Hebrew Jidlaph. Traditional English Jidlaph.")))

(lemma "Ἰεμνά" (sense name (gloss "Imnah") (why "(LXX, supplied.) Asher's firstborn (Genesis 46:17), Greek Ἰεμνά; traditional English Imnah.")))

(lemma "Ἰεμουήλ" (sense name (gloss "Jemuel") (why "(LXX, supplied.) Simeon's firstborn (Genesis 46:10), Greek Ἰεμουήλ; traditional English Jemuel. Swete prints the same name for the second son of Perez (46:12), where the Hebrew has Hamul: the Greek gives the name Jemuel, so the English follows it (rule 8, as Μαθουσαλά).")))

(lemma "Ἰεξάν" (sense name (gloss "Jokshan") (why "(LXX, supplied.) A son of Abraham and Keturah (Genesis 25:2-3); the Greek Ἰεξάν for the Hebrew Jokshan, traditional English Jokshan.")))

(lemma "Ἰεούλ" (sense name (gloss "Ishvi") (why "(LXX, supplied.) A son of Asher (Genesis 46:17), Greek Ἰεούλ, standing where the Hebrew has Ishvi; traditional English Ishvi. The form row for Ἰεούλ reads Esau's son Ἰεούς (36:18), so a word override chooses this lemma in 46:17.")))

(lemma "Ἰεούς" (sense name (gloss "Jeush") (why "(LXX, supplied.) A son of Esau by Oholibamah, and a chief (Genesis 36:5; Swete prints Ἰεύς at 36:14 and Ἰεούλ at 36:18 for the same man), Greek Ἰεούς; traditional English Jeush.")))

(lemma "Ἰεσβόκ"(sense name (gloss "Ishbak") (why "(LXX, supplied.) A son of Abraham and Keturah (Genesis 25:2), traditional English Ishbak.")))

(lemma "Ἰεσσαί" (sense name (gloss "Jesse") (why "Jesse, the father of David (Matthew 1:5-6; Luke 3:32; Acts 13:22). Swete also prints Ἰεσσαί for a son of Asher (Genesis 46:17), where the Hebrew has Ishvah: the Greek gives the name Jesse, so the English follows it (rule 8, as Μαθουσαλά).")))

(lemma "Ἰεσχά" (sense name (gloss "Iscah") (why "(LXX, supplied.) Haran's daughter (Genesis 11:29), traditional English Iscah.")))

(lemma "Ἰετούρ" (sense name (gloss "Jetur") (why "(LXX, supplied.) A son of Ishmael (Genesis 25:15), traditional English Jetur.")))

(lemma "ἱκανός" (sense sufficient (gloss "sufficient") (why "Enough, sufficient; of persons, fit, worthy (Genesis 30:15, Leah: Οὐχ ἱκανόν σοι ὅτι ἔλαβες τὸν ἄνδρα μου; Matthew 3:11; 2 Corinthians 2:16). \"Sufficient\" serves the things and the persons; \"many\" (Luke 7:11) may become its own sense.")))

(lemma "ἱκανόω" (sense make-sufficient (verb "make sufficient" "made sufficient" "made sufficient") (gloss "make sufficient" "made sufficient" "makes sufficient" "making sufficient") (why "To make sufficient, qualify (2 Corinthians 3:6; Colossians 1:12). Genesis 32:10, as Swete is transcribed, ἱκανοῦσαί μοι, taken as the passive ἱκανοῦταί, \"it is made sufficient to me\", Jacob's \"enough for me of all the righteousness\". The reading is unsure.")))

(lemma "ἵλεως" (sense gracious (gloss "gracious") (why "Propitious, gracious, merciful (Genesis 43:23 Ἵλεως ὑμῖν, \"Gracious [be God] to you\", the steward's greeting; Matthew 16:22 Ἵλεώς σοι; Hebrews 8:12). Akin to ἱλάσκομαι.")))

(lemma "ἱμάτιον" (sense garment (gloss "garment" "garments") (why "A garment, the outer cloak (Genesis 9:23, Shem and Japheth took τὸ ἱμάτιον; Matthew 5:40; John 19:23-24). \"Garment\" against χιτών \"tunic\".")))

(lemma "ἱματισμός" (sense clothing (gloss "clothing") (why "Clothing, apparel (Genesis 24:53, gold and silver articles and clothing for Rebekah; Luke 9:29; John 19:24). Kept apart from ἱμάτιον \"garment\".")))

(lemma "ἵνα"
  (sense so-that
    (gloss "so that")
    (why "Purpose: \"so that\". With μή, \"so that ... not\" (Genesis 3:3). The content use (\"that\") becomes its own sense when needed."))
  (sense why-phrase
    (gloss "")
    (why "ἵνα τί, \"why\" (Genesis 4:6; Matthew 9:4): the phrase's English is carried by τί (sense why); ἵνα is aligned with it and left unrendered.")))

(lemma "Ἰορδάνης" (sense name (gloss "Jordan") (why "The river Jordan (Genesis 13:10-11; Matthew 3:6).")))

(lemma "Ἰουβάλ" (sense name (gloss "Jubal") (why "(LXX, supplied.) Genesis 4:21, traditional English Jubal.")))

(lemma "Ἰούδας" (sense name (gloss "Judah") (why "Jacob's fourth son by Leah (Genesis 29:35, Swete's indeclinable Ἰουδά, named from ἐξομολογήσομαι; 38; 49:8-10); Matthew 1:2-3 and Hebrews 7:14 Ἰούδας, declined. Traditional English Judah. The New Testament's other men of the name (Judas Iscariot, Jude) will need their own sense.")))

(lemma "Ἰουδίν" (sense name (gloss "Judith") (why "(LXX, supplied.) Esau's Hittite wife (Genesis 26:34), Greek Ἰουδίν for the Hebrew Judith; traditional English Judith.")))

(lemma "ἱππόδρομος" (sense racecourse (gloss "racecourse" "racecourses") (why "(LXX, supplied.) A course for horse races (ἵππος + δρόμος), and so a measure of distance (Genesis 48:7, Rachel died κατὰ τὸν ἱππόδρομον χαβραθὰ τῆς γῆς, and was buried in the way of the racecourse). \"Racecourse\" keeps the Greek picture; the Hebrew has a stretch of land.")))

(lemma "ἱππεύς" (sense horseman (person) (plural "horsemen") (gloss "horseman" "horsemen") (why "(LXX form supplied.) A horseman, rider (Genesis 49:17, the rider falls backward; 50:9, chariots and horsemen; Acts 23:23, 32).")))

(lemma "ἵππος"
  (sense horse (gloss "horse" "horses") (why "A horse (James 3:3; Revelation 6:2)."))
  (sense cavalry (gloss "cavalry") (why "(LXX sense, supplied.) The feminine ἡ ἵππος, horses taken together, cavalry (Genesis 14:11, 16, 21, where the Hebrew has \"goods\"). Chosen by the form row of ἵππον with the feminine article.")))

(lemma "Ἰσαάκ" (sense name (gloss "Isaac") (why "Abraham's son by Sarah (Genesis 17:19, 21; Matthew 1:2; Romans 9:7-10); traditional English Isaac.")))

(lemma "Ἰσμαήλ" (sense name (gloss "Ishmael") (why "(LXX, supplied.) Abraham's son by Hagar (Genesis 16:11-17:26); traditional English Ishmael.")))

(lemma "Ἰσμαηλίτης" (sense name (person) (gloss "Ishmaelite" "Ishmaelites") (why "(LXX, supplied.) A descendant of Ishmael (Ἰσμαήλ), the traders who bought Joseph (Genesis 37:25-28; 39:1). Swete spells it both Ἰσμαηλίτης (37:27) and Ἰσμαηλείτης (37:25; 39:1).")))

(lemma "Ἰσραήλ" (sense name (gloss "Israel") (why "Traditional English form.")))

(lemma "Ἴσσααρ" (sense name (gloss "Jezer") (why "(LXX, supplied.) A son of Naphtali (Genesis 46:24), Greek Ἴσσααρ for the Hebrew Jezer; traditional English Jezer.")))

(lemma "Ἰσσαχάρ" (sense name (gloss "Issachar") (why "Jacob's fifth son by Leah (Genesis 30:18, ὅ ἐστιν Μισθός \"which is Wage\"); Revelation 7:7 Ἰσσαχάρ. Traditional English Issachar.")))

(lemma "ἵστημι" (sense stand (gloss "stand" "stood" "stands" "standing") (why "Intransitive: to stand. The transitive \"set, make stand\" becomes its own sense."))
  (sense establish
    (gloss "establish" "established" "establishes" "establishing")
    (why "Transitive: to set up, establish (Genesis 6:18, στήσω τὴν διαθήκην μου, \"I will establish my covenant\"; Romans 3:31; Hebrews 10:9)."))
  (sense set-up
    (gloss "set up" "sets up" "setting up")
    (why "Transitive, of a thing: to set up, make stand (Genesis 28:18, 22, Jacob sets up the stone as a pillar: ἔστησεν αὐτὸν στήλην, ὃν ἔστησα στήλην). Kept apart from \"establish\", which is for covenants and the like.")))

(lemma "ἰσχυρός" (sense strong (gloss "strong") (why "Strong, mighty (Genesis 14:5, strong nations; Matthew 12:29). Beside ἰσχύς \"strength\".")))

(lemma "ἰσχύς" (sense strength (gloss "strength") (why "Strength.")))

(lemma "ἰσχύω" (sense have-strength (verb "have strength" "had strength" "had strength") (gloss "have strength" "had strength" "has strength" "having strength") (why "To be strong, have strength, be able (Genesis 31:29 ἰσχύει ἡ χείρ μου κακοποιῆσαί σε; Matthew 8:28; Philippians 4:13). \"Have strength\" keeps it apart from δύναμαι, with the noun ἰσχύς \"strength\" visible in it.")))

(lemma "ἴσως" (sense perhaps (gloss "perhaps") (why "Perhaps, it may be (Genesis 32:20 ἴσως γὰρ προσδέξεταί τὸ πρόσωπόν μου; Luke 20:13).")))

(lemma "ἰχθύς"
  (sense fish
    (gloss "fish")
    (why "Fish (Genesis 1:26, 28; Matthew 7:10).")))

(lemma "ἴχνος" (sense track (gloss "track" "tracks") (why "A footprint, track, trace (Genesis 42:9, 12 κατανοῆσαι τὰ ἴχνη τῆς χώρας, spies come to observe the land's tracks, its ways in and weak places; Romans 4:12; 1 Peter 2:21 \"steps\").")))

(lemma "Ἰωβάβ" (sense name (gloss "Jobab") (why "(LXX, supplied.) A son of Joktan (Genesis 10:29), traditional English Jobab.")))

(lemma "Ἰωβέλ" (sense name (gloss "Jabal") (why "(LXX, supplied.) Genesis 4:20, traditional English Jabal.")))

(lemma "Ἰωσήφ" (sense name (gloss "Joseph") (why "Jacob's son by Rachel (Genesis 30:24 onward; John 4:5; Acts 7:9-18; Hebrews 11:22); the same name as Joseph the husband of Mary (Matthew 1:16). Traditional English Joseph, indeclinable in Greek.")))

(lemma "Ἰωυάν" (sense name (gloss "Javan") (why "(LXX, supplied.) Japheth's son (Genesis 10:2, 4), Greek Ἰωυάν; traditional English Javan.")))

(lemma "Ἰωυκάμ" (sense name (gloss "Jaakan") (why "(LXX, supplied.) A son of Ezer, the Horite Σάαρ (Genesis 36:27). The Hebrew lists Bilhan, Zaavan and Akan; the Greek has four names, Ἰωυκάμ and Οὐκάν both answering to Akan (1 Chronicles 1:42 Jaakan). Traditional English Jaakan for Ἰωυκάμ, Akan for Οὐκάν.")))
