;; Greek Source Bible concordance, lemmas beginning with ζ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Ζαβουλών" (sense name (gloss "Zebulun") (why "Jacob's sixth son by Leah (Genesis 30:20); Matthew 4:13, 15 and Revelation 7:8 Ζαβουλών. Traditional English Zebulun.")))

(lemma "Ζαμβράμ" (sense name (gloss "Shimron") (why "(LXX, supplied.) A son of Issachar (Genesis 46:13), Greek Ζαμβράμ for the Hebrew Shimron, the same name in Greek letters: traditional English Shimron.")))

(lemma "Ζάρα" (sense name (gloss "Zerah") (why "Father of Jobab, king of Edom (Genesis 36:33), traditional English Zerah; the New Testament's Ζάρα (Matthew 1:3) is Judah's son Zerah.")))

(lemma "Ζάρε" (sense name (gloss "Zerah") (why "(LXX, supplied.) A son of Reuel, Esau's grandson, and a chief (Genesis 36:13, 17), Greek Ζάρε; traditional English Zerah. Shares \"Zerah\" with Ζάρα, the same Hebrew name.")))

(lemma "Ζαφωεί" (sense name (gloss "Zaphoi") (why "(LXX, supplied.) The last chief of Edom in the list (Genesis 36:43), where the Hebrew has Iram. The Greek gives a different name, so the English transcribes the Greek (rule 8).")))

(lemma "ζάω"
  (sense live
    (intransitive)
    (gloss "live" "lives" "lived" "living")
    (why "To live. The participle is \"living\": ψυχὴ ζῶσα \"living soul\" (Genesis 1:24; 2:7; 1 Corinthians 15:45), οἱ ζῶντες \"the living\" (Genesis 3:20).")))

(lemma "Ζεβράν" (sense name (gloss "Zimran") (why "(LXX, supplied.) A son of Abraham and Keturah (Genesis 25:2); Greek Ζεβράν for the Hebrew Zimran, traditional English Zimran.")))

(lemma "Ζέλφα" (sense name (gloss "Zilpah") (why "(LXX, supplied.) Leah's slave girl, given to Jacob (Genesis 29:24; 30:9-12), Greek Ζέλφα (accusative Ζέλφαν) for the Hebrew Zilpah; traditional English Zilpah.")))

(lemma "ζεύγνυμι" (sense yoke (verb "yoke" "yoked" "yoked") (gloss "yoke" "yoked" "yokes" "yoking") (why "(LXX, supplied.) To yoke, harness (Genesis 46:29, Joseph yoked his chariots). Shares \"yoke\" with the noun ζυγός; the verb is its action.")))

(lemma "Ζεχρεί" (sense name (gloss "Zichri") (why "(LXX, supplied.) A son of Izhar (Exodus 6:21), Greek Ζεχρεί; traditional English Zichri.")))

(lemma "ζηλόω" (sense envy (gloss "envy" "envied" "envies" "envying") (why "To be jealous of, envy (Genesis 26:14, the Philistines envied Isaac; 37:11; Acts 7:9, the patriarchs envied Joseph). The good sense, \"be zealous\" (1 Corinthians 12:31), will be its own sense beside ζηλωτής \"zealous\".")))

(lemma "ζηλωτής" (sense zealous (gloss "zealous") (why "One who is zealous, jealous for (Exodus 20:5 θεὸς ζηλωτής; Acts 21:20). \"Zealous\" keeps the link with ζῆλος; the readable layer may say \"jealous\".")))

(lemma "ζηλωτός" (sense enviable (gloss "enviable") (why "(LXX, supplied.) To be envied, enviable (Genesis 49:22, Joseph υἱὸς ηὐξημένος μου ζηλωτός). Not ζηλωτής \"zealous\"; ζηλόω has \"envy\"."))
  (sense jealous (gloss "jealous") (why "Of God, jealous, not bearing a rival: ὁ γὰρ Κύριος ὁ θεὸς ζηλωτὸν ὄνομα, θεὸς ζηλωτής ἐστιν (Exodus 34:14), where the verbal adjective stands as the active partner of ζηλωτής, as the Hebrew has one word twice; \"enviable name\" would say the opposite of the warning. \"Jealous\" keeps it apart from ζηλωτής \"zealous\" beside it. Chosen by word override.")))

(lemma "ζημιόω" (sense fine (gloss "fine" "fined" "fines" "fining") (why "To penalize, fine, and in the passive to suffer loss (Exodus 21:22, ἐπιζήμιον ζημιωθήσεται, \"will be fined [a] penalty\"; Matthew 16:26; Philippians 3:8 \"suffer loss\", which may become its own sense). (LXX form supplied.)")))

(lemma "ζητέω" (sense seek (gloss "seek" "sought" "seeks" "seeking") (verb "seek" "sought" "sought") (why "To seek, look for (Genesis 19:11 ζητοῦντες τὴν θύραν; 37:15-16; Matthew 2:13; 7:7).")))

(lemma "Ζόγορα" (sense name (gloss "Zoar") (why "(LXX, supplied.) Genesis 13:10, Swete's Ζόγορα for the town the Hebrew calls Zoar; traditional English Zoar. Genesis 14:2, 8 spells it Σήγωρ, also \"Zoar\": two Greek spellings of one name.")))

(lemma "Ζουκάμ" (sense name (gloss "Zaavan") (why "(LXX, supplied.) A son of Ezer, the Horite Σάαρ (Genesis 36:27), Greek Ζουκάμ for the Hebrew Zaavan; traditional English Zaavan.")))

(lemma "ζυγός"(sense yoke (gloss "yoke" "yokes") (why "A yoke (Genesis 27:40, Esau shall loosen Jacob's yoke from his neck; Matthew 11:29-30; Acts 15:10). (LXX form supplied.)")))

(lemma "ζύμη" (sense leaven (gloss "leaven") (why "Leaven, sourdough (Exodus 12:15, 19; 13:3, 7; Matthew 13:33; 16:6; 1 Corinthians 5:6). ἄζυμος, unleavened, is its negative.")))

(lemma "ζυμόω" (sense ferment (gloss "ferment" "fermented" "ferments" "fermenting") (why "To leaven, make rise with ζύμη; passive, to rise, be leavened (Exodus 12:34 πρὸ τοῦ ζυμωθῆναι, 12:39 οὐ γὰρ ἐζυμώθη, the dough; Matthew 13:33; 1 Corinthians 5:6 μικρὰ ζύμη ὅλον τὸ φύραμα ζυμοῖ). \"Ferment\" because \"leaven\" is ζύμη's and \"leavened\" ζυμωτός's.")))

(lemma "ζυμωτός" (sense leavened (gloss "leavened") (why "(LXX, supplied.) Leavened, made with ζύμη \"leaven\" (Exodus 13:7, οὐκ ὀφθήσεταί σοι ζυμωτόν).")))

(lemma "ζωή"
  (sense life
    (gloss "life")
    (why "ζωή, life itself, against βίος, livelihood or manner of life, which gets its own gloss. In Genesis 3:20 the Septuagint gives the woman's name as Ζωή, \"Life\" (capitalized as a name); see the note there.")))

(lemma "ζώνη" (sense belt (dative "with") (gloss "belt" "belts") (why "A belt, girdle worn around the waist (Matthew 3:4 ζώνην δερματίνην; Acts 21:11; Revelation 1:13): of the priests' woven belts (Exodus 28:4, 39-40; 29:9 ζώσεις αὐτοὺς ταῖς ζώναις \"you will gird them with the belts\"). \"Belt\" in both testaments; its verb ζώννυμι is \"gird\". Use this English in every tabernacle chapter.")))

(lemma "ζώννυμι" (sense gird (gloss "gird" "girded" "girds" "girding") (why "To put a belt on, gird (John 21:18 ἐζώννυες σεαυτόν; Acts 12:8): ζώσεις αὐτοὺς ταῖς ζώναις \"you will gird them with the belts\" (Exodus 29:9). The verb of ζώνη \"belt\".")))

(lemma "ζωογονέω" (sense keep-alive (verb "keep alive" "kept alive" "kept alive") (gloss "keep alive" "kept alive" "keeps alive" "keeping alive") (why "To give life, preserve alive, let live (Exodus 1:17-18, 22, the midwives kept the males alive; Luke 17:33; Acts 7:19 εἰς τὸ μὴ ζωογονεῖσθαι, of the same story). From ζωή \"life\" + γόνος; kept apart from ζάω \"live\" and περιποιέω \"preserve\".")))

(lemma "ζῷον"
  (sense animal
    (gloss "animal" "animals")
    (why "A living being, an animal (Genesis 1:21; Hebrews 13:11; 2 Peter 2:12). \"Animal\" keeps it apart from ψυχή (\"soul\") and ζάω (\"living\"). In Revelation 4-6 tradition says \"living creatures\"; the owner may want a separate sense there.")))
