;; Greek Source Bible concordance, lemmas beginning with ζ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ζάω"
  (sense live
    (intransitive)
    (gloss "live" "lives" "lived" "living")
    (why "To live. The participle is \"living\": ψυχὴ ζῶσα \"living soul\" (Genesis 1:24; 2:7; 1 Corinthians 15:45), οἱ ζῶντες \"the living\" (Genesis 3:20).")))

(lemma "Ζεβράν" (sense name (gloss "Zimran") (why "(LXX, supplied.) A son of Abraham and Keturah (Genesis 25:2); Greek Ζεβράν for the Hebrew Zimran, traditional English Zimran.")))

(lemma "ζηλόω" (sense envy (gloss "envy" "envied" "envies" "envying") (why "To be jealous of, envy (Genesis 26:14, the Philistines envied Isaac; 37:11; Acts 7:9, the patriarchs envied Joseph). The good sense, \"be zealous\" (1 Corinthians 12:31), will be its own sense beside ζηλωτής \"zealous\".")))

(lemma "ζηλωτής" (sense zealous (gloss "zealous") (why "One who is zealous, jealous for (Exodus 20:5 θεὸς ζηλωτής; Acts 21:20). \"Zealous\" keeps the link with ζῆλος; the readable layer may say \"jealous\".")))

(lemma "ζητέω" (sense seek (gloss "seek" "sought" "seeks" "seeking") (verb "seek" "sought" "sought") (why "To seek, look for (Genesis 19:11 ζητοῦντες τὴν θύραν; 37:15-16; Matthew 2:13; 7:7).")))

(lemma "Ζόγορα" (sense name (gloss "Zoar") (why "(LXX, supplied.) Genesis 13:10, Swete's Ζόγορα for the town the Hebrew calls Zoar; traditional English Zoar. Genesis 14:2, 8 spells it Σήγωρ, also \"Zoar\": two Greek spellings of one name.")))

(lemma "ζυγός" (sense yoke (gloss "yoke" "yokes") (why "A yoke (Genesis 27:40, Esau shall loosen Jacob's yoke from his neck; Matthew 11:29-30; Acts 15:10). (LXX form supplied.)")))

(lemma "ζωή"
  (sense life
    (gloss "life")
    (why "ζωή, life itself, against βίος, livelihood or manner of life, which gets its own gloss. In Genesis 3:20 the Septuagint gives the woman's name as Ζωή, \"Life\" (capitalized as a name); see the note there.")))

(lemma "ζῷον"
  (sense animal
    (gloss "animal" "animals")
    (why "A living being, an animal (Genesis 1:21; Hebrews 13:11; 2 Peter 2:12). \"Animal\" keeps it apart from ψυχή (\"soul\") and ζάω (\"living\"). In Revelation 4-6 tradition says \"living creatures\"; the owner may want a separate sense there.")))
