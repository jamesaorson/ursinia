;; Greek Source Bible concordance, lemmas beginning with ε (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ἐάν"
  (sense ever
    (gloss "ever")
    (why "After a relative pronoun ἐάν stands for ἄν and makes the relative indefinite (ὃ ἐάν, \"which ever\", Genesis 2:19; Matthew 5:19). Same gloss as ἄν. The conditional \"if\" becomes its own sense when first needed."))
  (sense if
    (gloss "if")
    (why "The conditional, \"if\" (Genesis 4:7). The generator takes it wherever ἐάν does not follow a relative.")))

(lemma "ἔαρ" (sense springtime (gloss "springtime" "springtimes") (why "(LXX, supplied.) Spring, the season (Genesis 8:22, summer and springtime). \"Springtime\" because \"spring\" is πηγή's English, a spring of water (Genesis 7:11).")))

(lemma "ἑαυτοῦ"
  (sense self
    (gloss "itself" "himself" "herself" "themselves" "yourself" "yourselves" "myself" "ourselves")
    (why "The reflexive pronoun; the English form follows the referent's person, gender and number. A dative \"for themselves\" carries its case in \"for\".")))

(lemma "ἐάω" (sense permit (gloss "permit" "permitted" "permits" "permitting") (why "To let, permit (Genesis 38:16, Judah to Tamar: Ἔασόν με εἰσελθεῖν πρὸς σέ, \"Permit me to go in to you\"; Luke 4:41; Acts 14:16; 16:7). \"Permit\" keeps it apart from ἀφίημι \"allow\".")))

(lemma "ἑβδομάς" (sense week (gloss "week" "weeks") (why "(LXX, supplied.) A group of seven, a week (Exodus 34:22 ἑορτὴν ἑβδομάδων, \"feast of weeks\"). Kept apart from σάββατον \"sabbath\", which the New Testament also uses for the week.")))

(lemma "ἑβδομήκοντα" (sense seventy (gloss "seventy") (why "The numeral seventy (Genesis 5:12; Acts 7:14).")))

(lemma "ἑβδομηκοντάκις" (sense seventy-times (gloss "seventy times") (why "Seventy times (Genesis 4:24; Matthew 18:22, ἑβδομηκοντάκις ἑπτά, \"seventy times seven\", which takes up this verse).")))

(lemma "ἕβδομος"
  (sense seventh
    (dative "on")
    (gloss "seventh")
    (why "The ordinal \"seventh\" (Genesis 2:2-3; Hebrews 4:4).")))

(lemma "Ἔβερ" (sense name (gloss "Eber") (why "Shelah's son (Genesis 10:21-25; 11:14-17; Luke 3:35, KJV \"Heber\"), traditional Old Testament English Eber.")))

(lemma "Ἑβραῖος" (sense name (person) (gloss "Hebrew" "Hebrews") (why "A Hebrew (Genesis 39:14, 17, παῖδα Ἐβραῖον, Joseph; 40:15 γῆς Ἐβραίων; 2 Corinthians 11:22; Philippians 3:5). Swete prints a smooth breathing, Ἐβραῖος; the concordance keeps the usual Ἑβραῖος."))
  (sense woman (person) (gloss "Hebrew woman" "Hebrew women") (why "The feminine, a Hebrew woman, with no noun beside it (Exodus 1:16 μαιοῦσθε τὰς Ἐβραίας; 1:19 αἱ Ἐβραῖαι). \"The Hebrews\" would lose the Greek's gender, which says the women are meant; chosen by form row.")))

(lemma "ἐγγίζω" (sense draw-near (intransitive) (gloss "draw near" "drew near" "drawn near" "draws near" "drawing near") (why "To come near, draw near (Genesis 12:11, when Abram drew near to enter Egypt; Mark 1:15, the kingdom has drawn near).")))

(lemma "ἐγγύς" (sense near (gloss "near" "nearest") (why "Near, close by, with the genitive (Genesis 19:20 ἡ πόλις αὕτη ἐγγὺς τοῦ καταφυγεῖν με ἐκεῖ; John 3:23; Romans 10:8). The adverb of ἐγγίζω \"draw near\".")))

(lemma "ἐγγράφω" (sense write-in (verb "write in" "wrote in" "written in") (gloss "write in" "wrote in" "written in" "writes in" "writing in") (why "To write in, inscribe (ἐν + γράφω \"write\"): the stones of the oracle ἐνγεγραμμένα εἰς σφραγῖδας (Exodus 39:14, Swete's spelling ἐν-; Luke 10:20; 2 Corinthians 3:2-3). \"In\" renders the ἐν- and keeps it apart from γράφω and καταγράφω. (LXX form supplied.)")))

(lemma "ἐγείρω" (sense wake (voice active) (verb "wake" "woke" "woken") (gloss "wake" "woke" "woken" "wakes" "waking") (why "To rouse; passive, to be roused from sleep, wake (Genesis 41:4, 7 ἠγέρθη δὲ Φαραώ; Matthew 1:24; 25:7). The passive is rendered active because English \"wake\" is intransitive. \"Wake\" keeps it apart from ἐξεγείρω \"awake\"; the New Testament's \"raise\" (of the dead) becomes its own sense when first needed."))
  (sense arise (voice active) (verb "arise" "arose" "arisen") (gloss "arise" "arose" "arisen" "arises" "arising") (why "Passive, to get up from where one is, to set out (Exodus 5:8 Ἐγερθῶμεν καὶ θύσωμεν, \"Let us arise and sacrifice\", the Israelites as Pharaoh quotes them): not waking from sleep. Rendered active like the sense wake; \"arise\" keeps it apart from ἀνίστημι \"stand up\".")))

(lemma "ἐγκάθημαι" (sense lurk (gloss "lurk" "lurked" "lurks" "lurking") (why "(LXX, supplied.) To sit in, lie in wait (Genesis 49:17, Dan a snake ἐνκαθήμενος ἐπὶ τρίβου, Swete's spelling ἐνκ-). \"Lurk\" keeps it apart from κάθημαι \"be seated\"."))
  (sense be-settled (intransitive) (verb "be settled" "was settled" "been settled") (gloss "be settled" "was settled" "were settled" "is settled" "are settled" "been settled" "being settled") (why "Of a people: to sit in a land, be settled there (Exodus 23:31 τοὺς ἐνκαθημένους ἐν τῇ γῇ; 23:33 οὐκ ἐνκαθήσονται ἐν τῇ γῇ σου). \"Lurk\" would make the inhabitants an ambush. Kept apart from κατοικέω \"reside\" and οἰκέω \"dwell\"; κατοικίζω has the active \"settle\". Chosen in the form rows.")))

(lemma "ἐγκαλέω" (sense accuse (gloss "accuse" "accused" "accuses" "accusing") (why "To call in, bring a charge, accuse (Exodus 22:9 πάσης ἀπωλίας τῆς ἐνκαλουμένης, \"of all loss being accused\", the loss claimed in court, Swete's spelling ἐνκ-; Acts 19:38; 23:28; Romans 8:33). Kept apart from the noun αἰτία \"charge\".")))

(lemma "ἐγκαταλείπω" (sense forsake (gloss "forsake" "forsook" "forsaken" "forsakes" "forsaking") (why "To leave behind in, abandon, forsake (Genesis 28:15 οὐ μή σε ἐγκαταλείπω; Hebrews 13:5; Matthew 27:46 quoting Psalm 22:1). \"Forsake\" keeps it apart from καταλείπω \"leave\". (LXX form supplied.)")))

(lemma "ἐγκοτέω" (sense resent (dative "") (gloss "resent" "resented" "resents" "resenting") (why "(LXX, supplied.) To bear a grudge against, with the dative (Genesis 27:41 ἐνεκότει Ἠσαὺ τῷ Ἰακώβ, \"Esau was resenting Jacob\"). \"Resent\" because \"bear a grudge\" would need an unbracketed \"a\".")))

(lemma "ἔγκειμαι" (sense lie-in (gloss "lie in" "lay in" "lain in" "lies in" "lying in") (why "(LXX, supplied.) To lie in or on, be set on, be intent on (Genesis 8:21, ἔγκειται ἡ διάνοια ... ἐπὶ τὰ πονηρά, the mind lies intent on evil things). \"Lie in\" renders the ἐν- of the compound; the readable layer will say \"is set on\"."))
  (sense be-devoted (verb "be devoted" "was devoted" "been devoted") (dative "to") (gloss "be devoted" "is devoted" "was devoted" "were devoted" "been devoted" "being devoted") (why "With a dative person: to be bent on, devoted to (Genesis 34:19, ἐνέκειτο γὰρ τῇ θυγατρὶ Ἰακώβ, Shechem's love for Dinah). \"Was lying in to the daughter\" does not say it. Chosen by override.")))

(lemma "ἐγκισσάω" (sense crave (intransitive) (gloss "crave" "craved" "craves" "craving") (why "(LXX, supplied.) Of animals in heat, to crave, desire to conceive (Genesis 30:38-41, the flocks ἐνκισσήσωσιν at the peeled rods; 31:10). From κίσσα, the craving of pregnancy. Swete prints the unassimilated ἐνκισσ- (and the augmented ἐνεκίσσων); the lemma has the usual ἐγ-.")))

(lemma "ἐγκρατεύομαι" (sense hold-back (verb "hold back" "held back" "held back") (gloss "hold back" "held back" "holds back" "holding back") (why "(LXX, supplied.) To exercise self-control, restrain oneself (Genesis 43:31, Joseph, having washed his face and come out, ἐνεκρατεύσατο, \"held back\" his weeping; 1 Corinthians 7:9; 9:25). \"Hold back\" keeps it apart from κρατέω \"hold\" and κατέχω \"hold fast\".")))

(lemma "ἐγκρατέω" (sense keep-hold (genitive "of") (verb "keep hold" "kept hold" "kept hold") (gloss "keep hold" "kept hold" "keeps hold" "keeping hold") (why "(LXX, supplied.) To have in one's power, keep hold of, with the genitive (Exodus 9:2 ἀλλ’ ἔτι ἐνκρατεῖς αὐτοῦ, Pharaoh still keeping hold of the people; Swete spells it ἐν-). Read as the verb: the adjective ἐγκρατής would be singular here. \"Keep hold\" keeps it apart from κρατέω \"hold\", κατέχω \"hold fast\" and ἐγκρατεύομαι \"hold back\".")))

(lemma "ἐγκρίς" (sense wafer (gloss "wafer" "wafers") (why "(LXX, supplied.) A cake made with oil or honey, a wafer (Exodus 16:31, the taste of the manna ὡς ἐγκρὶς ἐν μέλιτι, \"as wafer in honey\"; Swete prints ἐνκρίς).")))

(lemma "ἐγκρυφίας" (sense ash-cake (gloss "ash-cake" "ash-cakes") (why "(LXX, supplied.) A loaf baked hidden (ἐν + κρύπτω) in the hot ashes (Genesis 18:6). \"Ash-cake\" names it by how it was baked.")))

(lemma "ἐγκτάομαι" (sense gain-possession (verb "gain possession" "gained possession" "gained possession") (gloss "gain possession" "gained possession" "gains possession" "gaining possession") (why "(LXX, supplied.) To acquire property in a land, settle with possessions (Genesis 34:10 ἐνκτᾶσθε ἐν αὐτῇ, Swete's spelling ἐνκ-). Kept apart from κτάομαι \"acquire\".")))

(lemma "ἐγχειρίδιον" (sense hand-tool (gloss "hand-tool") (why "(LXX, supplied.) Something held in the hand, a tool or blade (Exodus 20:25). Swete spells ἐνχειρίδιον.")))

(lemma "ἐγχέω" (sense pour-in (verb "pour in" "poured in" "poured in") (gloss "pour in" "poured in" "pours in" "pouring in") (why "(LXX, supplied.) To pour in (Exodus 24:6, Moses poured half the blood into bowls, ἐνέχεεν εἰς κρατῆρας). Kept apart from ἐκχέω, ἐπιχέω \"pour on\" and προσχέω \"pour against\".")))

(lemma "ἐγχώριος" (sense native (person) (gloss "native" "natives") (why "(LXX, supplied.) Of the land, native, local (Genesis 34:1 τὰς θυγατέρας τῶν ἐνχωρίων, Swete's spelling ἐνχ-, the daughters of the natives).")))

(lemma "ἐγώ"
  (sense pronoun
    (gloss "I" "me" "my" "mine" "we" "us" "our" "ours")
    (why "The first-person pronoun, singular and plural (the table lemmatizes ἡμεῖς under ἐγώ). The English form follows the Greek case and number.")))

(lemma "Ἐδέμ"
  (sense name
    (gloss "Eden")
    (why "(LXX, supplied.) The place name, given its traditional English form; the Greek spells it Ἐδέμ, with final μ. In Genesis 3:23-24 the Septuagint translates the same Hebrew word instead, τρυφή \"delight\" (\"the paradise of the delight\").")))

(lemma "ἔδεσμα" (sense delicacy (gloss "delicacy" "delicacies") (why "(LXX, supplied.) Food, a dish, especially a choice one (Genesis 27:4-31, the ἐδέσματα Isaac loves). \"Delicacy\" keeps it apart from βρῶμα \"food\" and βρῶσις.")))

(lemma "Ἐδώμ" (sense name (gloss "Edom") (why "(LXX, supplied.) Esau's other name, \"red\" (Genesis 25:30, from the red stew; 36:1); traditional English Edom.")))

(lemma "ἐθισμός" (sense habit (gloss "habit" "habits") (why "(LXX, supplied.) A custom, habitual way (Genesis 31:35 τὰ κατ’ ἐθισμὸν τῶν γυναικίων, Rachel's period). \"Habit\" leaves \"custom\" for ἔθος (Luke 1:9).")))

(lemma "ἔθνος" (sense nation (gloss "nation" "nations") (why "A nation, people; plural τὰ ἔθνη, the nations, the Gentiles (Genesis 17:4-6 πατὴρ πλήθους ἐθνῶν, quoted in Romans 4:17-18; 18:18, quoted in Galatians 3:8). \"Nation\" in the literal layer everywhere so the promise to Abraham reads the same in both testaments; the readable layer may say \"Gentiles\".")))

(lemma "εἰ"
  (sense if
    (gloss "if")
    (why "The conditional \"if\". εἰ μή in Genesis 3:11 is rendered word for word (\"if not\") and discussed in a note."))
  (sense oath
    (gloss "")
    (why "εἰ μήν, the oath formula \"surely\" (Genesis 22:17, quoted in Hebrews 6:14): the phrase's English is carried by μήν (sense surely); εἰ is aligned with it and left unrendered, since \"if surely\" says the opposite of an oath.")))

(lemma "εἰδέα" (sense appearance (gloss "appearance") (why "Look, appearance, outward form (Genesis 5:3, Seth begotten κατὰ τὴν εἰδέαν of Adam; Matthew 28:3, the angel's appearance like lightning). Kept apart from εἰκών \"image\", which follows it in Genesis 5:3.")))

(lemma "εἶδος" (sense shape (dative "in") (gloss "shape" "shapes") (why "Form, outward shape, look (Genesis 29:17, Rachel καλὴ τῷ εἴδει; Luke 3:22 σωματικῷ εἴδει; John 5:37). \"Shape\" keeps it apart from εἰδέα \"appearance\", ὄψις, and the verb πλάσσω \"form\".")))

(lemma "εἴδωλον" (sense idol (gloss "idol" "idols") (why "Image, idol (Exodus 20:4; 1 Corinthians 8:4).")))

(lemma "εἰκάς" (sense twentieth (dative "") (gloss "twentieth") (why "(LXX, supplied.) The twentieth day of a month, a feminine noun: ἑβδόμῃ καὶ εἰκάδι τοῦ μηνός, \"on [the] seventh and twentieth of the month\" (Genesis 7:11; 8:4, 14), the twenty-seventh day.")))

(lemma "εἰκοσαετής" (sense twenty-years-old (gloss "twenty years old") (why "(LXX, supplied.) Twenty years old (Exodus 30:14 ἀπὸ εἰκοσαετοῦς καὶ ἐπάνω, \"from twenty years old and upward\"; 38:26; Numbers 1 passim). One adjective, rendered by the English phrase.")))

(lemma "εἴκοσι" (sense twenty (gloss "twenty") (why "The numeral twenty (Genesis 6:3; Acts 27:28).")))

(lemma "εἰκών"
  (sense image
    (gloss "image" "images")
    (why "Image, likeness that represents (Genesis 1:26-27; 2 Corinthians 4:4; Colossians 1:15; 3:10). Kept apart from ὁμοίωσις \"likeness\".")))

(lemma "εἰμί"
  (sense be
    (gloss "be" "am" "is" "are" "was" "were" "been" "being" "will be")
    (why "The verb of being. εἰμί has no aorist, so its imperfect is plain \"was\", not \"was being\"; the progressive is kept for the imperfect of verbs that also have an aorist.")))

(lemma "εἶμι" (sense go (intransitive) (gloss "go" "goes" "went" "going" "gone") (why "(LXX, supplied.) To go, the verb whose compounds are ἄπειμι, εἴσειμι, ἔξειμι (Exodus 32:26, ἴτω πρὸς μέ, \"let him go to me\"). It shares \"go\" with πορεύομαι: English has no second plain verb of going, and the two are the same in sense.")))

(lemma "εἵν" (sense hin (gloss "hin" "hins") (why "(LXX, supplied.) The hin, a Hebrew liquid measure, transliterated and indeclinable: τῷ τετάρτῳ τοῦ εἵν \"with the fourth of the hin\" (Exodus 29:40; 30:24). The traditional English \"hin\".")))

(lemma "Εἱρᾶς"(sense name (gloss "Hirah") (why "(LXX, supplied.) Judah's friend, the Adullamite (Genesis 38:1, 12, 20), Greek Εἱρᾶς for the Hebrew Hirah; traditional English Hirah.")))

(lemma "εἰρήνη" (sense peace (gloss "peace") (why "Peace (Genesis 15:15 μετ᾽ εἰρήνης, \"with peace\"; Luke 2:29).")))

(lemma "εἰρηνικός" (sense peaceable (gloss "peaceable") (why "(LXX, supplied.) Peaceable, of peace (Genesis 34:21, these men are peaceable with us). The adjective of εἰρήνη \"peace\"; the New Testament has εἰρηνικός at James 3:17.")))

(lemma "εἷς"
  (sense one
    (gloss "one")
    (why "The numeral, kept as \"one\" so emphatic uses (οὐδὲ ἕν, \"not even one\") stay visible. Genesis 1:5 ἡμέρα μία is \"day one\", a cardinal, not \"the first day\".")))

(lemma "εἰς"
  (sense into
    (gloss "into")
    (why "Motion into, and the Hebrew-style \"come to be into\" / \"be into\" (Genesis 2:7, 24), which the literal layer keeps (\"the two will be into one flesh\") and the readable layer renders \"become\". Also εἰς τὸν αἰῶνα, \"into the age\"."))
  (sense for
    (gloss "for")
    (why "Purpose or destination: \"for signs\", \"for eating\" (Genesis 1:14, 29). A different English preposition because \"into food\" would mislead; the Greek is the same word.")))

(lemma "εἰσάγω" (sense bring-in (gloss "bring in" "brought in" "brings in" "bringing in") (why "To lead in, bring in (Genesis 6:19, the animals into the ark; Luke 2:27). \"Bring in\" against ἐξάγω \"bring out\".")))

(lemma "εἰσακούω" (sense hearken (genitive "to") (gloss "hearken" "hearkened" "hearkens" "hearkening") (why "To hear and attend to, hearken (Genesis 21:17 εἰσήκουσεν ὁ θεὸς τῆς φωνῆς; Luke 1:13 εἰσηκούσθη ἡ δέησίς σου; Hebrews 5:7). \"Hearken\" keeps it apart from ἀκούω \"hear\", ἐπακούω \"listen to\" and ὑπακούω \"obey\"; the readable layer will want a modern word. The genitive of the one heard takes \"to\".")))

(lemma "εἴσειμι" (sense come-in (intransitive) (verb "come in" "came in" "come in") (gloss "come in" "came in" "comes in" "coming in") (why "To go in, enter (εἰς + εἶμι \"go\"; Acts 3:3; 21:18, 26; Hebrews 9:6, the priests going into the tent): εἰσιόντι εἰς τὸ ἅγιον \"to [him] coming in into the holy [place]\" (Exodus 28:29, 35). \"Come in\" keeps it apart from εἰσέρχομαι \"go in\" and εἰσπορεύομαι \"enter\"; its pair ἔξειμι is \"come out\".")))

(lemma "εἰσέρχομαι" (sense go-in (gloss "go in" "went in" "goes in" "going in" "gone in") (why "To go in, enter. \"Go in\" to match ἐξέρχομαι \"go forth\" and keep the compound visible.")))

(lemma "εἴσοδος" (sense entrance (dative "at") (gloss "entrance" "entrances") (why "A going in, coming, entrance (Genesis 30:27, God blessed Laban τῇ σῇ εἰσόδῳ, at Jacob's coming; Acts 13:24; 1 Thessalonians 1:9). From εἰσέρχομαι \"go in\".")))

(lemma "εἰσπορεύομαι" (sense enter (gloss "enter" "entered" "enters" "entering") (why "To go in, enter (Genesis 6:4; Mark 1:21). \"Enter\" to keep it apart from εἰσέρχομαι \"go in\", as ἐκπορεύομαι \"go out\" is kept apart from ἐξέρχομαι \"go forth\". In Genesis 6:4 εἰσπορεύεσθαι πρός is to go in to a woman; the literal layer keeps \"were entering to\".")))

(lemma "εἰσσπάω" (sense draw-in (verb "draw in" "drew in" "drawn in") (gloss "draw in" "drew in" "drawn in" "draws in" "drawing in") (why "(LXX, supplied.) To draw in, pull inside (Genesis 19:10, the men drew Lot in to themselves). The middle is rendered active.")))

(lemma "εἰσφέρω" (sense carry-in (gloss "carry in" "carried in" "carries in" "carrying in") (why "To carry in, bring in (Genesis 27:10, 18, 25, 31, 33, Jacob and Esau bringing food in to Isaac; Luke 5:18). \"Carry in\" follows φέρω \"carry\" and keeps it apart from εἰσάγω \"bring in\".")))

(lemma "εἰσφορά" (sense contribution (gloss "contribution" "contributions") (why "(LXX, supplied.) What is brought in, a contribution, levy (Exodus 30:13-16, the half didrachm given as εἰσφορὰ Κυρίῳ; 38:25). Tabernacle term: keep \"contribution\"; kept apart from ἀπαρχή \"firstfruit\" and the offering words (θυσία \"sacrifice\", δῶρον).")))

(lemma "ἐκ"
  (sense out-of
    (gloss "out of")
    (why "Origin, \"out of\", against ἀπό \"from\" (Genesis 2:23 ἐκ τῶν ὀστέων μου, \"out of my bones\").")))

(lemma "ἕκαστος" (sense each (gloss "each") (why "Each, every one (Genesis 11:7, \"each the voice of the neighbor\"; Matthew 16:27). Kept apart from πᾶς \"every\".")))

(lemma "ἑκάτερος" (sense each-of-two (gloss "each of two") (why "(LXX, supplied.) Each of two (Genesis 40:5, the cupbearer and the baker each a dream). \"Each of two\" keeps it apart from ἕκαστος \"each\".")))

(lemma "ἑκατόν" (sense hundred (gloss "one hundred") (why "The numeral one hundred (Genesis 5; Matthew 18:12). \"One hundred\", not \"a hundred\", so no article is supplied; the larger hundreds (διακόσιοι, τριακόσιοι...) are single Greek words with their own entries.")))

(lemma "ἑκατονταετής" (sense hundred-years-old (gloss "hundred-years-old") (why "(LXX, supplied.) A hundred years old (Genesis 17:17 τῷ ἑκατονταετεῖ \"to the hundred-years-old [one]\"; Romans 4:19 ἑκατονταετής που ὑπάρχων).")))

(lemma "ἑκατοντάρχης" (sense commander-of-hundreds (person) (plural "commanders of hundreds") (gloss "commander of hundreds" "commanders of hundreds") (why "Commander of a hundred (Exodus 18:21, 25, judges over the people; the centurion of Matthew 8:5; Acts 10:1). Swete's ἑκατοντάρχους is of the by-form ἑκατόνταρχος; the New Testament tables list both under ἑκατοντάρχης. Each rank \"commander of\" its number, with χιλίαρχος, πεντηκόνταρχος and δεκάδαρχος; \"centurion\" belongs to the readable layer of the New Testament.")))

(lemma "ἑκατοστεύω" (sense yield-hundredfold (gloss "yield hundredfold" "yielded hundredfold" "yields hundredfold" "yielding hundredfold") (why "(LXX, supplied.) To bear a hundred times over (from ἑκατόν, Genesis 26:12 ἑκατοστεύουσαν κριθήν, \"barley yielding hundredfold\").")))

(lemma "ἐκβάλλω"
  (sense cast-out
    (gloss "cast out" "casts out" "casting out")
    (why "To throw out, drive out (Genesis 3:24; Mark 1:34, casting out demons). Same gloss in both testaments.")))

(lemma "ἐκβολή" (sense expulsion (gloss "expulsion" "expulsions") (why "(LXX, supplied.) A casting out, the noun of ἐκβάλλω (Exodus 11:1 σὺν παντὶ ἐκβαλεῖ ὑμᾶς ἐκβολῇ, \"with all expulsion he will cast you out\", the Hebrew-style cognate dative; Acts 27:18, a jettisoning). \"Expulsion\" because the verb's \"casting out\" is one of its own forms.")))

(lemma "ἔκγονος" (sense offspring (person) (plural "offspring") (gloss "offspring") (why "Born of, descended from; τὰ ἔκγονα, offspring, descendants (Genesis 48:6, the offspring Joseph may beget after Ephraim and Manasseh; 1 Timothy 5:4, \"grandchildren\"). \"Offspring\" keeps it apart from τέκνον \"child\", σπέρμα \"seed\" and γένημα. (LXX form supplied.)")))

(lemma "ἐκδανείζω" (sense lend-out (verb "lend out" "lent out" "lent out") (gloss "lend out" "lent out" "lends out" "lending out") (why "(LXX, supplied.) To lend out at interest (Exodus 22:25 Ἐὰν δὲ ἀργύριον ἐκδανίσῃς τῷ ἀδελφῷ). The compound of δανείζω \"lend\" (Luke 6:34-35).")))

(lemma "ἐκδέχομαι" (sense accept (gloss "accept" "accepted" "accepts" "accepting") (why "To take from another's hand, receive as one's charge (Genesis 43:9 ἐγὼ δὲ ἐκδέχομαι αὐτόν, Judah taking Benjamin on himself; 44:32 ἐκδέδεκται τὸ παιδίον παρὰ τοῦ πατρός). \"Accept\" keeps it apart from δέχομαι \"receive\". The New Testament's \"wait for, expect\" (John 5:3; Hebrews 11:10) will need its own sense.")))

(lemma "ἐκδίδωμι" (sense give-out (dative "to") (verb "give out" "gave out" "given out") (gloss "give out" "gave out" "given out" "gives out" "giving out") (why "To give out, hand over; middle, to let out for hire (Matthew 21:33 ἐξέδετο, of a vineyard) or give out a daughter in marriage (Exodus 2:21 ἐξέδοτο Σεπφώραν ... Μωυσῇ γυναῖκα). \"Give out\" keeps it apart from δίδωμι \"give\".")))

(lemma "ἐκδικέω" (sense avenge (gloss "avenge" "avenged" "avenges" "avenging") (why "To avenge, punish (Romans 12:19; Revelation 6:10).")))

(lemma "ἐκδίκησις" (sense vengeance (gloss "vengeance" "vengeances") (why "Vengeance, the doing of justice on a wrongdoer (Exodus 7:4 σὺν ἐκδικήσει μεγάλῃ, God bringing Israel out with great vengeance; Luke 18:7-8; Romans 12:19). The noun of ἐκδικέω.")))

(lemma "ἐκδύω" (sense strip (gloss "strip" "stripped" "strips" "stripping") (why "To take off clothing, strip, with an accusative of the person and of the garment (Genesis 37:23 ἐξέδυσαν τὸν Ἰωσὴφ τὸν χιτῶνα, \"they stripped Joseph the tunic\"; Matthew 27:28, 31). \"Strip\" keeps it apart from περισύρω \"strip off\" (bark) and ἐνδύω \"put on\".")))

(lemma "ἐκεῖ"
  (sense there
    (gloss "there")
    (why "The adverb of place.")))

(lemma "ἐκεῖθεν"
  (sense from-there
    (gloss "from there")
    (why "The adverb of place from which (Genesis 2:10).")))

(lemma "ἐκεῖνος"
  (sense that
    (gloss "that" "those")
    (why "The far demonstrative, against οὗτος \"this\". Never turned into a personal pronoun.")))

(lemma "ἐκζέω" (sense seethe (gloss "seethe" "seethed" "seethes" "seething") (why "(LXX, supplied.) To boil out, boil over, seethe (Genesis 49:4, μὴ ἐκζέσῃς, of Reuben). \"Seethe\" because ἕψω has \"boil\".")))

(lemma "ἐκζητέω" (sense seek-out (gloss "seek out" "sought out" "seeks out" "seeking out") (why "To seek out, search for; of blood, to require it back (Genesis 9:5, ἐκζητήσω three times; Luke 11:50-51; Hebrews 11:6; 12:17). \"Seek out\" renders ἐκ- + ζητέω and leaves bare \"seek\" for ζητέω; \"require\" is a reading for the readable layer.")))

(lemma "ἐκθλίβω" (sense squeeze-out (verb "squeeze out" "squeezed out" "squeezed out") (gloss "squeeze out" "squeezed out" "squeezes out" "squeezing out") (why "(LXX, supplied.) To press out, squeeze out (Genesis 40:11, the grape into Pharaoh's cup).")))

(lemma "ἐκκαίω" (sense kindle (gloss "kindle" "kindled" "kindles" "kindling") (why "To set burning, kindle (Exodus 22:6 ὁ τὸ πῦρ ἐκκαύσας, \"the [one] having kindled the fire\"; Romans 1:27 ἐξεκαύθησαν, inflamed). Kept apart from καίω \"burn\" and κατακαίω \"burn up\".")))

(lemma "ἐκκαλέω" (sense call-out (gloss "call out" "called out" "calls out" "calling out") (why "(LXX, supplied.) To call out, summon out of a place (Genesis 19:5, the men of Sodom calling Lot out). The middle is rendered active; kept apart from καλέω \"call\".")))

(lemma "ἐκκενόω" (sense empty-out (gloss "empty out" "emptied out" "empties out" "emptying out") (why "(LXX, supplied.) To empty out, pour out completely (Genesis 24:20, the jar emptied into the trough). Kept apart from κενόω \"empty\" (Philippians 2:7) by the particle.")))

(lemma "ἐκκλείω" (sense shut-out (verb "shut out" "shut out" "shut out") (gloss "shut out" "shuts out" "shutting out") (why "To shut out, exclude (Exodus 23:2 ὥστε ἐκκλεῖσαι κρίσιν, \"so as to shut out judgment\", as Swete prints; Romans 3:27; Galatians 4:17). Kept apart from κλείω \"shut\".")))

(lemma "ἐκκλίνω" (sense turn-aside (gloss "turn aside" "turned aside" "turns aside" "turning aside") (why "To turn aside, turn away (Genesis 18:5, the guests turned aside to Abraham; Romans 3:12; 16:17; 1 Peter 3:11). Kept apart from the στρέφω compounds.")))

(lemma "ἐκκόλαμμα" (sense engraved-work (gloss "engraved work" "engraved works") (plural "engraved works") (why "(LXX, supplied.) A thing cut out, an engraving (ἐκκολάπτω \"engrave out\"): the stones of the shoulder-piece ἐκκεκολαμμένους ἐκκόλαμμα σφραγῖδος (Exodus 39:6). \"Engraved work\" on the pattern of γλύμμα \"carved work\", kept apart from it and from γλυφή \"engraving\". Tabernacle term.")))

(lemma "ἐκκολάπτω" (sense engrave-out (verb "engrave out" "engraved out" "engraved out") (gloss "engrave out" "engraved out" "engraves out" "engraving out") (why "(LXX, supplied.) To cut out, engrave (ἐκ + κολάπτω \"engrave\"): the two emerald stones ἐκκεκολαμμένους, cut with the names (Exodus 39:6). \"Out\" renders the ἐκ- and keeps it apart from κολάπτω and διαγλύφω \"engrave\". Tabernacle term.")))

(lemma "ἐκκόπτω" (sense cut-off (verb "cut off" "cut off" "cut off") (gloss "cut off" "cuts off" "cutting off") (why "(LXX form supplied.) To cut out, cut off, cut down (Genesis 36:35 ὁ ἐκκόψας Μαδιάμ, of a defeat in battle; Matthew 3:10; 5:30; Romans 11:22, 24). Kept apart from κατακόπτω \"cut down\".")))

(lemma "ἐκκρέμαμαι"(sense hang (verb "hang" "hung" "hung") (gloss "hang" "hung" "hangs" "hanging") (why "(LXX, supplied.) To hang from, depend on (Genesis 44:30 ἡ δὲ ψυχὴ αὐτοῦ ἐκκρέμαται ἐκ τῆς τούτου ψυχῆς, \"his soul hangs out of the soul of this one\"; the form of ἐκκρεμάννυμι, compare Luke 19:48 ἐξεκρέματο).")))

(lemma "ἐκλέγω" (sense choose (gloss "choose" "chose" "chosen" "chooses" "choosing") (why "Middle: to pick out for oneself, choose (Genesis 6:2; Luke 6:13; Ephesians 1:4).")))

(lemma "ἐκλείπω" (sense fail (intransitive) (gloss "fail" "failed" "fails" "failing") (why "(LXX sense, supplied.) To leave off, fail, give out (Genesis 8:13, the water was failing from the earth; Luke 16:9; 22:32, that your faith may not fail; Hebrews 1:12).")))

(lemma "ἐκλύω" (sense loosen (gloss "loosen" "loosened" "loosens" "loosening") (why "To loose, release; passive, to grow faint (Matthew 15:32; Galatians 6:9). Genesis 27:40, Esau will loosen Jacob's yoke from his neck. The passive \"faint\" will be its own sense. (LXX form supplied.)")))

(lemma "ἐκλεκτός" (sense choice (gloss "choice") (why "Picked out, choice, the best (Genesis 23:6, ἐν τοῖς ἐκλεκτοῖς μνημείοις ἡμῶν, \"in our choice tombs\"). \"Choice\" keeps it apart from ἐκλέγω \"choose\" (\"chosen\"); the New Testament's \"elect\" (Matthew 24:22; Romans 8:33), of persons, may become its own sense.")))

(lemma "ἐκνήφω" (sense sober-up (gloss "sober up" "sobered up" "sobers up" "sobering up") (why "To become sober out of drunkenness (Genesis 9:24, Noah ἐξένηψεν ἀπὸ τοῦ οἴνου; 1 Corinthians 15:34). Against νήφω \"be sober\".")))

(lemma "ἐκπέμπω" (sense send-off(gloss "send off" "sent off" "sends off" "sending off") (why "To send away, send off on a journey (Genesis 24:54, 56, 59; Acts 13:4; 17:10). \"Send off\" keeps it apart from πέμπω \"send\" and ἐξαποστέλλω \"send out\".")))

(lemma "ἐκπετάννυμι" (sense spread-out (verb "spread out" "spread out" "spread out") (gloss "spread out" "spreads out" "spreading out") (why "To spread out, of the hands in prayer (Exodus 9:29 ἐκπετάσω τὰς χεῖράς μου; Romans 10:21 quoting Isaiah 65:2). Kept apart from ἐκτείνω \"stretch out\".")))

(lemma "ἐκπολεμέω" (sense make-war-against (verb "make war against" "made war against" "made war against") (gloss "make war against" "made war against" "makes war against" "making war against") (why "(LXX, supplied.) To fight out a war, make war on and defeat (Exodus 1:10 ἐκπολεμήσαντες ἡμᾶς ἐξελεύσονται). The verb of πόλεμος \"war\", whose English it keeps.")))

(lemma "ἐκπορεύομαι"
  (sense go-out
    (gloss "go out" "goes out" "going out" "went out")
    (why "To go out, come out. Genesis 2:10 (a river going out of Eden) is echoed in Revelation 22:1 (a river ἐκπορευόμενον from the throne); one gloss keeps the echo. John 15:26 (the Spirit who ἐκπορεύεται from the Father) will read \"goes out\", not the traditional \"proceeds\".")))

(lemma "ἐκπορνεύω" (sense commit-fornication (verb "commit fornication" "committed fornication" "committed fornication") (gloss "commit fornication" "committed fornication" "commits fornication" "committing fornication") (why "(LXX form supplied.) To commit fornication, give oneself to prostitution (Genesis 38:24, Ἐκπεπόρνευκεν Θαμάρ, \"Tamar has committed fornication\"; Jude 7). Kept with πορνεία \"fornication\"; πόρνη is \"harlot\".")))

(lemma "ἔκστασις"
  (sense trance
    (gloss "trance")
    (why "(Supplied in Genesis 2:21.) A standing outside oneself: trance (Acts 10:10; 11:5; 22:17), and astonishment (Mark 5:42), which will be its own sense. Genesis 2:21 says God cast a trance on Adam where translations from the Hebrew have \"a deep sleep\".")))

(lemma "ἐκτείνω"
  (sense stretch-out
    (gloss "stretch out" "stretched out" "stretches out" "stretching out")
    (why "(Supplied in Genesis 3:22.) To stretch out the hand (Matthew 8:3; 12:13).")))

(lemma "ἐκτινάσσω" (sense shake-off (verb "shake off" "shook off" "shaken off") (gloss "shake off" "shook off" "shaken off" "shakes off" "shaking off") (why "To shake off, shake out (Exodus 14:27, ἐξετίναξεν Κύριος τοὺς Αἰγυπτίους μέσον τῆς θαλάσσης; Matthew 10:14, shake off the dust of your feet).")))

(lemma "ἕκτος"
  (sense sixth
    (gloss "sixth")
    (why "The ordinal \"sixth\".")))

(lemma "ἐκτός" (sense outside-of (genitive "") (gloss "outside of") (why "Outside, with the genitive (Exodus 9:33 ἐκτὸς τῆς πόλεως, Moses going out of the city to pray; 1 Corinthians 6:18; 2 Corinthians 12:2). \"Outside of\" keeps it apart from ἔξω and ἔξωθεν \"outside\". Not ἕκτος \"sixth\", the same letters with another accent.")))

(lemma "ἐκτρέφω" (sense rear (gloss "rear" "reared" "rears" "rearing") (why "To feed fully, nourish, bring up (Genesis 47:17, Joseph reared the Egyptians with bread for that year; Ephesians 5:29; 6:4). \"Rear\" keeps it apart from τρέφω \"nourish\" and διατρέφω.")))

(lemma "ἐκτρίβω" (sense rub-out (gloss "rub out" "rubbed out" "rubs out" "rubbing out") (verb "rub out" "rubbed out" "rubbed out") (why "(LXX, supplied.) To rub out, wipe away completely, destroy (Genesis 19:13-14, 29, the angels' word for what they will do to Sodom). \"Rub out\" keeps its picture and keeps it apart from ἀπόλλυμι \"destroy\", ἀπαλείφω \"wipe out\" and ἐξαλείφω \"blot out\".")))

(lemma "ἐκτυπόω" (sense figure (gloss "figure" "figured" "figures" "figuring") (why "(LXX, supplied.) To model in relief, work into a figure (from τύπος \"pattern\"): the lampstand's bowls ἐκτετυπωμένοι καρυίσκους, \"figured [into] little nuts\" (Exodus 25:33-34). \"Figure\" keeps it apart from τορευτός \"embossed\", πλάσσω \"form\" and εἶδος \"shape\".")))

(lemma "ἐκτύπωμα" (sense figured-work (gloss "figured work" "figured works") (plural "figured works") (why "(LXX, supplied.) A thing worked in relief, a figure (ἐκτυπόω \"figure\"): on the gold plate, ἐκτυπώσεις ἐν αὐτῷ ἐκτύπωμα σφραγῖδος \"you will figure on it figured work of seal\" (Exodus 28:36; 36:38). Kept with its verb. Use this English in every tabernacle chapter.")))

(lemma "ἐκτυφλόω" (sense make-blind (verb "make blind" "made blind" "made blind") (gloss "make blind" "made blind" "makes blind" "making blind") (why "(LXX, supplied.) To blind utterly (Exodus 23:8 τὰ γὰρ δῶρα ἐκτυφλοῖ ὀφθαλμοὺς βλεπόντων). \"Make blind\" because the adjective τυφλός has \"blind\".")))

(lemma "ἐκφέρω"
  (sense bring-forth
    (gloss "bring forth" "brought forth" "brings forth" "bringing forth")
    (why "To carry out, bring forth; of the earth, to produce (Genesis 1:12; Hebrews 6:8). \"Bring forth\" keeps it apart from ἐξάγω \"bring out\". The sense \"carry out\" (a corpse, Acts 5:6) becomes its own sense.")))

(lemma "ἐκχέω" (sense pour-out (gloss "pour out" "poured out" "pours out" "pouring out") (why "To pour out, shed (Genesis 9:6, ὁ ἐκχέων αἷμα ἀνθρώπου, of blood; Matthew 26:28; Acts 2:17, of the Spirit). \"Pour out\" serves blood, wine and the Spirit alike; \"shed\" is a reading.")))

(lemma "ἑκουσίως" (sense voluntarily (gloss "voluntarily") (why "Of one's own will, voluntarily (Exodus 36:2, all those ἑκουσίως βουλομένους to come to the work; Hebrews 10:26; 1 Peter 5:2). The adverb of ἑκούσιος; \"voluntarily\" keeps it apart from ἑκών \"willing\".")))

(lemma "ἑκών" (sense willing (gloss "willing") (why "Willing, of one's own will, on purpose (Exodus 21:13, ὁ δὲ οὐχ ἑκών, the one who killed not of his own will; Romans 8:20; 1 Corinthians 9:17). (LXX form supplied.)")))

(lemma "ἐλαία" (sense olive (gloss "olive" "olives") (why "The olive tree, and its fruit (Genesis 8:11, a leaf of olive; Romans 11:17, 24; the Mount of Olives, Matthew 21:1).")))

(lemma "ἔλαιον" (sense oil (gloss "oil") (why "Olive oil (Genesis 28:18, Jacob pours oil on the stone; Luke 10:34; Hebrews 1:9). (LXX form supplied.)")))

(lemma "ἐλαιών" (sense olive-grove (gloss "olive grove" "olive groves") (why "A planting of olive trees, an olive grove (Exodus 23:11 τὸν ἐλαιῶνά σου; Acts 1:12, the mount called Ἐλαιῶνος, \"Olivet\"). Kept apart from ἐλαία \"olive\".")))

(lemma "ἐλάσσων"
  (sense lesser
    (gloss "lesser")
    (why "Smaller, lesser (Genesis 1:16; John 2:10; Romans 9:12, \"the greater will serve the lesser\" from Genesis 25:23, where traditional English says \"the younger\").")))

(lemma "ἐλάτη" (sense fir (gloss "fir" "firs") (why "(LXX, supplied.) A fir tree (Genesis 21:15, ὑποκάτω μιᾶς ἐλάτης), where the Hebrew has a bush.")))

(lemma "ἐλαττονέω" (sense have-less (intransitive) (verb "have less" "had less" "had less") (gloss "have less" "had less" "has less" "having less") (why "To have less, fall short (Exodus 16:18, the one with the less did not have less; quoted in 2 Corinthians 8:15). From ἐλάττων \"less\"; kept apart from ἐλαττονόω \"diminish\".")))

(lemma "ἐλαττονόω" (sense diminish (voice active) (intransitive) (gloss "diminish" "diminished" "diminishes" "diminishing") (why "(LXX, supplied.) To make less; passive, to become less, diminish (Genesis 8:3, 5, the water was diminishing; 18:28). The passive is rendered as the intransitive \"diminish\". Kept apart from ἐλάσσων \"less\" by the verb form.")))

(lemma "ἐλαύνω"
  (sense drive
    (verb "drive" "drove" "driven")
    (gloss "drive" "drove" "driven" "drives" "driving")
    (why "To drive, drive on; of a ship, to be driven or to row (Luke 8:29; James 3:4; Mark 6:48; John 6:19)."))
  (sense beat-out
    (verb "beat out" "beat out" "beaten out")
    (gloss "beat out" "beaten out" "beats out" "beating out")
    (why "(LXX, supplied.) Of metal, to beat out, forge by hammering (Exodus 25:12, ἐλάσεις αὐτῇ τέσσαρες δακτυλίους χρυσοῦς, rings for the ark; so ἐλατός \"beaten\" of beaten work). Chosen by word override where metal is worked.")))

(lemma "ἐλαφρός" (sense lightweight (gloss "lightweight") (why "Light in weight, easy to bear (Exodus 18:26, πᾶν δὲ ῥῆμα ἐλαφρόν, the light cases the judges kept; Matthew 11:30; 2 Corinthians 4:17). \"Lightweight\" because φῶς has \"light\".")))

(lemma "Ἐλεάζαρ" (sense name (gloss "Eleazar") (why "Aaron's third son and successor as priest (Exodus 6:23, 25; Swete accents Ἐλεαζάρ); Matthew 1:15 Ἐλεάζαρ is another man of the same name. Traditional English Eleazar.")))

(lemma "ἐλέγχω" (sense reprove (gloss "reprove" "reproved" "reproves" "reproving") (why "To bring to account, reprove, rebuke (Genesis 21:25 ἤλεγξεν Ἀβραὰμ τὸν Ἀβιμέλεχ; Matthew 18:15; John 16:8).")))

(lemma "ἐλεέω" (sense have-mercy (verb "have mercy on" "had mercy on" "had mercy on") (gloss "have mercy on" "had mercy on" "has mercy on" "having mercy on") (why "To have mercy on, pity (Genesis 43:29 Ὁ θεὸς ἐλεήσαι σε, τέκνον, \"May God have mercy on you, child\"; Matthew 9:27; Romans 9:15). The verb of ἔλεος \"mercy\".")))

(lemma "ἐλεημοσύνη" (sense kindness (gloss "kindness") (why "Mercy shown, a kindness done (Genesis 47:29 ποιήσεις ἐπ’ ἐμὲ ἐλεημοσύνην καὶ ἀλήθειαν, \"you will do upon me kindness and truth\"). \"Kindness\" keeps it apart from ἔλεος \"mercy\". The New Testament's \"alms\" (Matthew 6:2-4; Acts 10:2) may become its own sense.")))

(lemma "ἐλεήμων" (sense merciful (gloss "merciful") (why "Merciful, compassionate (Exodus 22:27 ἐλεήμων γάρ εἰμι; Matthew 5:7; Hebrews 2:17). The adjective of ἔλεος and ἐλεέω \"have mercy on\".")))

(lemma "Ἐλεισάβεθ" (sense name (gloss "Elisheba") (why "(LXX, supplied.) Aaron's wife, daughter of Amminadab and sister of Nahshon (Exodus 6:23), Greek Ἐλεισάβεθ for the Hebrew Elisheba; traditional English Elisheba. Luke 1:5 Ἐλισάβετ, Elizabeth \"of the daughters of Aaron\", bears the same name: whether the two share one English (rule 8) is for the owner.")))

(lemma "ἔλεος" (sense mercy (gloss "mercy") (why "Mercy.")))

(lemma "Ἐλιάβ" (sense name (gloss "Eliab") (why "(LXX, supplied.) Bezalel's fellow craftsman, son of Ahisamach, of Dan (Exodus 31:6; 35:34; 36:1-2; 38:23). The Hebrew name is Oholiab; Swete's Greek gives Ἐλιάβ, which is the Greek of a different Hebrew name, Eliab (Numbers 1:9, Eliab son of Helon). Rule 8: where the Greek gives a different name the English follows the Greek (as Μαθουσαλά for Methushael), so \"Eliab\". The owner may prefer Oholiab; if so change this gloss only.")))

(lemma "ἐλεύθερος" (sense free (gloss "free") (why "Free, not a slave (Exodus 21:2, the Hebrew slave goes out free in the seventh year; 21:26-27; John 8:36; Galatians 4:22-31). (LXX form supplied.)")))

(lemma "Ἐλιέζερ" (sense name (gloss "Eliezer") (why "Abram's house-born heir (Genesis 15:2); also the name in Luke 3:29. Traditional English Eliezer.")))

(lemma "ἕλιξ" (sense tendril (gloss "tendril" "tendrils") (why "(LXX, supplied.) Anything coiled; the tendril of a vine (Genesis 49:11, the colt bound τῇ ἕλικι).")))

(lemma "Ἐλισά" (sense name (gloss "Elishah") (why "(LXX, supplied.) Javan's son (Genesis 10:4), traditional English Elishah. The Greek of 10:2 also lists Ἐλισά among Japheth's sons, where the Hebrew has no such name.")))

(lemma "Ἐλισαφάν" (sense name (gloss "Elzaphan") (why "(LXX, supplied.) A son of Uzziel, Kohath's grandson (Exodus 6:22), Greek Ἐλισαφάν; the Hebrew has Elzaphan here (Elizaphan at Numbers 3:30), so the traditional English at Exodus 6:22, Elzaphan.")))

(lemma "Ἐλιφάς" (sense name (gloss "Eliphaz") (why "(LXX, supplied.) Esau's firstborn, by Adah (Genesis 36:4, 10-16), Greek Ἐλιφάς; traditional English Eliphaz.")))

(lemma "ἕλκος" (sense sore (gloss "sore" "sores") (why "A sore, an ulcer (Exodus 9:9-11, the sores of the sixth plague, ἕλκη, φλυκτίδες ἀναζέουσαι; Luke 16:21; Revelation 16:2, 11).")))

(lemma "Ἐλκανά" (sense name (gloss "Elkanah") (why "(LXX, supplied.) A son of Korah (Exodus 6:24), Greek Ἐλκανά; traditional English Elkanah, the name also of Samuel's father (1 Kingdoms 1:1).")))

(lemma "Ἐλμωδάδ"(sense name (gloss "Almodad") (why "(LXX, supplied.) A son of Joktan (Genesis 10:26), Greek Ἐλμωδάδ; traditional English Almodad.")))

(lemma "Ἐλλασάρ" (sense name (gloss "Ellasar") (why "(LXX, supplied.) Arioch's kingdom (Genesis 14:1, 9); traditional English Ellasar.")))

(lemma "ἕλος" (sense marsh (dative "in") (gloss "marsh" "marshes") (why "(LXX, supplied.) A marsh, a reed bed by a river (Exodus 2:3 εἰς τὸ ἕλος παρὰ τὸν ποταμόν; 2:5 ἐν τῷ ἕλει).")))

(lemma "ἐλπίζω" (sense hope (gloss "hope" "hoped" "hopes" "hoping") (why "To hope.")))

(lemma "Ἐλώμ" (sense name (gloss "Elon") (why "(LXX, supplied.) Elon the Hittite, father of Esau's wife Adah (Genesis 36:2), Greek Ἐλώμ; traditional English Elon (as Αἰλώμ at 26:34).")))

(lemma "ἐμαυτοῦ"(sense myself (gloss "myself") (why "The first person reflexive, myself (Genesis 12:19, \"I took her to myself for wife\"; John 5:31).")))

(lemma "ἐμβάλλω" (sense throw-in (verb "throw in" "threw in" "thrown in") (gloss "throw in" "threw in" "thrown in" "throws in" "throwing in") (why "To throw in, cast into (Genesis 39:20, Joseph into the stronghold; 40:15; Luke 12:5 ἐμβαλεῖν εἰς τὴν γέενναν). \"Throw in\" with ῥίπτω \"throw\" and περιβάλλω \"throw around\"; ἐκβάλλω is \"cast out\".")))

(lemma "Ἐμμώρ" (sense name (gloss "Hamor") (why "(LXX, supplied.) Father of Shechem, the Hivite ruler (Genesis 33:19; 34), Greek Ἐμμώρ (Swete's smooth breathing; Acts 7:16 Ἑμμώρ); traditional English Hamor.")))

(lemma "ἐμός" (sense my (gloss "my") (why "The possessive adjective \"my\" (Genesis 22:18 τῆς ἐμῆς φωνῆς; John 4:34). It shares \"my\" with the genitive μου, the same meaning in another form."))
  (sense mine (gloss "mine") (why "The possessive standing alone as predicate, \"mine\" (Exodus 19:5 and 23:22 ἐμὴ γάρ ἐστιν πᾶσα ἡ γῆ; John 17:10 τὰ ἐμὰ πάντα σά ἐστιν). \"My\" needs a noun after it. Chosen by word override.")))

(lemma "ἐμπαίζω" (sense mock (dative "") (gloss "mock" "mocked" "mocks" "mocking") (why "To play with, make sport of, mock, with the dative (Genesis 39:14, 17 ἐμπαίζειν ἡμῖν; Matthew 20:19; 27:29). Kept apart from παίζω \"play\".")))

(lemma "ἐμπίπλημι" (sense fill-full (genitive "with") (verb "fill full" "filled full" "filled full") (gloss "fill full" "filled full" "fills full" "filling full") (why "To fill full, fill up, with the genitive of the filling (Genesis 42:25 ἐμπλῆσαι τὰ ἄγγια αὐτῶν σίτου; Luke 1:53; Acts 14:17). \"Fill full\" keeps it apart from πίμπλημι \"fill\" and ἀναπληρόω \"fill up\".")))

(lemma "ἐμπίπτω" (sense fall-in (verb "fall in" "fell in" "fallen in") (gloss "fall in" "fell in" "fallen in" "falls in" "falling in") (why "To fall in, fall into (Genesis 14:10, the kings fell in there, into the asphalt pits; Matthew 12:11; Luke 10:36). Kept apart from πίπτω \"fall\" and ἐπιπίπτω \"fall upon\".")))

(lemma "ἐμπλατύνω" (sense widen (gloss "widen" "widened" "widens" "widening") (why "(LXX, supplied.) To make broad, widen (Exodus 23:18 ἐμπλατύνω τὰ ὅριά σου, \"I widen your borders\"). Kept apart from the simple πλατύνω \"enlarge\".")))

(lemma "ἐμπλόκιον" (sense braid (gloss "braid" "braids") (why "(LXX, supplied.) A plaited thing, a braided ornament for the hair (ἐμπλέκω \"plait in\"; compare ἐμπλοκή, 1 Peter 3:3): among the gold the people brought (Exodus 35:22). Kept apart from ἐνώτιον \"earring\", δακτύλιος \"ring\" and περιδέξιον \"armlet\". Tabernacle term.")))

(lemma "ἐμποιέω" (sense lay-claim (genitive "to") (verb "lay claim" "laid claim" "laid claim") (gloss "lay claim" "laid claim" "lays claim" "laying claim") (why "(LXX, supplied.) Middle: to make a thing one's own, lay claim to, with the genitive (Exodus 9:17 ἔτι οὖν σὺ ἐνποιῇ τοῦ λαοῦ μου, Pharaoh still claiming the people; Swete spells it ἐν-). The middle is rendered active.")))

(lemma "ἐμπορεύομαι" (sense trade (gloss "trade" "traded" "trades" "trading") (why "To travel as a merchant, trade, trade in (Genesis 34:10, 21; James 4:13; 2 Peter 2:3 with an accusative). The verb of ἔμπορος \"merchant\".")))

(lemma "ἔμπορος" (sense merchant (person) (gloss "merchant" "merchants") (why "A merchant, trader (Genesis 23:16, silver approved ἐμπόροις, Swete's ἐνπόροις; Matthew 13:45; Revelation 18:3).")))

(lemma "ἔμπροσθεν" (sense ahead-of (gloss "ahead of") (why "In front of, ahead of, with the genitive (Genesis 24:7, the angel sent ἔμπροσθέν σου; Matthew 11:10; John 3:28, \"sent ahead of him\"). \"Ahead of\" keeps it apart from ἐναντίον \"in front of\", ἐνώπιον \"in sight of\" and πρό \"before\".")))

(lemma "ἐμπρόσθιος" (sense front (gloss "front") (why "(LXX, supplied.) In front, foremost (ἔμπροσθεν \"ahead of\"): κατὰ τὰς παρωμίδας αὐτῶν ἐκ τῶν ἐμπροσθίων \"on their shoulder-straps from the front [parts]\" (Exodus 28:14).")))

(lemma "ἐμφανής" (sense visible (gloss "visible") (why "Visible, manifest, in plain view (Exodus 2:14 Εἰ οὕτως ἐμφανὲς γέγονεν τὸ ῥῆμα τοῦτο; Acts 10:40 ἐμφανῆ γενέσθαι; Romans 10:20 ἐμφανὴς ἐγενόμην). \"Visible\" keeps it apart from διάδηλος \"evident\" and the verb ἐπιφαίνω \"manifest\".")))

(lemma "ἐμφανίζω" (sense disclose (dative "to") (gloss "disclose" "disclosed" "discloses" "disclosing") (why "To make visible, show plainly, reveal; of persons, to show oneself (Exodus 33:13, 18, ἐμφάνισόν μοι σεαυτόν, Moses to the Lord; John 14:21-22; Acts 23:15, to inform). \"Disclose\" keeps it apart from ἐμφανής \"visible\", ἐπιφαίνω \"manifest\" and δείκνυμι \"show\".")))

(lemma "ἐμφράσσω" (sense stop-up (gloss "stop up" "stopped up" "stops up" "stopping up") (why "To block, stop up (Genesis 26:15, 18, the Philistines stopped up the wells; Romans 3:19 and Hebrews 11:33 φράσσω, \"stop\" a mouth).")))

(lemma "ἐμφυσάω"
  (sense breathe
    (gloss "breathe" "breathed" "breathes" "breathing")
    (why "To breathe into or on. Rare: in the New Testament only John 20:22, where Jesus ἐνεφύσησεν on the disciples and says \"Receive the Holy Spirit\", the same verb God uses in Genesis 2:7. One gloss keeps the echo.")))

(lemma "ἐν"
  (sense in
    (gloss "in")
    (why "Location in, among or within, of place or time. The instrumental use (\"with, by\") becomes its own sense when first needed.")))

(lemma "ἐναλλάξ" (sense crosswise (gloss "crosswise") (why "(LXX, supplied.) Alternately, crosswise (Genesis 48:14 ἐναλλὰξ τὰς χεῖρας, Israel crossing his hands, the right on the younger's head).")))

(lemma "ἔναντι" (sense in-front-of (gloss "in front of") (why "In front of, before, with the genitive (Exodus 6:12 ἐλάλησεν δὲ Μωυσῆς ἔναντι Κυρίου; Luke 1:8; Acts 8:21). It shares \"in front of\" with ἐναντίον, the same word in another form, as σός shares \"your\" with σου.")))

(lemma "ἐναντίον" (sense in-front-of (gloss "in front of") (why "Facing, before, in the presence of, with the genitive (Genesis 6:8, 11, 13; Luke 1:6; Acts 8:32). \"In front of\" to keep it apart from πρό \"before\" and κατέναντι \"opposite\"; ἔμπροσθεν will need its own English (\"in front\" is the natural word for it too). Not \"in the presence of\", which would put an unbracketed \"the\" in the text.")))

(lemma "ἐναντίος" (sense opposite (gloss "opposite") (why "Opposite, facing; ἐξ ἐναντίας, \"from opposite\", over against (Exodus 14:2, 9, ἐξ ἐναντίας Βεελσεπφών; Mark 15:39, the centurion standing opposite him). Shares \"opposite\" with the adverb κατέναντι; the sense \"contrary\" (Acts 27:4, contrary winds) can be its own sense.")))

(lemma "ἐνάρχομαι" (sense commence (gloss "commence" "commenced" "commences" "commencing") (why "To begin, make a beginning (Exodus 12:18 ἐναρχομένου τῇ τεσσαρεσκαιδεκάτῃ ἡμέρᾳ, \"commencing on the fourteenth day\"; Galatians 3:3; Philippians 1:6). \"Commence\" keeps it apart from ἄρχω \"begin\".")))

(lemma "ἐνδείκνυμι" (sense display (gloss "display" "displayed" "displays" "displaying") (why "(LXX form supplied.) Middle: to show forth, display, do to someone (Genesis 50:15, 17, the evils the brothers ἐνεδείξαντο to Joseph; Romans 9:17; 2 Corinthians 8:24; 2 Timothy 4:14). \"Display\" because δείκνυμι has \"show\".")))

(lemma "ἕνδεκα" (sense eleven (gloss "eleven") (why "The numeral eleven, indeclinable (Genesis 32:22 τὰ ἕνδεκα παιδία αὐτοῦ; Matthew 28:16).")))

(lemma "ἑνδέκατος" (sense eleventh (gloss "eleventh") (why "(LXX, supplied.) The ordinal \"eleventh\" (Genesis 8:5, the eleventh month; Matthew 20:6, 9, the eleventh hour).")))

(lemma "ἐνδελεχισμός" (sense continuance (gloss "continuance") (why "(LXX, supplied.) Continuance, what is done without break (ἐνδελεχής \"continual\"): κάρπωμα ἐνδελεχισμοῦ \"fruit offering of continuance\", θυσία ἐνδελεχισμοῦ (Exodus 29:38, 42; 30:8), the daily offering. Kept with the adverb ἐνδελεχῶς \"continually\". Use this English in every tabernacle chapter.")))

(lemma "ἐνδελεχῶς" (sense continually (gloss "continually") (why "(LXX, supplied.) Continually, without break: two lambs a day ἐπὶ τὸ θυσιαστήριον ἐνδελεχῶς (Exodus 29:38). Kept with ἐνδελεχισμός \"continuance\"; διὰ παντός is \"through all\".")))

(lemma "ἐνδέω" (sense tie-up (verb "tie up" "tied up" "tied up") (gloss "tie up" "tied up" "ties up" "tying up") (why "(LXX, supplied.) To bind in, tie up in something (Exodus 12:34 τὰ φυράματα αὐτῶν ἐνδεδεμένα ἐν τοῖς ἱματίοις αὐτῶν, their lumps tied up in their garments). \"Tie up\" keeps it apart from δεσμεύω \"bind\" and συνδέω.")))

(lemma "ἐνδίδωμι" (sense give-way (intransitive) (gloss "give way" "gave way" "given way" "gives way" "giving way") (why "(LXX, supplied.) To give in, yield, give way (Genesis 8:3, the water was giving way, going from the earth: it was receding). \"Give way\" keeps the root δίδωμι \"give\".")))

(lemma "ἐνδοξάζω" (sense glorify (gloss "glorify" "glorified" "glorifies" "glorifying") (why "To glorify; passive, to be glorified, get glory in or over (Exodus 14:4, 17-18, ἐνδοξασθήσομαι ἐν Φαραώ; 2 Thessalonians 1:10, 12). Kin to ἔνδοξος \"glorious\". The simple δοξάζω is not yet in the concordance; if it takes \"glorify\", one of the two needs another word.")))

(lemma "ἔνδοξος" (sense glorious (gloss "glorious") (why "Held in honor, glorious, splendid (Genesis 34:19 ἐνδοξότατος, \"most glorious\" of all in his father's house; Luke 7:25; Ephesians 5:27).")))

(lemma "ἐνδόξως" (sense gloriously (gloss "gloriously") (why "(LXX, supplied.) Gloriously, in a glorious way (Exodus 15:1, 21 ἐνδόξως γὰρ δεδόξασται); the adverb of ἔνδοξος \"glorious\".")))

(lemma "ἐνδόσθια" (sense entrails (plural "entrails") (gloss "entrails") (why "(LXX, supplied.) The inner parts, entrails (ἔνδοσθεν \"within\"), always plural (Exodus 12:9, the Passover lamb roasted whole, head with the feet and the entrails).")))

(lemma "ἐνδύω"
  (sense clothe
    (gloss "clothe" "clothed" "clothes" "clothing")
    (why "(Supplied in Genesis 3:21.) Active: to clothe someone; middle: to put on, clothe oneself (Romans 13:14; Galatians 3:27). \"Clothe\" for both so the image of being clothed carries across.")))

(lemma "ἕνεκα"
  (sense on-account-of
    (gloss "on account of")
    (why "Cause: \"on account of\" (ἕνεκεν τούτου, Genesis 2:24; Matthew 19:5 has ἕνεκα τούτου). Kept apart from διὰ τοῦτο, which will take \"because of this\".")))

(lemma "ἐνενήκοντα" (sense ninety (gloss "ninety") (why "The numeral ninety (Genesis 5:9, 17; Matthew 18:12, ἐνενήκοντα ἐννέα).")))

(lemma "ἐνευλογέω" (sense bless (gloss "bless" "blessed" "blesses" "blessing") (why "To bless in someone (Genesis 18:18 ἐνευλογηθήσονται ἐν αὐτῷ, quoted in Galatians 3:8; Acts 3:25). It shares \"bless\" with εὐλογέω: the compound's ἐν- is repeated by the ἐν that follows it, and \"bless in\" would print \"blessed in in him\". The alignment shows which verb stands behind it.")))

(lemma "ἐνεχυράζω" (sense take-as-security (verb "take as security" "took as security" "taken as security") (gloss "take as security" "took as security" "taken as security" "takes as security" "taking as security") (why "(LXX, supplied.) To take a pledge from a debtor, take as security (Exodus 22:26 ἐὰν δὲ ἐνεχύρασμα ἐνεχυράσῃς τὸ ἱμάτιον τοῦ πλησίον). \"Security\" because ἀρραβών has \"pledge\"; the noun ἐνεχύρασμα is \"security\" too, so the Greek's repetition shows.")))

(lemma "ἐνεχύρασμα" (sense security (gloss "security" "securities") (why "(LXX, supplied.) A thing taken in pledge, security for a loan (Exodus 22:26 ἐνεχύρασμα ἐνεχυράσῃς, the cognate object of ἐνεχυράζω \"take as security\"). \"Security\" because ἀρραβών has \"pledge\".")))

(lemma "ἐνέχω" (sense press-hard (dative "upon") (verb "press hard" "pressed hard" "pressed hard") (gloss "press hard" "pressed hard" "presses hard" "pressing hard") (why "(LXX form supplied.) With the dative, to set oneself against, press hard upon, hold a grudge (Genesis 49:23 ἐνεῖχον αὐτῷ κύριοι τοξευμάτων; Mark 6:19; Luke 11:53 δεινῶς ἐνέχειν). The passive \"be held in\" (Galatians 5:1) will be its own sense.")))

(lemma "ἔνθεν" (sense from-this-side (gloss "from this side") (why "From here, on this side; doubled, ἔνθεν καὶ ἔνθεν, on this side and on that (Exodus 26:13; 25:18 is ἐξ ἀμφοτέρων; John 19:18 ἐντεῦθεν καὶ ἐντεῦθεν; Luke 16:26 ἔνθεν). \"From this side\" keeps it apart from ἐντεῦθεν \"from here\".")))

(lemma "ἐνθέμιον" (sense inset (gloss "inset" "insets") (why "(LXX, supplied.) Something set in (ἐντίθημι \"put in\"), the socket or cup set on the lampstand's branches to hold the lamps: τὰ ἐνθέμια ... ἵνα ὦσιν ἐπ’ αὐτῶν οἱ λύχνοι (Exodus 37:19-22). The exact shape is uncertain; \"inset\" says only what the Greek word does. Tabernacle term.")))

(lemma "ἐνθυμέομαι" (sense ponder (gloss "ponder" "pondered" "ponders" "pondering") (why "To take to heart, ponder, think over (Genesis 6:6; Matthew 1:20; 9:4). \"Ponder\" to keep it apart from διανοέομαι \"think through\", which follows it in Genesis 6:6.")))

(lemma "ἐνιαύσιος" (sense yearling (gloss "yearling" "yearlings") (why "(LXX, supplied.) A year old, of a year (ἐνιαυτός \"year\"): of a sacrificial animal (Exodus 12:5 πρόβατον τέλειον ἄρσεν ἐνιαύσιον, \"perfect male yearling sheep\"; Leviticus and Numbers passim). \"Yearling\" keeps it one word.")))

(lemma "ἐνιαυτός"
  (sense year
    (with-preposition "εἰς" for)
    (gloss "year" "years")
    (why "A year, a cycle of seasons (Genesis 1:14; Luke 4:19). ἔτος, the other word for year, will be distinguished in a note if needed.")))

(lemma "ἐνισχύω" (sense strengthen (gloss "strengthen" "strengthened" "strengthens" "strengthening") (why "To strengthen (Luke 22:43; Acts 9:19), and intransitively to grow strong, prevail (Genesis 12:10, the famine strengthened over the land). One English verb for both; English \"strengthen\" is also intransitive.")))

(lemma "ἐννακόσιοι" (sense nine-hundred (gloss "nine hundred") (why "(LXX, supplied.) The numeral nine hundred (Genesis 5). Swete spells it ἐννακόσιοι, with double ν.")))

(lemma "ἐννέα" (sense nine (gloss "nine") (why "The numeral nine (Genesis 5:27; Luke 17:17).")))

(lemma "ἐνοράω" (sense observe (gloss "observe" "observed" "observes" "observing") (why "(LXX, supplied.) To look into, observe, see something in a matter (Genesis 20:10 Τί ἐνιδὼν ἐποίησας τοῦτο; \"Having observed what did you do this?\"). Kept apart from ὁράω \"see\".")))

(lemma "ἐνοχλέω" (sense ail (voice active) (intransitive) (gloss "ail" "ailed" "ails" "ailing") (why "To trouble, disturb; passive, to be troubled, be unwell (Genesis 48:1 Ὁ πατήρ σου ἐνοχλεῖται, \"Your father ails\", Jacob's last illness). The passive is rendered active, \"ail\", which keeps it apart from ταράσσω \"trouble\". The active of Hebrews 12:15 (\"trouble\") will be its own sense. (LXX form supplied.)")))

(lemma "ἔνοχος" (sense liable (genitive "to") (gloss "liable") (why "Held in, liable, subject to, with the genitive of the penalty (Genesis 26:11 θανάτου ἔνοχος ἔσται, \"to death liable will be\"; Matthew 26:66; Hebrews 2:15).")))

(lemma "ἐνταῦθα" (sense here (gloss "here") (why "(LXX, supplied.) Here, in this place (Genesis 48:9, the sons whom God gave me here). It shares \"here\" with ὧδε, unavoidably: English has one plain word for both; the alignment shows which Greek word stands behind it.")))

(lemma "ἐνταφιάζω" (sense embalm (gloss "embalm" "embalmed" "embalms" "embalming") (why "(LXX form supplied.) To prepare a body for burial; in Egypt, to embalm (Genesis 50:2-3, Jacob embalmed by Joseph's physicians; Matthew 26:12; John 19:40).")))

(lemma "ἐνταφιαστής" (sense embalmer (person) (gloss "embalmer" "embalmers") (why "(LXX, supplied.) One who prepares bodies for burial, an embalmer (Genesis 50:2, Joseph's servants οἱ ἐνταφιασταί). The noun of ἐνταφιάζω.")))

(lemma "ἐντέλλομαι"
  (sense command
    (dative "")
    (gloss "command" "commanded" "commands" "commanding")
    (why "To command, give an order (Genesis 2:16; 3:11, 17; Matthew 28:20). The noun ἐντολή will take \"commandment\".")))

(lemma "ἐντρέπω" (sense respect (voice active) (gloss "respect" "respected" "respects" "respecting") (why "Passive with an accusative: to turn toward in shame, respect, defer to (Exodus 10:3 Ἕως τίνος οὐ βούλει ἐντραπῆναί με; \"until when do you not want to respect me?\"; Matthew 21:37 ἐντραπήσονται τὸν υἱόν μου; Luke 18:2). The active \"put to shame\" (1 Corinthians 4:14) will be its own sense.")))

(lemma "ἐνυπνιάζομαι" (sense dream (gloss "dream" "dreamed" "dreams" "dreaming") (why "To dream (Genesis 28:12, Jacob at Bethel; Acts 2:17 quoting Joel 2:28; Jude 8). The aorist is passive in form, rendered active. (LXX form supplied.)")))

(lemma "ἐνυπνιαστής" (sense dreamer (person) (gloss "dreamer" "dreamers") (why "(LXX, supplied.) A dreamer, one given to dreams (Genesis 37:19, the brothers: Ἰδοὺ ὁ ἐνυπνιαστὴς ἐκεῖνος ἔρχεται). Kept with ἐνυπνιάζομαι \"dream\" and ἐνύπνιον \"dream\".")))

(lemma "ἐνύπνιον" (sense dream (gloss "dream" "dreams") (why "A dream (Genesis 37:5-10; 40:5-16; 41; Acts 2:17 quoting Joel 2:28). The noun of ἐνυπνιάζομαι, which shares \"dream\" as its verb: one English word for the noun and its verb.")))

(lemma "ἔντερον" (sense bowel (gloss "bowel" "bowels") (why "(LXX, supplied.) The intestines, bowels, as the seat of feeling (Genesis 43:30 συνεστρέφετο γὰρ τὰ ἔντερα αὐτοῦ ἐπὶ τῷ ἀδελφῷ αὐτοῦ). Kept apart from σπλάγχνα (Philippians 1:8) and κοιλία \"belly\".")))

(lemma "ἐντεῦθεν" (sense from-here (gloss "from here") (why "(LXX form supplied.) From this place, from here (Genesis 50:25, carry my bones from here; John 2:16; 7:3; Luke 4:9).")))

(lemma "ἐντολή" (sense commandment (gloss "commandment" "commandments") (why "A command, commandment (Genesis 26:5; Matthew 22:36-40). \"Commandment\" beside the verb ἐντέλλομαι \"command\".")))

(lemma "ἐνώπιον" (sense in-sight-of (gloss "in sight of") (why "Before, in the sight of, with the genitive (Genesis 11:28, Haran died in sight of Terah his father; Luke 1:15, 19). \"In sight of\" keeps it apart from πρό \"before\" and ἐναντίον \"in front of\"; not \"in the sight of\", which would put an unbracketed \"the\" in the text."))
  (sense in-sight
    (gloss "in sight")
    (why "Without a genitive, as an adverb: openly, face to face (Genesis 16:13-14 ἐνώπιον ἴδον, \"in sight I saw\"). A word override chooses it.")))

(lemma "Ἐνώς" (sense name (gloss "Enosh") (why "Traditional English form of Seth's son (Luke 3:38).")))

(lemma "ἐνώπιος" (sense presence (gloss "presence") (why "(LXX, supplied.) Facing, set in the presence (ἐν ὦπι, \"in the face\"): ἄρτους ἐνωπίους, the loaves set out before God on the table (Exodus 25:30), traditionally \"bread of the Presence\". The adjective goes before its noun, \"presence loaves\"; ἐνώπιον \"before\" is the preposition, and ἀπέναντι has \"facing\".")))

(lemma "ἐνώτιον" (sense earring (gloss "earring" "earrings") (why "(LXX, supplied.) An earring, or a ring for the nose or ear (Genesis 24:22, 30, 47, gifts to Rebekah). The word is from οὖς \"ear\".")))

(lemma "ἐνωτίζομαι" (sense give-ear (gloss "give ear" "gave ear" "gives ear" "giving ear") (why "To give ear to, listen closely (Acts 2:14).")))

(lemma "Ἑνώχ" (sense name (gloss "Enoch") (why "Traditional English form (Cain's son, Genesis 4:17; the other Enoch, Jude 14).")))

(lemma "ἕξ" (sense six (gloss "six") (why "Six.")))

(lemma "ἐξάγω"
  (sense bring-out
    (gloss "bring out" "brought out" "brings out" "bringing out")
    (why "To lead out, bring out (Genesis 1:20-24; Acts 7:36, Moses leading Israel out). Against ἐκφέρω \"bring forth\".")))

(lemma "ἐξαίρετος" (sense select (gloss "select") (why "(LXX, supplied.) Taken out from the rest, picked, select (Genesis 48:22 σίκιμα ἐξαίρετον, Shechem given to Joseph as a select portion beyond his brothers). From ἐξαιρέω \"take out\"; \"select\" keeps it apart from ἐκλεκτός \"choice\".")))

(lemma "ἐξαιρέω" (sense take-out (verb "take out" "took out" "taken out") (gloss "take out" "took out" "taken out" "takes out" "taking out") (why "To take out; middle, to take out for oneself, rescue (Genesis 32:11 ἐξελοῦ με ἐκ χειρὸς τοῦ ἀδελφοῦ μου; Acts 7:10, 34; 12:11; Matthew 5:29 ἔξελε). \"Take out\" because \"rescue\" is διασῴζω's and \"deliver\" ῥύομαι's.")))

(lemma "ἐξαίρω" (sense uplift (gloss "uplift" "uplifted" "uplifts" "uplifting") (why "To lift up and off, raise; to remove (Genesis 29:1 ἐξάρας Ἰακὼβ τοὺς πόδας, the setting out; 1 Corinthians 5:13 \"remove\"). \"Uplift\" keeps it apart from ἐπαίρω \"lift up\" and αἴρω \"lift\"; the sense \"remove\" may become its own."))
  (sense set-out (verb "set out" "set out" "set out") (gloss "set out" "sets out" "setting out") (why "Intransitive, with no object: to lift off (the tents), set out on a journey (Genesis 35:5 καὶ ἐξῆρεν Ἰσραὴλ ἐκ Σικίμων). \"Uplift\" with no object does not read; the form row gives this sense."))
  (sense remove (gloss "remove" "removed" "removes" "removing") (why "To take away, lift off and away, with an object that is carried off: sins (Exodus 28:38 ἐξαρεῖ Ἀαρὼν τὰ ἁμαρτήματα), a people led away (Exodus 15:22 Ἐξῆρεν Μωυσῆς τοὺς υἱοὺς Ἰσραήλ); 1 Corinthians 5:13 ἐξάρατε \"remove\". \"Uplift\" there reads as exalting or hoisting; chosen by word override.")))

(lemma "ἑξακόσιοι" (sense six-hundred (gloss "six hundred") (why "(LXX, supplied.) The numeral six hundred (Genesis 7:6, Noah was of six hundred years; Revelation 13:18; 14:20).")))

(lemma "ἑξακοσιοστός" (sense six-hundredth (gloss "six hundredth") (why "(LXX, supplied.) The ordinal \"six hundredth\" (Genesis 7:11; 8:13, ἐν τῷ ἑνὶ καὶ ἑξακοσιοστῷ ἔτει, \"in the one and six hundredth year\", kept word for word).")))

(lemma "ἐξαλείφω" (sense blot-out (verb "blot out" "blotted out" "blotted out") (gloss "blot out" "blotted out" "blots out" "blotting out") (why "To wipe out, blot out (Genesis 7:4, 23, of the flood; Acts 3:19, that your sins may be blotted out; Revelation 3:5). \"Blot out\" keeps it apart from ἀπαλείφω \"wipe out\" (Genesis 6:7), as that entry asked.")))

(lemma "ἐξαναλίσκω" (sense utterly-consume (verb "utterly consume" "utterly consumed" "utterly consumed") (gloss "utterly consume" "utterly consumed" "utterly consumes" "utterly consuming") (why "(LXX, supplied.) To use up entirely, destroy utterly (Exodus 32:12, ἐξαναλῶσαι αὐτοὺς ἀπὸ τῆς γῆς; 33:3, 5, ἵνα μὴ ἐξαναλώσω σε). ἀναλίσκω is \"consume\"; the added ἐξ- is \"utterly\", put first so the object follows the verb (\"utterly consume them\").")))

(lemma "ἐξανατέλλω"
  (sense cause-to-spring-up
    (verb "cause to spring up")
    (gloss "caused to spring up" "cause to spring up" "causes to spring up")
    (why "Transitive in Genesis 2:9 (God made every tree spring up out of the earth). Intransitive \"spring up\" (Matthew 13:5) becomes its own sense. Kept apart from ἀνατέλλω \"rise\" by the ἐξ- (\"spring up out\").")))

(lemma "ἐξανθέω" (sense blossom (intransitive) (gloss "blossom" "blossomed" "blossoms" "blossoming") (why "(LXX, supplied.) To burst into flower, blossom: the hem's little pomegranates ὡσεὶ ἐξανθούσης ῥόας \"as of blossoming pomegranate\" (Exodus 28:33).")))

(lemma "ἐξανίστημι" (sense raise-up (gloss "raise up" "raised up" "raises up" "raising up") (why "Transitive: to raise up (offspring), Genesis 4:25; Mark 12:19. Kept apart from ἀνίστημι \"stand up\"."))
  (sense get-up (verb "get up" "got up" "gotten up") (gloss "get up" "got up" "gotten up" "gets up" "getting up") (why "Intransitive (second aorist and middle): to get up, rise and set out (Genesis 18:16 Ἐξαναστάντες δὲ ἐκεῖθεν οἱ ἄνδρες; Acts 15:5). \"Get up\" because \"rise\" is ἀνατέλλω's and \"stand up\" ἀνίστημι's.")))

(lemma "ἐξαπατάω" (sense beguile (gloss "beguile" "beguiled" "beguiles" "beguiling") (why "To deceive thoroughly, beguile (Exodus 8:29, Moses to Pharaoh, do not add further to beguile; Romans 7:11; 2 Corinthians 11:3, the serpent beguiled Eve). \"Beguile\" keeps it apart from ἀπατάω \"deceive\".")))

(lemma "ἐξαποστέλλω"
  (sense send-out
    (gloss "send out" "sent out" "sends out" "sending out")
    (why "To send out, send away (Genesis 3:23; Luke 1:53; Galatians 4:4-6, God sent out his Son). Against ἀποστέλλω, which will take \"send\".")))

(lemma "ἐξάπτω" (sense light-up (verb "light up" "lit up" "lit up") (gloss "light up" "lit up" "lights up" "lighting up") (why "(LXX, supplied.) To kindle, light (Exodus 30:8 ὅταν ἐξάπτῃ Ἀαρὼν τοὺς λύχνους, \"when Aaron lights up the lamps\"). \"Light up\" renders the ἐξ- and keeps it apart from ἅπτω, whose active \"kindle\" is reserved.")))

(lemma "ἐξαριθμέω" (sense count (gloss "count" "counted" "counts" "counting") (why "(LXX, supplied.) To count out, count completely (Genesis 13:16, if anyone is able to count the sand of the earth). \"Count\" keeps it apart from ἀριθμέω \"number\" in the same verse.")))

(lemma "ἐξαρτίζω" (sense fit-out (verb "fit out" "fitted out" "fitted out") (gloss "fit out" "fitted out" "fits out" "fitting out") (why "To finish, fit out completely (2 Timothy 3:17 πρὸς πᾶν ἔργον ἀγαθὸν ἐξηρτισμένος; Acts 21:5): the shoulder-pieces ἐπὶ τοῖς δυσὶ μέρεσιν ἐξηρτισμέναι \"fitted out on the two parts\" (Exodus 28:7). \"Fit out\" keeps the sense of finished workmanship.")))

(lemma "ἐξάρχω" (sense strike-up (genitive "for") (verb "strike up" "struck up" "struck up") (gloss "strike up" "struck up" "strikes up" "striking up") (why "(LXX, supplied.) To begin, lead off, strike up a song for others to take up (Exodus 15:21 ἐξῆρχεν δὲ αὐτῶν Μαριάμ, \"but Miriam was striking up for them\"), with the genitive of those led. \"Strike up\" is the musical phrase; πατάσσω has \"strike\".")))

(lemma "ἐξεγείρω" (sense awake (voice active) (gloss "awake" "awoke" "awoken" "awakes" "awaking") (why "To rouse; passive, to wake up (Genesis 28:16 ἐξηγέρθη Ἰακὼβ ἀπὸ τοῦ ὕπνου αὐτοῦ). The passive is rendered active, \"awoke\". The active \"raise up\" (Romans 9:17) will be its own sense. (LXX form supplied.)")))

(lemma "ἐξεικονίζω" (sense form-fully (verb "form fully" "formed fully" "formed fully") (gloss "form fully" "formed fully" "forms fully" "forming fully") (why "(LXX, supplied.) To form completely, give full shape (εἰκών \"image\"); the perfect passive participle of an unborn child that is or is not yet fully formed (Exodus 21:22-23). Kept apart from πλάσσω \"form\".")))

(lemma "ἔξειμι" (sense come-out (intransitive) (verb "come out" "came out" "come out") (gloss "come out" "came out" "comes out" "coming out") (why "To go out (ἐκ + εἶμι \"go\"; Acts 13:42; 17:15; 20:7): Aaron's bells heard εἰσιόντι ... καὶ ἐξιόντι \"to [him] coming in ... and coming out\" (Exodus 28:35). \"Come out\", the pair of εἴσειμι \"come in\", kept apart from ἐξέρχομαι \"go forth\" and ἐκπορεύομαι \"go out\".")))

(lemma "ἐξελκύω" (sense draw-out (verb "draw out" "drew out" "drawn out") (gloss "draw out" "drew out" "drawn out" "draws out" "drawing out") (why "(LXX, supplied.) To draw out, haul out (Genesis 37:28, the merchants ἐξείλκυσαν Joseph out of the pit). The ἐξέλκω of James 1:14 is the same verb in its short form.")))

(lemma "ἐξερεύγομαι" (sense belch-out (verb "belch out" "belched out" "belched out") (gloss "belch out" "belched out" "belches out" "belching out") (why "(LXX, supplied.) To belch out, disgorge (Exodus 8:3 ἐξερεύξεται ὁ ποταμὸς βατράχους, the river will belch out frogs). Compare ἐρεύγομαι, Matthew 13:35 \"I will utter\".")))

(lemma "ἐξέρχομαι" (sense go-forth (intransitive) (gloss "go forth" "went forth" "goes forth" "going forth" "gone forth") (why "To go out, go forth. \"Go forth\" so as not to share \"go out\" with ἐκπορεύομαι.")))

(lemma "ἐξέχω" (sense jut-out (intransitive) (verb "jut out" "jutted out" "jutted out") (gloss "jut out" "jutted out" "juts out" "jutting out") (why "(LXX, supplied.) To stand out, project (ἐκ + ἔχω): the shoots ἐξέχοντες from the lampstand's small reeds, three on each side (Exodus 37:18). \"Jut out\" keeps it apart from ἐξέρχομαι \"go forth\" and ἐκτείνω.")))

(lemma "ἐξηγητής" (sense expounder (person) (gloss "expounder" "expounders") (why "(LXX, supplied.) One who explains, an expounder of signs and dreams (Genesis 41:8, 24, Pharaoh's ἐξηγηταί). From ἐξηγέομαι; \"expounder\" keeps it apart from ἑρμηνευτής \"interpreter\".")))

(lemma "ἑξήκοντα" (sense sixty (gloss "sixty") (why "The numeral sixty (Genesis 5; Matthew 13:8).")))

(lemma "ἑξῆς" (sense next (gloss "next") (why "In order, next, one after another (Exodus 10:1 ἵνα ἑξῆς ἐπέλθῃ τὰ σημεῖα ταῦτα, the signs coming in succession; Luke 7:11; Acts 21:1, τῇ ἑξῆς \"on the next [day]\").")))

(lemma "ἐξιλάσκομαι" (sense appease (gloss "appease" "appeased" "appeases" "appeasing") (why "(LXX, supplied.) To propitiate, appease (Genesis 32:20 Ἐξιλάσομαι τὸ πρόσωπον αὐτοῦ ἐν τοῖς δώροις). In the Law, to make atonement; that use may need its own sense. Compare ἱλάσκομαι (Luke 18:13; Hebrews 2:17).")))

(lemma "ἐξισόω" (sense make-equal (dative "to") (verb "make equal" "made equal" "made equal") (gloss "make equal" "made equal" "makes equal" "making equal") (why "(LXX, supplied.) To make equal, match (ἐκ + ἴσος \"equal\"); passive with the dative, the lampstand's shoots ἐξισούμενοι ἀλλήλοις, \"being made equal to one another\" (Exodus 37:18; 38:18). Uses ἴσος's \"equal\" with the verb \"make\"; ἴσος alone stays \"equal\".")))

(lemma "ἐξίστημι" (sense be-amazed (verb "be amazed") (gloss "be amazed" "was amazed" "were amazed" "is amazed" "been amazed" "being amazed") (why "Intransitive (second aorist ἐξέστη): to stand out of oneself, be amazed (Genesis 27:33 ἐξέστη δὲ Ἰσαὰκ ἔκστασιν μεγάλην, with its own noun ἔκστασις \"trance\"; Mark 2:12; Luke 2:47). (LXX form supplied.)"))
  (sense confound (gloss "confound" "confounded" "confounds" "confounding") (why "Transitive (future ἐκστήσω, first aorist): to put out of their senses, confound (Exodus 23:27 ἐκστήσω πάντα τὰ ἔθνη; Luke 24:22 ἐξέστησαν ἡμᾶς; Acts 8:9, 11). \"Be amazed\" cannot take an object. Chosen in the form row.")))

(lemma "ἔξοδος" (sense exodus (gloss "exodus" "exoduses") (why "A going out, departure, and so the Exodus (Exodus 19:1, τοῦ μηνὸς τοῦ τρίτου τῆς ἐξόδου τῶν υἱῶν Ἰσραήλ; Luke 9:31, of Jesus' departure; Hebrews 11:22; 2 Peter 1:15, of death). \"Exodus\" is the Greek word itself and keeps it apart from ἀπαίρω \"depart\" and ἐξέρχομαι \"go out\". (LXX form supplied.)"))
  (sense departure (gloss "departure" "departures") (why "Of time: the going out, close of a period (Exodus 23:16 ἐπ’ ἐξόδου τοῦ ἐνιαυτοῦ, \"at departure of the year\"). \"Exodus\" would name the going out of Egypt. Chosen by word override.")))

(lemma "ἐξολεθρεύω" (sense destroy-utterly (gloss "destroy utterly" "destroyed utterly" "destroys utterly" "destroying utterly") (why "(LXX, supplied.) To destroy utterly, root out (Genesis 17:14 ἐξολεθρευθήσεται ἡ ψυχὴ ἐκείνη; Acts 3:23 quotes the formula). \"Destroy utterly\" keeps it apart from ἀπόλλυμι \"destroy\".")))

(lemma "ἐξομολογέω" (sense acknowledge (dative "") (gloss "acknowledge" "acknowledged" "acknowledges" "acknowledging") (why "Middle, to acknowledge openly: to confess (Matthew 3:6) or to give thanks, praise (Matthew 11:25 ἐξομολογοῦμαί σοι; Genesis 29:35, Leah at Judah's birth: ἐξομολογήσομαι Κυρίῳ). \"Acknowledge\" covers both without choosing; the dative is its object.")))

(lemma "ἐξορκίζω" (sense adjure (gloss "adjure" "adjured" "adjures" "adjuring") (why "To put under oath, adjure (Genesis 24:3, ἐξορκίσω σε Κύριον; Matthew 26:63, ἐξορκίζω σε κατὰ τοῦ θεοῦ). Kept apart from ὁρκίζω \"swear in\" and ὀμνύω \"swear\".")))

(lemma "ἐξυβρίζω" (sense act-insolently (verb "act insolently" "acted insolently" "acted insolently") (gloss "act insolently" "acted insolently" "acts insolently" "acting insolently") (why "(LXX, supplied.) To break out in wantonness, behave insolently (Genesis 49:4, Reuben ἐξύβρισας ὡς ὕδωρ). Kept apart from ὑβρίζω, which will take \"insult\".")))

(lemma "ἔξω" (sense outside (gloss "outside") (why "Outside, out of doors (Genesis 9:22, he told his two brothers ἔξω; Matthew 26:69; John 6:37). It shares \"outside\" with ἔξωθεν, unavoidably: English has one word for both; ἔξωθεν, \"from outside\", is the rarer.")))

(lemma "ἔξωθεν" (sense outside (gloss "outside") (why "From outside, on the outside (Genesis 6:14, the ark pitched ἔσωθεν καὶ ἔξωθεν; Matthew 23:27). Paired with ἔσωθεν \"inside\".")))

(lemma "ἐξώτερος" (sense outer (gloss "outer") (why "Outer, outermost (Exodus 26:4, τῆς αὐλαίας τῆς ἐξωτέρας, the outer curtain of a set; Matthew 8:12, the outer darkness). The comparative of ἔξω; kept apart from ἔξωθεν \"outside\". Its opposite is ἐσώτερος \"inner\".")))

(lemma "ἑορτή"(sense feast (gloss "feast" "feasts") (why "A feast, festival (Exodus 13:6, ἑορτὴ Κυρίου; Luke 2:41, the feast of the Passover; John 7:2).")))

(lemma "ἑορτάζω" (sense keep-feast (verb "keep feast" "kept feast" "kept feast") (gloss "keep feast" "kept feast" "keeps feast" "keeping feast") (why "To hold a feast, keep a festival (Exodus 5:1 ἵνα μοι ἑορτάσωσιν ἐν τῇ ἐρήμῳ; 1 Corinthians 5:8 ὥστε ἑορτάζωμεν), the verb of ἑορτή.")))
(lemma "ἐπάγω" (sense bring-on (gloss "bring on" "brought on" "brings on" "bringing on") (why "To bring upon (Genesis 6:17, the flood; 2 Peter 2:5, ἐπάξας κατακλυσμόν). \"Bring on\" against ἄγω and its other compounds.")))

(lemma "ἐπαινέω" (sense praise (gloss "praise" "praised" "praises" "praising") (why "To praise, commend (Genesis 12:15, the officials praised Sarai to Pharaoh; Luke 16:8; 1 Corinthians 11:2).")))

(lemma "ἐπαίρω" (sense lift-up (gloss "lift up" "lifted up" "lifts up" "lifting up") (why "To lift up, raise (Genesis 7:17, the water lifted up the ark; Luke 6:20; John 17:1, lifting up his eyes). Kept apart from ὑψόω \"raise high\".")))

(lemma "ἐπακούω" (sense listen-to (genitive "") (dative "") (gloss "listen to" "listened to" "listens to" "listening to") (why "To listen to, give a hearing to, with the genitive (Genesis 17:20 ἐπήκουσά σου \"I listened to you\"; 2 Corinthians 6:2 quoting Isaiah 49:8). Kept apart from ἀκούω \"hear\".")))

(lemma "ἐπαναστρέφω" (sense come-back-again (voice active) (verb "come back again" "came back again" "come back again") (gloss "come back again" "came back again" "comes back again" "coming back again") (why "(LXX, supplied.) To come back again, return (Genesis 18:10 Ἐπαναστρέφων ἥξω \"coming back again I will come\"). Built on ἀναστρέφω \"come back\", with \"again\" for the added ἐπ-, as ἐπιστρέφω \"turn again\".")))

(lemma "ἐπάνω"
  (sense over
    (gloss "over")
    (why "Above, over, on top of (Genesis 1:2, 7, 29; Matthew 2:9, the star stood over where the child was). One gloss, \"over\". The sense \"more than\" (Mark 14:5) becomes its own sense."))
  (sense upward
    (gloss "upward")
    (why "As an adverb with a measure, upward, higher: δέκα πέντε πήχεις ἐπάνω ὑψώθη τὸ ὕδωρ, \"ten five cubits upward the water was raised high\" (Genesis 7:20). \"Over\" would read as a preposition governing the next noun; chosen by word override.")))

(lemma "ἐπάνωθεν" (sense on-top (gloss "on top") (why "(LXX, supplied.) From above, on top: the cherubim stretching out their wings ἐπάνωθεν over the propitiatory (Exodus 25:20). \"On top\" keeps it apart from ἄνωθεν \"from above\" and ἐπάνω.")))

(lemma "ἐπαοιδός" (sense enchanter (person) (gloss "enchanter" "enchanters") (why "(LXX, supplied.) One who sings spells over (ἐπ- + ἀοιδή \"song\"), an enchanter: the Egyptian ἐπαοιδοί who copy Moses' signs (Exodus 7:11, 22; 8:7, 18-19). Kept apart from φαρμακός \"sorcerer\" and σοφιστής \"sage\" beside it.")))

(lemma "ἐπαποστέλλω" (sense send-forth (verb "send forth" "sent forth" "sent forth") (gloss "send forth" "sent forth" "sends forth" "sending forth") (why "(LXX, supplied.) To send against or upon, send forth on someone (Exodus 8:21 ἰδοὺ ἐγὼ ἐπαποστέλλω ἐπὶ σέ ... κυνόμυιαν). \"Send forth\" keeps it apart from ἀποστέλλω \"send\", ἐξαποστέλλω \"send out\" and πέμπω \"dispatch\"; the ἐπι- is echoed by the following ἐπί \"upon\".")))

(lemma "ἔπαυλις" (sense homestead (gloss "homestead" "homesteads") (why "A farmstead, an unwalled dwelling-place with its folds (Genesis 25:16, Ishmael's sons \"in their tents and in their homesteads\"; Acts 1:20, quoting Psalm 68:26 LXX).")))

(lemma "ἐπαρυστήρ" (sense pourer (gloss "pourer" "pourers") (why "(LXX, supplied.) A vessel for drawing off and pouring oil into the lamps (from ἐπαρύω \"draw off\"), one of the lampstand's utensils (Exodus 25:38; 37:23). The exact shape is uncertain; \"pourer\" says only what the Greek word does.")))

(lemma "ἐπαρυστρίς" (sense pouring-vessel (gloss "pouring vessel" "pouring vessels") (why "(LXX, supplied.) A vessel for drawing off and pouring oil (from ἐπαρύω \"draw off\"), a feminine by-form beside ἐπαρυστήρ: the lampstand's τὰς ἐπαρυστρίδας αὐτῶν χρυσᾶς (Exodus 37:23). A different Greek word from ἐπαρυστήρ \"pourer\" (25:38), so a different English word for the same use.")))

(lemma "ἐπαύριον" (sense morrow (dative "on") (gloss "morrow") (why "Tomorrow; with the article, ἡ ἐπαύριον (ἡμέρα), the next day (Genesis 19:34 τῇ ἐπαύριον \"on the morrow\"; Matthew 27:62; John 1:29). \"Morrow\" because the article needs a noun in English.")))

(lemma "ἐπεί" (sense when (gloss "when") (why "When, since (Genesis 15:17 ἐπεὶ δὲ ἐγίνετο ὁ ἥλιος πρὸς δυσμαῖς; Luke 1:34 \"since\"). \"When\" is shared with ὅτε and ἡνίκα, \"since\" being διότι's.")))

(lemma "ἐπειδή" (sense seeing-that (gloss "seeing that") (why "Since, seeing that (Genesis 18:31 Ἐπειδὴ ἔχω λαλῆσαι; Luke 7:1; 1 Corinthians 1:21-22). \"Seeing that\" because διότι takes \"since\" and ὅτι \"because\".")))

(lemma "ἐπεῖδον" (sense look (gloss "look" "looked" "looks" "looking") (why "The aorist of ἐφοράω, to look upon (with favor): Genesis 4:4; Luke 1:25. Swete spells ἔπιδεν. \"Look\": the ἐπί that follows it in Genesis 4:4 gives the \"upon\"."))
  (sense look-upon
    (gloss "look upon" "looked upon" "looks upon" "looking upon")
    (why "With a direct object and no ἐπί: to look upon (Genesis 16:13 ὁ θεὸς ὁ ἐφιδών με, \"the God the [one] having looked upon me\"; Luke 1:25).")))

(lemma "ἔπειμι" (sense be-on (intransitive) (verb "be on" "was on" "been on") (gloss "be on" "is on" "are on" "was on" "were on" "been on" "being on" "will be on") (why "(LXX, supplied.) To be on, upon (ἐπί + εἰμί): Exodus 8:22, the land Goshen ἐφ’ ἧς ὁ λαός μου ἔπεστιν ἐπ’ αὐτῆς, \"upon which my people is on upon it\", the Greek's resumptive pronoun kept; \"on\" so the English does not say \"upon upon\". (Not ἔπειμι \"come after\" of Acts 7:26, from εἶμι, which will be its own lemma sense if it comes.)")))

(lemma "ἐπέκεινα" (sense beyond (genitive "") (gloss "beyond") (why "Beyond, on the far side of, with the genitive (Genesis 35:21 ἐπέκεινα τοῦ πύργου Γάδερ; Acts 7:43 ἐπέκεινα Βαβυλῶνος).")))

(lemma "ἐπέρχομαι" (sense come-over (verb "come over" "came over" "come over") (gloss "come over" "came over" "comes over" "coming over") (why "To come upon, come against, befall (Genesis 42:21 ἐπῆλθεν ἐφ’ ἡμᾶς ἡ θλίψις αὕτη; Luke 1:35; 21:26). \"Come over\", not \"come upon\", because the verb usually takes ἐπί, which is \"upon\" (\"came over upon us\"), and συμβαίνω has \"befall\".")))

(lemma "ἐπερωτάω"(sense question (gloss "question" "questioned" "questions" "questioning") (why "To ask, put a question to, inquire of (Genesis 26:7; Mark 9:32; Luke 2:46). \"Question\" keeps it apart from αἰτέω \"ask\", δέομαι \"beg\" and πυνθάνομαι \"inquire\".")))

(lemma "ἐπερώτησις" (sense query (gloss "query" "queries") (why "(LXX, supplied.) A questioning, inquiry (Genesis 43:7 κατὰ τὴν ἐπερώτησιν αὐτοῦ, \"according to his query\"). The noun of ἐπερωτάω \"question\"; \"query\" because \"questioning\" is that verb's participle.")))

(lemma "ἐπέχω" (sense hold-on (gloss "hold on" "held on" "holds on" "holding on") (why "(LXX sense, supplied.) Intransitive: to hold on, wait, stay (Genesis 8:10, 12, ἐπισχὼν ἔτι ἡμέρας ἑπτά, having held on yet seven days; Acts 19:22). \"Hold on\" keeps the root ἔχω \"have, hold\"; the New Testament's \"give heed\" (Luke 14:7; 1 Timothy 4:16) will be its own sense.")))

(lemma "ἐπί"
  (sense upon
    (gloss "upon")
    (why "Of place, with the genitive, dative or accusative: \"upon\" (upon the earth, upon Adam, upon your breast). \"Upon\" rather than \"on\" because it also covers the birds flying \"upon the earth\" (Genesis 1:20). The many non-spatial uses (\"in the time of\", \"on the basis of\", \"against\") will be separate senses.")))

(lemma "ἐπιβαίνω" (sense mount (gloss "mount" "mounted" "mounts" "mounting") (why "To go up on, mount (Genesis 24:61, ἐπέβησαν ἐπὶ τὰς καμήλους; Matthew 21:5, mounted on a donkey; Acts 21:2, embarking).")))

(lemma "ἐπιβάλλω"
  (sense cast
    (gloss "cast" "casts" "casting")
    (why "To throw or lay upon (Genesis 2:21, a trance; Mark 14:46, laying hands on). \"Cast\", from βάλλω, which will also take \"cast\" with its own note; the compound's ἐπι- is usually echoed by the following ἐπί \"upon\"."))
  (sense impose (dative "on") (gloss "impose" "imposed" "imposes" "imposing") (why "To lay a charge or penalty on someone (Exodus 21:22, καθότι ἂν ἐπιβάλῃ ὁ ἀνὴρ τῆς γυναικός, what the woman's husband imposes; 21:30, λύτρα ἐπιβληθῇ αὐτῷ, \"ransoms are imposed on him\"). \"Cast\" would not say a fine is set; chosen by override.")))

(lemma "ἐπιβλέπω" (sense gaze (gloss "gaze" "gazed" "gazes" "gazing") (why "To look attentively at, gaze (Genesis 19:26, Lot's wife ἐπέβλεψεν εἰς τὰ ὀπίσω; 19:28; Luke 1:48; 9:38). \"Gaze\" keeps it apart from βλέπω \"see\", ἀναβλέπω \"look up\" and ἐπεῖδον \"look\".")))

(lemma "ἐπιγαμβρεύω" (sense intermarry (dative "with") (gloss "intermarry" "intermarried" "intermarries" "intermarrying") (why "To become related by marriage, intermarry, with the dative (Genesis 34:9 ἐπιγαμβρεύσατε ἡμῖν); in Matthew 22:24 to marry as next of kin.")))

(lemma "ἐπιγινώσκω" (sense recognize (gloss "recognize" "recognized" "recognizes" "recognizing") (why "To know fully, recognize (Genesis 27:23, Isaac did not recognize Jacob; Luke 24:16, 31). \"Recognize\" keeps it apart from γινώσκω \"know\". (LXX form supplied.)")))

(lemma "ἐπιδίδωμι" (sense yield (gloss "yield" "yielded" "yields" "yielding") (why "(LXX form supplied.) To give besides, give forth, hand on (Genesis 49:21, Naphtali ἐπιδιδοὺς ἐν τῷ γενήματι κάλλος; Luke 24:30, 42; Acts 27:15). \"Yield\" because παραδίδωμι has \"hand over\" and δίδωμι \"give\".")))

(lemma "ἐπιδιπλόω" (sense double-over (verb "double over" "doubled over" "doubled over") (gloss "double over" "doubled over" "doubles over" "doubling over") (why "(LXX, supplied.) To fold double over (ἐπί + διπλόω): the sixth skin-cloth doubled over at the front of the tabernacle (Exodus 26:9).")))

(lemma "ἐπιδιώκω" (sense give-chase (verb "give chase" "gave chase" "given chase") (gloss "give chase" "gave chase" "given chase" "gives chase" "giving chase") (why "(LXX, supplied.) To pursue after, give chase (Genesis 44:4 Ἀναστὰς ἐπιδίωξον ὀπίσω τῶν ἀνθρώπων, \"Having arisen, give chase behind the men\"). \"Give chase\" keeps it apart from διώκω \"pursue\" and καταδιώκω \"chase\".")))

(lemma "ἐπιζάω" (sense live-on (intransitive) (verb "live on" "lived on" "lived on") (gloss "live on" "lived on" "lives on" "living on") (why "(LXX, supplied.) To live on, survive, live after (Genesis 47:28 Ἐπέζησεν δὲ Ἰακὼβ ἐν γῇ Αἰγύπτῳ ἔτη δέκα ἑπτά). \"Live on\" keeps it apart from ζάω \"live\".")))

(lemma "ἐπιζήμιον" (sense penalty (gloss "penalty" "penalties") (why "(LXX, supplied.) A fine, penalty (ζημία \"loss\"), the neuter of the adjective ἐπιζήμιος used as a noun (Exodus 21:22, ἐπιζήμιον ζημιωθήσεται, \"will be fined [a] penalty\").")))

(lemma "ἐπιδιαιρέω" (sense apportion (gloss "apportion" "apportioned" "apportions" "apportioning") (why "(LXX, supplied.) To divide out among, apportion (Genesis 33:1, Jacob apportioned the children upon Leah and upon Rachel). Kept apart from διαιρέω \"divide\".")))

(lemma "ἐπίθεμα" (sense lid (gloss "lid" "lids") (why "(LXX, supplied.) Something put on, a lid, cover (from ἐπιτίθημι): the propitiatory is ἐπίθεμα χρυσίου καθαροῦ, \"a lid of pure gold\" on the ark (Exodus 25:17). Kept apart from κάλυμμα and from καλύπτω \"cover\".")))

(lemma "ἐπιθυμέω" (sense desire (genitive "") (gloss "desire" "desired" "desires" "desiring") (why "To desire, set the heart on. \"Desire\" in the literal layer (Exodus 20:17; Romans 7:7 quotes it); the readable layer may say \"covet\".")))

(lemma "ἐπιθυμία" (sense desire (dative "with") (gloss "desire" "desires") (why "Desire, longing (Genesis 31:30 ἐπιθυμίᾳ γὰρ ἐπεθύμησας, \"for with desire you desired\"; Luke 22:15 ἐπιθυμίᾳ ἐπεθύμησα). It shares \"desire\" with its verb ἐπιθυμέω on purpose, so the cognate doubling shows, as ἁμαρτία and ἁμαρτάνω share \"sin\".")))

(lemma "ἐπικαθίζω" (sense sit-upon (verb "sit upon" "sat upon" "sat upon") (dative "") (gloss "sit upon" "sat upon" "sits upon" "sitting upon") (why "To sit on (Genesis 31:34 ἐπεκάθισεν αὐτοῖς, Rachel on the idols; Matthew 21:7 ἐπεκάθισεν ἐπάνω αὐτῶν). The dative is its object: \"sat upon them\".")))

(lemma "ἐπικαλέω" (sense call-upon (voice middle) (gloss "call upon" "called upon" "calls upon" "calling upon") (why "Middle: to call upon (a name), Genesis 4:26; Romans 10:13. (voice middle): the middle/passive forms of the present and perfect (ἐπικαλεῖσθαι, Genesis 4:26) are the active \"call upon\"; the aorist and future passive are passive (Genesis 48:16 ἐπικληθήσεται \"will be called upon\").")))

(lemma "ἐπικάλυμμα" (sense upper-cover (gloss "upper cover" "upper covers") (why "(LXX, supplied.) A covering laid over (ἐπί + κάλυμμα): the upper covers of blue-dyed skins over the tabernacle (Exodus 26:14; 36); a cloak, pretext (1 Peter 2:16). \"Upper cover\" keeps it beside κάλυμμα \"cover\". Tabernacle term.")))

(lemma "ἐπικαλύπτω" (sense cover-over (gloss "cover over" "covered over" "covers over" "covering over") (why "To cover over (Genesis 7:19-20, the water covered over all the high mountains; Romans 4:7, whose sins were covered over, from Psalm 31:1). \"Cover over\" for the ἐπι- of the compound.")))

(lemma "ἐπικατάρατος"
  (sense cursed
    (gloss "cursed")
    (why "Accursed, under a curse (Genesis 3:14, 17; Galatians 3:10, 13 quoting Deuteronomy). καταράομαι and its participle will need a note so the two do not merge.")))

(lemma "ἐπίκειμαι" (sense lie-on (intransitive) (verb "lie on" "lay on" "lain on") (gloss "lie on" "lay on" "lain on" "lies on" "lying on") (why "To lie on, be placed on (Exodus 39:31 ὥστε ἐπικεῖσθαι ἐπὶ τὴν μίτραν ἄνωθεν, the plate on the miter; John 11:38; 21:9). \"On\" renders the ἐπι- without doubling the \"upon\" of the ἐπί that follows; its past \"lay on\" is unavoidably the English of ἐπιτίθημι. Pressing upon (Luke 5:1; 23:23) will be its own sense. (LXX form supplied.)")))

(lemma "ἐπικλίνω" (sense tilt (gloss "tilt" "tilted" "tilts" "tilting") (why "(LXX, supplied.) To bend, lean over, tilt (Genesis 24:14, Ἐπίκλινον τὴν ὑδρίαν σου, tilting the jar for a drink). Kept apart from κλίνω \"bend\" and ἐκκλίνω.")))

(lemma "ἐπικρατέω" (sense prevail (intransitive) (genitive "over") (gloss "prevail" "prevailed" "prevails" "prevailing") (why "(LXX, supplied.) To gain the mastery, prevail (Genesis 7:18-19, 24, the water was prevailing on the earth). Kept apart from κρατέω, which will need its own English.")))

(lemma "ἐπιλανθάνομαι" (sense forget (genitive "") (verb "forget" "forgot" "forgotten") (gloss "forget" "forgot" "forgotten" "forgets" "forgetting") (why "To forget, with the accusative or genitive (Genesis 27:45, until Esau forgets what Jacob did; Hebrews 13:2; James 1:24). (LXX form supplied.)")))

(lemma "ἐπιλαμβάνω" (sense take-hold (genitive "of") (gloss "take hold" "took hold" "taken hold" "takes hold" "taking hold") (why "In the middle, to lay hold of, take hold of, with the genitive (Genesis 25:26, Jacob's hand ἐπειλημμένη τῆς πτέρνης Ἠσαύ; Mark 8:23; Hebrews 2:16).")))

(lemma "ἐπιλέγω" (sense pick-out (verb "pick out" "picked out" "picked out") (gloss "pick out" "picked out" "picks out" "picking out") (why "(LXX form supplied.) To choose out, select (Exodus 17:9, Ἐπίλεξον σεαυτῷ ἄνδρας δυνατούς; 18:25; Acts 15:40, Paul ἐπιλεξάμενος Silas). \"Pick out\" keeps it apart from ἐκλέγω.")))

(lemma "ἐπίλεκτος" (sense picked (gloss "picked") (why "(LXX, supplied.) Picked out, chosen, select (from ἐπιλέγω): τῶν ἐπιλέκτων τοῦ Ἰσραήλ, the picked men of Israel who saw God (Exodus 24:11). \"Picked\" keeps it apart from ἐκλεκτός \"chosen\".")))

(lemma "ἐπιμελέομαι" (sense take-care (genitive "of") (verb "take care" "took care" "taken care") (gloss "take care" "took care" "taken care" "takes care" "taking care") (why "With the genitive: to take care of, look after (Genesis 44:21 ἐπιμελοῦμαι αὐτοῦ, \"I take care of him\"; Luke 10:34-35; 1 Timothy 3:5). (LXX form supplied.) The verb of ἐπιμελῶς \"diligently\".")))

(lemma "ἐπιμελῶς" (sense diligently (gloss "diligently") (why "Carefully, diligently (Genesis 6:5; Luke 15:8).")))

(lemma "ἐπιμένω" (sense stay-on (intransitive) (verb "stay on" "stayed on" "stayed on") (gloss "stay on" "stayed on" "stays on" "staying on") (why "To stay on, remain longer (Exodus 12:39 οὐκ ἠδυνήθησαν ἐπιμεῖναι, they could not stay on in Egypt; Acts 10:48; 21:4; Romans 6:1 \"continue\"). \"Stay on\" keeps it apart from μένω \"stay\".")))

(lemma "ἐπίμικτος" (sense mixed-company (gloss "mixed company") (why "(LXX, supplied.) Mixed, mingled; as a noun, a mixed company of people of other races who went out with Israel (Exodus 12:38 ἐπίμικτος πολὺς συνανέβη αὐτοῖς). \"Mixed company\" keeps it apart from μίγνυμι \"mix\".")))

(lemma "ἐπισάσσω" (sense saddle (gloss "saddle" "saddled" "saddles" "saddling") (why "(LXX, supplied.) To pack or saddle a beast (Genesis 22:3 ἐπέσαξεν τὴν ὄνον αὐτοῦ).")))

(lemma "ἐπίσημος" (sense marked (gloss "marked") (why "Bearing a mark, marked (Genesis 30:42, τὰ ἐπίσημα, the marked animals that became Jacob's, against τὰ ἄσημα \"the unmarked\"). Of persons, \"notable\" (Romans 16:7; Matthew 27:16), which may become its own sense.")))

(lemma "ἐπισιτισμός" (sense provisions (gloss "provisions") (why "Food for a journey, provisions (Genesis 42:25; 45:21, provisions for the way; Luke 9:12). Plural in English for a collective singular.")))

(lemma "ἐπισκέπτομαι" (sense visit (gloss "visit" "visited" "visits" "visiting") (why "To look upon, visit, attend to (Genesis 21:1, the Lord visited Sarah; Luke 1:68; Matthew 25:36)."))
  (sense inspect (gloss "inspect" "inspected" "inspects" "inspecting") (why "To look over, number, muster: the men τῶν ἐπεσκεμμένων of the gathering, those counted at the census (Exodus 38:25; Numbers 1 passim). \"Inspect\" to match ἐπίσκεψις \"inspection\", the census of Exodus 30:12-14 and 38:26; \"visit\" would say the wrong thing here. Chosen in the form row.")))

(lemma "ἐπισκευάζω" (sense trim (gloss "trim" "trimmed" "trims" "trimming") (why "(LXX, supplied.) To make ready, put in order; of lamps, to trim them (Exodus 30:7 ὅταν ἐπισκευάσῃ τοὺς λύχνους). \"Trim\" is the English for readying a lamp; tabernacle term.")))

(lemma "ἐπίσκεψις" (sense inspection (gloss "inspection" "inspections") (why "(LXX, supplied.) A looking over, inspection, and so the numbering of the people (Exodus 30:13-14 ὅσοι ἂν παραπορεύωνται τὴν ἐπίσκεψιν; 38:25-26; Numbers 1 passim), from ἐπισκέπτομαι. \"Inspection\" keeps it apart from ἐπισκοπή \"visitation\" and συλλογισμός \"tally\".")))

(lemma "ἐπισκιάζω" (sense overshadow (gloss "overshadow" "overshadowed" "overshadows" "overshadowing") (why "To cast a shadow over, overshadow (Luke 1:35; 9:34, the cloud ἐπεσκίαζεν αὐτούς at the transfiguration; Acts 5:15): Exodus 40:35, ὅτι ἐπεσκίαζεν ἐπ’ αὐτὴν ἡ νεφέλη, \"because the cloud was overshadowing upon it\". (LXX form supplied.)")))

(lemma "ἐπισκοπή" (sense visitation (dative "with") (gloss "visitation" "visitations") (why "(LXX form supplied.) A visiting, visitation (Genesis 50:24-25, ἐπισκοπῇ ἐπισκέψεται ὑμᾶς ὁ θεός, \"with visitation God will visit you\"; Luke 19:44; 1 Peter 2:12). The noun of ἐπισκέπτομαι \"visit\". The office of overseer (Acts 1:20; 1 Timothy 3:1) will be its own sense.")))

(lemma "ἐπίσπαστρον" (sense screen (gloss "screen" "screens") (why "(LXX, supplied.) A thing drawn over (ἐπισπάω \"draw\"), a drawn curtain: the screen at the door of the tabernacle (Exodus 26:36; 35-40). Tabernacle term: \"screen\" for ἐπίσπαστρον only; αὐλαία is \"curtain\", καταπέτασμα \"veil\", ἱστίον \"sheet\".")))

(lemma "ἐπισπάω" (sense pull (gloss "pull" "pulled" "pulls" "pulling") (why "To draw to oneself, pull (Genesis 39:12, she pulled Joseph by his garments, a genitive of the part grasped; 1 Corinthians 7:18, middle). (LXX form supplied.)")))

(lemma "ἐπισπουδάζω" (sense urge (gloss "urge" "urged" "urges" "urging") (why "(LXX, supplied.) To press on, hurry someone along, urge (Genesis 19:15, the angels urging Lot). Kept apart from σπεύδω and σπουδάζω.")))

(lemma "ἐπιπίπτω" (sense fall-upon (verb "fall upon" "fell upon" "fallen upon") (dative "") (gloss "fall upon" "fell upon" "fallen upon" "falls upon" "falling upon") (why "To fall upon, attack (Genesis 14:15, Abram fell upon them by night); also of fear or the Spirit falling on people (Luke 1:12; Acts 10:44).")))

(lemma "ἐπισκάζω" (sense limp (dative "on") (gloss "limp" "limped" "limps" "limping") (why "(LXX, supplied.) To limp, be lame (Genesis 32:31 ἐπέσκαζεν τῷ μηρῷ αὐτοῦ, \"was limping on his thigh\"). The dative names the limb.")))

(lemma "ἐπίσταμαι" (sense understand (gloss "understand" "understood" "understands" "understanding") (verb "understand" "understood" "understood") (why "To know well, understand, be acquainted with (Genesis 47:6 εἰ δὲ ἐπίστῃ ὅτι εἰσὶν ἐν αὐτοῖς ἄνδρες δυνατοί; Acts 10:28; 18:25). \"Understand\" keeps it apart from γινώσκω and οἶδα, which share \"know\". (LXX form supplied.)")))

(lemma "ἐπιστάτης" (sense overseer (person) (gloss "overseer" "overseers") (why "One set over others, an overseer, taskmaster (Exodus 1:11 ἐπιστάτας τῶν ἔργων, \"overseers of the works\"). The vocative ἐπιστάτα of Jesus in Luke (5:5; 8:24) is \"Master\" and will be its own sense.")))

(lemma "ἐπιστήμη" (sense expertise (gloss "expertise") (why "(LXX, supplied.) Knowledge that knows how, skill (Exodus 31:3; 35:31 σοφίας καὶ συνέσεως καὶ ἐπιστήμης, of Bezalel's gifts; 36:1), the noun of ἐπίσταμαι. \"Expertise\" keeps it apart from σοφία \"wisdom\", σύνεσις \"intelligence\", ἐπίσταμαι \"understand\" and the \"knowledge\" that γνῶσις will need.")))

(lemma "ἐπιστηρίζω" (sense lean (voice active) (gloss "lean" "leaned" "leans" "leaning") (why "(LXX, supplied.) To prop upon; passive, to lean or be set firm upon (Genesis 28:13 ὁ δὲ Κύριος ἐπεστήρικτο ἐπ’ αὐτῆς, \"the Lord had leaned upon it\", the ladder). The passive is rendered active. In the New Testament (Acts 14:22; 15:32, 41) it is \"strengthen\", which will be its own sense.")))

(lemma "ἐπιστρέφω" (sense turn-again (gloss "turn again" "turned again" "turns again" "turning again") (why "Intransitive: to turn around, turn back again, return (Genesis 8:12, the dove did not add of turning again to him; Luke 17:4; Acts 3:19). \"Turn again\" keeps it apart from στρέφω \"turn\", ἀποστρέφω \"turn back\", ἀναστρέφω \"come back\" and ὑποστρέφω \"return\".")))

(lemma "ἐπισυνάγω" (sense gather-together (gloss "gather together" "gathered together" "gathers together" "gathering together") (why "To gather together (Matthew 23:37, a hen gathering her chicks). In Genesis 6:16 ἐπισυνάγων ποιήσεις seems to mean building the ark drawn in toward the top; the literal layer keeps \"gathering together\". Kept apart from συνάγω \"gather\".")))

(lemma "ἐπιτάσσω" (sense enjoin (dative "") (gloss "enjoin" "enjoined" "enjoins" "enjoining") (why "(LXX form supplied.) To give orders to, with the dative (Genesis 49:33, Jacob ceased ἐπιτάσσων τοῖς υἱοῖς αὐτοῦ; Mark 1:27; Luke 8:25). \"Enjoin\" because προστάσσω has \"order\" and ἐντέλλομαι \"command\".")))

(lemma "ἐπιτίθημι"
  (sense lay-on
    (verb "lay on" "laid on" "laid on")
    (dative "")
    (gloss "lay on" "laid on" "lays on" "laying on")
    (why "To put or lay on (Matthew 19:13, laying hands on; Luke 23:26). The commonest sense, listed first."))
  (sense attempt
    (gloss "attempt" "attempted" "attempts" "attempting")
    (why "(LXX, supplied.) Middle with an infinitive: to set oneself to, attempt (Genesis 11:6, \"all things whatever they may attempt to do\")."))
  (sense attack
    (dative "")
    (gloss "attack" "attacked" "attacks" "attacking")
    (why "(LXX, supplied.) Middle with a dative: to set upon, attack (Genesis 43:18 τοῦ συκοφαντῆσαι ἡμᾶς καὶ ἐπιθέσθαι ἡμῖν, \"to attack us\"; Acts 18:10 οὐδεὶς ἐπιθήσεταί σοι). Chosen in the form row for ἐπιθέσθαι.")))

(lemma "ἐπιτιμάω" (sense rebuke (dative "") (gloss "rebuke" "rebuked" "rebukes" "rebuking") (why "To rebuke, reprove, with the dative (Genesis 37:10, his father ἐπετίμησεν αὐτῷ; Matthew 8:26; Luke 4:39).")))

(lemma "ἐπιτρέχω" (sense run-up(gloss "run up" "ran up" "runs up" "running up") (why "(LXX, supplied.) To run up, run toward (Genesis 24:17, the servant ran up to meet her). Kept apart from τρέχω \"run\" by the particle.")))

(lemma "ἐπιτυγχάνω" (sense succeed (gloss "succeed" "succeeded" "succeeds" "succeeding") (why "To hit the mark, attain, succeed (Genesis 39:2 ἀνὴρ ἐπιτυγχάνων, Joseph a man succeeding; Hebrews 6:15; Romans 11:7, obtain). (LXX form supplied.)")))

(lemma "ἐπιφαίνω" (sense manifest (gloss "manifest" "manifested" "manifests" "manifesting") (why "(LXX form supplied.) To show forth; passive, to be manifested, to show oneself (Genesis 35:7 ἐκεῖ γὰρ ἐπεφάνη αὐτῷ ὁ θεός; Luke 1:79; Titus 2:11; 3:4). Kept apart from ὁράω and φαίνω \"appear\".")))

(lemma "ἐπιφέρω"
  (sense borne
    (verb "bear" "bore" "borne")
    (gloss "borne")
    (readable "moving")
    (why "(Supplied in Genesis 1:2, where the form is LXX-only.) Active: to bring upon; middle/passive: to be borne or carried over, to move over. Genesis 1:2 ἐπεφέρετο is imperfect middle/passive, \"was being borne\" in the literal layer. The readable layer says \"was moving\" (Genesis 1:2): \"borne\" is no longer natural English (gsb/lexicon/readable-avoid.scm). The active (Romans 3:5, \"inflict\") will be its own sense."))
  (sense bring-upon (verb "bring upon" "brought upon" "brought upon") (dative "") (gloss "bring upon" "brought upon" "brings upon" "bringing upon") (why "(LXX form supplied.) The active, to bring upon, lay upon, with the dative (Genesis 37:22, Reuben: χεῖρα δὲ μὴ ἐπενέγκητε αὐτῷ, \"but do not bring hand upon him\"; Romans 3:5 ἐπιφέρων τὴν ὀργήν; Jude 9). Kept apart from ἐπάγω \"bring on\".")))

(lemma "ἐπίχαρμα" (sense gloating (gloss "gloating" "gloatings") (why "(LXX, supplied.) A cause of malicious joy, something to gloat over (Exodus 32:25, the people broken loose, ἐπίχαρμα τοῖς ὑπεναντίοις αὐτῶν). From ἐπιχαίρω, to rejoice over another's harm; \"gloating\" keeps the malice that \"joy\" (χαρά) lacks.")))

(lemma "ἐπιχέω" (sense pour-on (gloss "pour on" "poured on" "pours on" "pouring on") (why "To pour upon (Genesis 28:18, oil on the stone; Luke 10:34, oil and wine on the wounds). (LXX form supplied.)")))

(lemma "ἐπόζω" (sense reek (intransitive) (gloss "reek" "reeked" "reeks" "reeking") (why "(LXX, supplied.) To stink, give off a stench (Exodus 7:18, 21, the river reeked when the fish died). \"Reek\" keeps it apart from ὄζω \"stink\" (Exodus 8:14; John 11:39).")))

(lemma "ἐπονομάζω" (sense name (gloss "name" "named" "names" "naming") (why "To give a name to, name (Genesis 4:17, 25-26). Against καλέω \"call\".")))

(lemma "ἑπτά" (sense seven (gloss "seven") (why "Seven.")))

(lemma "ἑπτάκις" (sense seven-times (gloss "seven times") (why "Seven times.")))

(lemma "ἑπτακόσιοι" (sense seven-hundred (gloss "seven hundred") (why "(LXX, supplied.) The numeral seven hundred (Genesis 5).")))

(lemma "ἐπωμίς" (sense shoulder-piece (gloss "shoulder-piece" "shoulder-pieces") (why "(LXX, supplied.) What lies on the shoulders, ἐπί + ὦμος \"shoulder\": the Greek's name for the high priest's garment the Hebrew calls the ephod (Exodus 25:7; 28:4, 6, 8, 12, 15; 29:5; 35-39), and for its two shoulder straps (28:7 δύο ἐπωμίδες συνέχουσαι, \"two shoulder-pieces holding together\"). The literal layer follows the Greek, not the Hebrew loanword \"ephod\"; one English for both uses, as the Greek has one word. παρωμίς is \"shoulder-strap\". Use this English in every tabernacle chapter.")))

(lemma "ἐργάζομαι"
  (sense work
    (gloss "work" "worked" "works" "working")
    (why "To work, to work the soil (Genesis 2:5, 15; 3:23); to do, perform (John 6:28). Kept as \"work\" so the verb and the noun ἔργον stay visibly related.")))

(lemma "ἐργαλεῖον" (sense tool (gloss "tool" "tools") (why "(LXX, supplied.) A tool, implement (ἔργον \"work\"): all the tools of the court of the tabernacle, of bronze (Exodus 27:19; 39). Kept apart from σκεῦος \"vessel\".")))

(lemma "ἐργασία" (sense labor (gloss "labor" "labors") (why "Work done, labor, business (Genesis 29:27, ἀντὶ τῆς ἐργασίας ἧς ἐργᾷ παρ’ ἐμοί; Luke 12:58; Acts 16:16, 19 \"gain\"). \"Labor\" keeps it apart from ἔργον \"work\" and the verb ἐργάζομαι \"work\".")))

(lemma "ἐργοδιώκτης" (sense taskmaster (person) (gloss "taskmaster" "taskmasters") (why "(LXX, supplied.) One who drives on the work (ἔργον + διώκω), a taskmaster: the Egyptian overseers of Israel's labor (Exodus 3:7; 5:6-14).")))

(lemma "ἔργον"
  (sense work
    (gloss "work" "works")
    (why "A work, deed (Genesis 2:2-3; Hebrews 4:4; John 6:28-29). Same English as ἐργάζομαι, deliberately.")))

(lemma "ἐρευνάω" (sense search (gloss "search" "searched" "searches" "searching") (why "To search, examine (Genesis 31:33-35, Laban searching for the images; 44:12 ἠρεύνα, the steward searching the sacks; John 5:39; Romans 8:27).")))

(lemma "ἔρημος" (sense wilderness (gloss "wilderness" "wildernesses") (why "As a noun (ἡ ἔρημος, the feminine adjective standing alone), the uninhabited land, wilderness (Genesis 12:9; Matthew 3:1). The adjective \"desolate\" (Matthew 23:38) will be its own sense.")))

(lemma "ἐρημόω" (sense lay-waste (verb "lay waste" "laid waste" "laid waste") (gloss "lay waste" "laid waste" "lays waste" "laying waste") (why "To make desolate (ἔρημος), lay waste; passive, be laid waste (Genesis 47:19, lest the land be laid waste; Matthew 12:25; Revelation 18:17). \"Lay waste\" leaves \"desolate\" to the adjective ἔρημος.")))

(lemma "ἔριφος" (sense kid (gloss "kid" "kids") (why "A young goat, kid (Genesis 27:9, 16; Luke 15:29; Matthew 25:32-33, where the KJV has \"goats\"). (LXX form supplied.)")))

(lemma "ἐρίζω" (sense strive (dative "with") (gloss "strive" "strove" "striven" "strives" "striving") (verb "strive" "strove" "striven") (why "To wrangle, quarrel, contend with words (Genesis 26:35, Esau's wives were striving with Isaac and Rebekah; Matthew 12:19 quotes Isaiah 42:2). \"Strive\" keeps it apart from μάχη \"quarrel\", μάχομαι \"fight\" and the middle of κρίνω \"dispute\".")))

(lemma "ἑρμηνευτής" (sense interpreter (person) (gloss "interpreter" "interpreters") (why "(LXX, supplied.) One who translates between languages, an interpreter (Genesis 42:23 ὁ γὰρ ἑρμηνευτὴς ἀνὰ μέσον αὐτῶν ἦν; compare 1 Corinthians 14:28 διερμηνευτής).")))

(lemma "ἑρπετόν"
  (sense creeping-thing
    (gloss "creeping thing" "creeping things" "creeping")
    (why "A creeping or crawling animal, reptile (Genesis 1:20-30; Acts 10:12; Romans 1:23). \"Creeping thing\" keeps its link with ἕρπω \"creep\" (Genesis 1:26, \"the creeping things creeping upon the earth\"). Used attributively with ζῷα (Genesis 1:21) it is \"creeping\".")))

(lemma "ἕρπω"
  (sense creep
    (gloss "creep" "creeps" "crept" "creeping")
    (why "(LXX, supplied.) To creep, crawl, move along the ground. Not in the New Testament.")))

(lemma "ἐρυθροδανόω" (sense dye-red (verb "dye red" "dyed red" "dyed red") (gloss "dye red" "dyed red" "dyes red" "dyeing red") (why "(LXX, supplied.) To dye red with madder (ἐρυθρόδανον): δέρματα κριῶν ἠρυθροδανωμένα, \"rams' skins dyed red\" (Exodus 25:5; 26:14; 35:7, 23).")))

(lemma "ἐρυθρός" (sense red (gloss "red") (why "Red; ἡ ἐρυθρὰ θάλασσα is the Red Sea (Exodus 13:18; Acts 7:36; Hebrews 11:29). Shares \"red\" with πυρρός (fiery red, Genesis 25:30): the traditional name Red Sea needs the plain word.")))
(lemma "ἔρχομαι" (sense come (intransitive) (gloss "come" "came" "come" "comes" "coming") (why "To come, go (Genesis 18:21 τὴν ἐρχομένην πρὸς μέ \"the [cry] coming to me\"; 18:22 ἦλθον εἰς Σόδομα; very common in the New Testament). It shares \"come\" with ἥκω, as that entry says, until the two are separated; the alignment shows which Greek verb stands behind it.")))
(lemma "ἐρωτάω" (sense ask (gloss "ask" "asked" "asks" "asking") (why "To ask, question, request (Genesis 24:47, ἠρώτησα αὐτήν; John 1:19, 21). Kept apart from ἐπερωτάω \"question\" and αἰτέω, which may take \"request\".")))

(lemma "ἐσθίω"
  (sense eat
    (gloss "eat" "ate" "eaten" "eats" "eating")
    (why "To eat. The Greek of Genesis 2-3 uses the future (φάγῃ, φάγεσθε) both for commands and for permission; the literal layer keeps \"you will eat\".")))

(lemma "ἑσπέρα"
  (sense evening
    (gloss "evening")
    (why "Evening (Genesis 1; Luke 24:29).")))

(lemma "ἐσχάρα" (sense grate (gloss "grate" "grates") (why "(LXX, supplied.) A hearth, and a grate: the bronze grate of netted work under the altar's rim (Exodus 27:4-5; 35-39). Tabernacle term.")))

(lemma "ἔσχατος" (sense last (gloss "last") (why "Last, final (Genesis 33:2, Rachel and Joseph last; Matthew 20:16; John 6:39).")))

(lemma "Ἐσχώλ" (sense name (gloss "Eshcol") (why "(LXX, supplied.) Abram's ally, brother of Mamre (Genesis 14:13, 24); traditional English Eshcol.")))

(lemma "ἔσω" (sense within (gloss "within") (why "Within, inside (Genesis 39:11, no one in the house within; Matthew 26:58; John 20:26). \"Within\" because \"inside\" is ἔσωθεν's.")))

(lemma "ἔσωθεν" (sense inside (gloss "inside") (why "From inside, on the inside (Genesis 6:14; Matthew 23:25). Paired with ἔξωθεν \"outside\".")))

(lemma "ἐσώτερος" (sense inner (gloss "inner") (why "Inner; with a genitive, the inner side of: ἐσώτερον τοῦ καταπετάσματος, \"inner of the veil\" (Exodus 26:33; Hebrews 6:19 τὸ ἐσώτερον τοῦ καταπετάσματος; Acts 16:24 the inner prison). The opposite of ἐξώτερος \"outer\"; kept apart from ἔσωθεν.")))

(lemma "ἐτάζω"(sense examine (gloss "examine" "examined" "examines" "examining") (why "(LXX, supplied.) To examine, test, as by torture (Genesis 12:17, God examined Pharaoh with great examinations, where the Hebrew has \"plagued ... with plagues\"; compare ἀνετάζω, Acts 22:24, examined by scourging). The Greek word is kept, not the Hebrew's.")))

(lemma "ἐτασμός" (sense examination (dative "with") (gloss "examination" "examinations") (why "(LXX, supplied.) An examination, a testing by affliction (Genesis 12:17), the noun of ἐτάζω and given its English; the dative is the means, \"with examinations\".")))

(lemma "ἕτερος" (sense other (gloss "other") (why "Other, another of a different kind; kept apart from ἄλλος when it occurs.")))

(lemma "ἔτι"
  (sense further
    (gloss "further")
    (why "Additive \"further, besides\" (Genesis 2:9, 19, where the Septuagint has God make trees and animals \"further\", after Genesis 1; the Hebrew has no such word). Temporal \"still, yet\" (Luke 1:15) becomes its own sense."))
  (sense still
    (gloss "still")
    (why "Temporal: still, yet (Genesis 25:6 ἔτι ζῶντος αὐτοῦ, \"he still living\"; Luke 1:15; Romans 5:6). Chosen by word override.")))

(lemma "ἑτοιμάζω" (sense prepare (gloss "prepare" "prepared" "prepares" "preparing") (why "To make ready, prepare (Genesis 24:14, 31, 44, the woman whom the Lord prepared for Isaac; Matthew 3:3; John 14:2-3).")))

(lemma "ἕτοιμος" (sense ready (gloss "ready") (why "Ready, prepared (Exodus 15:17 εἰς ἕτοιμον κατοικητήριόν σου, \"into your ready dwelling place\"; 19:11, 15; Matthew 22:4, 8). The adjective of ἑτοιμάζω \"prepare\".")))

(lemma "ἔτος" (sense year (dative "in") (gloss "year" "years") (why "A year (Genesis 5, the ages of the patriarchs; Luke 2:41). It shares \"year\" with ἐνιαυτός (Genesis 1:14): both are plain words for a year and English has no second word; the alignment shows which Greek word stands behind it.")))

(lemma "εὖ" (sense well (gloss "well") (why "Well (Exodus 20:12; Ephesians 6:3 quotes it).")))

(lemma "Εὕα" (sense name (gloss "Eve") (why "(LXX from Genesis 4:1.) The traditional English name; the Septuagint calls the woman Ζωή, \"Life\", at 3:20 and Εὕα from 4:1, as do 2 Corinthians 11:3 and 1 Timothy 2:13.")))

(lemma "Εὑαῖος" (sense name (person) (gloss "Hivite" "Hivites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:17), Greek Εὑαῖος; traditional English Hivite.")))

(lemma "εὐαρεστέω" (sense be-well-pleasing (verb "be well-pleasing" "was well-pleasing" "been well-pleasing") (dative "to") (gloss "be well-pleasing" "was well-pleasing" "is well-pleasing" "were well-pleasing" "been well-pleasing" "being well-pleasing") (why "(LXX form supplied.) To be well-pleasing to, with the dative (Genesis 5:22, 24; 6:9; Hebrews 11:5-6, which quotes Genesis 5:24: Enoch εὐηρεστηκέναι τῷ θεῷ). \"Be well-pleasing\" keeps εὖ (\"well\") and the root of ἀρεστός visible.")))

(lemma "εὐδοκέω" (sense be-pleased(gloss "be pleased" "was pleased" "is pleased" "been pleased" "being pleased" "were pleased") (why "To be pleased, take delight, consent (Genesis 24:25, 48, εὐδοκήσας ὁ ἄνθρωπος; Matthew 3:17, ἐν ᾧ εὐδόκησα). \"Be pleased\" keeps it apart from εὐαρεστέω \"be well-pleasing\" and ἀρέσκω.")))

(lemma "εὐδοκιμέω" (sense be-approved (verb "be approved" "was approved" "been approved") (gloss "be approved" "is approved" "was approved" "been approved" "being approved") (why "(LXX, supplied.) To be in good repute, be approved, tested and found good (Genesis 43:23 τὸ δὲ ἀργύριον ὑμῶν εὐδοκιμοῦν ἀπέχω, \"your silver, being approved, I have in full\", of coin accepted as good). Kept apart from εὐδοκέω \"be well pleased\" and δόκιμος \"approved\" (the adjective).")))

(lemma "Εὑειλά" (sense name (gloss "Havilah") (why "(LXX, supplied.) A son of Joktan (Genesis 10:29), Greek Εὑειλά; traditional English Havilah. The same English as Εὑιλά, Cush's son (10:7), and as the land Εὑειλάτ (2:11), which the Hebrew also spells alike.")))

(lemma "Εὑειλάτ"
  (sense name
    (gloss "Havilah")
    (why "(LXX, supplied.) The land of Genesis 2:11, given its traditional English name; the Greek spells it Εὑειλάτ (Heuilat).")))

(lemma "εὐθηνία" (sense plenty (gloss "plenty") (why "(LXX, supplied.) Prosperity, abundance of food, plenty (Genesis 41:29-53, the seven years of plenty).")))

(lemma "εὐθύς" (sense at-once (gloss "at once") (why "The adverb: at once, immediately (Genesis 15:4 καὶ εὐθὺς φωνὴ Κυρίου; Mark 1:10-12). \"At once\" keeps it apart from εὐθέως, which can take \"immediately\"; the adjective \"straight\" (Luke 3:4-5) will be its own sense."))
  (sense straight (gloss "straight") (why "The adjective: straight, level (Genesis 33:12 ἐπ’ εὐθεῖαν, upon [a] straight [way]; Luke 3:4-5; Acts 9:11).")))

(lemma "Εὑιλά" (sense name (gloss "Havilah") (why "(LXX, supplied.) A son of Cush (Genesis 10:7), Greek Εὑιλά; traditional English Havilah, as Εὑειλά (10:29) and the land Εὑειλάτ (2:11).")))

(lemma "εὐλαβέομαι" (sense be-wary (verb "be wary" "was wary" "been wary") (gloss "be wary" "was wary" "wary") (why "To take care, be cautious, beware, and so to show reverent fear (Exodus 3:6, Moses εὐλαβεῖτο κατεμβλέψαι ἐνώπιον τοῦ θεοῦ; Hebrews 11:7 εὐλαβηθείς, Noah; Acts 23:10). \"Be wary\" keeps it apart from φοβέομαι \"fear\".")))

(lemma "εὐλογέω"
  (sense bless
    (gloss "bless" "blessed" "blesses" "blessing")
    (why "(Supplied in Genesis 1-2, where the augmented form ηὐλόγησεν is LXX-only.) To bless, speak well of (Genesis 1:22; Luke 24:50).")))

(lemma "εὐλογητός" (sense blessed (gloss "blessed") (why "Blessed, praised (Genesis 12:2, \"you will be blessed\"; Luke 1:68; Romans 9:5). It shares \"blessed\" with the participle of εὐλογέω, its own root; μακάριος will need other English.")))

(lemma "εὐλογία" (sense blessing (gloss "blessing" "blessings") (why "A blessing, the spoken benediction (Genesis 27:12-41, Isaac's blessing; 28:4 τὴν εὐλογίαν Ἀβραάμ; Galatians 3:14; Hebrews 12:17, Esau's lost blessing). The noun of εὐλογέω \"bless\".")))

(lemma "εὐνοῦχος" (sense eunuch (person) (plural "eunuchs") (gloss "eunuch" "eunuchs") (why "A eunuch, and so a court officer (Genesis 39:1, Potiphar; 40:2, 7, Pharaoh's cupbearer and baker; Acts 8:27). The literal layer keeps \"eunuch\"; whether the word means only \"officer\" here is for the readable layer.")))

(lemma "εὐοδόω" (sense prosper (gloss "prosper" "prospered" "prospers" "prospering") (why "To give a good journey, make succeed, prosper (Genesis 24:12, 21, 27, 40, 42, 48, 56, the Lord prospering the servant's way; Romans 1:10; 3 John 2). Active and transitive in Genesis 24: \"prospered my way\".")))

(lemma "εὐπρόσωπος" (sense fair-faced (gloss "fair-faced") (why "(LXX, supplied.) Fair of face, good-looking (Genesis 12:11; Galatians 6:12 uses the verb εὐπροσωπέω, \"to make a fair show\"). \"Fair-faced\" renders εὐ- and πρόσωπον \"face\".")))

(lemma "εὑρίσκω"
  (sense find
    (gloss "find" "found" "finds" "finding")
    (why "To find; passive \"be found\" (Genesis 2:20).")))

(lemma "εὖρος" (sense width (gloss "width") (why "(LXX, supplied.) Width (Exodus 25:23, the table πήχεος τὸ εὖρος; 26:2, 8; 27:12-13; 28:16). \"Width\" keeps it apart from πλάτος \"breadth\", which the same chapters use for the same measure (25:10, 17).")))

(lemma "εὐρύς" (sense wide (gloss "wide") (why "(LXX, supplied.) Wide, broad: the rings of the ark and the table made εὐρεῖς τοῖς διωστῆρσιν, wide for the poles (Exodus 37:4-5, 13; 38:7). The adjective behind εὐρυχωρία \"spaciousness\" and εὐρύχωρος (Matthew 7:13).")))

(lemma "εὐρυχωρία" (sense spaciousness (gloss "spaciousness") (why "(LXX, supplied.) Broad room, open space: the name Isaac gives the undisputed well, \"because now the Lord enlarged [room] for us\" (Genesis 26:22).")))

(lemma "Εὐφράτης"
  (sense name
    (gloss "Euphrates")
    (why "(Supplied in Genesis 2:14.) The river, by its traditional English name, as in Revelation 9:14; 16:12.")))

(lemma "εὐφροσύνη" (sense gladness (gloss "gladness") (why "Good cheer, gladness (Genesis 31:27 μετ’ εὐφροσύνης; Acts 2:28; 14:17). \"Gladness\" leaves \"joy\" for χαρά.")))

(lemma "εὐχή" (sense vow (gloss "vow" "vows") (why "A vow (Genesis 28:20 ηὔξατο Ἰακὼβ εὐχήν, \"Jacob vowed [a] vow\"; Acts 18:18; 21:23); a prayer (James 5:15) will be its own sense. Shares \"vow\" with its verb εὔχομαι in the cognate phrase.")))

(lemma "εὔχομαι" (sense vow (gloss "vow" "vowed" "vows" "vowing") (why "To vow (Genesis 28:20 ηὔξατο Ἰακὼβ εὐχήν, the cognate accusative \"vowed [a] vow\", so the English shares \"vow\" with εὐχή as the Greek shares its root). \"Pray, wish\" (Acts 26:29; 2 Corinthians 13:7; 3 John 2) will be its own sense, kept apart from προσεύχομαι. (LXX form supplied.)")) (sense petition (gloss "petition" "petitioned" "petitions" "petitioning") (why "To pray, ask of God (Exodus 8:8 Εὔξασθε περὶ ἐμοῦ πρὸς Κύριον, Pharaoh asking Moses to pray for him; 8:29-30; Acts 26:29; 2 Corinthians 13:7; James 5:16). \"Petition\" because \"pray\" is προσεύχομαι's and \"entreat\" καταδέομαι's.")))

(lemma "εὐώδης" (sense fragrant (gloss "fragrant") (why "(LXX, supplied.) Sweet-smelling, fragrant (Exodus 30:23 κινναμώμου εὐώδους ... καλάμου εὐώδους). The adjective of εὐωδία \"fragrance\".")))

(lemma "εὐωδία" (sense fragrance (gloss "fragrance" "fragrances") (why "A sweet smell, fragrance (Genesis 8:21, ὀσμὴ εὐωδίας, an odor of fragrance; Ephesians 5:2; Philippians 4:18, the same phrase). Kept apart from ὀσμή \"odor\" so the New Testament phrase stays visibly the Septuagint's.")))

(lemma "εὐώνυμος" (sense left (gloss "left") (why "Left, the left side, a euphemism, \"of good name\" (Exodus 14:22, 29, τεῖχος ἐξ εὐωνύμων, \"from left [parts]\", on the left; Matthew 20:21; 25:33). Shares \"left\" with ἀριστερός: English has one word for the side.")))

(lemma "ἐφίστημι" (sense set-over (dative "") (verb "set over" "set over" "set over") (gloss "set over" "sets over" "setting over") (why "The transitive (first aorist) active: to set someone over others, put in charge (Exodus 1:11 ἐπέστησεν αὐτοῖς ἐπιστάτας τῶν ἔργων, \"set over them overseers of the works\"). The intransitive \"stand by, come upon\" of the New Testament (Luke 2:9; Acts 12:7) will be its own sense.")) (sense apply (gloss "apply" "applied" "applies" "applying") (why "Transitive with νοῦς: to set the mind upon, apply it (Exodus 7:23 οὐκ ἐπέστησεν τὸν νοῦν αὐτοῦ οὐδὲ ἐπὶ τούτῳ, Pharaoh did not apply his intellect even to this). \"Set over\" would read as putting someone in charge. Chosen by override.")))

(lemma "ἐφοράω" (sense watch-over (verb "watch over" "watched over" "watched over") (gloss "watch over" "watched over" "watches over" "watching over") (why "To look upon, watch over (Genesis 31:49 Ἐφίδοι ὁ θεός, at the place called Ἡ ὅρασις; Acts 4:29 ἔπιδε; Luke 1:25). \"Watch over\" because \"look upon\" is another verb's.")))

(lemma "Ἐφράθα" (sense name (gloss "Ephrath") (why "(LXX, supplied.) The place where Rachel died, on the way that is Bethlehem (Genesis 35:16, 19), Greek Ἐφράθα; traditional English Ephrath.")))

(lemma "Ἐφραίμ" (sense name (gloss "Ephraim") (why "Joseph's second son (Genesis 41:52, named from ὕψωσέν με; 46:20; 48), Greek Ἐφραίμ (Swete Ἐφράιμ); John 11:54 has a town Ἐφραίμ. Traditional English Ephraim.")))

(lemma "Ἐφρών"(sense name (gloss "Ephron") (why "(LXX, supplied.) The Hittite who sold Abraham the field and cave of Machpelah (Genesis 23; 25:9); traditional English Ephron.")))

(lemma "ἐχθές" (sense yesterday (gloss "yesterday") (why "Yesterday (Genesis 19:34; John 4:52; Hebrews 13:8, Swete's and the New Testament's spelling).")))

(lemma "ἔχθρα"
  (sense enmity
    (gloss "enmity")
    (why "Hostility, enmity (Genesis 3:15; Romans 8:7; Ephesians 2:15-16).")))

(lemma "ἐχθρεύω" (sense be-enemy (dative "to") (verb "be enemy" "was enemy" "been enemy") (gloss "be enemy" "was enemy" "were enemy" "is enemy" "are enemy" "been enemy" "being enemy") (why "(LXX, supplied.) To be an enemy, be hostile to (Exodus 23:22 ἐχθρεύσω τοῖς ἐχθροῖς σου, \"I will be enemy to your enemies\"). The verb of ἐχθρός \"enemy\"; English needs the noun to say it.")))

(lemma "ἐχθρία" (sense hostility (gloss "hostility") (why "(LXX, supplied.) Hostility, enmity: the name Isaac gives the second disputed well (Genesis 26:21). Kept apart from ἔχθρα \"enmity\" (Genesis 3:15), a different word of the same root.")))

(lemma "ἐχθρός" (sense enemy (person) (gloss "enemy" "enemies") (why "Hostile; as a noun, an enemy (Genesis 14:20, who handed over your enemies; Matthew 5:44). Beside ἔχθρα \"enmity\".")))

(lemma "ἔχω"
  (sense have
    (gloss "have" "has" "had" "having")
    (why "To have, hold. The many idioms (\"be ill\", ἔχω + adverb) will be separate senses."))
  (sense hold-to
    (genitive "")
    (verb "hold to" "held to" "held to")
    (gloss "hold to" "held to" "holds to" "holding to")
    (why "The middle with the genitive, to hold on to, so to be next to (Genesis 41:23 ἀνεφύοντο ἐχόμενοι αὐτῶν, the thin ears springing up \"holding to them\"; Mark 1:38 τὰς ἐχομένας κωμοπόλεις; Hebrews 6:9).")))

(lemma "ἕψεμα" (sense stew (gloss "stew" "stews") (why "(LXX, supplied.) Something boiled, a stew, broth (Genesis 25:29-34, Jacob's stew; from ἕψω \"boil\").")))

(lemma "ἕψω" (sense boil (gloss "boil" "boiled" "boils" "boiling") (why "(LXX, supplied.) To boil, cook by boiling (Genesis 25:29 Ἥψησεν δὲ Ἰακὼβ ἕψεμα, \"But Jacob boiled stew\").")))

(lemma "ἑωθινός" (sense daybreak (gloss "daybreak") (why "(LXX, supplied.) Of the early morning, of daybreak (Exodus 14:24, ἐν τῇ φυλακῇ τῇ ἑωθινῇ, the daybreak watch). \"Morning\" is πρωΐ and \"dawn\" ὄρθρος.")))

(lemma "ἕως"
  (sense until
    (gloss "until")
    (why "Until, as far as. With τοῦ and an infinitive (Genesis 3:19, ἕως τοῦ ἀποστρέψαι σε) it is \"until you turn back\".")))
