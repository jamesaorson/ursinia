;; Greek Source Bible concordance, lemmas beginning with ε (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ἐάν"
  (sense ever
    (gloss "ever")
    (why "After a relative pronoun ἐάν stands for ἄν and makes the relative indefinite (ὃ ἐάν, \"which ever\", Genesis 2:19; Matthew 5:19). Same gloss as ἄν. The conditional \"if\" becomes its own sense when first needed."))
  (sense if
    (gloss "if")
    (why "The conditional, \"if\" (Genesis 4:7). The generator takes it wherever ἐάν does not follow a relative.")))

(lemma "ἔαρ" (sense springtime (gloss "springtime" "springtimes") (why "(LXX, supplied.) Spring, the season (Genesis 8:22, summer and springtime). \"Springtime\" because \"spring\" is πηγή's English, a spring of water (Genesis 7:11).")))

(lemma "ἑαυτοῦ"
  (sense self
    (gloss "itself" "himself" "herself" "themselves" "yourself" "yourselves" "myself" "ourselves")
    (why "The reflexive pronoun; the English form follows the referent's person, gender and number. A dative \"for themselves\" carries its case in \"for\".")))

(lemma "ἑβδομήκοντα" (sense seventy (gloss "seventy") (why "The numeral seventy (Genesis 5:12; Acts 7:14).")))

(lemma "ἑβδομηκοντάκις" (sense seventy-times (gloss "seventy times") (why "Seventy times (Genesis 4:24; Matthew 18:22, ἑβδομηκοντάκις ἑπτά, \"seventy times seven\", which takes up this verse).")))

(lemma "ἕβδομος"
  (sense seventh
    (gloss "seventh")
    (why "The ordinal \"seventh\" (Genesis 2:2-3; Hebrews 4:4).")))

(lemma "Ἔβερ" (sense name (gloss "Eber") (why "Shelah's son (Genesis 10:21-25; 11:14-17; Luke 3:35, KJV \"Heber\"), traditional Old Testament English Eber.")))

(lemma "ἐγγίζω" (sense draw-near (gloss "draw near" "drew near" "drawn near" "draws near" "drawing near") (why "To come near, draw near (Genesis 12:11, when Abram drew near to enter Egypt; Mark 1:15, the kingdom has drawn near).")))

(lemma "ἐγγύς" (sense near (gloss "near") (why "Near, close by, with the genitive (Genesis 19:20 ἡ πόλις αὕτη ἐγγὺς τοῦ καταφυγεῖν με ἐκεῖ; John 3:23; Romans 10:8). The adverb of ἐγγίζω \"draw near\".")))

(lemma "ἐγκαταλείπω" (sense forsake (gloss "forsake" "forsook" "forsaken" "forsakes" "forsaking") (why "To leave behind in, abandon, forsake (Genesis 28:15 οὐ μή σε ἐγκαταλείπω; Hebrews 13:5; Matthew 27:46 quoting Psalm 22:1). \"Forsake\" keeps it apart from καταλείπω \"leave\". (LXX form supplied.)")))

(lemma "ἐγκοτέω" (sense resent (dative "") (gloss "resent" "resented" "resents" "resenting") (why "(LXX, supplied.) To bear a grudge against, with the dative (Genesis 27:41 ἐνεκότει Ἠσαὺ τῷ Ἰακώβ, \"Esau was resenting Jacob\"). \"Resent\" because \"bear a grudge\" would need an unbracketed \"a\".")))

(lemma "ἔγκειμαι"(sense lie-in (gloss "lie in" "lay in" "lain in" "lies in" "lying in") (why "(LXX, supplied.) To lie in or on, be set on, be intent on (Genesis 8:21, ἔγκειται ἡ διάνοια ... ἐπὶ τὰ πονηρά, the mind lies intent on evil things). \"Lie in\" renders the ἐν- of the compound; the readable layer will say \"is set on\".")))

(lemma "ἐγκρυφίας" (sense ash-cake (gloss "ash-cake" "ash-cakes") (why "(LXX, supplied.) A loaf baked hidden (ἐν + κρύπτω) in the hot ashes (Genesis 18:6). \"Ash-cake\" names it by how it was baked.")))

(lemma "ἐγχειρίδιον"(sense hand-tool (gloss "hand-tool") (why "(LXX, supplied.) Something held in the hand, a tool or blade (Exodus 20:25). Swete spells ἐνχειρίδιον.")))

(lemma "ἐγώ"
  (sense pronoun
    (gloss "I" "me" "my" "mine" "we" "us" "our" "ours")
    (why "The first-person pronoun, singular and plural (the table lemmatizes ἡμεῖς under ἐγώ). The English form follows the Greek case and number.")))

(lemma "Ἐδέμ"
  (sense name
    (gloss "Eden")
    (why "(LXX, supplied.) The place name, given its traditional English form; the Greek spells it Ἐδέμ, with final μ. In Genesis 3:23-24 the Septuagint translates the same Hebrew word instead, τρυφή \"delight\" (\"the paradise of the delight\").")))

(lemma "ἔδεσμα" (sense delicacy (gloss "delicacy" "delicacies") (why "(LXX, supplied.) Food, a dish, especially a choice one (Genesis 27:4-31, the ἐδέσματα Isaac loves). \"Delicacy\" keeps it apart from βρῶμα \"food\" and βρῶσις.")))

(lemma "Ἐδώμ" (sense name (gloss "Edom") (why "(LXX, supplied.) Esau's other name, \"red\" (Genesis 25:30, from the red stew; 36:1); traditional English Edom.")))

(lemma "ἔθνος" (sense nation (gloss "nation" "nations") (why "A nation, people; plural τὰ ἔθνη, the nations, the Gentiles (Genesis 17:4-6 πατὴρ πλήθους ἐθνῶν, quoted in Romans 4:17-18; 18:18, quoted in Galatians 3:8). \"Nation\" in the literal layer everywhere so the promise to Abraham reads the same in both testaments; the readable layer may say \"Gentiles\".")))

(lemma "εἰ"
  (sense if
    (gloss "if")
    (why "The conditional \"if\". εἰ μή in Genesis 3:11 is rendered word for word (\"if not\") and discussed in a note."))
  (sense oath
    (gloss "")
    (why "εἰ μήν, the oath formula \"surely\" (Genesis 22:17, quoted in Hebrews 6:14): the phrase's English is carried by μήν (sense surely); εἰ is aligned with it and left unrendered, since \"if surely\" says the opposite of an oath.")))

(lemma "εἰδέα" (sense appearance (gloss "appearance") (why "Look, appearance, outward form (Genesis 5:3, Seth begotten κατὰ τὴν εἰδέαν of Adam; Matthew 28:3, the angel's appearance like lightning). Kept apart from εἰκών \"image\", which follows it in Genesis 5:3.")))

(lemma "εἴδωλον" (sense idol (gloss "idol" "idols") (why "Image, idol (Exodus 20:4; 1 Corinthians 8:4).")))

(lemma "εἰκάς" (sense twentieth (dative "") (gloss "twentieth") (why "(LXX, supplied.) The twentieth day of a month, a feminine noun: ἑβδόμῃ καὶ εἰκάδι τοῦ μηνός, \"on [the] seventh and twentieth of the month\" (Genesis 7:11; 8:4, 14), the twenty-seventh day.")))

(lemma "εἴκοσι"(sense twenty (gloss "twenty") (why "The numeral twenty (Genesis 6:3; Acts 27:28).")))

(lemma "εἰκών"
  (sense image
    (gloss "image" "images")
    (why "Image, likeness that represents (Genesis 1:26-27; 2 Corinthians 4:4; Colossians 1:15; 3:10). Kept apart from ὁμοίωσις \"likeness\".")))

(lemma "εἰμί"
  (sense be
    (gloss "be" "am" "is" "are" "was" "were" "been" "being" "will be")
    (why "The verb of being. εἰμί has no aorist, so its imperfect is plain \"was\", not \"was being\"; the progressive is kept for the imperfect of verbs that also have an aorist.")))

(lemma "εἰρήνη" (sense peace (gloss "peace") (why "Peace (Genesis 15:15 μετ᾽ εἰρήνης, \"with peace\"; Luke 2:29).")))

(lemma "εἷς"
  (sense one
    (gloss "one")
    (why "The numeral, kept as \"one\" so emphatic uses (οὐδὲ ἕν, \"not even one\") stay visible. Genesis 1:5 ἡμέρα μία is \"day one\", a cardinal, not \"the first day\".")))

(lemma "εἰς"
  (sense into
    (gloss "into")
    (why "Motion into, and the Hebrew-style \"come to be into\" / \"be into\" (Genesis 2:7, 24), which the literal layer keeps (\"the two will be into one flesh\") and the readable layer renders \"become\". Also εἰς τὸν αἰῶνα, \"into the age\"."))
  (sense for
    (gloss "for")
    (why "Purpose or destination: \"for signs\", \"for eating\" (Genesis 1:14, 29). A different English preposition because \"into food\" would mislead; the Greek is the same word.")))

(lemma "εἰσάγω" (sense bring-in (gloss "bring in" "brought in" "brings in" "bringing in") (why "To lead in, bring in (Genesis 6:19, the animals into the ark; Luke 2:27). \"Bring in\" against ἐξάγω \"bring out\".")))

(lemma "εἰσακούω" (sense hearken (genitive "to") (gloss "hearken" "hearkened" "hearkens" "hearkening") (why "To hear and attend to, hearken (Genesis 21:17 εἰσήκουσεν ὁ θεὸς τῆς φωνῆς; Luke 1:13 εἰσηκούσθη ἡ δέησίς σου; Hebrews 5:7). \"Hearken\" keeps it apart from ἀκούω \"hear\", ἐπακούω \"listen to\" and ὑπακούω \"obey\"; the readable layer will want a modern word. The genitive of the one heard takes \"to\".")))

(lemma "εἰσέρχομαι" (sense go-in (gloss "go in" "went in" "goes in" "going in" "gone in") (why "To go in, enter. \"Go in\" to match ἐξέρχομαι \"go forth\" and keep the compound visible.")))

(lemma "εἰσπορεύομαι" (sense enter (gloss "enter" "entered" "enters" "entering") (why "To go in, enter (Genesis 6:4; Mark 1:21). \"Enter\" to keep it apart from εἰσέρχομαι \"go in\", as ἐκπορεύομαι \"go out\" is kept apart from ἐξέρχομαι \"go forth\". In Genesis 6:4 εἰσπορεύεσθαι πρός is to go in to a woman; the literal layer keeps \"were entering to\".")))

(lemma "εἰσσπάω" (sense draw-in (verb "draw in" "drew" "drawn") (gloss "draw in" "drew in" "drawn in" "draws in" "drawing in") (why "(LXX, supplied.) To draw in, pull inside (Genesis 19:10, the men drew Lot in to themselves). The middle is rendered active.")))

(lemma "εἰσφέρω" (sense carry-in (gloss "carry in" "carried in" "carries in" "carrying in") (why "To carry in, bring in (Genesis 27:10, 18, 25, 31, 33, Jacob and Esau bringing food in to Isaac; Luke 5:18). \"Carry in\" follows φέρω \"carry\" and keeps it apart from εἰσάγω \"bring in\".")))

(lemma "ἐκ"
  (sense out-of
    (gloss "out of")
    (why "Origin, \"out of\", against ἀπό \"from\" (Genesis 2:23 ἐκ τῶν ὀστέων μου, \"out of my bones\").")))

(lemma "ἕκαστος" (sense each (gloss "each") (why "Each, every one (Genesis 11:7, \"each the voice of the neighbor\"; Matthew 16:27). Kept apart from πᾶς \"every\".")))

(lemma "ἑκατόν" (sense hundred (gloss "one hundred") (why "The numeral one hundred (Genesis 5; Matthew 18:12). \"One hundred\", not \"a hundred\", so no article is supplied; the larger hundreds (διακόσιοι, τριακόσιοι...) are single Greek words with their own entries.")))

(lemma "ἑκατονταετής" (sense hundred-years-old (gloss "hundred-years-old") (why "(LXX, supplied.) A hundred years old (Genesis 17:17 τῷ ἑκατονταετεῖ \"to the hundred-years-old [one]\"; Romans 4:19 ἑκατονταετής που ὑπάρχων).")))

(lemma "ἑκατοστεύω" (sense yield-hundredfold (gloss "yield hundredfold" "yielded hundredfold" "yields hundredfold" "yielding hundredfold") (why "(LXX, supplied.) To bear a hundred times over (from ἑκατόν, Genesis 26:12 ἑκατοστεύουσαν κριθήν, \"barley yielding hundredfold\").")))

(lemma "ἐκβάλλω"
  (sense cast-out
    (gloss "cast out" "casts out" "casting out")
    (why "To throw out, drive out (Genesis 3:24; Mark 1:34, casting out demons). Same gloss in both testaments.")))

(lemma "ἐκδικέω" (sense avenge (gloss "avenge" "avenged" "avenges" "avenging") (why "To avenge, punish (Romans 12:19; Revelation 6:10).")))

(lemma "ἐκεῖ"
  (sense there
    (gloss "there")
    (why "The adverb of place.")))

(lemma "ἐκεῖθεν"
  (sense from-there
    (gloss "from there")
    (why "The adverb of place from which (Genesis 2:10).")))

(lemma "ἐκεῖνος"
  (sense that
    (gloss "that" "those")
    (why "The far demonstrative, against οὗτος \"this\". Never turned into a personal pronoun.")))

(lemma "ἐκζητέω" (sense seek-out (gloss "seek out" "sought out" "seeks out" "seeking out") (why "To seek out, search for; of blood, to require it back (Genesis 9:5, ἐκζητήσω three times; Luke 11:50-51; Hebrews 11:6; 12:17). \"Seek out\" renders ἐκ- + ζητέω and leaves bare \"seek\" for ζητέω; \"require\" is a reading for the readable layer.")))

(lemma "ἐκκαλέω" (sense call-out (gloss "call out" "called out" "calls out" "calling out") (why "(LXX, supplied.) To call out, summon out of a place (Genesis 19:5, the men of Sodom calling Lot out). The middle is rendered active; kept apart from καλέω \"call\".")))

(lemma "ἐκκενόω" (sense empty-out (gloss "empty out" "emptied out" "empties out" "emptying out") (why "(LXX, supplied.) To empty out, pour out completely (Genesis 24:20, the jar emptied into the trough). Kept apart from κενόω \"empty\" (Philippians 2:7) by the particle.")))

(lemma "ἐκκλίνω"(sense turn-aside (gloss "turn aside" "turned aside" "turns aside" "turning aside") (why "To turn aside, turn away (Genesis 18:5, the guests turned aside to Abraham; Romans 3:12; 16:17; 1 Peter 3:11). Kept apart from the στρέφω compounds.")))

(lemma "ἐκλέγω" (sense choose (gloss "choose" "chose" "chosen" "chooses" "choosing") (why "Middle: to pick out for oneself, choose (Genesis 6:2; Luke 6:13; Ephesians 1:4).")))

(lemma "ἐκλείπω" (sense fail (intransitive) (gloss "fail" "failed" "fails" "failing") (why "(LXX sense, supplied.) To leave off, fail, give out (Genesis 8:13, the water was failing from the earth; Luke 16:9; 22:32, that your faith may not fail; Hebrews 1:12).")))

(lemma "ἐκλύω" (sense loosen (gloss "loosen" "loosened" "loosens" "loosening") (why "To loose, release; passive, to grow faint (Matthew 15:32; Galatians 6:9). Genesis 27:40, Esau will loosen Jacob's yoke from his neck. The passive \"faint\" will be its own sense. (LXX form supplied.)")))

(lemma "ἐκλεκτός" (sense choice (gloss "choice") (why "Picked out, choice, the best (Genesis 23:6, ἐν τοῖς ἐκλεκτοῖς μνημείοις ἡμῶν, \"in our choice tombs\"). \"Choice\" keeps it apart from ἐκλέγω \"choose\" (\"chosen\"); the New Testament's \"elect\" (Matthew 24:22; Romans 8:33), of persons, may become its own sense.")))

(lemma "ἐκνήφω" (sense sober-up (gloss "sober up" "sobered up" "sobers up" "sobering up") (why "To become sober out of drunkenness (Genesis 9:24, Noah ἐξένηψεν ἀπὸ τοῦ οἴνου; 1 Corinthians 15:34). Against νήφω \"be sober\".")))

(lemma "ἐκπέμπω" (sense send-off(gloss "send off" "sent off" "sends off" "sending off") (why "To send away, send off on a journey (Genesis 24:54, 56, 59; Acts 13:4; 17:10). \"Send off\" keeps it apart from πέμπω \"send\" and ἐξαποστέλλω \"send out\".")))

(lemma "ἐκπορεύομαι"
  (sense go-out
    (gloss "go out" "goes out" "going out" "went out")
    (why "To go out, come out. Genesis 2:10 (a river going out of Eden) is echoed in Revelation 22:1 (a river ἐκπορευόμενον from the throne); one gloss keeps the echo. John 15:26 (the Spirit who ἐκπορεύεται from the Father) will read \"goes out\", not the traditional \"proceeds\".")))

(lemma "ἔκστασις"
  (sense trance
    (gloss "trance")
    (why "(Supplied in Genesis 2:21.) A standing outside oneself: trance (Acts 10:10; 11:5; 22:17), and astonishment (Mark 5:42), which will be its own sense. Genesis 2:21 says God cast a trance on Adam where translations from the Hebrew have \"a deep sleep\".")))

(lemma "ἐκτείνω"
  (sense stretch-out
    (gloss "stretch out" "stretched out" "stretches out" "stretching out")
    (why "(Supplied in Genesis 3:22.) To stretch out the hand (Matthew 8:3; 12:13).")))

(lemma "ἕκτος"
  (sense sixth
    (gloss "sixth")
    (why "The ordinal \"sixth\".")))

(lemma "ἐκτρίβω" (sense rub-out (gloss "rub out" "rubbed out" "rubs out" "rubbing out") (verb "rub out" "rubbed" "rubbed") (why "(LXX, supplied.) To rub out, wipe away completely, destroy (Genesis 19:13-14, 29, the angels' word for what they will do to Sodom). \"Rub out\" keeps its picture and keeps it apart from ἀπόλλυμι \"destroy\", ἀπαλείφω \"wipe out\" and ἐξαλείφω \"blot out\".")))

(lemma "ἐκφέρω"
  (sense bring-forth
    (gloss "bring forth" "brought forth" "brings forth" "bringing forth")
    (why "To carry out, bring forth; of the earth, to produce (Genesis 1:12; Hebrews 6:8). \"Bring forth\" keeps it apart from ἐξάγω \"bring out\". The sense \"carry out\" (a corpse, Acts 5:6) becomes its own sense.")))

(lemma "ἐκχέω" (sense pour-out (gloss "pour out" "poured out" "pours out" "pouring out") (why "To pour out, shed (Genesis 9:6, ὁ ἐκχέων αἷμα ἀνθρώπου, of blood; Matthew 26:28; Acts 2:17, of the Spirit). \"Pour out\" serves blood, wine and the Spirit alike; \"shed\" is a reading.")))

(lemma "ἐλαία" (sense olive (gloss "olive" "olives") (why "The olive tree, and its fruit (Genesis 8:11, a leaf of olive; Romans 11:17, 24; the Mount of Olives, Matthew 21:1).")))

(lemma "ἔλαιον" (sense oil (gloss "oil") (why "Olive oil (Genesis 28:18, Jacob pours oil on the stone; Luke 10:34; Hebrews 1:9). (LXX form supplied.)")))

(lemma "ἐλάσσων"
  (sense lesser
    (gloss "lesser")
    (why "Smaller, lesser (Genesis 1:16; John 2:10; Romans 9:12, \"the greater will serve the lesser\" from Genesis 25:23, where traditional English says \"the younger\").")))

(lemma "ἐλάτη" (sense fir (gloss "fir" "firs") (why "(LXX, supplied.) A fir tree (Genesis 21:15, ὑποκάτω μιᾶς ἐλάτης), where the Hebrew has a bush.")))

(lemma "ἐλαττονόω" (sense diminish (voice active) (intransitive) (gloss "diminish" "diminished" "diminishes" "diminishing") (why "(LXX, supplied.) To make less; passive, to become less, diminish (Genesis 8:3, 5, the water was diminishing; 18:28). The passive is rendered as the intransitive \"diminish\". Kept apart from ἐλάσσων \"less\" by the verb form.")))

(lemma "ἐλέγχω" (sense reprove (gloss "reprove" "reproved" "reproves" "reproving") (why "To bring to account, reprove, rebuke (Genesis 21:25 ἤλεγξεν Ἀβραὰμ τὸν Ἀβιμέλεχ; Matthew 18:15; John 16:8).")))

(lemma "ἔλεος"(sense mercy (gloss "mercy") (why "Mercy.")))

(lemma "Ἐλιέζερ" (sense name (gloss "Eliezer") (why "Abram's house-born heir (Genesis 15:2); also the name in Luke 3:29. Traditional English Eliezer.")))

(lemma "Ἐλισά" (sense name (gloss "Elishah") (why "(LXX, supplied.) Javan's son (Genesis 10:4), traditional English Elishah. The Greek of 10:2 also lists Ἐλισά among Japheth's sons, where the Hebrew has no such name.")))

(lemma "Ἐλμωδάδ" (sense name (gloss "Almodad") (why "(LXX, supplied.) A son of Joktan (Genesis 10:26), Greek Ἐλμωδάδ; traditional English Almodad.")))

(lemma "Ἐλλασάρ" (sense name (gloss "Ellasar") (why "(LXX, supplied.) Arioch's kingdom (Genesis 14:1, 9); traditional English Ellasar.")))

(lemma "ἐλπίζω" (sense hope (gloss "hope" "hoped" "hopes" "hoping") (why "To hope.")))

(lemma "ἐμαυτοῦ" (sense myself (gloss "myself") (why "The first person reflexive, myself (Genesis 12:19, \"I took her to myself for wife\"; John 5:31).")))

(lemma "ἐμός" (sense my (gloss "my") (why "The possessive adjective \"my\" (Genesis 22:18 τῆς ἐμῆς φωνῆς; John 4:34). It shares \"my\" with the genitive μου, the same meaning in another form.")))

(lemma "ἐμπίπτω" (sense fall-in (verb "fall in" "fell" "fallen") (gloss "fall in" "fell in" "fallen in" "falls in" "falling in") (why "To fall in, fall into (Genesis 14:10, the kings fell in there, into the asphalt pits; Matthew 12:11; Luke 10:36). Kept apart from πίπτω \"fall\" and ἐπιπίπτω \"fall upon\".")))

(lemma "ἔμπορος" (sense merchant (person) (gloss "merchant" "merchants") (why "A merchant, trader (Genesis 23:16, silver approved ἐμπόροις, Swete's ἐνπόροις; Matthew 13:45; Revelation 18:3).")))

(lemma "ἔμπροσθεν" (sense ahead-of (gloss "ahead of") (why "In front of, ahead of, with the genitive (Genesis 24:7, the angel sent ἔμπροσθέν σου; Matthew 11:10; John 3:28, \"sent ahead of him\"). \"Ahead of\" keeps it apart from ἐναντίον \"in front of\", ἐνώπιον \"in sight of\" and πρό \"before\".")))

(lemma "ἐμφράσσω" (sense stop-up (gloss "stop up" "stopped up" "stops up" "stopping up") (why "To block, stop up (Genesis 26:15, 18, the Philistines stopped up the wells; Romans 3:19 and Hebrews 11:33 φράσσω, \"stop\" a mouth).")))

(lemma "ἐμφυσάω"
  (sense breathe
    (gloss "breathe" "breathed" "breathes" "breathing")
    (why "To breathe into or on. Rare: in the New Testament only John 20:22, where Jesus ἐνεφύσησεν on the disciples and says \"Receive the Holy Spirit\", the same verb God uses in Genesis 2:7. One gloss keeps the echo.")))

(lemma "ἐν"
  (sense in
    (gloss "in")
    (why "Location in, among or within, of place or time. The instrumental use (\"with, by\") becomes its own sense when first needed.")))

(lemma "ἐναντίον" (sense in-front-of (gloss "in front of") (why "Facing, before, in the presence of, with the genitive (Genesis 6:8, 11, 13; Luke 1:6; Acts 8:32). \"In front of\" to keep it apart from πρό \"before\" and κατέναντι \"opposite\"; ἔμπροσθεν will need its own English (\"in front\" is the natural word for it too). Not \"in the presence of\", which would put an unbracketed \"the\" in the text.")))

(lemma "ἑνδέκατος" (sense eleventh (gloss "eleventh") (why "(LXX, supplied.) The ordinal \"eleventh\" (Genesis 8:5, the eleventh month; Matthew 20:6, 9, the eleventh hour).")))

(lemma "ἐνδίδωμι" (sense give-way (intransitive) (gloss "give way" "gave way" "given way" "gives way" "giving way") (why "(LXX, supplied.) To give in, yield, give way (Genesis 8:3, the water was giving way, going from the earth: it was receding). \"Give way\" keeps the root δίδωμι \"give\".")))

(lemma "ἐνδύω"
  (sense clothe
    (gloss "clothe" "clothed" "clothes" "clothing")
    (why "(Supplied in Genesis 3:21.) Active: to clothe someone; middle: to put on, clothe oneself (Romans 13:14; Galatians 3:27). \"Clothe\" for both so the image of being clothed carries across.")))

(lemma "ἕνεκα"
  (sense on-account-of
    (gloss "on account of")
    (why "Cause: \"on account of\" (ἕνεκεν τούτου, Genesis 2:24; Matthew 19:5 has ἕνεκα τούτου). Kept apart from διὰ τοῦτο, which will take \"because of this\".")))

(lemma "ἐνενήκοντα" (sense ninety (gloss "ninety") (why "The numeral ninety (Genesis 5:9, 17; Matthew 18:12, ἐνενήκοντα ἐννέα).")))

(lemma "ἐνευλογέω" (sense bless (gloss "bless" "blessed" "blesses" "blessing") (why "To bless in someone (Genesis 18:18 ἐνευλογηθήσονται ἐν αὐτῷ, quoted in Galatians 3:8; Acts 3:25). It shares \"bless\" with εὐλογέω: the compound's ἐν- is repeated by the ἐν that follows it, and \"bless in\" would print \"blessed in in him\". The alignment shows which verb stands behind it.")))

(lemma "ἐνθυμέομαι" (sense ponder (gloss "ponder" "pondered" "ponders" "pondering") (why "To take to heart, ponder, think over (Genesis 6:6; Matthew 1:20; 9:4). \"Ponder\" to keep it apart from διανοέομαι \"think through\", which follows it in Genesis 6:6.")))

(lemma "ἐνιαυτός"
  (sense year
    (with-preposition "εἰς" for)
    (gloss "year" "years")
    (why "A year, a cycle of seasons (Genesis 1:14; Luke 4:19). ἔτος, the other word for year, will be distinguished in a note if needed.")))

(lemma "ἐνισχύω" (sense strengthen (gloss "strengthen" "strengthened" "strengthens" "strengthening") (why "To strengthen (Luke 22:43; Acts 9:19), and intransitively to grow strong, prevail (Genesis 12:10, the famine strengthened over the land). One English verb for both; English \"strengthen\" is also intransitive.")))

(lemma "ἐννακόσιοι" (sense nine-hundred (gloss "nine hundred") (why "(LXX, supplied.) The numeral nine hundred (Genesis 5). Swete spells it ἐννακόσιοι, with double ν.")))

(lemma "ἐννέα" (sense nine (gloss "nine") (why "The numeral nine (Genesis 5:27; Luke 17:17).")))

(lemma "ἐνοράω" (sense observe (gloss "observe" "observed" "observes" "observing") (why "(LXX, supplied.) To look into, observe, see something in a matter (Genesis 20:10 Τί ἐνιδὼν ἐποίησας τοῦτο; \"Having observed what did you do this?\"). Kept apart from ὁράω \"see\".")))

(lemma "ἔνοχος" (sense liable (genitive "to") (gloss "liable") (why "Held in, liable, subject to, with the genitive of the penalty (Genesis 26:11 θανάτου ἔνοχος ἔσται, \"to death liable will be\"; Matthew 26:66; Hebrews 2:15).")))

(lemma "ἐντέλλομαι"
  (sense command
    (dative "")
    (gloss "command" "commanded" "commands" "commanding")
    (why "To command, give an order (Genesis 2:16; 3:11, 17; Matthew 28:20). The noun ἐντολή will take \"commandment\".")))

(lemma "ἐνυπνιάζομαι" (sense dream (gloss "dream" "dreamed" "dreams" "dreaming") (why "To dream (Genesis 28:12, Jacob at Bethel; Acts 2:17 quoting Joel 2:28; Jude 8). The aorist is passive in form, rendered active. (LXX form supplied.)")))

(lemma "ἐντολή" (sense commandment (gloss "commandment" "commandments") (why "A command, commandment (Genesis 26:5; Matthew 22:36-40). \"Commandment\" beside the verb ἐντέλλομαι \"command\".")))

(lemma "ἐνώπιον" (sense in-sight-of (gloss "in sight of") (why "Before, in the sight of, with the genitive (Genesis 11:28, Haran died in sight of Terah his father; Luke 1:15, 19). \"In sight of\" keeps it apart from πρό \"before\" and ἐναντίον \"in front of\"; not \"in the sight of\", which would put an unbracketed \"the\" in the text."))
  (sense in-sight
    (gloss "in sight")
    (why "Without a genitive, as an adverb: openly, face to face (Genesis 16:13-14 ἐνώπιον ἴδον, \"in sight I saw\"). A word override chooses it.")))

(lemma "Ἐνώς" (sense name (gloss "Enosh") (why "Traditional English form of Seth's son (Luke 3:38).")))

(lemma "ἐνώτιον" (sense earring (gloss "earring" "earrings") (why "(LXX, supplied.) An earring, or a ring for the nose or ear (Genesis 24:22, 30, 47, gifts to Rebekah). The word is from οὖς \"ear\".")))

(lemma "ἐνωτίζομαι" (sense give-ear (gloss "give ear" "gave ear" "gives ear" "giving ear") (why "To give ear to, listen closely (Acts 2:14).")))

(lemma "Ἑνώχ" (sense name (gloss "Enoch") (why "Traditional English form (Cain's son, Genesis 4:17; the other Enoch, Jude 14).")))

(lemma "ἕξ" (sense six (gloss "six") (why "Six.")))

(lemma "ἐξάγω"
  (sense bring-out
    (gloss "bring out" "brought out" "brings out" "bringing out")
    (why "To lead out, bring out (Genesis 1:20-24; Acts 7:36, Moses leading Israel out). Against ἐκφέρω \"bring forth\".")))

(lemma "ἑξακόσιοι" (sense six-hundred (gloss "six hundred") (why "(LXX, supplied.) The numeral six hundred (Genesis 7:6, Noah was of six hundred years; Revelation 13:18; 14:20).")))

(lemma "ἑξακοσιοστός" (sense six-hundredth (gloss "six hundredth") (why "(LXX, supplied.) The ordinal \"six hundredth\" (Genesis 7:11; 8:13, ἐν τῷ ἑνὶ καὶ ἑξακοσιοστῷ ἔτει, \"in the one and six hundredth year\", kept word for word).")))

(lemma "ἐξαλείφω" (sense blot-out (verb "blot out" "blotted" "blotted") (gloss "blot out" "blotted out" "blots out" "blotting out") (why "To wipe out, blot out (Genesis 7:4, 23, of the flood; Acts 3:19, that your sins may be blotted out; Revelation 3:5). \"Blot out\" keeps it apart from ἀπαλείφω \"wipe out\" (Genesis 6:7), as that entry asked.")))

(lemma "ἐξανατέλλω"
  (sense cause-to-spring-up
    (verb "cause to spring up")
    (gloss "caused to spring up" "cause to spring up" "causes to spring up")
    (why "Transitive in Genesis 2:9 (God made every tree spring up out of the earth). Intransitive \"spring up\" (Matthew 13:5) becomes its own sense. Kept apart from ἀνατέλλω \"rise\" by the ἐξ- (\"spring up out\").")))

(lemma "ἐξανίστημι" (sense raise-up (gloss "raise up" "raised up" "raises up" "raising up") (why "Transitive: to raise up (offspring), Genesis 4:25; Mark 12:19. Kept apart from ἀνίστημι \"stand up\"."))
  (sense get-up (verb "get up" "got" "gotten") (gloss "get up" "got up" "gotten up" "gets up" "getting up") (why "Intransitive (second aorist and middle): to get up, rise and set out (Genesis 18:16 Ἐξαναστάντες δὲ ἐκεῖθεν οἱ ἄνδρες; Acts 15:5). \"Get up\" because \"rise\" is ἀνατέλλω's and \"stand up\" ἀνίστημι's.")))

(lemma "ἐξαποστέλλω"
  (sense send-out
    (gloss "send out" "sent out" "sends out" "sending out")
    (why "To send out, send away (Genesis 3:23; Luke 1:53; Galatians 4:4-6, God sent out his Son). Against ἀποστέλλω, which will take \"send\".")))

(lemma "ἐξαριθμέω" (sense count (gloss "count" "counted" "counts" "counting") (why "(LXX, supplied.) To count out, count completely (Genesis 13:16, if anyone is able to count the sand of the earth). \"Count\" keeps it apart from ἀριθμέω \"number\" in the same verse.")))

(lemma "ἐξεγείρω" (sense awake (voice active) (gloss "awake" "awoke" "awoken" "awakes" "awaking") (why "To rouse; passive, to wake up (Genesis 28:16 ἐξηγέρθη Ἰακὼβ ἀπὸ τοῦ ὕπνου αὐτοῦ). The passive is rendered active, \"awoke\". The active \"raise up\" (Romans 9:17) will be its own sense. (LXX form supplied.)")))

(lemma "ἐξέρχομαι" (sense go-forth (gloss "go forth" "went forth" "goes forth" "going forth" "gone forth") (why "To go out, go forth. \"Go forth\" so as not to share \"go out\" with ἐκπορεύομαι.")))

(lemma "ἑξήκοντα" (sense sixty (gloss "sixty") (why "The numeral sixty (Genesis 5; Matthew 13:8).")))

(lemma "ἐξίστημι" (sense be-amazed (verb "be amazed") (gloss "be amazed" "was amazed" "were amazed" "is amazed" "been amazed" "being amazed") (why "Intransitive (second aorist ἐξέστη): to stand out of oneself, be amazed (Genesis 27:33 ἐξέστη δὲ Ἰσαὰκ ἔκστασιν μεγάλην, with its own noun ἔκστασις \"trance\"; Mark 2:12; Luke 2:47). (LXX form supplied.)")))

(lemma "ἐξολεθρεύω" (sense destroy-utterly (gloss "destroy utterly" "destroyed utterly" "destroys utterly" "destroying utterly") (why "(LXX, supplied.) To destroy utterly, root out (Genesis 17:14 ἐξολεθρευθήσεται ἡ ψυχὴ ἐκείνη; Acts 3:23 quotes the formula). \"Destroy utterly\" keeps it apart from ἀπόλλυμι \"destroy\".")))

(lemma "ἐξορκίζω" (sense adjure (gloss "adjure" "adjured" "adjures" "adjuring") (why "To put under oath, adjure (Genesis 24:3, ἐξορκίσω σε Κύριον; Matthew 26:63, ἐξορκίζω σε κατὰ τοῦ θεοῦ). Kept apart from ὁρκίζω \"swear in\" and ὀμνύω \"swear\".")))

(lemma "ἔξω" (sense outside (gloss "outside") (why "Outside, out of doors (Genesis 9:22, he told his two brothers ἔξω; Matthew 26:69; John 6:37). It shares \"outside\" with ἔξωθεν, unavoidably: English has one word for both; ἔξωθεν, \"from outside\", is the rarer.")))

(lemma "ἔξωθεν"(sense outside (gloss "outside") (why "From outside, on the outside (Genesis 6:14, the ark pitched ἔσωθεν καὶ ἔξωθεν; Matthew 23:27). Paired with ἔσωθεν \"inside\".")))

(lemma "ἐπάγω" (sense bring-on (gloss "bring on" "brought on" "brings on" "bringing on") (why "To bring upon (Genesis 6:17, the flood; 2 Peter 2:5, ἐπάξας κατακλυσμόν). \"Bring on\" against ἄγω and its other compounds.")))

(lemma "ἐπαινέω" (sense praise (gloss "praise" "praised" "praises" "praising") (why "To praise, commend (Genesis 12:15, the officials praised Sarai to Pharaoh; Luke 16:8; 1 Corinthians 11:2).")))

(lemma "ἐπαίρω" (sense lift-up (gloss "lift up" "lifted up" "lifts up" "lifting up") (why "To lift up, raise (Genesis 7:17, the water lifted up the ark; Luke 6:20; John 17:1, lifting up his eyes). Kept apart from ὑψόω \"raise high\".")))

(lemma "ἐπακούω" (sense listen-to (genitive "") (dative "") (gloss "listen to" "listened to" "listens to" "listening to") (why "To listen to, give a hearing to, with the genitive (Genesis 17:20 ἐπήκουσά σου \"I listened to you\"; 2 Corinthians 6:2 quoting Isaiah 49:8). Kept apart from ἀκούω \"hear\".")))

(lemma "ἐπαναστρέφω" (sense come-back-again (verb "come back again" "came" "come") (gloss "come back again" "came back again" "comes back again" "coming back again") (why "(LXX, supplied.) To come back again, return (Genesis 18:10 Ἐπαναστρέφων ἥξω \"coming back again I will come\"). Built on ἀναστρέφω \"come back\", with \"again\" for the added ἐπ-, as ἐπιστρέφω \"turn again\".")))

(lemma "ἐπάνω"
  (sense over
    (gloss "over")
    (why "Above, over, on top of (Genesis 1:2, 7, 29; Matthew 2:9, the star stood over where the child was). One gloss, \"over\". The sense \"more than\" (Mark 14:5) becomes its own sense."))
  (sense upward
    (gloss "upward")
    (why "As an adverb with a measure, upward, higher: δέκα πέντε πήχεις ἐπάνω ὑψώθη τὸ ὕδωρ, \"ten five cubits upward the water was raised high\" (Genesis 7:20). \"Over\" would read as a preposition governing the next noun; chosen by word override.")))

(lemma "ἔπαυλις" (sense homestead (gloss "homestead" "homesteads") (why "A farmstead, an unwalled dwelling-place with its folds (Genesis 25:16, Ishmael's sons \"in their tents and in their homesteads\"; Acts 1:20, quoting Psalm 68:26 LXX).")))

(lemma "ἐπαύριον" (sense morrow (dative "on") (gloss "morrow") (why "Tomorrow; with the article, ἡ ἐπαύριον (ἡμέρα), the next day (Genesis 19:34 τῇ ἐπαύριον \"on the morrow\"; Matthew 27:62; John 1:29). \"Morrow\" because the article needs a noun in English.")))

(lemma "ἐπεί" (sense when (gloss "when") (why "When, since (Genesis 15:17 ἐπεὶ δὲ ἐγίνετο ὁ ἥλιος πρὸς δυσμαῖς; Luke 1:34 \"since\"). \"When\" is shared with ὅτε and ἡνίκα, \"since\" being διότι's.")))

(lemma "ἐπειδή"(sense seeing-that (gloss "seeing that") (why "Since, seeing that (Genesis 18:31 Ἐπειδὴ ἔχω λαλῆσαι; Luke 7:1; 1 Corinthians 1:21-22). \"Seeing that\" because διότι takes \"since\" and ὅτι \"because\".")))

(lemma "ἐπεῖδον" (sense look (gloss "look" "looked" "looks" "looking") (why "The aorist of ἐφοράω, to look upon (with favor): Genesis 4:4; Luke 1:25. Swete spells ἔπιδεν. \"Look\": the ἐπί that follows it in Genesis 4:4 gives the \"upon\"."))
  (sense look-upon
    (gloss "look upon" "looked upon" "looks upon" "looking upon")
    (why "With a direct object and no ἐπί: to look upon (Genesis 16:13 ὁ θεὸς ὁ ἐφιδών με, \"the God the [one] having looked upon me\"; Luke 1:25).")))

(lemma "ἐπερωτάω" (sense question (gloss "question" "questioned" "questions" "questioning") (why "To ask, put a question to, inquire of (Genesis 26:7; Mark 9:32; Luke 2:46). \"Question\" keeps it apart from αἰτέω \"ask\", δέομαι \"beg\" and πυνθάνομαι \"inquire\".")))

(lemma "ἐπέχω" (sense hold-on (gloss "hold on" "held on" "holds on" "holding on") (why "(LXX sense, supplied.) Intransitive: to hold on, wait, stay (Genesis 8:10, 12, ἐπισχὼν ἔτι ἡμέρας ἑπτά, having held on yet seven days; Acts 19:22). \"Hold on\" keeps the root ἔχω \"have, hold\"; the New Testament's \"give heed\" (Luke 14:7; 1 Timothy 4:16) will be its own sense.")))

(lemma "ἐπί"
  (sense upon
    (gloss "upon")
    (why "Of place, with the genitive, dative or accusative: \"upon\" (upon the earth, upon Adam, upon your breast). \"Upon\" rather than \"on\" because it also covers the birds flying \"upon the earth\" (Genesis 1:20). The many non-spatial uses (\"in the time of\", \"on the basis of\", \"against\") will be separate senses.")))

(lemma "ἐπιβαίνω" (sense mount (gloss "mount" "mounted" "mounts" "mounting") (why "To go up on, mount (Genesis 24:61, ἐπέβησαν ἐπὶ τὰς καμήλους; Matthew 21:5, mounted on a donkey; Acts 21:2, embarking).")))

(lemma "ἐπιβάλλω"
  (sense cast
    (gloss "cast" "casts" "casting")
    (why "To throw or lay upon (Genesis 2:21, a trance; Mark 14:46, laying hands on). \"Cast\", from βάλλω, which will also take \"cast\" with its own note; the compound's ἐπι- is usually echoed by the following ἐπί \"upon\".")))

(lemma "ἐπιβλέπω" (sense gaze (gloss "gaze" "gazed" "gazes" "gazing") (why "To look attentively at, gaze (Genesis 19:26, Lot's wife ἐπέβλεψεν εἰς τὰ ὀπίσω; 19:28; Luke 1:48; 9:38). \"Gaze\" keeps it apart from βλέπω \"see\", ἀναβλέπω \"look up\" and ἐπεῖδον \"look\".")))

(lemma "ἐπιγινώσκω" (sense recognize (gloss "recognize" "recognized" "recognizes" "recognizing") (why "To know fully, recognize (Genesis 27:23, Isaac did not recognize Jacob; Luke 24:16, 31). \"Recognize\" keeps it apart from γινώσκω \"know\". (LXX form supplied.)")))

(lemma "ἐπιθυμέω"(sense desire (genitive "") (gloss "desire" "desired" "desires" "desiring") (why "To desire, set the heart on. \"Desire\" in the literal layer (Exodus 20:17; Romans 7:7 quotes it); the readable layer may say \"covet\".")))

(lemma "ἐπικαλέω" (sense call-upon (voice active) (gloss "call upon" "called upon" "calls upon" "calling upon") (why "Middle: to call upon (a name), Genesis 4:26; Romans 10:13.")))

(lemma "ἐπικαλύπτω" (sense cover-over (gloss "cover over" "covered over" "covers over" "covering over") (why "To cover over (Genesis 7:19-20, the water covered over all the high mountains; Romans 4:7, whose sins were covered over, from Psalm 31:1). \"Cover over\" for the ἐπι- of the compound.")))

(lemma "ἐπικατάρατος"
  (sense cursed
    (gloss "cursed")
    (why "Accursed, under a curse (Genesis 3:14, 17; Galatians 3:10, 13 quoting Deuteronomy). καταράομαι and its participle will need a note so the two do not merge.")))

(lemma "ἐπικλίνω" (sense tilt (gloss "tilt" "tilted" "tilts" "tilting") (why "(LXX, supplied.) To bend, lean over, tilt (Genesis 24:14, Ἐπίκλινον τὴν ὑδρίαν σου, tilting the jar for a drink). Kept apart from κλίνω \"bend\" and ἐκκλίνω.")))

(lemma "ἐπικρατέω" (sense prevail (intransitive) (gloss "prevail" "prevailed" "prevails" "prevailing") (why "(LXX, supplied.) To gain the mastery, prevail (Genesis 7:18-19, 24, the water was prevailing on the earth). Kept apart from κρατέω, which will need its own English.")))

(lemma "ἐπιλανθάνομαι" (sense forget (verb "forget" "forgot" "forgotten") (gloss "forget" "forgot" "forgotten" "forgets" "forgetting") (why "To forget, with the accusative or genitive (Genesis 27:45, until Esau forgets what Jacob did; Hebrews 13:2; James 1:24). (LXX form supplied.)")))

(lemma "ἐπιλαμβάνω" (sense take-hold (genitive "of") (gloss "take hold" "took hold" "taken hold" "takes hold" "taking hold") (why "In the middle, to lay hold of, take hold of, with the genitive (Genesis 25:26, Jacob's hand ἐπειλημμένη τῆς πτέρνης Ἠσαύ; Mark 8:23; Hebrews 2:16).")))

(lemma "ἐπιμελῶς"(sense diligently (gloss "diligently") (why "Carefully, diligently (Genesis 6:5; Luke 15:8).")))

(lemma "ἐπισάσσω" (sense saddle (gloss "saddle" "saddled" "saddles" "saddling") (why "(LXX, supplied.) To pack or saddle a beast (Genesis 22:3 ἐπέσαξεν τὴν ὄνον αὐτοῦ).")))

(lemma "ἐπισκέπτομαι" (sense visit (gloss "visit" "visited" "visits" "visiting") (why "To look upon, visit, attend to (Genesis 21:1, the Lord visited Sarah; Luke 1:68; Matthew 25:36).")))

(lemma "ἐπισπουδάζω" (sense urge (gloss "urge" "urged" "urges" "urging") (why "(LXX, supplied.) To press on, hurry someone along, urge (Genesis 19:15, the angels urging Lot). Kept apart from σπεύδω and σπουδάζω.")))

(lemma "ἐπιπίπτω" (sense fall-upon (verb "fall upon" "fell" "fallen") (dative "") (gloss "fall upon" "fell upon" "fallen upon" "falls upon" "falling upon") (why "To fall upon, attack (Genesis 14:15, Abram fell upon them by night); also of fear or the Spirit falling on people (Luke 1:12; Acts 10:44).")))

(lemma "ἐπιστηρίζω" (sense lean (voice active) (gloss "lean" "leaned" "leans" "leaning") (why "(LXX, supplied.) To prop upon; passive, to lean or be set firm upon (Genesis 28:13 ὁ δὲ Κύριος ἐπεστήρικτο ἐπ’ αὐτῆς, \"the Lord had leaned upon it\", the ladder). The passive is rendered active. In the New Testament (Acts 14:22; 15:32, 41) it is \"strengthen\", which will be its own sense.")))

(lemma "ἐπιστρέφω"(sense turn-again (gloss "turn again" "turned again" "turns again" "turning again") (why "Intransitive: to turn around, turn back again, return (Genesis 8:12, the dove did not add of turning again to him; Luke 17:4; Acts 3:19). \"Turn again\" keeps it apart from στρέφω \"turn\", ἀποστρέφω \"turn back\", ἀναστρέφω \"come back\" and ὑποστρέφω \"return\".")))

(lemma "ἐπισυνάγω"(sense gather-together (gloss "gather together" "gathered together" "gathers together" "gathering together") (why "To gather together (Matthew 23:37, a hen gathering her chicks). In Genesis 6:16 ἐπισυνάγων ποιήσεις seems to mean building the ark drawn in toward the top; the literal layer keeps \"gathering together\". Kept apart from συνάγω \"gather\".")))

(lemma "ἐπιτίθημι"
  (sense lay-on
    (verb "lay on" "laid" "laid")
    (dative "")
    (gloss "lay on" "laid on" "lays on" "laying on")
    (why "To put or lay on (Matthew 19:13, laying hands on; Luke 23:26). The commonest sense, listed first."))
  (sense attempt
    (gloss "attempt" "attempted" "attempts" "attempting")
    (why "(LXX, supplied.) Middle with an infinitive: to set oneself to, attempt (Genesis 11:6, \"all things whatever they may attempt to do\").")))

(lemma "ἐπιτρέχω" (sense run-up(gloss "run up" "ran up" "runs up" "running up") (why "(LXX, supplied.) To run up, run toward (Genesis 24:17, the servant ran up to meet her). Kept apart from τρέχω \"run\" by the particle.")))

(lemma "ἐπιφέρω"
  (sense borne
    (verb "bear" "bore" "borne")
    (gloss "borne")
    (readable "moving")
    (why "(Supplied in Genesis 1:2, where the form is LXX-only.) Active: to bring upon; middle/passive: to be borne or carried over, to move over. Genesis 1:2 ἐπεφέρετο is imperfect middle/passive, \"was being borne\" in the literal layer. The readable layer says \"was moving\" (Genesis 1:2): \"borne\" is no longer natural English (gsb/lexicon/readable-avoid.scm). The active (Romans 3:5, \"inflict\") will be its own sense.")))

(lemma "ἐπιχέω" (sense pour-on (gloss "pour on" "poured on" "pours on" "pouring on") (why "To pour upon (Genesis 28:18, oil on the stone; Luke 10:34, oil and wine on the wounds). (LXX form supplied.)")))

(lemma "ἐπονομάζω" (sense name (gloss "name" "named" "names" "naming") (why "To give a name to, name (Genesis 4:17, 25-26). Against καλέω \"call\".")))

(lemma "ἑπτά" (sense seven (gloss "seven") (why "Seven.")))

(lemma "ἑπτάκις" (sense seven-times (gloss "seven times") (why "Seven times.")))

(lemma "ἑπτακόσιοι" (sense seven-hundred (gloss "seven hundred") (why "(LXX, supplied.) The numeral seven hundred (Genesis 5).")))

(lemma "ἐργάζομαι"
  (sense work
    (gloss "work" "worked" "works" "working")
    (why "To work, to work the soil (Genesis 2:5, 15; 3:23); to do, perform (John 6:28). Kept as \"work\" so the verb and the noun ἔργον stay visibly related.")))

(lemma "ἔργον"
  (sense work
    (gloss "work" "works")
    (why "A work, deed (Genesis 2:2-3; Hebrews 4:4; John 6:28-29). Same English as ἐργάζομαι, deliberately.")))

(lemma "ἔρημος" (sense wilderness (gloss "wilderness" "wildernesses") (why "As a noun (ἡ ἔρημος, the feminine adjective standing alone), the uninhabited land, wilderness (Genesis 12:9; Matthew 3:1). The adjective \"desolate\" (Matthew 23:38) will be its own sense.")))

(lemma "ἔριφος" (sense kid (gloss "kid" "kids") (why "A young goat, kid (Genesis 27:9, 16; Luke 15:29; Matthew 25:32-33, where the KJV has \"goats\"). (LXX form supplied.)")))

(lemma "ἐρίζω" (sense strive (dative "with") (gloss "strive" "strove" "striven" "strives" "striving") (verb "strive" "strove" "striven") (why "To wrangle, quarrel, contend with words (Genesis 26:35, Esau's wives were striving with Isaac and Rebekah; Matthew 12:19 quotes Isaiah 42:2). \"Strive\" keeps it apart from μάχη \"quarrel\", μάχομαι \"fight\" and the middle of κρίνω \"dispute\".")))

(lemma "ἑρπετόν"
  (sense creeping-thing
    (gloss "creeping thing" "creeping things" "creeping")
    (why "A creeping or crawling animal, reptile (Genesis 1:20-30; Acts 10:12; Romans 1:23). \"Creeping thing\" keeps its link with ἕρπω \"creep\" (Genesis 1:26, \"the creeping things creeping upon the earth\"). Used attributively with ζῷα (Genesis 1:21) it is \"creeping\".")))

(lemma "ἕρπω"
  (sense creep
    (gloss "creep" "creeps" "crept" "creeping")
    (why "(LXX, supplied.) To creep, crawl, move along the ground. Not in the New Testament.")))

(lemma "ἔρχομαι" (sense come (gloss "come" "came" "come" "comes" "coming") (why "To come, go (Genesis 18:21 τὴν ἐρχομένην πρὸς μέ \"the [cry] coming to me\"; 18:22 ἦλθον εἰς Σόδομα; very common in the New Testament). It shares \"come\" with ἥκω, as that entry says, until the two are separated; the alignment shows which Greek verb stands behind it.")))
(lemma "ἐρωτάω" (sense ask (gloss "ask" "asked" "asks" "asking") (why "To ask, question, request (Genesis 24:47, ἠρώτησα αὐτήν; John 1:19, 21). Kept apart from ἐπερωτάω \"question\" and αἰτέω, which may take \"request\".")))

(lemma "ἐσθίω"
  (sense eat
    (gloss "eat" "ate" "eaten" "eats" "eating")
    (why "To eat. The Greek of Genesis 2-3 uses the future (φάγῃ, φάγεσθε) both for commands and for permission; the literal layer keeps \"you will eat\".")))

(lemma "ἑσπέρα"
  (sense evening
    (gloss "evening")
    (why "Evening (Genesis 1; Luke 24:29).")))

(lemma "Ἐσχώλ" (sense name (gloss "Eshcol") (why "(LXX, supplied.) Abram's ally, brother of Mamre (Genesis 14:13, 24); traditional English Eshcol.")))

(lemma "ἔσωθεν" (sense inside (gloss "inside") (why "From inside, on the inside (Genesis 6:14; Matthew 23:25). Paired with ἔξωθεν \"outside\".")))

(lemma "ἐτάζω" (sense examine (gloss "examine" "examined" "examines" "examining") (why "(LXX, supplied.) To examine, test, as by torture (Genesis 12:17, God examined Pharaoh with great examinations, where the Hebrew has \"plagued ... with plagues\"; compare ἀνετάζω, Acts 22:24, examined by scourging). The Greek word is kept, not the Hebrew's.")))

(lemma "ἐτασμός" (sense examination (dative "with") (gloss "examination" "examinations") (why "(LXX, supplied.) An examination, a testing by affliction (Genesis 12:17), the noun of ἐτάζω and given its English; the dative is the means, \"with examinations\".")))

(lemma "ἕτερος" (sense other (gloss "other") (why "Other, another of a different kind; kept apart from ἄλλος when it occurs.")))

(lemma "ἔτι"
  (sense further
    (gloss "further")
    (why "Additive \"further, besides\" (Genesis 2:9, 19, where the Septuagint has God make trees and animals \"further\", after Genesis 1; the Hebrew has no such word). Temporal \"still, yet\" (Luke 1:15) becomes its own sense."))
  (sense still
    (gloss "still")
    (why "Temporal: still, yet (Genesis 25:6 ἔτι ζῶντος αὐτοῦ, \"he still living\"; Luke 1:15; Romans 5:6). Chosen by word override.")))

(lemma "ἑτοιμάζω" (sense prepare (gloss "prepare" "prepared" "prepares" "preparing") (why "To make ready, prepare (Genesis 24:14, 31, 44, the woman whom the Lord prepared for Isaac; Matthew 3:3; John 14:2-3).")))

(lemma "ἔτος" (sense year (dative "in") (gloss "year" "years") (why "A year (Genesis 5, the ages of the patriarchs; Luke 2:41). It shares \"year\" with ἐνιαυτός (Genesis 1:14): both are plain words for a year and English has no second word; the alignment shows which Greek word stands behind it.")))

(lemma "εὖ" (sense well (gloss "well") (why "Well (Exodus 20:12; Ephesians 6:3 quotes it).")))

(lemma "Εὕα" (sense name (gloss "Eve") (why "(LXX from Genesis 4:1.) The traditional English name; the Septuagint calls the woman Ζωή, \"Life\", at 3:20 and Εὕα from 4:1, as do 2 Corinthians 11:3 and 1 Timothy 2:13.")))

(lemma "Εὑαῖος" (sense name (person) (gloss "Hivite" "Hivites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:17), Greek Εὑαῖος; traditional English Hivite.")))

(lemma "εὐαρεστέω" (sense be-well-pleasing (verb "be well-pleasing" "was well-pleasing" "been well-pleasing") (dative "to") (gloss "be well-pleasing" "was well-pleasing" "is well-pleasing" "been well-pleasing" "being well-pleasing") (why "(LXX form supplied.) To be well-pleasing to, with the dative (Genesis 5:22, 24; 6:9; Hebrews 11:5-6, which quotes Genesis 5:24: Enoch εὐηρεστηκέναι τῷ θεῷ). \"Be well-pleasing\" keeps εὖ (\"well\") and the root of ἀρεστός visible.")))

(lemma "εὐδοκέω" (sense be-pleased(gloss "be pleased" "was pleased" "is pleased" "been pleased" "being pleased" "were pleased") (why "To be pleased, take delight, consent (Genesis 24:25, 48, εὐδοκήσας ὁ ἄνθρωπος; Matthew 3:17, ἐν ᾧ εὐδόκησα). \"Be pleased\" keeps it apart from εὐαρεστέω \"be well-pleasing\" and ἀρέσκω.")))

(lemma "Εὑειλά" (sense name (gloss "Havilah") (why "(LXX, supplied.) A son of Joktan (Genesis 10:29), Greek Εὑειλά; traditional English Havilah. The same English as Εὑιλά, Cush's son (10:7), and as the land Εὑειλάτ (2:11), which the Hebrew also spells alike.")))

(lemma "Εὑειλάτ"
  (sense name
    (gloss "Havilah")
    (why "(LXX, supplied.) The land of Genesis 2:11, given its traditional English name; the Greek spells it Εὑειλάτ (Heuilat).")))

(lemma "εὐθύς" (sense at-once (gloss "at once") (why "The adverb: at once, immediately (Genesis 15:4 καὶ εὐθὺς φωνὴ Κυρίου; Mark 1:10-12). \"At once\" keeps it apart from εὐθέως, which can take \"immediately\"; the adjective \"straight\" (Luke 3:4-5) will be its own sense.")))

(lemma "Εὑιλά" (sense name (gloss "Havilah") (why "(LXX, supplied.) A son of Cush (Genesis 10:7), Greek Εὑιλά; traditional English Havilah, as Εὑειλά (10:29) and the land Εὑειλάτ (2:11).")))

(lemma "εὐλογέω"
  (sense bless
    (gloss "bless" "blessed" "blesses" "blessing")
    (why "(Supplied in Genesis 1-2, where the augmented form ηὐλόγησεν is LXX-only.) To bless, speak well of (Genesis 1:22; Luke 24:50).")))

(lemma "εὐλογητός" (sense blessed (gloss "blessed") (why "Blessed, praised (Genesis 12:2, \"you will be blessed\"; Luke 1:68; Romans 9:5). It shares \"blessed\" with the participle of εὐλογέω, its own root; μακάριος will need other English.")))

(lemma "εὐλογία" (sense blessing (gloss "blessing" "blessings") (why "A blessing, the spoken benediction (Genesis 27:12-41, Isaac's blessing; 28:4 τὴν εὐλογίαν Ἀβραάμ; Galatians 3:14; Hebrews 12:17, Esau's lost blessing). The noun of εὐλογέω \"bless\".")))

(lemma "εὐοδόω" (sense prosper (gloss "prosper" "prospered" "prospers" "prospering") (why "To give a good journey, make succeed, prosper (Genesis 24:12, 21, 27, 40, 42, 48, 56, the Lord prospering the servant's way; Romans 1:10; 3 John 2). Active and transitive in Genesis 24: \"prospered my way\".")))

(lemma "εὐπρόσωπος" (sense fair-faced (gloss "fair-faced") (why "(LXX, supplied.) Fair of face, good-looking (Genesis 12:11; Galatians 6:12 uses the verb εὐπροσωπέω, \"to make a fair show\"). \"Fair-faced\" renders εὐ- and πρόσωπον \"face\".")))

(lemma "εὑρίσκω"
  (sense find
    (gloss "find" "found" "finds" "finding")
    (why "To find; passive \"be found\" (Genesis 2:20).")))

(lemma "εὐρυχωρία" (sense spaciousness (gloss "spaciousness") (why "(LXX, supplied.) Broad room, open space: the name Isaac gives the undisputed well, \"because now the Lord enlarged [room] for us\" (Genesis 26:22).")))

(lemma "Εὐφράτης"
  (sense name
    (gloss "Euphrates")
    (why "(Supplied in Genesis 2:14.) The river, by its traditional English name, as in Revelation 9:14; 16:12.")))

(lemma "εὐχή" (sense vow (gloss "vow" "vows") (why "A vow (Genesis 28:20 ηὔξατο Ἰακὼβ εὐχήν, \"Jacob vowed [a] vow\"; Acts 18:18; 21:23); a prayer (James 5:15) will be its own sense. Shares \"vow\" with its verb εὔχομαι in the cognate phrase.")))

(lemma "εὔχομαι" (sense vow (gloss "vow" "vowed" "vows" "vowing") (why "To vow (Genesis 28:20 ηὔξατο Ἰακὼβ εὐχήν, the cognate accusative \"vowed [a] vow\", so the English shares \"vow\" with εὐχή as the Greek shares its root). \"Pray, wish\" (Acts 26:29; 2 Corinthians 13:7; 3 John 2) will be its own sense, kept apart from προσεύχομαι. (LXX form supplied.)")))

(lemma "εὐωδία" (sense fragrance (gloss "fragrance" "fragrances") (why "A sweet smell, fragrance (Genesis 8:21, ὀσμὴ εὐωδίας, an odor of fragrance; Ephesians 5:2; Philippians 4:18, the same phrase). Kept apart from ὀσμή \"odor\" so the New Testament phrase stays visibly the Septuagint's.")))

(lemma "Ἐφρών" (sense name (gloss "Ephron") (why "(LXX, supplied.) The Hittite who sold Abraham the field and cave of Machpelah (Genesis 23; 25:9); traditional English Ephron.")))

(lemma "ἐχθές" (sense yesterday (gloss "yesterday") (why "Yesterday (Genesis 19:34; John 4:52; Hebrews 13:8, Swete's and the New Testament's spelling).")))

(lemma "ἔχθρα"
  (sense enmity
    (gloss "enmity")
    (why "Hostility, enmity (Genesis 3:15; Romans 8:7; Ephesians 2:15-16).")))

(lemma "ἐχθρία" (sense hostility (gloss "hostility") (why "(LXX, supplied.) Hostility, enmity: the name Isaac gives the second disputed well (Genesis 26:21). Kept apart from ἔχθρα \"enmity\" (Genesis 3:15), a different word of the same root.")))

(lemma "ἐχθρός" (sense enemy (person) (gloss "enemy" "enemies") (why "Hostile; as a noun, an enemy (Genesis 14:20, who handed over your enemies; Matthew 5:44). Beside ἔχθρα \"enmity\".")))

(lemma "ἔχω"
  (sense have
    (gloss "have" "has" "had" "having")
    (why "To have, hold. The many idioms (\"be ill\", ἔχω + adverb) will be separate senses.")))

(lemma "ἕψεμα" (sense stew (gloss "stew" "stews") (why "(LXX, supplied.) Something boiled, a stew, broth (Genesis 25:29-34, Jacob's stew; from ἕψω \"boil\").")))

(lemma "ἕψω" (sense boil (gloss "boil" "boiled" "boils" "boiling") (why "(LXX, supplied.) To boil, cook by boiling (Genesis 25:29 Ἥψησεν δὲ Ἰακὼβ ἕψεμα, \"But Jacob boiled stew\").")))

(lemma "ἕως"
  (sense until
    (gloss "until")
    (why "Until, as far as. With τοῦ and an infinitive (Genesis 3:19, ἕως τοῦ ἀποστρέψαι σε) it is \"until you turn back\".")))
