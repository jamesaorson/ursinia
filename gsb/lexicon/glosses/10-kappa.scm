;; Greek Source Bible concordance, lemmas beginning with κ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "κἀγώ" (sense and-i (gloss "And I" "and I") (why "Crasis of καί + ἐγώ, \"and I\", \"I also\" (Genesis 20:6 Κἀγὼ ἔγνων; John 1:31; Matthew 2:8). Rendered \"and I\" so both words stay visible."))
  (sense me-also (gloss "me also") (why "The accusative κἀμέ, καί + ἐμέ, \"me also\" (Genesis 27:34, 38 Εὐλόγησον δὴ κἀμέ; Matthew 2:8 has the nominative). Chosen in the form row for κἀμέ.")))

(lemma "Καδής" (sense name (gloss "Kadesh") (why "(LXX, supplied.) Kadesh in the southern wilderness (Genesis 14:7; 16:14; 20:1); traditional English Kadesh.")))

(lemma "καθά" (sense according-as (gloss "according as") (why "(LXX, supplied.) According as, just as: καθὰ ἐνετείλατο αὐτῷ ὁ θεός, \"according as God commanded him\" (Genesis 7:9, 16; Matthew 27:10). \"According as\" keeps it apart from ὡς \"as\" and καθώς \"just as\".")))

(lemma "καθαιρέω" (sense take-down (gloss "take down" "took down" "taken down" "takes down" "taking down") (why "To take down, lower (Genesis 27:40 ἡνίκα ἐὰν καθέλῃς, \"whenever you take down\", the yoke; Mark 15:36, 46, taking the body down; Luke 1:52). (LXX form supplied.)")))

(lemma "καθάπερ" (sense even-as (gloss "even as") (why "Even as, just as (Genesis 12:4, \"even as the Lord spoke to him\"; Romans 4:6). \"Even as\" keeps it apart from καθώς \"just as\", καθά \"according as\" and ὡς \"as\".")))

(lemma "καθαρίζω" (sense cleanse (gloss "cleanse" "cleansed" "cleanses" "cleansing") (why "To cleanse, and so to hold guiltless (Exodus 20:7).")))

(lemma "καθαρός" (sense clean (gloss "clean") (why "Clean, pure: of animals fit for sacrifice (Genesis 7:2-3, 8; 8:20, the clean cattle and the clean birds), and of the heart (Matthew 5:8). \"Clean\" for the ritual sense of the Septuagint; a \"pure\" sense may follow where the New Testament needs it.")))

(lemma "καθεύδω" (sense be-asleep (verb "be asleep") (gloss "be asleep" "was asleep" "were asleep" "is asleep" "are asleep" "been asleep" "being asleep") (why "To sleep, lie asleep (Genesis 28:13 ἐφ’ ἧς σὺ καθεύδεις, \"on which you are asleep\"; Matthew 8:24; 1 Thessalonians 5:6). \"Be asleep\" keeps it apart from ὑπνόω \"sleep\" and κοιμάομαι \"lie down\".")))

(lemma "καθήκω"
  (sense be-fitting
    ;; Impersonal: καθήκει "it is fitting" never has a personal subject.
    (subject "it")
    (verb "be fitting" "was fitting" "been fitting")
    (gloss "be fitting" "is fitting" "was fitting" "been fitting" "being fitting")
    (why "Impersonal: it is fitting, proper (Genesis 19:31 ὡς καθήκει πάσῃ τῇ γῇ; Acts 22:22; Romans 1:28 τὰ μὴ καθήκοντα).")))

(lemma "κάθημαι" (sense be-seated (verb "be seated" "was seated" "been seated") (gloss "be seated" "is seated" "was seated" "were seated" "been seated" "being seated") (why "To be seated, sit (Genesis 18:1 καθημένου αὐτοῦ ἐπὶ τῆς θύρας, as he was seated at the door; Matthew 9:9; Revelation 4:2). \"Be seated\" keeps the state apart from καθίζω \"sit\" (sit down).")))

(lemma "καθίζω" (sense sit (verb "sit" "sat" "sat") (gloss "sit" "sat" "sits" "sitting") (why "Intransitive: to sit, settle (Genesis 8:4, the ark sat on the mountains; Matthew 5:1). The transitive \"seat\" (Ephesians 1:20) will be its own sense.")))

(lemma "καθότι" (sense inasmuch-as (gloss "inasmuch as") (why "According as, inasmuch as, because (Genesis 26:29; Luke 1:7; Acts 2:24). \"Inasmuch as\" keeps it apart from ὅτι \"because\", διότι and καθώς \"just as\".")))

(lemma "καθώς" (sense just-as (gloss "just as") (why "Just as, as (Genesis 8:21, just as I did; John 3:14). \"Just as\" keeps it apart from ὡς \"as\" and καθά \"according as\".")))

(lemma "καί"
  (sense and
    (gloss "and")
    (why "The connective, always rendered so the parataxis of the Greek stays visible. At the start of a sentence it stays \"And\" in the literal layer; the readable layer usually keeps it too."))
  (sense also
    (gloss "also")
    (why "Adverbial καί, adding a word rather than joining clauses: \"she gave also to her man\" (Genesis 3:6). \"Even\" becomes its own sense when first needed.")))

(lemma "Κάϊν" (sense name (gloss "Cain") (why "Traditional English form; also Hebrews 11:4, 1 John 3:12. Swete writes Κάιν without the diaeresis.")))

(lemma "Καϊνάμ" (sense name (gloss "Cainan") (why "Arphaxad's son, Shelah's father (Genesis 10:24; 11:12-13; Luke 3:36, KJV \"Cainan\"). The Hebrew has no such generation (Arpachshad fathers Shelah); the Greek gives a name the Hebrew lacks, so the English follows the Greek and Luke: Cainan. Swete spells Καινάμ. Not Καινάν \"Kenan\" of Genesis 5.")))

(lemma "Καινάν" (sense name (gloss "Kenan") (why "(LXX spelling supplied.) Enosh's son (Genesis 5:9-14), Greek Καινάν; the English follows the traditional Old Testament form Kenan, as Ἐνώς is \"Enosh\". Luke 3:37 spells Καϊνάμ (KJV \"Cainan\"); whether both testaments should read \"Cainan\" is for the owner.")))

(lemma "καιρός"
  (sense season
    (with-preposition "εἰς" for)
    (gloss "season" "seasons")
    (why "A fixed or fitting time, a season (Genesis 1:14; Acts 14:17, fruitful seasons). \"Season\" everywhere, so that χρόνος can keep \"time\"; \"the season is fulfilled\" (Mark 1:15) is the cost. The owner may prefer \"time\" for καιρός and \"span\" or \"while\" for χρόνος.")))

(lemma "κακία" (sense wickedness (gloss "wickedness" "wickednesses") (why "Badness, wickedness, malice (Genesis 6:5, plural; Acts 8:22; 1 Corinthians 5:8). Kept apart from πονηρός \"evil\", which follows it in Genesis 6:5.")))

(lemma "κακός" (sense bad (gloss "bad") (why "Bad, harmful; τὰ κακά, bad things, harm (Genesis 19:19 μὴ καταλάβῃ με τὰ κακά; Romans 12:17, 21). \"Bad\" because πονηρός has \"evil\".")))

(lemma "κακόω" (sense mistreat (gloss "mistreat" "mistreated" "mistreats" "mistreating") (why "To do evil to, harm, mistreat (Genesis 15:13, quoted in Acts 7:6; 16:6, Sarai and Hagar; 19:9 σὲ κακώσομεν μᾶλλον ἢ ἐκείνους; 1 Peter 3:13). The verb of κακός \"bad\".")))

(lemma "καλέω"
  (sense call
    (gloss "call" "called" "calls" "calling")
    (why "To call, name, summon. Passive \"will be called\" (Genesis 2:23).")))

(lemma "καλός"
  (sense good
    (gloss "good")
    (why "Good, fine, beautiful: the word of God's verdict in Genesis 1. It shares \"good\" with ἀγαθός; the alignment shows which, and the owner may want ἀγαθός distinguished (\"good\" / \"beneficial\") when it first occurs."))
  (sense fair
    (gloss "fair")
    (why "Of a person's looks: fair, beautiful (Genesis 12:14, Sarai \"was exceedingly fair\"). \"Fair\" because \"beautiful\" is ὡραῖος's English; chosen by word override where the context is looks.")))

(lemma "καλῶς" (sense finely (gloss "finely") (why "The adverb of καλός, well, rightly, finely (Genesis 26:29 ἐχρήμεθά σοι καλῶς; Mark 7:37; John 13:13). \"Finely\" because εὖ has \"well\"; whether to share \"well\" is a question for the owner.")))

(lemma "κάμηλος" (sense camel (gloss "camel" "camels") (why "Camel (Genesis 12:16; Matthew 3:4; 19:24).")))

(lemma "Καμουήλ" (sense name (gloss "Kemuel") (why "(LXX, supplied.) Nahor's son, father of the Syrians (Genesis 22:21); traditional English Kemuel.")))

(lemma "κάμινος" (sense furnace (gloss "furnace" "furnaces") (why "A furnace, kiln (Genesis 19:28 ὡσεὶ ἀτμὶς καμίνου; Matthew 13:42; Revelation 9:2).")))

(lemma "καπνίζω" (sense smoke (gloss "smoke" "smoked" "smokes" "smoking") (why "(LXX, supplied.) To smoke (Exodus 20:18, the mountain smoking).")))

(lemma "καρδία" (sense heart (gloss "heart" "hearts") (why "Heart, the seat of thought and will (Genesis 6:5-6; Matthew 5:8).")))

(lemma "Καρνάιν" (sense name (gloss "Karnaim") (why "(LXX, supplied.) Ἀσταρὼθ Καρνάιν (Genesis 14:5), Ashteroth-karnaim: the place name's second word, traditional English Karnaim.")))

(lemma "κάρπιμος"
  (sense fruitful
    (gloss "fruitful")
    (why "(LXX, supplied.) Fruit-bearing, fruitful (Genesis 1:11-12, ξύλον κάρπιμον). Not in the New Testament.")))

(lemma "καρπός"
  (sense fruit
    (gloss "fruit" "fruits")
    (why "Fruit. ποιέω καρπόν is \"make fruit\" in the literal layer (Genesis 1:11-12; Matthew 3:10; Revelation 22:2, the tree of life \"making\" twelve fruits).")))

(lemma "κάρφος" (sense twig (gloss "twig" "twigs") (why "A dry stalk, twig, chip (Genesis 8:11, φύλλον ἐλαίας κάρφος, a leaf of olive, a twig, in the dove's mouth). The New Testament's speck in the eye (Matthew 7:3-5) is the same word; it will become its own sense there, or take \"twig\" with a note.")))

(lemma "κατά"
  (sense according-to
    (gloss "according to")
    (why "With the accusative: standard or correspondence, \"according to\": κατὰ γένος \"according to kind\", κατ’ εἰκόνα \"according to [the] image\" (Genesis 1:26-27), βοηθὸς κατ’ αὐτόν \"a helper according to him\" (2:18). Translations from the Hebrew say \"in our image\"; the Greek preposition says \"according to\"."))
  (sense along
    (gloss "along")
    (why "With the accusative of space: along, across (Genesis 1:20, birds flying along the firmament; Luke 8:39, \"throughout the city\")."))
  (sense toward
    (gloss "toward")
    (why "With the accusative of direction: toward (Genesis 2:8, κατὰ ἀνατολάς \"toward [the] east\"; Acts 8:26, toward the south)."))
  (sense against
    (object-case "G")
    (gloss "against")
    (why "With the genitive: against (Exodus 20:16, false witness against the neighbor; Matthew 5:11). The generator takes it for a genitive object."))
  (sense by
    (gloss "by")
    (why "Of an oath, with the genitive: by (Genesis 22:16 κατ' ἐμαυτοῦ ὤμοσα, quoted in Hebrews 6:13, 16 κατ' οὐδενὸς εἶχεν μείζονος ὀμόσαι; Matthew 26:63); and with the accusative of place, by, near (Genesis 21:14 κατὰ τὸ φρέαρ τοῦ ὅρκου). Chosen by a word override."))
  (sense during
    (gloss "during")
    (why "With the accusative of time: during, in the course of (Genesis 20:6 εἶπεν δὲ αὐτῷ ὁ θεὸς καθ’ ὕπνον; Matthew 1:20; 2:12 κατ’ ὄναρ, \"during [a] dream\"; Acts 16:25 κατὰ τὸ μεσονύκτιον). Chosen by a word override.")))

(lemma "καταβαίνω" (sense go-down (gloss "go down" "went down" "gone down" "goes down" "going down") (verb "go down" "went down" "gone down") (why "To go down, come down (Genesis 18:21 καταβὰς οὖν ὄψομαι; John 1:51; 3:13). The counterpart of ἀναβαίνω \"go up\".")))

(lemma "καταβλέπω" (sense look-down (gloss "look down" "looked down" "looks down" "looking down") (why "(LXX, supplied.) To look down on, look down toward (Genesis 18:16 κατέβλεψαν ἐπὶ πρόσωπον Σοδόμων). Kept apart from ἀναβλέπω \"look up\" and βλέπω \"see\".")))

(lemma "κατάγαιος" (sense underground (gloss "underground") (why "(LXX, supplied.) Under the earth, on the ground level, lowest (Genesis 6:16, the ark's κατάγαια, its lowest deck). \"Underground\" renders κατά + γῆ word for word.")))

(lemma "καταδείκνυμι" (sense show (gloss "show" "showed" "shown" "showing") (why "(LXX, supplied.) To show, make known, introduce: Genesis 4:21, the one who first showed (invented) the psaltery and harp.")))

(lemma "καταδιώκω" (sense chase (gloss "chase" "chased" "chases" "chasing") (why "To pursue closely, hunt down (Genesis 14:14, chased behind them as far as Dan; Mark 1:36). \"Chase\" keeps it apart from διώκω \"pursue\".")))

(lemma "κατακλυσμός" (sense flood (gloss "flood" "floods") (why "Deluge, flood (Genesis 6:17; Matthew 24:38-39; 2 Peter 2:5).")))

(lemma "κατακόπτω" (sense cut-down (verb "cut down" "cut down" "cut down") (gloss "cut down" "cuts down" "cutting down") (why "To cut down, cut to pieces; of an army, to strike down in battle (Genesis 14:5, 7; Mark 5:5 has \"cutting himself\").")))

(lemma "κατακυριεύω"
  (sense master
    (genitive "")
    (gloss "master" "mastered" "masters" "mastering")
    (why "(Supplied in Genesis 1:28.) To gain mastery over, subdue, lord it over (Matthew 20:25; 1 Peter 5:3). \"Master\" keeps it apart from κυριεύω \"be lord\" and ἄρχω \"rule\".")))

(lemma "καταλαμβάνω"
  (sense overtake
    (gloss "overtake" "overtook" "overtaken" "overtakes" "overtaking")
    (why "To seize, lay hold of, overtake. John uses the verb again in 12:35 of darkness against the light (ἵνα μὴ σκοτία ὑμᾶς καταλάβῃ, \"so that darkness may not overtake you\"), so 1:5 takes the same gloss. \"Comprehend\" (KJV) belongs to the middle voice (\"perceive\", Acts 4:13), which becomes its own sense.")))

(lemma "καταλείπω"
  (sense leave
    (gloss "leave" "left" "leaves" "leaving")
    (why "To leave behind (Genesis 2:24; Matthew 19:5; Mark 10:7; Ephesians 5:31).")))

(lemma "καταλύω" (sense lodge (gloss "lodge" "lodged" "lodges" "lodging") (why "To unharness, and so to halt for the night, lodge (Genesis 19:2 καταλύσατε ... ἐν τῇ πλατείᾳ καταλύσομεν; Luke 9:12; 19:7). The transitive \"tear down, destroy\" (Matthew 5:17; 26:61) will be its own sense.")))

(lemma "καταμανθάνω" (sense observe (gloss "observe" "observed" "observes" "observing") (why "To learn thoroughly by looking, observe closely (Genesis 24:21, the man was observing her; Matthew 6:28, \"consider the lilies\"). \"Observe\" keeps it apart from μανθάνω \"learn\" and κατανοέω.")))

(lemma "καταμένω" (sense remain (gloss "remain" "remained" "remains" "remaining") (why "To stay on, remain (Genesis 6:3; Acts 1:13). μένω, when it comes, will need its own English (\"abide\").")))

(lemma "κατανοέω"
  (sense consider
    (gloss "consider" "considered" "considers" "considering")
    (why "To look closely at, consider (Matthew 7:3; Hebrews 3:1). Genesis 3:6 τοῦ κατανοῆσαι, \"to consider\", where translations from the Hebrew have \"to make one wise\".")))

(lemma "καταπαύω"
  (sense rest
    (gloss "rest" "rested" "rests" "resting")
    (why "Intransitive: to cease, rest (Genesis 2:2-3; Hebrews 4:4, 10). The transitive \"give rest\" (Hebrews 4:8) will be its own sense; the noun κατάπαυσις will take \"rest\" too, deliberately.")))

(lemma "κατάρα" (sense curse (gloss "curse" "curses") (why "A curse (Genesis 27:12-13, Jacob fearing a curse, Rebekah taking it on herself; Galatians 3:10, 13; Hebrews 6:8). Shares \"curse\" with its verb καταράομαι, as the Greek shares the root. (LXX form supplied.)")))

(lemma "καταπηδάω" (sense leap-down (gloss "leap down" "leaped down" "leaps down" "leaping down") (why "(LXX, supplied.) To leap down, jump down (Genesis 24:64, Rebekah from the camel). Acts 14:14 has the related ἐκπηδάω.")))

(lemma "καταράκτης" (sense floodgate (gloss "floodgate" "floodgates") (why "(LXX, supplied.) A rushing downfall of water, and so the sluice or floodgate through which it rushes: οἱ καταράκται τοῦ οὐρανοῦ, the floodgates of heaven (Genesis 7:11; 8:2).")))

(lemma "καταράομαι" (sense curse (gloss "curse" "cursed" "curses" "cursing") (why "To curse (Genesis 5:29, the earth which the Lord God cursed; Matthew 5:44; Mark 11:21). Its past \"cursed\" is also the English of the adjective ἐπικατάρατος (Genesis 3:14, 17); the alignment shows which Greek word stands behind it.")))

(lemma "καταστρέφω" (sense overturn (gloss "overturn" "overturned" "overturns" "overturning") (why "To turn upside down, overturn, overthrow (Genesis 19:21, 25, 29, the overturning of Sodom; Matthew 21:12, the tables of the money-changers).")))

(lemma "καταστροφή" (sense overturning (gloss "overturning") (why "(LXX form supplied.) An overturning, overthrow, ruin (Genesis 19:29 ἐκ μέσου τῆς καταστροφῆς; 2 Peter 2:6, which uses it of Sodom and Gomorrah). The noun of καταστρέφω \"overturn\".")))

(lemma "κατάσχεσις" (sense possession (with-preposition "εἰς" for) (gloss "possession" "possessions") (why "A holding, possession (Genesis 17:8 εἰς κατάσχεσιν αἰώνιον \"for everlasting possession\"; Acts 7:5, 45, which recall it).")))

(lemma "καταφεύγω" (sense take-refuge (verb "take refuge" "took refuge" "taken refuge") (gloss "take refuge" "took refuge" "taken refuge" "takes refuge" "taking refuge") (why "To flee for refuge (Genesis 19:20 τοῦ καταφυγεῖν με ἐκεῖ; Acts 14:6; Hebrews 6:18). \"Take refuge\" keeps it apart from φεύγω \"flee\".")))

(lemma "καταφθείρω" (sense ruin (gloss "ruin" "ruined" "ruins" "ruining") (why "(LXX forms supplied.) To destroy, ruin; perfect passive, ruined, corrupted (Genesis 6:12-13, 17; 2 Peter 2:12). The Greek of Genesis 6:12-17 uses one verb for all flesh ruining its way and for God ruining all flesh; one English word keeps that visible. Kept apart from φθείρω \"corrupt\" (6:11).")))

(lemma "καταφρονέω" (sense despise (gloss "despise" "despised" "despises" "despising") (why "To think down on, despise (Genesis 27:12 ἔσομαι ἐναντίον αὐτοῦ ὡς καταφρονῶν, \"as despising\", where the Hebrew has \"as a mocker\"; Matthew 6:24; Hebrews 12:2). (LXX form supplied.)")))

(lemma "καταψύχω" (sense cool-off (gloss "cool off" "cooled off" "cools off" "cooling off") (why "To cool, refresh (Genesis 18:4 καταψύξατε ὑπὸ τὸ δένδρον \"cool off under the tree\"; Luke 16:24, to cool the tongue). \"Cool off\" for the intransitive use here.")))

(lemma "κατέναντι"
  (sense opposite
    (gloss "opposite")
    (why "Opposite, over against (Genesis 2:14; Mark 11:2). ἀπέναντι takes \"facing\".")))

(lemma "κατέχω" (sense hold-fast (gloss "hold fast" "held fast" "holds fast" "holding fast") (why "To hold down, hold fast (Genesis 22:13 κριὸς κατεχόμενος ἐν φυτῷ σαβέκ, a ram caught; Luke 4:42; Hebrews 10:23 κατέχωμεν). \"Hold fast\" keeps it apart from κρατέω \"hold\".")))

(lemma "κατοικέω"
  (sense reside
    (gloss "reside" "resided" "resides" "residing")
    (why "Intransitive: to settle down and live in a place, reside (Genesis 11:2, 31, \"resided there\"; Acts 7:2-4, of Abraham in Haran). \"Reside\" keeps it apart from οἰκέω \"dwell\" and κατοικίζω \"settle\"."))
  (sense inhabit
    (gloss "inhabit" "inhabited" "inhabits" "inhabiting")
    (why "With an accusative of the place: to inhabit (Genesis 12:6, the Canaanites were inhabiting the land; Revelation 3:10, those inhabiting the earth). Chosen by word override where the place is the object.")))

(lemma "κατοίκησις" (sense residence (gloss "residence" "residences") (why "A dwelling place, residence (Genesis 10:30, the residence of Joktan's sons; Mark 5:3). \"Residence\" pairs with κατοικέω \"reside\".")))

(lemma "κατοικίζω"
  (sense settle
    (gloss "settle" "settled" "settles" "settling")
    (why "To cause to dwell, settle someone somewhere (Genesis 3:24; James 4:5, the spirit God settled in us). Against κατοικέω, which will take \"dwell\".")))

(lemma "κάτω" (sense below (gloss "below") (why "Below.")))

(lemma "καῦμα" (sense heat (gloss "heat" "heats") (why "Burning heat (Genesis 8:22, cold and heat; Revelation 7:16; 16:9).")))

(lemma "Κέδμα" (sense name (gloss "Kedemah") (why "(LXX, supplied.) The last son of Ishmael (Genesis 25:15), Greek Κέδμα; traditional English Kedemah.")))

(lemma "Κελμωναῖος" (sense name (person) (gloss "Kadmonite" "Kadmonites") (why "(LXX, supplied.) Genesis 15:19, the people the Hebrew calls the Kadmonites; Swete's Greek spells Κελμωναῖοι. Taken as the same people in a Greek spelling, so traditional English Kadmonites; whether the Greek names a different people (as Μαθουσαλά does) is a question for the owner.")))

(lemma "Κεναῖος" (sense name (person) (gloss "Kenite" "Kenites") (why "(LXX, supplied.) The Kenites (Genesis 15:19), traditional English.")))

(lemma "Κενεζαῖος" (sense name (person) (gloss "Kenizzite" "Kenizzites") (why "(LXX, supplied.) The Kenizzites (Genesis 15:19), traditional English.")))

(lemma "κέρας" (sense horn (gloss "horn" "horns") (why "A horn (Genesis 22:13 τῶν κεράτων, the ram caught by the horns; Luke 1:69; Revelation 5:6).")))

(lemma "κεφαλή"
  (sense head
    (gloss "head" "heads")
    (why "Head (Genesis 3:15; and of Christ, Ephesians 1:22).")))

(lemma "Κηδάρ" (sense name (gloss "Kedar") (why "(LXX, supplied.) A son of Ishmael (Genesis 25:13), traditional English Kedar.")))

(lemma "Κήτιος" (sense name (person) (plural "Kittim") (gloss "Kittim") (why "(LXX, supplied.) Genesis 10:4, οἱ Κήτιοι, the people of Kition on Cyprus, among Javan's sons, where the Hebrew has Kittim. The same people, so the traditional English Kittim (a plural in itself).")))

(lemma "κῆτος"
  (sense sea-monster
    (gloss "sea monster" "sea monsters")
    (why "(Supplied in Genesis 1:21.) A huge sea creature (Matthew 12:40, Jonah's). \"Sea monster\" rather than \"whale\", which is too specific, or \"sea creature\", which is too weak.")))

(lemma "κιβωτός" (sense ark (gloss "ark" "arks") (why "Chest, box; Noah's ark (Genesis 6:14-22; Matthew 24:38; Hebrews 11:7) and the ark of the covenant (Hebrews 9:4). \"Ark\" for both, as the Greek has one word.")))

(lemma "κιθάρα" (sense harp (gloss "harp" "harps") (why "The lyre or harp (1 Corinthians 14:7; Revelation 5:8).")))

(lemma "κινέω" (sense move (voice active) (intransitive) (gloss "move" "moved" "moves" "moving") (why "To move, set in motion; the passive (\"be moved\") is rendered as the intransitive \"move\" (Genesis 7:14, 21; 8:17, 19, every creeping thing moving on the earth; Acts 17:28, in him we live and move).")))

(lemma "κλαίω" (sense weep (gloss "weep" "wept" "weeps" "weeping") (why "To weep, cry (Genesis 21:16, 23:2; Luke 6:21; John 11:33).")))

(lemma "κλείω" (sense shut (verb "shut" "shut" "shut") (gloss "shut" "shuts" "shutting") (why "To shut, close (Genesis 7:16, the Lord God shut the ark from outside it; Matthew 25:10, the door was shut).")))

(lemma "κλέπτω" (sense steal (gloss "steal" "stole" "stolen" "steals" "stealing") (why "To steal.")))

(lemma "κλίβανος" (sense oven (gloss "oven" "ovens") (why "An oven for baking (Genesis 15:17 κλίβανος καπνιζόμενος; Matthew 6:30). \"Oven\" keeps it apart from κάμινος \"furnace\".")))

(lemma "κληρονομέω" (sense inherit (gloss "inherit" "inherited" "inherits" "inheriting") (why "To receive a share (κλῆρος), to inherit (Genesis 21:10, quoted in Galatians 4:30; 22:17; Matthew 5:5).")))

(lemma "κλίμαξ" (sense ladder (gloss "ladder") (why "(LXX, supplied.) A ladder, staircase (Genesis 28:12, Jacob's ladder; John 1:51 alludes to it without the word).")))

(lemma "κοιλάς" (sense valley (gloss "valley" "valleys") (why "(LXX, supplied.) A hollow, valley (Genesis 14:3, 8, 10, 17, the salty valley, the valley of Shaveh).")))

(lemma "κοιλία"
  (sense belly
    (gloss "belly")
    (why "Belly, stomach; also womb (Luke 1:41), which may become its own sense.")))

(lemma "κοίλωμα" (sense hollow (gloss "hollow" "hollows") (why "(LXX, supplied.) A hollow, a valley (Genesis 23:2, Arba ἐν τῷ κοιλώματι, \"in the hollow\"). Kept apart from κοιλάς and κοιλία.")))

(lemma "κόλπος" (sense bosom (gloss "bosom") (why "Bosom, lap (Genesis 16:5, \"into your bosom\"; Luke 16:22; John 1:18).")))

(lemma "κοιμάομαι" (sense lie-down (voice active) (intransitive) (verb"lie down" "lay" "lain") (gloss "lie down" "lay down" "lain down" "lies down" "lying down") (why "To lie down to sleep, and so to sleep with (Genesis 19:4, 32-35; 1 Corinthians 7:39). The passive-deponent forms are rendered active. \"Lie down\" because ὑπνόω and ὕπνος have \"sleep\"; the New Testament's \"fall asleep\" (die, John 11:11; 1 Thessalonians 4:13) will be its own sense."))
  (sense make-lie-down
    (gloss "make lie down" "made lie down" "makes lie down" "making lie down")
    (why "The active κοιμάω, causative: to put to bed, make lie down (Genesis 24:11, ἐκοίμησεν τὰς καμήλους, of camels made to kneel and rest). Listed under κοιμάομαι, the table's lemma for the verb.")))

(lemma "κοπάζω" (sense abate (intransitive) (gloss "abate" "abated" "abates" "abating") (why "To grow weary, abate, cease (Genesis 8:1, 7-8, 11, the water abated; Matthew 14:32, the wind abated).")))

(lemma "κοπή" (sense slaughter (gloss "slaughter") (why "A cutting down, slaughter in battle (Genesis 14:17, from the slaughter of Chedorlaomer; Hebrews 7:1 quotes it). From κόπτω; beside κατακόπτω \"cut down\".")))

(lemma "κόπτω" (sense bewail (gloss "bewail" "bewailed" "bewails" "bewailing") (why "The middle: to beat one's breast in grief, bewail (Genesis 23:2, Abraham came κόψασθαι Σάρραν; Luke 8:52, ἐκόπτοντο αὐτήν; Matthew 11:17). \"Bewail\" keeps it apart from πενθέω \"mourn\" and κλαίω. The active \"cut\" (Matthew 21:8) will be its own sense.")))

(lemma "κόραξ" (sense raven (gloss "raven" "ravens") (why "A raven (Genesis 8:7; Luke 12:24).")))

(lemma "κόσμος"
  (sense adornment
    (gloss "adornment")
    (why "The root sense of κόσμος is order, arrangement, adornment (1 Peter 3:3). Genesis 2:1 πᾶς ὁ κόσμος αὐτῶν, \"all their adornment\", where translations from the Hebrew have \"all their host\". The New Testament's usual sense, \"world\", becomes its own sense when first translated; the owner may prefer \"world\" or \"array\" here.")))

(lemma "κρατέω" (sense hold (genitive "") (dative "with") (gloss "hold" "held" "holds" "holding") (why "To grasp, take hold of, hold (Genesis 21:18 κράτησον τῇ χειρί σου αὐτό; Matthew 9:25; Mark 1:31). κατέχω is \"hold fast\".")))

(lemma "κραυγή" (sense outcry (gloss "outcry" "outcries") (why "A crying out, outcry (Genesis 18:20-21, the outcry of Sodom and Gomorrah; Matthew 25:6; Hebrews 5:7). \"Outcry\" because βοάω takes \"cry out\".")))

(lemma "κρέας" (sense meat (gloss "meat" "meats") (why "Meat, flesh as food (Genesis 9:4, πλὴν κρέας ἐν αἵματι ψυχῆς; Romans 14:21; 1 Corinthians 8:13). \"Meat\" keeps it apart from σάρξ \"flesh\".")))

(lemma "κριθή" (sense barley (gloss "barley") (why "Barley (Genesis 26:12, Isaac's hundredfold barley; Revelation 6:6; John 6:9 has the adjective κρίθινος).")))

(lemma "κρίνω" (sense judge (gloss "judge" "judged" "judges" "judging") (why "To judge (Genesis 18:25 ὁ κρίνων πᾶσαν τὴν γῆν \"the [one] judging all the earth\"; Matthew 7:1; John 5:22). The participle stays a participle, not the noun κριτής."))
  (sense dispute (gloss "dispute" "disputed" "disputes" "disputing") (why "The middle, to contend, go to law with one another (Genesis 26:21 ἐκρίνοντο δὲ καὶ περὶ ἐκείνου, the herdsmen disputing over the second well; Matthew 5:40; 1 Corinthians 6:6). Chosen by the form row of the middle ἐκρίνοντο.")))

(lemma "κριός" (sense ram (gloss "ram" "rams") (why "(LXX, supplied.) A ram (Genesis 22:13; 15:9; 31:38).")))

(lemma "κρίσις" (sense judgment (gloss "judgment" "judgments") (why "Judgment, justice (Genesis 18:19, 25 ποιεῖν δικαιοσύνην καὶ κρίσιν; Matthew 23:23; John 5:22-30). The noun of κρίνω \"judge\".")))

(lemma "κρύπτω"
  (sense hide
    (voice active)
    (gloss "hide" "hid" "hidden" "hides" "hiding")
    (why "(Supplied in Genesis 3:8, 10.) To hide. The aorist passive (ἐκρύβησαν) is intransitive \"hid\", as in John 8:59.")))

(lemma "κτάομαι" (sense acquire (gloss "acquire" "acquired" "acquires" "acquiring") (why "To acquire, get (Luke 18:12; Acts 22:28). Genesis 4:1 Ἐκτησάμην, \"I acquired\", the play on Cain's name.")))

(lemma "κτῆνος"
  (sense livestock
    (gloss "livestock")
    (why "A domestic animal, beast of burden, livestock (Genesis 1:24-26; Luke 10:34). \"Livestock\" (singular and plural) rather than \"cattle\", which suggests cows only.")))

(lemma "κτηνοτρόφος" (sense livestock-keeping (gloss "livestock-keeping") (why "(LXX, supplied.) Keeping or rearing livestock (Genesis 4:20); built on κτῆνος \"livestock\".")))

(lemma "κτῆσις" (sense property (with-preposition "εἰς" for) (gloss "property" "properties") (why "(LXX, supplied.) Acquisition, a holding, property (Genesis 23:4, 9, 18, 20, κτῆσιν τάφου, \"property of a tomb\"). \"Property\" keeps it apart from κατάσχεσις \"possession\" and κτῆμα.")))

(lemma "κτίζω" (sense create (gloss "create" "created" "creates" "creating") (why "To create, found (Genesis 14:19, 22, who created the heaven and the earth; Mark 13:19; Ephesians 3:9). \"Create\" keeps it apart from ποιέω \"make\" (Genesis 1:1).")))

(lemma "κυκλόω"
  (sense encircle
    (gloss "encircle" "encircles" "encircled" "encircling")
    (why "(Supplied in Genesis 2:11, 13.) To go around, encircle (Luke 21:20; Hebrews 11:30).")))

(lemma "κύκλῳ" (sense round-about (gloss "round about") (why "The dative of κύκλος as an adverb: in a circle, round about (Genesis 23:17, the trees in its borders round about; Mark 3:34; Revelation 4:6).")))

(lemma "κυρία" (sense mistress (person) (gloss "mistress" "mistresses") (why "Feminine of κύριος: the mistress of a slave (Genesis 16:4, 8-9); a lady (2 John 1, 5). \"Mistress\" for the relation to the maidservant.")))

(lemma "κυνηγέω" (sense hunt (gloss "hunt" "hunted" "hunts" "hunting") (why "(LXX, supplied.) To hunt (Genesis 25:27, Esau εἰδὼς κυνηγεῖν, \"knowing to hunt\"), the verb of κυνηγός \"hunter\". It shares \"hunt\" with θηρεύω (Genesis 27:3), as English has no second plain verb; the alignment shows which Greek word stands behind it.")))

(lemma "κυνηγός" (sense hunter (person) (gloss "hunter" "hunters") (why "(LXX, supplied.) A hunter (Genesis 10:9, Nimrod γίγας κυνηγός, twice).")))

(lemma "κυριεύω"
  (sense be-lord
    (gloss "be lord")
    (why "To be lord, have dominion over (Genesis 3:16; Romans 6:9, 14). \"Be lord\" keeps its kinship with κύριος visible; the genitive of what is ruled takes \"of\".")))

(lemma "κύριος"
  (sense lord
    (person)
    (anarthrous "[the]")
    (gloss "Lord" "lord" "lords")
    (why "Lord, master. Without the article it stands in the Septuagint for the divine name; Κύριος ὁ θεός is \"the Lord God\" as one segment, with the Greek article (before θεός) carrying the English \"the\" (see the Genesis book notes). Capitalized for God.")))

(lemma "κυρόω" (sense ratify (gloss "ratify" "ratified" "ratifies" "ratifying") (why "To make valid, ratify, confirm (Genesis 23:20, the field and cave were ratified to Abraham; Galatians 3:15; 2 Corinthians 2:8).")))

(lemma "κωλύω" (sense keep-back(gloss "keep back" "kept back" "keeps back" "keeping back") (why "To hinder, prevent, keep back (Genesis 23:6, οὐδεὶς ... τὸ μνημεῖον αὐτοῦ κωλύσει ἀπὸ σοῦ, \"will keep back his tomb from you\"; Luke 6:29, do not keep back the tunic; Matthew 19:14 \"forbid\" may become its own sense).")))
