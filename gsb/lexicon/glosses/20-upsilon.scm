;; Greek Source Bible concordance, lemmas beginning with υ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ὑδρεύω" (sense fetch-water (dative "for") (gloss "fetch water" "fetched water" "fetches water" "fetching water" "fetch") (why "(LXX, supplied.) Middle: to draw water for oneself, fetch water (Genesis 24:11, 13, 19-20, 43-45, the women fetching water). The verb holds its object, so \"fetch water\"; where ὕδωρ follows (24:43) an override gives \"fetch\" alone. Kept apart from ἀντλέω \"draw\". The dative is \"for\": \"for your camels I will fetch water\".")))

(lemma "ὑδρία" (sense jar (gloss "jar" "jars") (why "A water jar (Genesis 24:14-20, 43-46, Rebekah's jar; John 2:6-7; 4:28).")))

(lemma "ὕδωρ"
  (sense water
    (gloss "water" "waters")
    (why "Water. The Greek number is kept: singular \"water\" in Genesis 1:2-9, plural \"waters\" from 1:10.")))

(lemma "ὑετός" (sense rain (gloss "rain" "rains") (why "Rain (Genesis 7:4, 12; 8:2; Acts 14:17; James 5:7, 18). The noun shares \"rain\" with the verb βρέχω (Genesis 2:5); English has one word for both.")))

(lemma "υἱός" (sense son (person) (gloss "son" "sons") (why "Son.")))

(lemma "ὑμέτερος" (sense your (gloss "your") (why "The possessive adjective of ὑμεῖς, \"your\" (Genesis 9:5, τὸ ὑμέτερον αἷμα; John 7:6; 15:20). It shares \"your\" with the genitive ὑμῶν, as English has one word for both.")))

(lemma "ὑπακούω" (sense obey (genitive "") (gloss "obey" "obeyed" "obeys" "obeying") (why "To listen under, obey (Genesis 16:2 ὑπήκουσεν δὲ Ἀβρὰμ τῆς φωνῆς αὐτῆς; Matthew 8:27; Romans 6:16). \"Obey\" keeps it apart from ἀκούω \"hear\" and ἐπακούω.")))

(lemma "ὑπάρχω" (sense belong (gloss "belong" "belonged" "belongs" "belonging") (why "To be at hand, exist; τὰ ὑπάρχοντα with a genitive, what belongs to someone, possessions (Genesis 12:5; Luke 8:3; 12:15). \"Belong\" so the participle reads \"the [things] belonging\"; \"be\" is εἰμί's.")))

(lemma "ὑπεναντίος" (sense adversary (gloss "adversary" "adversaries") (why "Set against, opposed; as a noun, the adversary (Genesis 22:17 τὰς πόλεις τῶν ὑπεναντίων; Hebrews 10:27 τοὺς ὑπεναντίους; Colossians 2:14 \"against us\").")))

(lemma "ὑπερασπίζω" (sense shield (genitive "") (gloss "shield" "shielded" "shields" "shielding") (why "(LXX, supplied.) To hold a shield over, shield, defend; with the genitive (Genesis 15:1 ἐγὼ ὑπερασπίζω σου, \"I shield you\").")))

(lemma "ὑπερέχω" (sense surpass (genitive "") (gloss "surpass" "surpassed" "surpasses" "surpassing") (why "To hold above, rise above, surpass, with the genitive (Genesis 25:23 λαὸς λαοῦ ὑπερέξει, \"people will surpass people\"; Philippians 2:3; 4:7; Romans 13:1).")))

(lemma "ὑπνόω"
  (sense sleep
    (gloss "sleep" "slept" "sleeps" "sleeping")
    (why "(LXX, supplied.) To fall asleep, sleep (Genesis 2:21). Not in the New Testament, which uses καθεύδω and κοιμάομαι; those will need distinct glosses.")))

(lemma "ὕπνος" (sense sleep (gloss "sleep") (why "Sleep (Genesis 28:16 ἐξηγέρθη Ἰακὼβ ἀπὸ τοῦ ὕπνου αὐτοῦ; Matthew 1:24; Romans 13:11). It shares \"sleep\" with its verb ὑπνόω, as the Greek shares the root. (LXX form supplied.)")))

(lemma "ὑπό" (sense under (gloss "under") (why "With the accusative: under, beneath (Genesis 18:4, 8 ὑπὸ τὸ δένδρον; John 1:48, under the fig tree). With the genitive of the agent (\"by\") it will take its own sense."))
  (sense by (object-case "G") (gloss "by") (why "With the genitive: the agent, \"by\" (Genesis 26:29 εὐλογητὸς ὑπὸ Κυρίου, \"blessed by [the] Lord\"; Matthew 1:22; 4:1). The generator picks it for a genitive object. It shares \"by\" with κατά of place (Genesis 21:14); English has no other word for the agent.")))

(lemma "ὑπόδημα" (sense sandal (gloss "sandal" "sandals") (why "A sandal, shoe (Genesis 14:23, a sandal's thong; Mark 1:7, the strap of whose sandals).")))

(lemma "ὑποζύγιον" (sense beast-of-burden (gloss "beast of burden" "beasts of burden") (why "A beast under the yoke, a pack animal (2 Peter 2:16).")))

(lemma "ὑποκάτω"
  (sense under
    (gloss "under")
    (why "Under, below (Genesis 1:7, 9; Mark 6:11).")))

(lemma "ὑπολείπω" (sense reserve (gloss "reserve" "reserved" "reserves" "reserving") (why "To leave remaining; middle, to keep back for oneself, reserve (Genesis 27:36 Οὐχ ὑπελείπου μοι εὐλογίαν, \"Were you not reserving for me [a] blessing?\"; Romans 11:3 quoting 1 Kings 19:10, \"I was left\"). \"Reserve\" keeps it apart from καταλείπω \"leave\". The middle is rendered active. (LXX form supplied.)")))

(lemma "ὑποστρέφω" (sense return (intransitive) (gloss "return" "returned" "returns" "returning") (why "To turn back, return (Genesis 8:7, the raven did not return; Luke 2:20; 24:52). \"Return\" keeps it apart from ἀποστρέφω \"turn back\", ἀναστρέφω \"come back\" and ἐπιστρέφω \"turn again\".")))

(lemma "ὑποχείριος" (sense subject (gloss "subject") (why "(LXX, supplied.) Under the hand, subject (Genesis 14:20, handed over your enemies subject to you), from ὑπό + χείρ.")))

(lemma "ὑψηλός" (sense high (gloss "high") (why "High, lofty (Genesis 7:19-20, all the high mountains; Matthew 4:8; 17:1, a high mountain).")))

(lemma "ὕψιστος" (sense most-high (gloss "most high") (why "Highest, the superlative of ὑψηλός \"high\"; of God, ὁ θεὸς ὁ ὕψιστος, \"the most high God\" (Genesis 14:18-22; Luke 1:32; Hebrews 7:1). \"Most high\" is the superlative English itself, so the generator adds no \"most\" or \"-est\".")))

(lemma "ὕψος" (sense height (gloss "height") (why "Height (Genesis 6:15; Ephesians 3:18); \"on high\" (Luke 1:78) may become its own sense.")))

(lemma "ὑψόω" (sense raise-high (gloss "raise high" "raised high" "raises high" "raising high") (why "To lift high, raise up; of the flood, to rise high (Genesis 7:17, 20, 24, the ark and the water were raised high). In the New Testament it is \"exalt\" (Luke 14:11; John 3:14, the Son of Man must be lifted up), which may become its own sense; \"raise high\" here keeps the physical height (ὕψος) and is kept apart from ἐπαίρω \"lift up\".")))
