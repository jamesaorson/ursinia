;; Greek Source Bible concordance, lemmas beginning with β (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "βαδίζω" (sense proceed (gloss "proceed" "proceeded" "proceeds" "proceeding") (why "(LXX, supplied.) To walk, go along, proceed on foot (Genesis 44:25 Βαδίσατε πάλιν, \"Proceed again\", Jacob sending his sons back to Egypt). \"Proceed\" keeps it apart from πορεύομαι \"go\" and περιπατέω \"walk\".")))

(lemma "Βαθουήλ" (sense name (gloss "Bethuel") (why "(LXX, supplied.) Rebekah's father, son of Nahor (Genesis 22:22-23; 24:15; 28:2, 5); Greek Βαθουήλ, traditional English Bethuel.")))

(lemma "Βαιθήλ" (sense name (gloss "Bethel") (why "(LXX, supplied.) Bethel, \"house of God\" (Genesis 12:8; 13:3); traditional English.")))

(lemma "Βάλα" (sense name (gloss "Bela") (why "(LXX, supplied.) Benjamin's firstborn (Genesis 46:21; Swete prints Βάλα, then Βαλά), Greek Βάλα; traditional English Bela.")))

(lemma "Βαλαάν" (sense name (gloss "Bilhan") (why "(LXX, supplied.) A son of Ezer, the Horite Σάαρ (Genesis 36:27), Greek Βαλαάν; traditional English Bilhan.")))

(lemma "Βαλαεννών" (sense name (gloss "Baal-hanan") (why "(LXX, supplied.) A king of Edom, son of Achbor (Genesis 36:38-39), Greek Βαλαεννών; traditional English Baal-hanan.")))

(lemma "Βαλάκ"(sense name (gloss "Balak") (why "The New Testament's Balak (Revelation 2:14). At Genesis 14:2, 8 Swete prints Βάλακ, the Greek name of the city the Hebrew calls Bela (Zoar); the English follows the Greek name, as Θόβελ is \"Tubal\".")))

(lemma "βάλανος" (sense oak (gloss "oak" "oaks") (why "(LXX, supplied.) Properly an acorn, in the Septuagint the oak that bears it (Genesis 35:8, Deborah buried under the oak; the place named Βάλανος πένθους, \"Oak of mourning\"). Shares \"oak\" with δρῦς (Genesis 18:1): English has one common word for the tree; the alignment shows which Greek word stands behind it.")))

(lemma "Βάλλα"(sense name (gloss "Bera") (why "(LXX, supplied.) King of Sodom (Genesis 14:2), Greek Βάλλα for the Hebrew Bera; traditional English Bera, the same man in the Greek spelling."))
  (sense bilhah (gloss "Bilhah") (why "(LXX, supplied.) Rachel's slave girl, given to Jacob (Genesis 29:29; 30:3-7; 35:22, 25), Greek Βάλλα (accusative Βάλλαν) for the Hebrew Bilhah. The same Greek spelling as the king of Sodom, a different person and Hebrew name: her own sense, traditional English Bilhah.")))

(lemma "Βάραδ" (sense name (gloss "Bered") (why "(LXX, supplied.) A place in the wilderness of Shur (Genesis 16:14), Hebrew Bered; the traditional English form, the Greek being the same name.")))

(lemma "Βαράδ" (sense name (gloss "Bedad") (why "(LXX, supplied.) Father of Hadad, king of Edom (Genesis 36:35); Swete's Βαράδ is the Hebrew Bedad with ρ for δ, the same name, so the traditional English Bedad (rule 8). Not the place Βάραδ \"Bered\" (Genesis 16:14).")))

(lemma "Βαράθ" (sense name (gloss "Barath") (why "(LXX, supplied.) Father of the king Hadar (Ἁράθ) of Edom (Genesis 36:39); the Hebrew names no father there, so the English follows the Greek name.")))

(lemma "Βαριά" (sense name (gloss "Beriah") (why "(LXX, supplied.) A son of Asher (Genesis 46:17), Greek Βαριά; traditional English Beriah.")))

(lemma "Βαρσά"(sense name (gloss "Birsha") (why "(LXX, supplied.) King of Gomorrah (Genesis 14:2); traditional English Birsha.")))

(lemma "βαρυωπέω" (sense grow-dim (intransitive) (verb "grow dim" "grew dim" "grown dim") (gloss "grow dim" "grew dim" "grown dim" "grows dim" "growing dim") (why "(LXX, supplied.) To be heavy of sight (βαρύς + ὤψ), see dimly: Genesis 48:10, Israel's eyes grew dim from old age. \"Grow dim\" keeps it apart from ἀμβλύνω \"dull\" (Genesis 27:1).")))

(lemma "βαρύς" (sense heavy (gloss "heavy") (why "Heavy, weighty, and so burdensome, grievous (Genesis 48:17 βαρὺ αὐτῷ κατεφάνη, it seemed heavy to Joseph; Matthew 23:4; 1 John 5:3). (LXX form supplied.)")))

(lemma "Βασεμμάθ" (sense name (gloss "Basemath") (why "(LXX, supplied.) Esau's wife, daughter of Ishmael, sister of Nebaioth (Genesis 36:3-4, 10); traditional English Basemath. Swete prints Μασεμμάθ for her at 36:13, 17, the lemma of Esau's other wife Basemath of Genesis 26:34.")))

(lemma "βασιλεία"(sense kingdom (gloss "kingdom" "kingdoms") (why "Kingdom, reign (Genesis 14:1, in the kingdom of Amraphel; Matthew 3:2). \"Kingdom\" in both testaments; \"reign\" may become its own sense.")))

(lemma "Βαβυλών" (sense name (gloss "Babylon") (why "Babylon (Matthew 1:11; Revelation 14:8). In Genesis 10:10, the first city of Nimrod's kingdom, the Hebrew has Babel; the Greek gives Babylon, and we translate the Greek.")))

(lemma "βαρέως" (sense heavily (gloss "heavily") (why "Heavily, with difficulty (Matthew 13:15 τοῖς ὠσὶν βαρέως ἤκουσαν, quoting Isaiah 6:10). Genesis 31:35 Μὴ βαρέως φέρε, Rachel to Laban, \"do not bear heavily\", take it ill.")))

(lemma "βασιλεύς" (sense king (person) (gloss "king" "kings") (why "King (Genesis 17:6, 16, kings will come out of Abraham; Matthew 1:6; 2:1).")))

(lemma "βασιλεύω" (sense reign (gloss "reign" "reigned" "reigns" "reigning") (why "(LXX form supplied.) To be king, reign (Genesis 36:31-39, the kings who reigned in Edom; Matthew 2:22; Luke 1:33). The verb of βασιλεύς \"king\".")))

(lemma "βδέλυγμα"(sense abomination (gloss "abomination" "abominations") (why "(LXX form supplied.) A thing abhorred, an abomination (Genesis 43:32 βδέλυγμα γάρ ἐστιν τοῖς Αἰγυπτίοις, of eating with Hebrews; Matthew 24:15; Luke 16:15). The noun of βδελύσσομαι \"abhor\".")))

(lemma "βδελύσσομαι" (sense abhor (gloss "abhor" "abhorred" "abhors" "abhorring") (why "To feel loathing for, abhor (Genesis 26:29 οὐκ ἐβδελυξάμεθα, \"we did not abhor you\"; Romans 2:22). Kept with βδέλυγμα \"abomination\" in the readable layer's choices.")))

(lemma "Βαύξ" (sense name (gloss "Buz") (why "(LXX, supplied.) Nahor's second son (Genesis 22:21); the Greek form of the Hebrew Buz. Traditional English Buz.")))

(lemma "Βεήρ" (sense name (gloss "Beeri") (why "(LXX, supplied.) Father of Esau's wife Judith (Genesis 26:34), Greek Βεήρ for the Hebrew Beeri; traditional English Beeri.")))

(lemma "Βεθλέεμ" (sense name (gloss "Bethlehem") (why "(LXX, supplied.) Ephrath, where Rachel was buried (Genesis 35:19; 48:7 αὕτη ἐστὶν Βεθλέεμ); Swete spells Βεθλέεμ where the New Testament has Βηθλέεμ (Matthew 2:1-8). Traditional English Bethlehem.")))

(lemma "βέλτιστος" (sense best (gloss "best") (why "(LXX, supplied.) Best, the superlative used with ἀγαθός (Genesis 47:6, 11 ἐν τῇ βελτίστῃ γῇ, \"in the best land\"). Its comparative βελτίων is \"better\" (2 Timothy 1:18 has the adverb).")))

(lemma "βελτίων" (sense better (gloss "better") (why "(LXX, supplied.) Better, the comparative used with ἀγαθός (Genesis 29:19 Βέλτιον δοῦναί με αὐτὴν σοί, Laban). Its superlative βέλτιστος is \"best\".")))

(lemma "Βενιαμίν" (sense name (gloss "Benjamin") (why "Jacob's last son by Rachel (Genesis 35:18, 24; Acts 13:21; Romans 11:1); Swete spells it Βενιαμείν. Traditional English Benjamin.")))

(lemma "Βεώρ" (sense name (gloss "Beor") (why "(LXX, supplied.) Father of Balak (Bela), the first king of Edom (Genesis 36:32), traditional English Beor. The New Testament's Βοσόρ (2 Peter 2:15) is the father of Balaam.")))

(lemma "Βηθλέεμ" (sense name (gloss "Bethlehem") (why "Bethlehem, on the way to Ephrath, where Rachel was buried (Genesis 35:19; Matthew 2:1-8; Luke 2:4). Traditional English.")))

(lemma "βιάζομαι"(sense force (gloss "force" "forced" "forces" "forcing") (why "To use force, press hard on (Genesis 33:11, Jacob forced Esau until he took the gifts; Matthew 11:12; Luke 16:16). Kept apart from παραβιάζομαι \"constrain\".")))

(lemma "βίβλος"
  (sense book
    (gloss "book" "books")
    (why "A book or written record (Genesis 2:4; 5:1; Matthew 1:1). βιβλίον, its diminutive, will take \"scroll\".")))

(lemma "βλαστάνω"
  (sense sprout
    (gloss "sprout" "sprouts" "sprouted" "sprouting")
    (why "(Supplied in Genesis 1:11.) To sprout, put forth shoots; transitively, to make sprout (Genesis 1:11; James 5:18). Hebrews 9:4, Aaron's rod \"that sprouted\".")))

(lemma "βλέπω" (sense see (verb "see" "saw" "seen") (gloss "see" "saw" "seen" "sees" "seeing") (why "To see, have sight, look (Genesis 48:10 οὐκ ἠδύνατο βλέπειν, Israel was not able to see; Matthew 13:13-16; John 9:7). It shares \"see\" with ὁράω until the two are separated (ἀναβλέπω \"look up\" already says \"Kept apart from βλέπω 'see'\"); the alignment shows which Greek word stands behind it.")))

(lemma "βλαστός" (sense shoot (gloss "shoot" "shoots") (why "(LXX, supplied.) A shoot, sprout (Genesis 40:10, the vine bringing up shoots); the noun of βλαστάνω \"sprout\".")))

(lemma "βοάω" (sense cry-out (gloss "cry out" "cried out" "cries out" "crying out") (why "To cry out, shout (Genesis 4:10, the voice of blood crying out).")))

(lemma "βοηθέω" (sense help (dative "") (gloss "help" "helped" "helps" "helping") (why "(LXX form supplied.) To come to the aid of, help, with the dative (Genesis 49:25 ἐβοήθησέν σοι ὁ θεός; Matthew 15:25; Mark 9:24). The verb of βοηθός.")))

(lemma "βοηθός"
  (sense helper
    (person)
    (gloss "helper" "helpers")
    (why "(Supplied in Genesis 2:18, where the form is LXX-only.) One who helps (Hebrews 13:6, \"the Lord is my helper\"). In the Septuagint it is often God himself (Psalm 54:4), which is why the word does not imply inferiority.")))

(lemma "βολή" (sense shot (gloss "shot" "shots") (why "A throw, a cast; with τόξου the distance of a bowshot (Genesis 21:16; Luke 22:41 ὡσεὶ λίθου βολήν, \"about a stone's throw\"). \"Shot\" fits the bow.")))

(lemma "βορρᾶς" (sense north (gloss "north") (why "The north wind, the north (Genesis 13:14 πρὸς βορρᾶν; Luke 13:29).")))

(lemma "βόσκω" (sense pasture (gloss "pasture" "pastured" "pastures" "pasturing") (why "To feed, graze, pasture a flock (Genesis 29:6-9, Rachel ἔβοσκεν her father's sheep; Luke 15:15; John 21:15). \"Pasture\" keeps it apart from ποιμαίνω \"tend\" and the \"feed\" of other verbs.")))

(lemma "Βοσόρρα" (sense name (gloss "Bozrah") (why "(LXX, supplied.) The Edomite city (Genesis 36:33 ἐκ Βοσόρρας), traditional English Bozrah.")))

(lemma "βοτάνη"
  (sense vegetation
    (gloss "vegetation")
    (why "Green growth, pasture (Genesis 1:11-12; Hebrews 6:7). \"Vegetation\" against χόρτος \"grass\".")))

(lemma "βότρυς" (sense cluster (gloss "cluster" "clusters") (why "A cluster of grapes (Genesis 40:10 οἱ βότρυες σταφυλῆς; Revelation 14:18).")))

(lemma "βουλεύω" (sense plan (gloss "plan" "planned" "plans" "planning") (why "(LXX form supplied.) To take counsel, plan, resolve; mostly middle (Genesis 50:20, you planned against me for evil, but God planned for good; John 11:53; 12:10; Acts 27:39). The verb of βουλή \"counsel\".")))

(lemma "βουλή" (sense counsel (gloss "counsel" "counsels") (why "(LXX form supplied.) Counsel, plan, purpose (Genesis 49:6 εἰς βουλὴν αὐτῶν μὴ ἔλθοι ἡ ψυχή μου; Luke 7:30; Acts 2:23; 20:27).")))

(lemma "βούλομαι" (sense wish (gloss "wish" "wished" "wishes" "wishing") (why "To wish, be willing, intend (Genesis 24:5, μή ποτε οὐ βούλεται ἡ γυνή; Matthew 1:19; 1 Timothy 2:8). \"Wish\" keeps it apart from θέλω.")))

(lemma "βουνός" (sense heap (gloss "heap" "heaps") (why "(LXX sense supplied.) A mound, here the heap of stones Jacob's kin piled as a witness (Genesis 31:46-52, Βουνὸς μαρτυρεῖ, Galeed). \"Heap\" because \"mound\" is θίς's; the New Testament's \"hill\" (Luke 3:5; 23:30) will be its own sense.")))

(lemma "βοῦς" (sense ox (gloss "ox" "oxen") (plural "oxen") (why "Ox (Exodus 20:17; 1 Corinthians 9:9).")))

(lemma "βούτυρον" (sense butter (gloss "butter") (why "(LXX, supplied.) Butter or curdled milk (Genesis 18:8, set before the three men with milk). \"Butter\" is the word's own sense in Greek; the readable layer may say \"curds\".")))

(lemma "βραδύνω" (sense delay (gloss "delay" "delayed" "delays" "delaying") (why "(LXX, supplied.) To be slow, delay, linger (Genesis 43:10 εἰ μὴ γὰρ ἐβραδύναμεν, \"for if we had not delayed\"; 1 Timothy 3:15; 2 Peter 3:9). From βραδύς \"slow\".")))

(lemma "βραχίων" (sense arm (gloss "arm" "arms") (why "The arm (Genesis 27:16, the kids' skins put on Jacob's arms; Luke 1:51; John 12:38, the arm of the Lord). (LXX form supplied.)")))

(lemma "βρέχω"
  (sense rain
    (gloss "rain" "rained" "rains" "raining")
    (why "To rain, send rain (Genesis 2:5; Matthew 5:45). The sense \"wet\" (Luke 7:38) becomes its own sense.")))

(lemma "βρῶμα" (sense food (gloss "food" "foods") (why "Food, what is eaten (Genesis 6:21; Mark 7:19; 1 Corinthians 8:8). Kept apart from βρῶσις \"eating\".")))

(lemma "βρῶσις"
  (sense eating
    (with-preposition "εἰς" for)
    (dative "with")
    (gloss "eating")
    (why "The act of eating, or what is eaten. \"Eating\" (1 Corinthians 8:4) keeps it apart from βρῶμα, which will take \"food\". In Genesis 2:16 βρώσει φάγῃ is \"with eating you will eat\", a Hebrew-style intensive kept in the literal layer.")))

(lemma "βύσσινος" (sense fine-linen (gloss "fine linen") (why "Made of byssus, fine linen (Genesis 41:42 στολὴν βυσσίνην, the robe Pharaoh put on Joseph; Revelation 18:12, 16; 19:8, 14).")))
