;; Greek Source Bible concordance, lemmas beginning with θ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Θαιμάν" (sense name (gloss "Teman") (why "(LXX, supplied.) Genesis 25:3, a son of Jokshan the Greek adds, and 25:15, a son of Ishmael, where the Hebrew has Tema; elsewhere Θαιμάν is Teman (Genesis 36:11, 15). One Greek name, one English: Teman. Whether 25:15 should read Tema is a question for the owner.")))

(lemma "Θαιμανός" (sense name (person) (gloss "Temanite" "Temanites") (why "(LXX, supplied.) One of the people of Teman (Θαιμάν): Genesis 36:34 γῆ Θεμανῶν, Swete's spelling, \"land of [the] Temanites\"; Job 2:11 Eliphaz the Temanite. Traditional English Temanite.")))

(lemma "θάλασσα"
  (sense sea
    (gloss "sea" "seas")
    (why "The sea (Genesis 1:10, 22, 26). Some forms are supplied by hand where the table has no lemma.")))

(lemma "Θαλγά" (sense name (gloss "Tidal") (why "(LXX, supplied.) \"King of nations\" (Genesis 14:1; spelled Θαλγάλ at 14:9), Greek Θαλγά for the Hebrew Tidal; traditional English Tidal, the same man in a Greek spelling.")))

(lemma "θάλλω" (sense flourish (gloss "flourish" "flourished" "flourishes" "flourishing") (why "(LXX, supplied.) To bloom, thrive, flourish (Genesis 40:10, the vine flourishing).")))

(lemma "Θαμάρ" (sense name (gloss "Tamar") (why "Tamar (Matthew 1:3; Genesis 38). In Genesis 14:7 Ἁσασὰν Θαμάρ, Hazazon-tamar, the place name's second word.")))

(lemma "Θαμνά" (sense name (gloss "Timna") (why "(LXX, supplied.) Timna, the concubine of Eliphaz and sister of Lotan, and a chief of Esau (Genesis 36:12, 22, 40), traditional English Timna. The town Timnah (Genesis 38:12) is spelled the same in Greek; give it its own sense when met."))
  (sense timnah (gloss "Timnah") (why "(LXX, supplied.) The town in the hill country of Judah where Judah went up to shear his sheep (Genesis 38:12-14), Hebrew Timnah; the same Greek spelling as the woman Timna, a different name in Hebrew, so its own sense with the traditional English Timnah.")))

(lemma "θάνατος"
  (sense death
    (dative "by")
    (gloss "death")
    (why "Death. The dative in θανάτῳ ἀποθανεῖσθε is \"by death\".")))

(lemma "θανατόω" (sense put-to-death (verb "put to death" "put to death" "put to death") (gloss "put to death" "puts to death" "putting to death") (why "To put to death (Genesis 38:10, God ἐθανάτωσεν also Onan; Matthew 10:21; Romans 8:13). Kept apart from ἀποκτείνω \"kill\".")))

(lemma "θάπτω" (sense bury (gloss "bury" "buried" "buries" "burying") (why "To bury (Genesis 23; 25:9-10, Isaac and Ishmael buried Abraham; Matthew 8:21; 1 Corinthians 15:4).")))

(lemma "Θάρα" (sense name (gloss "Terah") (why "Abram's father (Genesis 11:24-32; Luke 3:34, Θάρα), traditional English Terah.")))

(lemma "θαρσέω" (sense take-courage (gloss "take courage" "took courage" "takes courage" "taking courage") (why "To be of good courage (Exodus 20:20; Matthew 9:2).")))

(lemma "Θασοβάν" (sense name (gloss "Ezbon") (why "(LXX, supplied.) A son of Gad (Genesis 46:16), Greek Θασοβάν for the Hebrew Ezbon (the same consonants, with a θ before them): traditional English Ezbon. The owner may prefer Thasoban.")))

(lemma "θαυμάζω" (sense marvel-at (verb "marvel at" "marveled at" "marveled at") (gloss "marvel at" "marveled at" "marvels at" "marveling at") (why "To wonder, marvel at (Matthew 8:10; Luke 7:9). Genesis 19:21 ἐθαύμασά σου τὸ πρόσωπον, \"I marveled at your face\", is the Hebrew idiom of lifting up the face, showing favor; the literal layer keeps the Greek verb.")))

(lemma "θεῖον" (sense sulfur (gloss "sulfur") (why "(LXX form supplied.) Sulfur, brimstone (Genesis 19:24 θεῖον καὶ πῦρ; Luke 17:29, which recalls it; Revelation 14:10). Not the adjective θεῖος \"divine\".")))

(lemma "Θαρσίς" (sense name (gloss "Tarshish") (why "(LXX, supplied.) Javan's son (Genesis 10:4), Greek Θαρσίς; traditional English Tarshish.")))

(lemma "Θειράς" (sense name (gloss "Tiras") (why "(LXX, supplied.) Japheth's son (Genesis 10:2), Greek Θειράς; traditional English Tiras.")))

(lemma "θέλω" (sense want (gloss "want" "wanted" "wants" "wanting") (why "To will, want, be willing (Genesis 24:8, ἐὰν δὲ μὴ θέλῃ ἡ γυνή; Matthew 1:19; John 7:17). \"Want\" keeps it apart from βούλομαι \"wish\".")))

(lemma "θεός"
  (sense god
    (gloss "God" "god" "gods" "God's")
    (why "Capitalized for the God of Israel, lowercase for others. Whether the Greek has the article is shown by the alignment, not by the English (see ὁ, sense unrendered). The plural ὡς θεοί (Genesis 3:5) is \"as gods\".")))

(lemma "θεοσέβεια" (sense piety (gloss "piety") (why "Reverence toward God, piety (Genesis 20:11 οὐκ ἔστιν θεοσέβεια ἐν τῷ τόπῳ τούτῳ; 1 Timothy 2:10). \"Piety\": an English gloss may not name God where the Greek has no θεός (the compound's θεο- is not a separate word), and \"godliness\" is left for εὐσέβεια.")))

(lemma "θεραπεία" (sense retinue (gloss "retinue") (why "Service, and so the body of servants in attendance, a household (Genesis 45:16, Pharaoh and his retinue; Luke 12:42 τῆς θεραπείας αὐτοῦ). \"Healing\" (Luke 9:11; Revelation 22:2) will be its own sense. \"Retinue\" keeps it apart from οἶκος \"house\".")))

(lemma "θεράπων" (sense attendant (person) (gloss "attendant" "attendants") (why "An attendant, one who serves willingly (Genesis 24:44, Isaac τῷ ἑαυτοῦ θεράποντι; Hebrews 3:5, Moses faithful as a θεράπων). \"Attendant\" keeps it apart from παῖς \"servant\" and δοῦλος.")))

(lemma "Θεργαμά" (sense name (gloss "Togarmah") (why "(LXX, supplied.) Gomer's son (Genesis 10:3), Greek Θεργαμά; traditional English Togarmah.")))

(lemma "θερισμός" (sense harvest (gloss "harvest" "harvests") (why "Harvest, reaping (Genesis 8:22, seed and harvest; Matthew 9:37-38; John 4:35).")))

(lemma "θέριστρον" (sense veil (gloss "veil" "veils") (why "(LXX, supplied.) A light summer garment or veil (Genesis 24:65, Rebekah took τὸ θέριστρον and covered herself). From θέρος \"summer\". κάλυμμα, when it comes, will need its own English.")))

(lemma "θέρος" (sense summer (gloss "summer" "summers") (why "Summer (Genesis 8:22, summer and springtime; Matthew 24:32).")))

(lemma "θηλάζω" (sense suckle (gloss "suckle" "suckled" "suckles" "suckling") (why "To suckle, nurse at the breast (Genesis 21:7; Matthew 24:19 ταῖς θηλαζούσαις).")))

(lemma "θῆλυς"
  (sense female
    (gloss "female")
    (why "Female (Genesis 1:27; Matthew 19:4; Galatians 3:28).")))

(lemma "θήρα" (sense game (gloss "game") (why "(LXX, supplied.) Hunting, and what is hunted, game (Genesis 27:3-33, Esau's θήρα; Romans 11:9 has it as \"trap\" in a quotation of Psalm 69, a separate sense). \"Game\" beside θηρεύω \"hunt\".")))

(lemma "θηρεύω" (sense hunt (gloss "hunt" "hunted" "hunts" "hunting") (why "To hunt (Genesis 27:3, 5, 33, Esau hunting game; Luke 11:54, of catching a word). (LXX form supplied.)")))

(lemma "θηριάλωτος" (sense beast-caught (gloss "beast-caught") (why "(LXX, supplied.) Caught by a wild beast, torn by beasts (Genesis 31:39 θηριάλωτον οὐκ ἀνενήνοχά σοι). From θήρ \"beast\" and ἁλωτός \"caught\"; the compound English keeps it one word, apart from θηριόβρωτος.")))

(lemma "θηριόβρωτος" (sense beast-devoured (gloss "beast-devoured") (why "(LXX, supplied.) Eaten by wild beasts (θηρίον + βιβρώσκω): Genesis 44:28 Θηριόβρωτος γέγονεν, \"he has become beast-devoured\", Jacob of Joseph. The hyphen keeps the one Greek word one English word.")))

(lemma "θηρίον"
  (sense beast
    (gloss "beast" "beasts")
    (why "A wild animal, beast (Genesis 1:24-25; 2:19-20; 3:1, 14; Mark 1:13). \"Beast\" so the same word stays recognizable in Revelation 13 (the beast). κτῆνος takes \"livestock\" and ζῷον \"animal\".")))

(lemma "θησαυρός" (sense treasure (gloss "treasure" "treasures") (why "A store, treasure (Genesis 43:23 ἔδωκεν ὑμῖν θησαυροὺς ἐν τοῖς μαρσίπποις ὑμῶν; Matthew 6:19-21; 13:44). (LXX form supplied.)")))

(lemma "θλῖψις" (sense affliction (gloss "affliction" "afflictions") (why "(LXX form supplied.) Pressure, distress, affliction (Genesis 35:3 ἐν ἡμέρᾳ θλίψεως, \"in day of affliction\"; John 16:33; Romans 5:3). Kept apart from ταπείνωσις and λύπη \"sorrow\".")))

(lemma "θίς" (sense mound (gloss "mound" "mounds") (why "(LXX, supplied.) A heap, a sand-bank or dune, a hill (Genesis 49:26 θινῶν ἀενάων, Swete's θεινῶν, \"of everflowing mounds\"). \"Mound\" keeps it apart from βουνός and ὄρος.")))

(lemma "θνῄσκω" (sense die (intransitive) (gloss "die" "died" "dies" "dying") (why "To die; in the perfect, to be dead (Genesis 50:15 τέθνηκεν ὁ πατὴρ αὐτῶν, \"their father has died\"; Matthew 2:20; Luke 8:49; John 11:44). The simple verb of ἀποθνῄσκω, which also has \"die\": the English cannot tell the two apart, and the Greek difference is slight. (LXX form supplied.)")))

(lemma "Θόβελ"(sense name (gloss "Tubal") (why "(LXX, supplied.) Genesis 4:22: Greek Θόβελ where the Hebrew has Tubal-cain; the Greek name is Tubal alone.")))

(lemma "θρόνος" (sense throne (gloss "throne" "thrones") (why "A seat of state, a throne (Genesis 41:40 πλὴν τὸν θρόνον ὑπερέξω σου ἐγώ, Pharaoh above Joseph only in the throne; Matthew 5:34; Revelation 4:2).")))

(lemma "θυγάτηρ" (sense daughter (person) (gloss "daughter" "daughters") (why "Daughter.")))

(lemma "θῦμα" (sense slain-beast (gloss "slain beast" "slain beasts") (why "(LXX, supplied.) An animal slaughtered, for sacrifice or for the table (Genesis 43:16 σφάξον θύματα, Joseph's steward preparing the midday meal). From θύω; \"slain beast\" keeps it apart from θυσία \"sacrifice\" and σφάζω \"slaughter\".")))

(lemma "θυμίαμα" (sense incense (gloss "incense" "incenses") (why "(LXX, supplied.) Incense, sweet spice for burning (Genesis 43:11, among the gifts for Joseph; Luke 1:10-11; Revelation 5:8).")))

(lemma "θυμός" (sense fury (gloss "fury") (why "Passion, hot anger, fury (Genesis 27:45 τὸν θυμὸν καὶ τὴν ὀργὴν τοῦ ἀδελφοῦ σου; Romans 2:8 θυμὸς καὶ ὀργή; Revelation 14:10). \"Fury\" keeps it apart from ὀργή \"wrath\" where the two stand together.")))

(lemma "θυμόω" (sense anger (gloss "anger" "angered" "angers" "angering") (why "Active: to make angry; passive: to be angered, become angry (Genesis 6:7, ἐθυμώθην \"I was angered\"; Matthew 2:16). The passive is kept passive in the literal layer.")))

(lemma "θύρα" (sense door (gloss "door" "doors") (why "Door (Genesis 6:16; John 10:7-9).")))

(lemma "θυρίς" (sense window (gloss "window" "windows") (why "A small opening, window (Genesis 8:6, Noah opened the window of the ark; Acts 20:9; 2 Corinthians 11:33). Kept apart from θύρα \"door\".")))

(lemma "θυσία" (sense sacrifice (gloss "sacrifice" "sacrifices") (why "Sacrifice, offering (Genesis 4:3; Hebrews 11:4, Abel's sacrifice).")))

(lemma "θυσιαστήριον" (sense altar (gloss "altar" "altars") (why "Altar, the place of sacrifice (θυσία).")))

(lemma "θύω" (sense sacrifice (gloss "sacrifice" "sacrificed" "sacrifices" "sacrificing") (why "To sacrifice, the verb of θυσία.")))

(lemma "Θωλά" (sense name (gloss "Tola") (why "(LXX, supplied.) Issachar's firstborn (Genesis 46:13), Greek Θωλά; traditional English Tola.")))
