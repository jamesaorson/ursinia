;; Greek Source Bible concordance, lemmas beginning with σ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Σάαρ" (sense name (gloss "Zohar") (why "(LXX, supplied.) Ephron's father (Genesis 23:8; 25:9). Σάαρ transcribes the Hebrew Zohar without its guttural; the same name, so the traditional English Zohar (rule 8).")))

(lemma "Σαβά" (sense name (gloss "Seba") (why "(LXX, supplied.) Genesis 10:7, Cush's son, Hebrew Seba; the Greek spells Raamah's son in the same verse alike (Hebrew Sheba). One Greek name, so one English: Seba. Σαβεῦ (10:28) is \"Sheba\".")))

(lemma "Σαβαθά" (sense name (gloss "Sabtah") (why "(LXX, supplied.) A son of Cush (Genesis 10:7), traditional English Sabtah.")))

(lemma "Σαβακαθά" (sense name (gloss "Sabteca") (why "(LXX, supplied.) A son of Cush (Genesis 10:7), Greek Σαβακαθά; traditional English Sabteca.")))

(lemma "Σαβάν" (sense name (gloss "Sheba") (why "(LXX, supplied.) A son of Jokshan (Genesis 25:3), Greek Σαβάν for the Hebrew Sheba; traditional English Sheba. Σαβεῦ (10:28) is also \"Sheba\", another man of the same Hebrew name in another Greek spelling.")))

(lemma "σαββατίζω" (sense keep-sabbath (intransitive) (verb "keep sabbath" "kept sabbath" "kept sabbath") (gloss "keep sabbath" "kept sabbath" "keeps sabbath" "keeping sabbath") (why "(LXX, supplied.) To keep sabbath, rest on the sabbath (Exodus 16:30, the people kept sabbath on the seventh day). From σάββατον.")))

(lemma "Σαβεῦ" (sense name (gloss "Sheba") (why "(LXX, supplied.) A son of Joktan (Genesis 10:28), Greek Σαβεῦ; traditional English Sheba.")))

(lemma "σάββατον" (sense sabbath (gloss "sabbath" "sabbaths") (why "Sabbath; the plural often means one sabbath day (Exodus 20:8, 10).")))

(lemma "σαβέκ" (sense sabek (gloss "sabek") (why "(LXX, supplied.) The Hebrew sebak, \"thicket\", which the Greek transliterates instead of translating (Genesis 22:13 ἐν φυτῷ σαβέκ). Rendered by its sound, as the Greek has it.")))

(lemma "σάγμα" (sense packsaddle (gloss "packsaddle" "packsaddles") (why "(LXX, supplied.) A packsaddle, a camel's saddle-bags (Genesis 31:34, Rachel puts the idols εἰς τὰ σάγματα τῆς καμήλου). \"Packsaddle\" keeps it apart from the verb ἐπισάσσω \"saddle\".")))

(lemma "σάκκος" (sense bag (gloss "bag" "bags") (why "Sackcloth, and a bag made of it (Genesis 42:25, 35, the brothers' grain bags; Revelation 6:12 and Matthew 11:21 \"sackcloth\", a sense of its own when needed). \"Bag\" because μάρσιππος has \"sack\" (Genesis 42:27-28 uses both for the same bags)."))
  (sense sackcloth (gloss "sackcloth") (why "The coarse hair cloth itself, worn in mourning (Genesis 37:34, Jacob ἐπέθετο σάκκον ἐπὶ τὴν ὀσφὺν αὐτοῦ; Matthew 11:21; Revelation 6:12).")))

(lemma "Σαλά" (sense name (gloss "Shelah") (why "Arpachshad's line (Genesis 10:24; 11:13-15; Luke 3:35, Σαλά), traditional English Shelah. In the Greek of 11:13 he is Kainan's son, a generation the Hebrew lacks.")))

(lemma "Σαλαμά" (sense name (gloss "Samlah") (why "(LXX, supplied.) A king of Edom from Masrekah (Genesis 36:36-37), Greek Σαλαμά; traditional English Samlah.")))

(lemma "Σάλεφ"(sense name (gloss "Sheleph") (why "(LXX, supplied.) A son of Joktan (Genesis 10:26), traditional English Sheleph.")))

(lemma "Σαλήμ" (sense name (gloss "Salem") (why "Salem, Melchizedek's city (Genesis 14:18; Hebrews 7:1-2); traditional English.")))

(lemma "σάλπιγξ" (sense trumpet (gloss "trumpet" "trumpets") (why "Trumpet (Exodus 20:18; 1 Thessalonians 4:16).")))

(lemma "Σαμαραῖος" (sense name (person) (gloss "Zemarite" "Zemarites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:18), Greek Σαμαραῖος; traditional English Zemarite.")))

(lemma "σανιδωτός" (sense boarded (gloss "boarded") (why "(LXX, supplied.) Made of boards (σανίς \"plank\"), boarded: the altar κοῖλον σανιδωτόν, \"hollow, boarded\" (Exodus 27:8; 38).")))

(lemma "Σαούλ" (sense name (gloss "Saul") (why "Saul: a king of Edom from Rehoboth (Genesis 36:37-38); the same name as the first king of Israel (1 Kingdoms 9-31) and the apostle's Hebrew name (Acts 9:4; 13:21). Traditional English Saul, as the KJV has it at Genesis 36:37.")))

(lemma "Σαμουήλ" (sense name (gloss "Samuel") (why "Samuel (Acts 3:24; 13:20; Hebrews 11:32). Swete prints Σαμουήλ for the son of Simeon by the Canaanite woman (Genesis 46:10), where the Hebrew has Shaul: the Greek gives the name Samuel, so the English follows it (rule 8, as Μαθουσαλά).")))

(lemma "σάπφειρος" (sense sapphire (gloss "sapphire" "sapphires") (why "Sapphire, the blue stone (Revelation 21:19; Exodus 24:10 ἔργον πλίνθου σαπφείρου, \"work of brick of sapphire\" under God's feet; 28:18). Traditional English, kept from the Greek name.")))

(lemma "σάρδιον" (sense sardius (gloss "sardius") (why "Sardius, carnelian, a red stone (Revelation 4:3; 21:20): λίθους σαρδίου, \"stones of sardius\" for the shoulder-piece (Exodus 25:7; 35:9). Traditional English sardius.")))

(lemma "Σάρα"(sense name (gloss "Sarai") (why "(LXX, supplied.) Abram's wife before Genesis 17:15 renames her Σάρρα; traditional English Sarai.")))

(lemma "Σάρρα" (sense name (gloss "Sarah") (why "The name God gives Σάρα in Genesis 17:15; traditional English Sarah, as in the New Testament (Romans 4:19; 9:9; Hebrews 11:11; 1 Peter 3:6).")))
(lemma "σάρξ"
  (sense flesh
    (dative "in")
    (gloss "flesh" "fleshes")
    (why "Flesh, and the human being as flesh (Genesis 2:23-24; John 1:14).")))

(lemma "Σαύα" (sense name (gloss "Shua") (why "(LXX, supplied.) Judah's Canaanite wife (Genesis 38:2, 12). The Hebrew calls her bat-Shua, the daughter of Shua; the Greek θυγατέρα ἀνθρώπου Χαναναίου ᾗ ὄνομα Σαύα gives the name Σαύα to her. The same name, so traditional English Shua; the Greek makes it hers.")))

(lemma "Σαυή" (sense name (gloss "Shaveh") (why "(LXX, supplied.) Genesis 14:5 ἐν Σαυὴ τῇ πόλει, \"in Shaveh the city\" (the Hebrew Shaveh-kiriathaim, its second part translated), and 14:17 τὴν κοιλάδα τὴν Σαύην, \"the valley of Shaveh\"; traditional English Shaveh.")))

(lemma "Σαυνίς" (sense name (gloss "Shuni") (why "(LXX, supplied.) A son of Gad (Genesis 46:16), Greek Σαυνίς; traditional English Shuni.")))

(lemma "Σαφών" (sense name (gloss "Ziphion") (why "(LXX, supplied.) Gad's firstborn (Genesis 46:16), Greek Σαφών for the Hebrew Ziphion (Zephon in Numbers 26:15); traditional English of Genesis, Ziphion.")))

(lemma "σεαυτοῦ" (sense yourself (gloss "yourself") (why "Reflexive, second person singular.")))

(lemma "Σεβεγών" (sense name (gloss "Zibeon") (why "(LXX, supplied.) Zibeon the Hivite (Genesis 36:2), son of Seir the Horite and a chief (36:20, 24, 29), Greek Σεβεγών; traditional English Zibeon.")))

(lemma "Σεβωίμ"(sense name (gloss "Zeboiim") (why "(LXX, supplied.) A city near Sodom (Genesis 10:19), Greek Σεβωίμ; traditional English Zeboiim.")))

(lemma "Σεβωείμ" (sense name (gloss "Zeboiim") (why "(LXX, supplied.) One of the cities of the plain (Genesis 10:19; 14:2, 8); traditional English Zeboiim.")))

(lemma "Σείν" (sense name (gloss "Sin") (why "(LXX, supplied.) The wilderness of Sin, between Elim and Sinai (Exodus 16:1; 17:1). Greek Σείν (Swete Σεὶν before a word), indeclinable; traditional English Sin.")))

(lemma "Σεγρεί" (sense name (gloss "Sithri") (why "(LXX, supplied.) A son of Uzziel (Exodus 6:22), Greek Σεγρεί for the Hebrew Sithri, the same name as the Greek heard it; traditional English Sithri (rule 8).")))

(lemma "Σεινά" (sense name (gloss "Sinai") (why "(LXX, supplied.) Mount Sinai and its wilderness (Exodus 16:1 ἀνὰ μέσον Σεινά; Swete's spelling). The New Testament spells Σινᾶ (Acts 7:30; Galatians 4:24); traditional English Sinai.")))

(lemma "σελήνη" (sense moon (gloss "moon" "moons") (why "The moon (Genesis 37:9, Joseph's dream: ὁ ἥλιος καὶ ἡ σελήνη καὶ ἕνδεκα ἀστέρες; Matthew 24:29; Revelation 12:1).")))

(lemma "Σελλά" (sense name (gloss "Zillah") (why "(LXX, supplied.) Lamech's wife, Genesis 4:19-23, traditional English Zillah.")))

(lemma "Σεμεεί" (sense name (gloss "Shimei") (why "(LXX, supplied.) A son of Gershon (Exodus 6:17), Greek Σεμεεί; traditional English Shimei. Luke 3:26 Σεμεΐν is another man.")))

(lemma "σεμίδαλις" (sense fine-flour (gloss "fine flour") (why "(LXX, supplied.) The finest wheat flour (Genesis 18:6; Revelation 18:13).")))

(lemma "Σενναάρ" (sense name (gloss "Shinar") (why "(LXX, supplied.) The plain of Babel (Genesis 10:10; 11:2), traditional English Shinar.")))

(lemma "Σεπφωρά" (sense name (gloss "Shiphrah") (why "(LXX, supplied.) One of the two Hebrew midwives (Exodus 1:15 τῇ μιᾷ αὐτῶν ᾗ ὄνομα Σεπφωρά). The Greek spells her name like Moses' wife Σεπφώρα \"Zipporah\" (2:21), but the persons and the Hebrew names differ; Swete accents them differently, so the two are two lemmas. Traditional English Shiphrah.")))

(lemma "Σεπφώρα" (sense name (gloss "Zipporah") (why "(LXX, supplied.) Daughter of the priest of Midian, Moses' wife (Exodus 2:21; 4:25; 18:2). Traditional English Zipporah. Kept apart from the midwife Σεπφωρά \"Shiphrah\" (1:15), spelled alike but accented differently by Swete.")))

(lemma "Σέρεδ" (sense name (gloss "Sered") (why "(LXX, supplied.) Zebulun's firstborn (Genesis 46:14), Greek Σέρεδ; traditional English Sered.")))

(lemma "Σερούχ" (sense name (gloss "Serug") (why "Reu's son (Genesis 11:20-23; Luke 3:35, Σερούχ), traditional English Serug.")))

(lemma "Σήγωρ" (sense name (gloss "Zoar") (why "(LXX, supplied.) Genesis 14:2, 8 Βάλακ, αὕτη ἐστὶν Σήγωρ, \"Balak, this is Zoar\"; traditional English Zoar. Genesis 13:10 spells the same town Ζόγορα, also \"Zoar\".")))

(lemma "Σηείρ" (sense name (gloss "Seir") (why "(LXX, supplied.) The mountains of Seir (Genesis 14:6), Edom's hill country; traditional English Seir.")))

(lemma "Σήθ" (sense name (gloss "Seth") (why "Traditional English form; also Luke 3:38.")))

(lemma "Σηλώμ" (sense name (gloss "Shelah") (why "(LXX, supplied.) Judah's third son (Genesis 38:5, 11, 14, 26; 46:12), Greek Σηλώμ for the Hebrew Shelah: the same name in the Greek spelling, so traditional English Shelah. Not Σαλά, Arpachshad's son, also Shelah in English.")))

(lemma "Σήμ" (sense name (gloss "Shem") (why "Noah's son (Genesis 5:32; Luke 3:36), traditional English Shem.")))

(lemma "σημαίνω" (sense signify (dative "") (gloss "signify" "signified" "signifies" "signifying") (why "To give a sign, show, signify (Exodus 18:20, σημανεῖς αὐτοῖς τὰς ὁδούς, Moses showing the people the ways; John 12:33; Acts 11:28). The verb of σῆμα; kept apart from δείκνυμι \"show\". The dative is the one shown.")))

(lemma "σημεῖον"
  (sense sign
    (with-preposition "εἰς" for)
    (gloss "sign" "signs")
    (why "A sign, mark (Genesis 1:14; John 2:11).")))

(lemma "σήμερον" (sense today (gloss "today") (why "Today.")))

(lemma "σιγάω" (sense stay-silent (intransitive) (verb "stay silent" "stayed silent" "stayed silent") (gloss "stay silent" "stayed silent" "stays silent" "staying silent") (why "To be silent, keep still (Exodus 14:14, καὶ ὑμεῖς σιγήσετε; Luke 9:36; Acts 15:12). \"Keep silent\" is παρασιωπάω's.")))

(lemma "σίδηρος" (sense iron (gloss "iron") (why "Iron.")))

(lemma "Σιδών" (sense name (gloss "Sidon") (why "Canaan's firstborn and the city named for him (Genesis 10:15, 19; Matthew 11:21), traditional English Sidon.")))

(lemma "Σίκιμα" (sense name (gloss "Shechem") (plural "Shechem") (why "(LXX, supplied.) Genesis 48:22 δίδωμί σοι σίκιμα ἐξαίρετον, Jacob's gift to Joseph, the neuter plural name of the town elsewhere called Συχέμ (Genesis 12:6; 33:18; John 4:5 has Συχάρ near Joseph's field). The same place, so the same traditional English Shechem (rule 8), shared with Συχέμ. Swete prints it lowercase; the Hebrew word also means \"shoulder\", a share of land.")))

(lemma "σίκλος" (sense shekel (gloss "shekel" "shekels") (why "(LXX, supplied.) The shekel, a weight (Exodus 30:23-24 πεντακοσίους σίκλους, the spices of the anointing oil; 38:24-26; Numbers passim). The Hebrew word kept in Greek; traditional English \"shekel\". Kept apart from δίδραχμον \"didrachm\", the coin the Greek uses for it at Genesis 23 and Exodus 30:13.")))

(lemma "σιτοβολών" (sense granary (gloss "granary" "granaries") (why "(LXX, supplied.) A grain store, granary (Genesis 41:56 ἀνέῳξεν δὲ Ἰωσὴφ πάντας τοὺς σιτοβολῶνας).")))

(lemma "σιτοδοσία" (sense grain-ration (gloss "grain ration" "grain rations") (why "(LXX, supplied.) An allowance of grain, a grain ration (Genesis 42:19, 33 τὸν ἀγορασμὸν τῆς σιτοδοσίας ὑμῶν). From σῖτος + δίδωμι.")))

(lemma "σιτομετρέω" (sense ration (gloss "ration" "rationed" "rations" "rationing") (why "(LXX, supplied.) To measure out grain (σῖτος + μέτρον), give rations (Genesis 47:12, 14, Joseph was rationing grain to his father's house; Luke 12:42 has the noun σιτομέτριον). \"Ration\" keeps it a single verb and leaves \"grain\" to σῖτος, which follows it.")))

(lemma "σῖτος" (sense grain (gloss "grain") (why "Grain, wheat (Genesis 27:28, 37 σίτῳ καὶ οἴνῳ, Isaac's blessing; Matthew 3:12; John 12:24). (LXX form supplied.)")))

(lemma "σιτοποιός" (sense baker (person) (gloss "baker" "bakers") (why "(LXX, supplied.) A maker of bread from grain (σῖτος), a baker (Genesis 40:17 ἔργον σιτοποιοῦ). The base of ἀρχισιτοποιός \"chief baker\".")))

(lemma "σκεπαστής" (sense protector (person) (gloss "protector" "protectors") (why "(LXX, supplied.) One who covers and shelters, protector (Exodus 15:2 βοηθὸς καὶ σκεπαστής). From σκέπη \"shelter\".")))

(lemma "σκέπη" (sense shelter (gloss "shelter" "shelters") (why "(LXX, supplied.) A covering, shelter, protection (σκεπάζω \"shelter\"): the skin-cloths of hair σκέπην ἐπὶ τῆς σκηνῆς, \"[as] shelter upon the tent\" (Exodus 26:7); in the Psalms God's shelter. Kept apart from κάλυμμα \"cover\".")))

(lemma "σκέπτομαι" (sense look-out (verb "look out" "looked out" "looked out") (gloss "look out" "looked out" "looks out" "looking out") (why "(LXX form supplied.) To look about for, look out, choose with care (Genesis 41:33 σκέψαι ἄνθρωπον φρόνιμον; compare ἐπισκέπτομαι, Acts 6:3 \"look out\" seven men).")))

(lemma "σκεπάζω" (sense shelter (gloss "shelter" "sheltered" "shelters" "sheltering") (why "(LXX, supplied.) To cover, shelter, protect (Exodus 2:2 ἐσκέπασαν αὐτὸ μῆνας τρεῖς, of hiding the child; Hebrews 11:23 tells it with κρύπτω). \"Shelter\" keeps it apart from κρύπτω \"hide\" and the καλύπτω verbs \"cover\".")))

(lemma "σκεῦος" (sense gear (gloss "gear") (why "An implement, piece of equipment; here a hunter's gear (Genesis 27:3 λάβε τὸ σκεῦος, τήν τε φαρέτραν καὶ τὸ τόξον). The common New Testament sense \"vessel\" (Romans 9:21-23; 2 Timothy 2:20-21) will be its own sense."))
  (sense article (gloss "article" "articles") (why "A made object, an article (Genesis 24:53, σκεύη ἀργυρᾶ καὶ χρυσᾶ, articles of silver and gold given to Rebekah; Revelation 18:12, every article of ivory). Chosen by override where the things are goods or jewelry rather than equipment or vessels."))
  (sense vessel (gloss "vessel" "vessels") (why "A vessel, utensil, the common New Testament sense (Romans 9:21-23; 2 Timothy 2:20-21) and the furnishings of the tent: τὸ παράδειγμα πάντων τῶν σκευῶν αὐτῆς, \"the model of all its vessels\" (Exodus 25:9), πάντα τὰ σκεύη ταῦτα, the lampstand's utensils (25:39); Hebrews 9:21 πάντα τὰ σκεύη τῆς λειτουργίας, \"all the vessels of the ministry\". Chosen by word override for the tent's furnishings and utensils in every tabernacle chapter; κατασκευή is \"furnishing\".")))

(lemma "σκηνή" (sense tent (gloss "tent" "tents") (why "Tent, tabernacle; \"tent\" in the literal layer (Hebrews 11:9). Whether the tabernacle of Exodus keeps \"tent\" is a decision for the owner.")) (sense name (gloss "Tents") (why "(LXX, supplied.) The place name the Greek gives at Genesis 33:17, εἰς Σκηνάς ... Σκηναί, \"Tents\", where the Hebrew has Succoth; we translate the Greek name (rule 8, as Σύγχυσις \"Confusion\"), capitalized as a name.")))

(lemma "σκιρτάω" (sense leap (intransitive) (gloss "leap" "leaped" "leaps" "leaping") (why "To spring, leap, of a child in the womb (Genesis 25:22 ἐσκίρτων δὲ τὰ παιδία ἐν αὐτῇ; Luke 1:41, 44) or for joy (Luke 6:23).")))

(lemma "σκληροτράχηλος" (sense stiff-necked (gloss "stiff-necked") (why "(LXX, supplied.) Hard of neck, stiff-necked, stubborn (Exodus 33:3, 5, λαὸς σκληροτράχηλος; Acts 7:51 σκληροτράχηλοι, Stephen echoing it). The traditional English.")))

(lemma "σκνίψ"(sense gnat (gloss "gnat" "gnats") (why "(LXX, supplied.) A small biting insect, gnat, the third plague (Exodus 8:16-18; masculine, τὸν σκνῖφα, οἱ σκνῖφες).")))

(lemma "σκοπεύω" (sense keep-watch (intransitive) (verb "keep watch" "kept watch" "kept watch") (gloss "keep watch" "kept watch" "keeps watch" "keeping watch") (why "(LXX, supplied.) To keep a lookout, watch closely (Exodus 33:8, the people σκοπεύοντες each at the door of his tent as Moses went to the tent). From σκοπός \"watchman\"; \"keep watch\" keeps it apart from σκέπτομαι \"look out\" and τηρέω.")))

(lemma "σκοτεινός"(sense dark (gloss "dark") (why "Dark, full of darkness (Genesis 15:12 φόβος σκοτινὸς μέγας, Swete's spelling σκοτινός; Matthew 6:23). The adjective of σκότος \"darkness\".")))

(lemma "σκληρός" (sense hard (gloss "hard") (why "Hard, harsh (Genesis 21:11-12, the utterance was hard before Abraham; John 6:60 σκληρός ἐστιν ὁ λόγος οὗτος).")))

(lemma "σκληρῶς" (sense severely (gloss "severely") (why "(LXX, supplied.) Hardly, with difficulty, severely (Genesis 35:17 ἐν τῷ σκληρῶς αὐτὴν τίκτειν, of Rachel's hard labor). The adverb of σκληρός \"hard\"; English \"hardly\" now means \"scarcely\", so \"severely\".")))

(lemma "σκληρύνω"(sense harden (gloss "harden" "hardened" "hardens" "hardening") (why "(LXX form supplied.) To make hard, harden; passive, to be hardened, grow harsh (Genesis 49:7, their rage ὅτι ἐσκληρύνθη; Romans 9:18; Hebrews 3:8 quoting Psalm 94). The verb of σκληρός.")))

(lemma "σκηνόω" (sense camp (gloss "camp" "camped" "camps" "camping") (why "To live in a tent, encamp (Genesis 13:12, Lot camped in Sodom; John 1:14, the Word ἐσκήνωσεν among us). \"Camp\" keeps it apart from the noun σκηνή \"tent\"; the readable layer may say \"pitched his tent\" or \"dwelt\".")))

(lemma "σκοτία"
  (sense darkness
    (gloss "darkness")
    (why "σκοτία and σκότος are near synonyms and both take \"darkness\". John 1:5 has σκοτία where Genesis 1:2-5 has σκότος, so John's echo of Genesis is in the thought, not the word; the alignment shows which noun the Greek uses.")))

(lemma "σκότος"
  (sense darkness
    (gloss "darkness")
    (why "Darkness (Genesis 1:2-18; 2 Corinthians 4:6, \"out of darkness light will shine\", Paul's echo of Genesis 1:3). Shares \"darkness\" with σκοτία; see that entry.")))

(lemma "σκυθρωπός" (sense gloomy (gloss "gloomy") (why "Of a sad, sullen look, gloomy (Genesis 40:7, the prisoners' faces; Matthew 6:16; Luke 24:17).")))

(lemma "σκυλεύω" (sense despoil (gloss "despoil" "despoiled" "despoils" "despoiling") (why "(LXX, supplied.) To strip a slain enemy of his arms, and so despoil, plunder (σκῦλα \"spoils\"): Exodus 3:22, σκυλεύσατε τοὺς Αἰγυπτίους. \"Despoil\" keeps it apart from διαρπάζω \"plunder\".")))

(lemma "σκῦλον" (sense spoil (gloss "spoil" "spoils") (why "Spoil taken from an enemy (Exodus 15:9 μεριῶ σκῦλα, \"I will apportion spoils\"; Luke 11:22). The noun of σκυλεύω.")))

(lemma "σκύμνος" (sense whelp (gloss "whelp" "whelps") (why "(LXX, supplied.) A cub, a lion's whelp (Genesis 49:9 σκύμνος λέοντος, Ἰούδα).")))

(lemma "σκυτάλη" (sense stave (plural "staves") (gloss "stave" "staves") (why "(LXX, supplied.) A staff, cudgel, carrying pole (Exodus 30:4-5, the staves of the altar of incense, ψαλίδες ταῖς σκυτάλαις; 37-38 for the furniture). \"Stave\" keeps it apart from ῥάβδος \"staff\" and ἀναφορεύς, the carrying-pole word of 25:13-15. Tabernacle term: always \"stave\".")))

(lemma "σκώληξ" (sense worm (gloss "worm" "worms") (why "A worm, maggot (Exodus 16:20, 24, in the manna kept overnight; Mark 9:48).")))

(lemma "σκῶλον" (sense stake (gloss "stake" "stakes") (why "(LXX, supplied.) A pointed stake, a thorn to trip on, an obstacle (Exodus 10:7 Ἕως τίνος ἔσται τοῦτο ἡμῖν σκῶλον; Pharaoh's servants speaking of Moses). \"Stake\" keeps its picture and keeps it apart from ἄκανθα \"thorn\" and σκάνδαλον.")))

(lemma "σμάραγδος" (sense emerald (gloss "emerald" "emeralds") (why "Emerald (Revelation 21:19): the two shoulder stones, λίθους σμαράγδου \"stones of emerald\" (Exodus 28:9, where the Hebrew has onyx), and the third stone of the oracle's first row (28:17). The literal layer gives the stone the Greek names. The stones of the oracle keep the names the Greek gives them, in their English forms.")))

(lemma "σμύρνα" (sense myrrh (gloss "myrrh") (why "(LXX, supplied.) Myrrh, the gum resin (Exodus 30:23 τὸ ἄνθος σμύρνης ἐκλεκτῆς, the first spice of the anointing oil; Matthew 2:11; John 19:39). Kept apart from στακτή \"myrrh oil\". Tabernacle term.")))

(lemma "σνʹ" (sense two-hundred-fifty (gloss "two hundred fifty") (why "Not a word but a numeral written with Greek letters, σ (200) + ν (50) with the keraia ʹ: 250 (Exodus 30:23, as Swete prints it, between the spelled-out numerals of the verse). Rendered as the numeral words, like διακόσιοι πεντήκοντα \"two hundred fifty\" later in the same verse. Other letter numerals (Numbers, Judges) get entries of their own, each lemma the letters as printed.")))

(lemma "Σόδομα" (sense name (gloss "Sodom") (plural "Sodom") (why "The city, a neuter plural in Greek (Genesis 13:10-19:28; Matthew 10:15; Romans 9:29); traditional English Sodom, singular.")))

(lemma "Σοδομίτης" (sense name (person) (gloss "Sodomite" "Sodomites") (why "(LXX, supplied.) A man of Sodom (Genesis 19:4 οἱ ἄνδρες τῆς πόλεως οἱ Σοδομεῖται, Swete's spelling). Traditional English \"Sodomite\" for the inhabitant of the city; no other meaning is intended.")))

(lemma "Σουήλ" (sense name (gloss "Shur") (why "(LXX, supplied.) Genesis 25:18, the limit of Ishmael's dwelling, \"which is facing Egypt\": Swete's Σουήλ for the Hebrew Shur, elsewhere Σούρ (16:7; 20:1). The same place in another Greek spelling, so the same English, Shur.")))

(lemma "Σούρ" (sense name (gloss "Shur") (why "(LXX, supplied.) The wilderness of Shur, toward Egypt (Genesis 16:7; 20:1); traditional English Shur.")))

(lemma "Σουτάλααμ" (sense name (gloss "Shuthelah") (why "(LXX, supplied.) A son of Ephraim (Genesis 46:20, one of the Septuagint's additions to the list; Numbers 26:35-36), Greek Σουτάλααμ; traditional English Shuthelah.")))

(lemma "Σοκχώθ" (sense name (gloss "Succoth") (why "(LXX, supplied.) Israel's first camp after Rameses (Exodus 12:37; 13:20, ἐκ Σοκχώθ), indeclinable, the Hebrew name transliterated; traditional English Succoth.")))

(lemma "Σομαῖος" (sense name (person) (gloss "Zuzite" "Zuzites") (why "(LXX, supplied.) Genesis 14:5 τοὺς Σομαίους, a people the Hebrew calls the Zuzim; traditional English Zuzites, taking the Greek as the same people in its own spelling. For the owner: whether Σομαῖοι is a different name (\"Somaeans\").")))

(lemma "σορός" (sense coffin (gloss "coffin" "coffins") (why "(LXX form supplied.) A burial urn, coffin, bier (Genesis 50:26, Joseph put in the coffin in Egypt; Luke 7:14).")))

(lemma "Σομέ" (sense name (gloss "Shammah") (why "(LXX, supplied.) A son of Reuel, Esau's grandson, and a chief (Genesis 36:13, 17), Greek Σομέ; traditional English Shammah.")))

(lemma "σός"(sense your (gloss "your" "yours") (why "The possessive adjective \"your\" (singular): Genesis 21:13 σπέρμα σόν; Matthew 7:3. It shares \"your\" with the genitive σου, the same meaning in another form.")))

(lemma "σοφία" (sense wisdom (gloss "wisdom") (why "Wisdom, also skill of hand (Exodus 31:3 πνεῦμα θεῖον σοφίας, Bezalel's; 28:3; 35:31, 35; Luke 2:40; 1 Corinthians 1-2). One gloss for every use. (LXX form supplied.)")))

(lemma "σοφιστής" (sense sage (person) (gloss "sage" "sages") (why "(LXX, supplied.) A man skilled in wisdom, a sage (Exodus 7:11, Pharaoh's σοφισταί called with the sorcerers). \"Sage\" keeps it apart from σοφός \"wise\"; the later sense \"sophist\" does not belong here.")))

(lemma "σοφός" (sense wise (person) (gloss "wise") (why "Wise, skilled; as a noun, a wise man (Genesis 41:8 πάντας τοὺς σοφοὺς αὐτῆς, Egypt's wise men; Matthew 11:25; 1 Corinthians 1:19-27). \"Wise\" keeps it apart from φρόνιμος \"prudent\" and συνετός \"intelligent\".")))

(lemma "σπάδων" (sense castrate (person) (gloss "castrate" "castrates") (why "(LXX, supplied.) A castrated man, a eunuch, from σπάω \"tear\" (Genesis 37:36, τῷ Πετρεφῇ τῷ σπάδοντι Φαραώ). \"Castrate\" (the noun) because εὐνοῦχος (Genesis 39:1; Matthew 19:12; Acts 8:27) should keep \"eunuch\".")))

(lemma "σπαρτίον" (sense thread (gloss "thread" "threads") (why "(LXX, supplied.) A small cord, thread (Genesis 14:23, from a thread to a sandal's thong).")))

(lemma "σπείρω"
  (sense sow
    (gloss "sow" "sows" "sowed" "sown" "sowing")
    (why "(Supplied in Genesis 1:11-12, 29.) To sow (Matthew 13:3). Genesis has σπεῖρον σπέρμα, \"sowing seed\", where translations from the Hebrew have \"yielding seed\"; the Greek repeats the root, and so does the literal layer.")))

(lemma "σπένδω" (sense libate (gloss "libate" "libated" "libates" "libating") (why "(LXX form supplied.) To pour out a drink offering, libate (Genesis 35:14 ἔσπεισεν ἐπ’ αὐτὴν σπονδήν, \"libated upon it libation\"); passive of a life poured out, Philippians 2:17; 2 Timothy 4:6. Kept apart from ἐπιχέω \"pour on\" and ἐκχέω.")))

(lemma "σπέρμα"
  (sense seed
    (gloss "seed" "seeds")
    (why "Seed, and so offspring. Kept as \"seed\" in both layers, never \"offspring\": Galatians 3:16 argues from the singular σπέρμα, and Genesis 3:15 \"between your seed and her seed\" must stay readable that way.")))

(lemma "σπερματίζω" (sense form-seed (intransitive) (verb "form seed" "formed seed" "formed seed") (gloss "form seed" "formed seed" "forms seed" "forming seed") (why "(LXX, supplied.) To produce seed, go to seed (Exodus 9:31 τὸ δὲ λίνον σπερματίζον, the flax in seed when the hail struck). The verb of σπέρμα \"seed\".")))

(lemma "σπεύδω" (sense hasten (gloss "hasten" "hastened" "hastens" "hastening") (why "To hurry, hasten (Genesis 18:6 ἔσπευσεν ... Σπεῦσον; Luke 2:16; 19:5-6). Kept apart from ταχύνω \"hurry\".")))

(lemma "σπήλαιον" (sense cave (gloss "cave" "caves") (why "A cave (Genesis 19:30, Lot and his daughters in the cave; 23:9; John 11:38; Hebrews 11:38).")))

(lemma "σπιθαμή" (sense span (gloss "span" "spans") (why "(LXX, supplied.) A span, the width of the spread hand, half a cubit: σπιθαμῆς τὸ μῆκος αὐτοῦ καὶ σπιθαμῆς τὸ εὖρος \"of span its length and of span the width\" (Exodus 28:16; 36:16).")))

(lemma "σποδοειδής" (sense ash-colored (gloss "ash-colored") (why "(LXX, supplied.) Like ashes (σποδός) in color, ash-colored, gray (Genesis 30:39; 31:10-12, the flocks Jacob's rods produced). Kept apart from φαιός \"gray\".")))

(lemma "σποδός" (sense ashes (gloss "ashes") (why "Ashes (Genesis 18:27 γῆ καὶ σποδός \"earth and ashes\"; Matthew 11:21; Hebrews 9:13). A singular noun in Greek; English says \"ashes\".")))

(lemma "σπονδεῖον" (sense libation-bowl (gloss "libation bowl" "libation bowls") (why "(LXX, supplied.) A bowl for pouring libations (σπονδή \"libation\"), one of the table's vessels (Exodus 25:29; 37:16). Swete prints σπόνδια; the lemma (σπονδεῖον or σπόνδιον) is uncertain.")))

(lemma "σπονδή" (sense libation (gloss "libation" "libations") (why "(LXX, supplied.) A drink offering, libation (Genesis 35:14), the noun of σπένδω \"libate\".")))

(lemma "σπόριμος"
  (sense sowable
    (gloss "sowable")
    (why "Fit for sowing, sown (Genesis 1:29; Matthew 12:1, \"the sown [fields]\"). \"Sowable\" keeps it apart from σπείρω \"sow\" while showing the root.")))

(lemma "σπουδή" (sense haste (dative "in") (gloss "haste") (why "Haste, speed, and so eagerness (Exodus 12:11 ἔδεσθε αὐτὸ μετὰ σπουδῆς, \"with haste\"; 12:33 σπουδῇ, \"in haste\"; Mark 6:25; Luke 1:39 μετὰ σπουδῆς; Romans 12:8, 11 \"diligence\"). \"Haste\", the noun of σπεύδω \"hasten\".")))

(lemma "στάζω" (sense drip (intransitive) (gloss "drip" "dripped" "drips" "dripping") (why "(LXX, supplied.) To drip, fall in drops (Exodus 9:33 ὁ ὑετὸς οὐκ ἔσταξεν οὐκέτι ἐπὶ τὴν γῆν, the rain no longer dripping on the land).")))

(lemma "σταθμός" (sense balance (gloss "balance" "balances") (why "(LXX, supplied.) A weight, a balance for weighing, and so full weight (Genesis 43:21 τὸ ἀργύριον ἡμῶν ἐν σταθμῷ, \"our silver in balance\", the full sum). \"Balance\" keeps it apart from ὁλκή \"weight\"."))
  (sense doorpost (gloss "doorpost" "doorposts") (why "The upright post of a door, doorpost (Exodus 21:6, ἐπὶ τὴν θύραν ἐπὶ τὸν σταθμόν, where the slave's ear is bored; 12:7, 22-23, the blood on the doorposts). Chosen by override.")))

(lemma "σταῖς" (sense dough (gloss "dough") (why "(LXX, supplied.) Dough, flour kneaded with water, neuter τὸ σταῖς (Exodus 12:34, 39, the dough Israel carried out of Egypt before it was leavened).")))

(lemma "στακτή" (sense myrrh-oil (gloss "myrrh oil") (why "(LXX, supplied.) Oil of myrrh, the gum that drips (στάζω) from the tree (Genesis 37:25; 43:11, among the gifts for Joseph). Kept apart from σμύρνα \"myrrh\" (Matthew 2:11).")))

(lemma "στάμνος" (sense pot (gloss "pot" "pots") (why "A jar, pot (Exodus 16:33, the golden pot for the manna; Hebrews 9:4 στάμνος χρυσῆ). \"Pot\" because ὑδρία has \"jar\".")))

(lemma "σταφυλή" (sense grape (gloss "grape" "grapes") (why "A grape, bunch of grapes (Genesis 40:10-11; Matthew 7:16; Revelation 14:18). Collective singular in Genesis 40:11 ἔλαβον τὴν σταφυλήν.")))

(lemma "στάχυς" (sense ear-of-grain (plural "ears of grain") (gloss "ear of grain" "ears of grain") (why "An ear, head of grain (Genesis 41:5-27, the seven full and seven thin ears of Pharaoh's dream; Matthew 12:1; Mark 4:28). \"Ear of grain\" keeps it apart from οὖς \"ear\"; the noun takes \"of grain\" so English does not read the body part.")))

(lemma "στέαρ" (sense fat (gloss "fat" "fats") (why "(LXX, supplied.) Fat, the fat portions of an animal (Genesis 4:4).")))

(lemma "στέγη" (sense roof (gloss "roof" "roofs") (why "A roof, covering (Genesis 8:13, Noah uncovered the roof of the ark; Mark 2:4; Matthew 8:8).")))

(lemma "στεῖρα" (sense barren (gloss "barren") (why "Barren, unable to bear (Genesis 11:30, Sarai; Luke 1:7, 36; Galatians 4:27).")))

(lemma "στέλεχος" (sense stem (gloss "stem" "stems") (why "(LXX, supplied.) The trunk or stem of a tree (Genesis 49:21, Naphtali στέλεχος ἀνειμένον, \"stem let loose\").")))

(lemma "στεναγμός"
  (sense groaning
    (gloss "groaning" "groanings")
    (why "A groan, groaning (Genesis 3:16; Acts 7:34; Romans 8:26). Genesis 3:16 has \"your groaning\" where translations from the Hebrew have \"your conception\" or \"childbearing\".")))

(lemma "στένω" (sense groan (gloss "groan" "groaned" "groans" "groaning") (why "(LXX, supplied.) To groan: the verb of στεναγμός \"groaning\" (3:16).")))

(lemma "στερέω" (sense deprive (genitive "of") (gloss "deprive" "deprived" "deprives" "depriving") (why "(LXX, supplied.) To deprive, rob; passive with the genitive, to be deprived of (Genesis 48:11 τοῦ προσώπου σου οὐκ ἐστερήθην, \"of your face I was not deprived\").")))

(lemma "στερέωμα"
  (sense firmament
    (gloss "firmament")
    (why "Something made firm or solid; in Genesis 1 the firmament that separates the waters. Colossians 2:5 (\"the firmness of your faith\") will need its own sense.")))

(lemma "στεφάνη" (sense rim (gloss "rim" "rims") (why "(LXX, supplied.) A crown-like rim, a border running round (στέφανος \"crown\"): the rim of the altar (Exodus 27:3, 5) and of the table and the ark (25). \"Rim\" keeps it apart from στέφανος \"crown\" and κυμάτιον. Tabernacle term.")))

(lemma "στῆθος"
  (sense breast
    (gloss "breast")
    (why "(Supplied in Genesis 3:14.) Chest, breast (Luke 18:13; John 13:25).")))

(lemma "στηθύνιον" (sense brisket (gloss "brisket" "briskets") (why "(LXX, supplied.) The breast of a sacrificial animal, its brisket (diminutive of στῆθος \"breast\"): τὸ στηθύνιον ἀπὸ τοῦ κριοῦ τῆς τελειώσεως \"the brisket from the ram of the perfection\" (Exodus 29:26-27; Leviticus 7:30-34). \"Brisket\" keeps it apart from στῆθος \"breast\" and περιστήθιον \"breastpiece\".")))

(lemma "στήλη" (sense pillar (gloss "pillar" "pillars") (why "(LXX, supplied.) An upright stone, pillar (Genesis 19:26, Lot's wife a pillar of salt; 28:18, 22, Jacob's stone at Bethel). Kept apart from στῦλος (Galatians 2:9; Revelation 3:12), which will need its own English.")))

(lemma "στηρίζω" (sense support (gloss "support" "supported" "supports" "supporting") (why "To set fast, prop up, support; passive, be fixed (Genesis 27:37 σίτῳ καὶ οἴνῳ ἐστήρισα αὐτόν, \"with grain and wine I supported him\"; 28:12, the ladder ἐστηριγμένη ἐν τῇ γῇ, \"supported in the earth\"). \"Strengthen, establish\" (Luke 22:32; Romans 1:11) will be its own sense; \"establish\" is ἵστημι's. (LXX form supplied.)")))

(lemma "στίχος" (sense row (gloss "row" "rows") (why "(LXX, supplied.) A row, line: the four rows of stones in the oracle, ὁ στίχος ὁ εἷς ... ὁ δεύτερος (Exodus 28:17-20; 36:17-20). Kept with τετράστιχος \"four-rowed\".")))

(lemma "στολή" (sense robe (gloss "robe" "robes") (why "A long robe (Genesis 27:15, Esau's fine robe put on Jacob; Mark 16:5; Luke 15:22; Revelation 7:9). Kept apart from χιτών \"tunic\" and ἱμάτιον \"garment\". (LXX form supplied.)")))

(lemma "στόμα" (sense mouth (gloss "mouth" "mouths") (why "Mouth.")))

(lemma "στρατιά" (sense host (gloss "host" "hosts") (why "An army, a host (Exodus 14:4, 9, 17, ἐν πάσῃ τῇ στρατιᾷ αὐτοῦ, Pharaoh's army; Luke 2:13, a host of heaven; Acts 7:42). \"Army\" is δύναμις's, so \"host\".")))

(lemma "στρατοπεδεύω" (sense encamp (gloss "encamp" "encamped" "encamps" "encamping") (why "(LXX, supplied.) To pitch camp, encamp (Genesis 12:9, Abram encamped in the wilderness).")))

(lemma "στρεπτός" (sense wreathed (gloss "wreathed") (why "(LXX, supplied.) Twisted, plaited, wreathed (from στρέφω \"turn\"): κυμάτια στρεπτὰ χρυσᾶ, the wreathed gold moldings of the ark, the table and the incense altar (Exodus 25:11, 24-25; 30:3-4). \"Wreathed\" because κλώθω has \"twist\" (κεκλωσμένος \"twisted\").")))

(lemma "στρέφω"
  (sense turn
    (gloss "turn" "turns" "turned" "turning")
    (why "(Supplied in Genesis 3:24.) To turn; middle, to turn oneself (Genesis 3:24, the turning sword; Matthew 5:39).")))

(lemma "στρωμνή" (sense bedding (gloss "bedding") (why "(LXX, supplied.) What is spread to lie on, a mattress, bedding (Genesis 49:4, τότε ἐμίανας τὴν στρωμνήν). \"Bedding\" because κλίνη has \"bed\" and κοίτη \"couch\".")))

(lemma "στῦλος" (sense column (gloss "column" "columns") (why "A pillar, column (Exodus 13:21-22; 14:19, 24, ὁ στύλος τῆς νεφέλης, τοῦ πυρός; Galatians 2:9; Revelation 10:1, his feet as pillars of fire). Swete accents στύλος. \"Pillar\" is στήλη's, the standing stone, so \"column\".")))

(lemma "στυράκινος" (sense storax (gloss "storax") (why "(LXX, supplied.) Of the storax tree (Genesis 30:37, ῥάβδον στυρακίνην χλωράν, one of Jacob's rods).")))

(lemma "σύ"
  (sense pronoun
    (gloss "you" "your" "yours" "yourself")
    (why "The second-person pronoun, singular and plural (the table lemmatizes ὑμεῖς under σύ). English \"you\" cannot show number; the alignment shows it, and a note marks places where the number matters (Genesis 2:17).")))

(lemma "συγγένεια" (sense kindred (gloss "kindred" "kindreds") (why "Kinship, one's relatives, kindred (Genesis 12:1, \"out of your kindred\", quoted in Acts 7:3; Luke 1:61).")))

(lemma "συγγίνομαι" (sense be-with (dative "") (verb "be with" "was with" "been with") (gloss "be with" "was with" "were with" "been with" "being with") (why "(LXX, supplied.) To come together with, be with, and so to have intercourse with (Genesis 19:5 ἵνα συγγενώμεθα αὐτοῖς). \"Be with\" keeps the Greek's restraint; the readable layer can say more.")))

(lemma "συγκαθίζω" (sense sit-together (dative "with") (gloss "sit together" "sat together" "sits together" "sitting together") (why "To sit down together (with someone): Genesis 15:11 συνεκάθισεν αὐτοῖς Ἀβράμ, \"Abram sat together with them\", where the Hebrew has \"drove them away\"; we translate the Greek. Luke 22:55.")))

(lemma "συγκαίω" (sense scorch (gloss "scorch" "scorched" "scorches" "scorching") (why "(LXX, supplied.) To burn together, burn up; passive, to be scorched (Genesis 31:40 συγκαιόμενος τῷ καύσωνι, Jacob in the heat of the day).")))

(lemma "συγκαλέω" (sense call-together (verb "call together" "called together" "called together") (gloss "call together" "called together" "calls together" "calling together") (why "To call together, summon (Exodus 7:11 συνεκάλεσεν δὲ Φαραὼ τοὺς σοφιστάς; Luke 9:1; 15:6). Kept apart from καλέω \"call\". (LXX form supplied.)")))

(lemma "συγκατατίθημι" (sense consent (gloss "consent" "consented" "consents" "consenting") (why "Middle: to put down one's vote with another, consent, agree with (Exodus 23:1 οὐ συνκαταθήσῃ μετὰ τοῦ ἀδίκου; 23:32 οὐ συνκαταθήσῃ αὐτοῖς ... διαθήκην, Swete's spelling συνκ-; Luke 23:51). Kept apart from συμφωνέω \"agree\".")))

(lemma "συγκλείω" (sense shut-up (gloss "shut up" "shut up" "shuts up" "shutting up") (why "To shut in, shut up, confine (Genesis 16:2, the Lord has shut Sarai up from bearing; Romans 11:32; Galatians 3:22).")))

(lemma "συγκαλύπτω" (sense cover-up (gloss "cover up" "covered up" "covers up" "covering up") (why "To cover over completely (Genesis 9:23, they συνεκάλυψαν their father's nakedness; Luke 12:2). \"Cover up\" renders the συν- and leaves bare \"cover\" for καλύπτω.")))

(lemma "συγκρίνω" (sense interpret (gloss "interpret" "interpreted" "interprets" "interpreting") (why "To judge together, compare, and so interpret (Genesis 40:8, 16, 22; 41:12-15, interpreting dreams; 1 Corinthians 2:13; 2 Corinthians 10:12 \"compare\", which may become its own sense). Kept apart from κρίνω \"judge\".")))

(lemma "σύγκρισις" (sense interpretation (gloss "interpretation" "interpretations") (why "(LXX, supplied.) The interpretation of a dream (Genesis 40:12, 18; 41:11); the noun of συγκρίνω \"interpret\".")))

(lemma "συγκόπτω" (sense cut-up (verb "cut up" "cut up" "cut up") (gloss "cut up" "cuts up" "cutting up") (why "(LXX, supplied.) To cut to pieces, beat down (Genesis 34:30, having been gathered against me they will cut me up). Kept apart from κατακόπτω \"cut down\".")))

(lemma "συγχαίρω" (sense rejoice-with (dative "with") (gloss "rejoice" "rejoiced" "rejoices" "rejoicing") (why "To rejoice with someone (dative): Genesis 21:6, Luke 1:58, 1 Corinthians 12:26. The gloss is \"rejoice\" and the dative takes \"with\". χαίρω, when it is added, should take another English (\"be glad\") or say why it shares.")))

(lemma "συγχέω" (sense confuse (gloss "confuse" "confused" "confuses" "confusing") (why "(LXX forms supplied.) To pour together, confuse, confound (Genesis 11:7, 9, the confusing of the tongue; Acts 2:6, the crowd was confused). The noun σύγχυσις takes \"confusion\".")))

(lemma "σύγχυσις"
  (sense confusion
    (gloss "confusion")
    (why "Confusion, a pouring together (Acts 19:29). The noun of συγχέω \"confuse\"."))
  (sense name
    (gloss "Confusion")
    (why "(LXX, supplied.) The name the Greek gives the city of Genesis 11:9, Σύγχυσις, \"Confusion\", where the Hebrew has Babel; we translate the Greek name (rule 8), capitalized as a name.")))

(lemma "συκῆ"
  (sense fig-tree
    (gloss "fig tree" "fig trees")
    (why "The fig tree (Genesis 3:7; Matthew 21:19). φύλλα συκῆς is \"leaves of [a] fig tree\".")))

(lemma "συκοφαντέω" (sense slander (gloss "slander" "slandered" "slanders" "slandering") (why "(LXX form supplied.) To accuse falsely, extort by false charges (Genesis 43:18 τοῦ συκοφαντῆσαι ἡμᾶς; Luke 3:14; 19:8). \"Slander\" keeps it apart from κατηγορέω \"accuse\".")))

(lemma "συλλαμβάνω" (sense conceive (gloss "conceive" "conceived" "conceives" "conceiving") (why "To conceive (a child), Genesis 4:1; Luke 1:24. Its other sense, seize, becomes its own sense when met."))
  (sense take-in (verb "take in" "took in" "taken in") (gloss "take in" "took in" "taken in" "takes in" "taking in") (why "Middle with μετά: to take in with oneself as a partner (Exodus 12:4 συλλήμψεται μεθ’ ἑαυτοῦ τὸν γείτονα, \"he will take in with himself the neighbor\", to share the lamb). \"Take in\" keeps it apart from παραλαμβάνω \"take along\" and λαμβάνω \"take\".")))

(lemma "συλλέγω" (sense collect (gloss "collect" "collected" "collects" "collecting") (why "To gather up, collect (Genesis 31:46 Συλλέγετε λίθους; Matthew 13:28-30, 40-41). \"Collect\" keeps it apart from συνάγω \"gather\".")))

(lemma "συλλογισμός" (sense tally (gloss "tally" "tallies") (why "(LXX, supplied.) A reckoning together, a sum, the count of the people (Exodus 30:12 Ἐὰν λάβῃς τὸν συλλογισμὸν τῶν υἱῶν Ἰσραήλ). \"Tally\" keeps it apart from λογίζομαι \"reckon\" and ἐπίσκεψις \"inspection\".")))

(lemma "συμβαίνω" (sense befall (dative "") (subject "it") (gloss "befall" "befell" "befallen" "befalls" "befalling") (verb "befall" "befell" "befallen") (why "To come together, happen, befall (Genesis 42:4, 38; 44:29 συμβῇ αὐτῷ μαλακία, \"sickness may befall him\"; Mark 10:32; Acts 3:10). The dative is the one befallen.")))
;; (subject "it"): συμβαίνω is a true impersonal where no subject is expressed (Genesis 41:13 οὕτως καὶ συνέβη; 42:38 συμβήσεται αὐτὸν μαλακισθῆναι, \"it will befall\").

(lemma "συμβάλλω" (sense assist (dative "") (gloss "assist" "assisted" "assists" "assisting") (why "To throw together; middle, to contribute, help, assist (Genesis 30:8, Rachel: Συνεβάλετό μοι ὁ θεός; Acts 18:27 συνεβάλετο πολύ). \"Assist\" keeps it apart from βοηθός \"helper\"; the active \"meet, confer, ponder\" (Luke 2:19; 14:31) will be its own sense.")))

(lemma "συμβιβάζω" (sense instruct (gloss "instruct" "instructed" "instructs" "instructing") (why "To bring together; and so to teach, instruct (Exodus 18:16, συμβιβάζω αὐτοὺς τὰ προστάγματα τοῦ θεοῦ, with two accusatives, the persons and the thing taught; 1 Corinthians 2:16; Acts 9:22 \"proving\", which may become its own sense).")))

(lemma "σύμβλησις" (sense junction (gloss "junction" "junctions") (why "(LXX, supplied.) A putting together, a junction: the corner columns ἴσοι ἐκ τῶν κεφαλῶν εἰς σύμβλησιν μίαν, \"equal from the heads into one junction\" (Exodus 26:24). Kept apart from συμβολή \"coupling\".")))

(lemma "συμβολή" (sense coupling (gloss "coupling" "couplings") (why "(LXX, supplied.) A meeting, joining place: where two sets of curtains or skin-cloths meet and are joined (Exodus 26:4-5, 10; 36). \"Coupling\" keeps it apart from σύμβλησις \"junction\" and the verb συνάπτω \"join\". Tabernacle term.")))

(lemma "συμβουλεύω" (sense advise (dative "") (gloss "advise" "advised" "advises" "advising") (why "To give counsel, advise, with the dative of the one advised (Exodus 18:19, συμβουλεύσω σοι; John 18:14; Revelation 3:18). \"Advise\" because βουλή has \"counsel\". (LXX form supplied.)")))

(lemma "Συλλήμ" (sense name (gloss "Shillem") (why "(LXX, supplied.) A son of Naphtali (Genesis 46:24), Greek Συλλήμ; traditional English Shillem.")))

(lemma "Συμεών" (sense name (gloss "Simeon") (why "Jacob's second son by Leah (Genesis 29:33; 34:25; 42:24); Luke 2:25 and Revelation 7:7 Συμεών. Traditional English Simeon.")))

(lemma "συμμίγνυμι" (sense mingle (dative "with") (gloss "mingle" "mingled" "mingles" "mingling") (why "(LXX, supplied.) To mix together; of armies, to come into contact, close with (Exodus 14:20, οὐ συνέμιξαν ἀλλήλοις ὅλην τὴν νύκτα).")))

(lemma "Συμόβορ" (sense name (gloss "Shemeber") (why "(LXX, supplied.) King of Zeboiim (Genesis 14:2); traditional English Shemeber, the same man in a Greek spelling.")))

(lemma "συμπαραλαμβάνω" (sense take-along-with (verb "take along with" "took along with" "taken along with") (gloss "take along with" "took along with" "taken along with" "takes along with" "taking along with") (why "To take along with oneself (Acts 12:25; 15:37-38). Genesis 19:17 μή ποτε συνπαραλημφθῇς, lest you be taken along with [the city]. Built on παραλαμβάνω \"take along\".")))

(lemma "συμπίπτω" (sense fall-together (intransitive) (gloss "fall together" "fell together" "falls together" "falling together") (why "(LXX sense.) To fall together, collapse (Luke 6:49). Genesis 4:5-6, Cain's face fell.")))

(lemma "συμπλέκω" (sense plait-together (gloss "plait together" "plaited together" "plaits together" "plaiting together") (why "(LXX, supplied.) To plait together, intertwine (σύν + πλέκω \"plait\"): κροσοὺς συνπεπλεγμένους \"tassels plaited together\" (Exodus 28:22, where Swete prints the unassimilated συνπ-).")))

(lemma "συμποδίζω" (sense fetter (gloss "fetter" "fettered" "fetters" "fettering") (why "(LXX, supplied.) To tie the feet together, fetter (Genesis 22:9 συμποδίσας Ἰσαάκ), from σύν + πούς.")))

(lemma "συμπορεύομαι" (sense travel-together (gloss "travel together" "traveled together" "travels together" "traveling together") (why "To go along with, travel together (Genesis 18:16 συνεπορεύετο μετ’ αὐτῶν; Luke 7:11; 24:15). \"Travel together\" so the μετά that follows does not print \"go with with\"; kept apart from πορεύομαι \"go\".")))

(lemma "συμπροπέμπω" (sense escort (gloss "escort" "escorted" "escorts" "escorting") (why "(LXX, supplied.) To join in sending someone on the way, escort (Genesis 18:16 συνπροπέμπων αὐτούς, Swete's unassimilated spelling). The simple προπέμπω (Acts 15:3; Romans 15:24) will need its own English.")))
(lemma "συμφωνέω" (sense agree (gloss "agree" "agreed" "agrees" "agreeing") (why "To sound together, agree (Genesis 14:3, all these agreed upon the salty ravine, joined forces there; Matthew 18:19; 20:2).")))

(lemma "σύν" (sense with (gloss "with") (why "With, together with, governing the dative (Exodus 7:4 σὺν δυνάμει μου, σὺν ἐκδικήσει μεγάλῃ; Luke 2:13; Acts 14:4). It shares \"with\" with μετά and πρός: English has no second plain word, and the alignment shows which Greek word stands behind it.")))

(lemma "συνάγω"
  (sense gather
    (gloss "gather" "gathered" "gathers" "gathering")
    (why "(Some forms supplied.) To gather, bring together (Genesis 1:9; Matthew 3:12). The noun συναγωγή shares the root and the English (\"gathering\").")))

(lemma "συναγωγή"
  (sense gathering
    (gloss "gathering" "gatherings")
    (why "A gathering, a collected body (Genesis 1:9, the waters). The Jewish assembly and its building, \"synagogue\", will be a separate sense in the New Testament; the owner may instead want \"gathering\" there too.")))

(lemma "συναίρω" (sense raise-together (verb "raise together" "raised together" "raised together") (gloss "raise together" "raised together" "raises together" "raising together") (why "To take up together; with λόγον, to settle accounts (Exodus 23:5 συναρεῖς αὐτὸ μετ’ αὐτοῦ, lifting the fallen beast with its owner; Matthew 18:23-24; 25:19 συναίρει λόγον). Kept apart from αἴρω \"lift\".")))

(lemma "συναναβαίνω" (sense go-up-together (verb "go up together" "went up together" "gone up together") (gloss "go up together" "went up together" "gone up together" "goes up together" "going up together") (why "(LXX form supplied.) To go up together with (Genesis 50:7, 9, 14, Pharaoh's servants went up with Joseph to bury Jacob; Mark 15:41; Acts 13:31). The compound of ἀναβαίνω \"go up\" with σύν.")))

(lemma "συναναστρέφω" (sense turn-about-with (voice active) (dative "") (verb "turn about with" "turned about with" "turned about with") (gloss "turn about with" "turned about with" "turns about with" "turning about with") (why "(LXX, supplied.) Passive, to be turned about together with, have to do with, live among (Genesis 30:8, Rachel: συνανεστράφην τῇ ἀδελφῇ μου, at Naphtali's birth; Acts 10:41 v.l.). \"Turn about with\" keeps the verb's picture and leaves the kind of dealing open, as the Greek does.")))

(lemma "συναναφέρω" (sense bring-up-together (verb "bring up together" "brought up together" "brought up together") (gloss "bring up together" "brought up together" "brings up together" "bringing up together") (why "(LXX, supplied.) To bring up together with (Genesis 50:25, you will bring up my bones from here together with you). The compound of ἀναφέρω \"bring up\" with σύν.")))

(lemma "συναντάω" (sense meet-with (dative "") (verb "meet with" "met with" "met with") (gloss "meet with" "met with" "meets with" "meeting with") (why "To meet, come face to face with, with the dative (Genesis 46:28, to meet with Joseph; Luke 9:37; Hebrews 7:1). \"Meet with\" keeps it apart from ἀπαντάω \"meet\"; the noun is συνάντησις \"meeting\".")))

(lemma "συνάντημα" (sense encounter (gloss "encounter" "encounters") (why "(LXX, supplied.) What meets one, an occurrence, a blow that befalls (Exodus 9:14 πάντα τὰ συναντήματά μου, the plagues God sends on Pharaoh's heart). \"Encounter\" keeps the root of συναντάω \"meet\" and keeps it apart from συνάντησις \"meeting\".")))

(lemma "συνάντησις" (sense meeting (with-preposition "εἰς" for) (gloss "meeting") (why "A meeting; εἰς συνάντησιν + dative, \"for meeting\" someone, to meet them (Genesis 18:2; Matthew 8:34; John 12:13).")))

(lemma "συναντιλαμβάνομαι" (sense take-hold-with (dative "") (verb "take hold with" "took hold with" "taken hold with") (gloss "take hold with" "took hold with" "taken hold with" "takes hold with" "taking hold with") (why "(LXX form supplied.) To take hold together with someone at a load, help (Exodus 18:22, συναντιλήμψονταί σοι, the judges sharing Moses' burden; Luke 10:40; Romans 8:26). \"Take hold with\" renders σύν + ἀντιλαμβάνομαι and keeps it apart from βοηθέω \"help\" and ἀντιλαμβάνω \"lay hold\". Middle deponent, rendered active.")))

(lemma "συναπάγω" (sense lead-away-together (verb "lead away together" "led away together" "led away together") (gloss "lead away together" "led away together" "leads away together" "leading away together") (why "To lead away together, carry along with (Exodus 14:6, πάντα τὸν λαὸν αὐτοῦ συναπήγαγεν μεθ’ ἑαυτοῦ; Galatians 2:13; Romans 12:16). ἀπάγω is \"lead away\".")))

(lemma "συναπόλλυμι" (sense destroy-together (gloss "destroy together" "destroyed together" "destroys together" "destroying together") (why "To destroy together with (Genesis 18:23-25 μὴ συναπολέσῃς δίκαιον μετὰ ἀσεβοῦς; Hebrews 11:31, Rahab did not perish together with the disobedient). Built on ἀπόλλυμι \"destroy\"; the συν- is \"together\"."))
  (sense perish-together (dative "with") (verb "perish together" "perished together" "perished together") (gloss "perish together" "perished together" "perishes together" "perishing together") (why "The middle: to perish together with (Genesis 19:15 ἵνα μὴ συναπόλῃ ταῖς ἀνομίαις τῆς πόλεως; Hebrews 11:31 οὐ συναπώλετο τοῖς ἀπειθήσασιν). Chosen by the form row.")))

(lemma "συναποστέλλω" (sense send-with (verb "send with" "sent with" "sent with") (gloss "send with" "sent with" "sends with" "sending with") (why "To send along with, send together (Exodus 33:2, συναποστελῶ τὸν ἄγγελόν μου πρὸ προσώπου σου; 33:12; 2 Corinthians 12:18). \"Send with\" against ἀποστέλλω and ἐξαποστέλλω.")))

(lemma "συνάπτω"(sense join (gloss "join" "joined" "joins" "joining") (why "(LXX, supplied.) To fasten together, join: the curtains and skin-cloths joined to one another with the clasps (Exodus 26:6, 9, 11; 36). Kept apart from κολλάω and συνέχω \"hold together\". Tabernacle term.")))

(lemma "συναριθμέω" (sense number-together (verb "number together" "numbered together" "numbered together") (gloss "number together" "numbered together" "numbers together" "numbering together") (why "(LXX, supplied.) To count in together, reckon in with (Exodus 12:4, each household reckoning its share of the lamb by the number of souls). The compound of ἀριθμέω \"number\".")))

(lemma "συνδειπνέω" (sense dine-together (verb "dine together" "dined together" "dined together") (gloss "dine together" "dined together" "dines together" "dining together") (why "(LXX, supplied.) To dine together with (Genesis 43:32 τοῖς Αἰγυπτίοις τοῖς συνδειπνοῦσιν μετ’ αὐτοῦ). The compound of δειπνέω \"dine\".")))

(lemma "συνδέω" (sense bind-together (verb "bind together" "bound together" "bound together") (gloss "bind together" "bound together" "binds together" "binding together") (why "To bind together, fetter (Exodus 14:25, συνέδησεν τοὺς ἄξονας τῶν ἁρμάτων αὐτῶν, clogged the chariots' axles; Hebrews 13:3, as bound with them).")))

(lemma "συνεισέρχομαι" (sense go-in-together (verb "go in together" "went in together" "gone in together") (gloss "go in together" "went in together" "gone in together" "goes in together" "going in together") (why "To go in with someone, go in together (Exodus 21:3, ἐὰν δὲ γυνὴ συνεισέλθῃ μετ’ αὐτοῦ; John 6:22; 18:15). \"Together\" renders the συν- and keeps it apart from εἰσέρχομαι \"go in\". (LXX form supplied.)")))

(lemma "συνέρχομαι" (sense come-together (intransitive) (verb "come together" "came together" "come together") (gloss "come together" "came together" "comes together" "coming together") (why "To come together, assemble, gather (Exodus 32:26, συνῆλθον οὖν πάντες οἱ υἱοὶ Λευεί, to Moses; Mark 3:20; Acts 1:6; 1 Corinthians 11:17-20). \"Come together\" against συνάγω \"gather\".")))

(lemma "συνεσθίω"(sense eat-together (verb "eat together" "ate together" "eaten together") (gloss "eat together" "ate together" "eaten together" "eats together" "eating together") (why "To eat with, eat together (Genesis 43:32 συνεσθίειν μετὰ τῶν Ἐβραίων; Luke 15:2; Acts 11:3; Galatians 2:12). \"Eat together\" so a following μετά (\"with\") does not double the English. (LXX form supplied.)")))

(lemma "σύνεσις" (sense intelligence (gloss "intelligence") (why "Understanding, insight, the faculty of putting things together (Exodus 31:3, 6; 35:31; Luke 2:47; Colossians 1:9). \"Intelligence\" pairs with the adjective συνετός \"intelligent\" and keeps it apart from ἐπίσταμαι \"understand\". (LXX form supplied.)")))

(lemma "συνετός" (sense intelligent (comparative "more intelligent") (gloss "intelligent" "more intelligent") (why "Of understanding, intelligent (Genesis 41:33 ἄνθρωπον φρόνιμον καὶ συνετόν; 41:39 συνετώτερος; Matthew 11:25; Acts 13:7). \"Intelligent\" keeps it apart from σοφός \"wise\" and φρόνιμος \"prudent\".")))

(lemma "συνέχω" (sense restrain (gloss "restrain" "restrained" "restrains" "restraining") (why "To hold together, hold back, restrain (Genesis 8:2, the rain was restrained from heaven; Luke 12:50; 2 Corinthians 5:14, the love of Christ constrains us). \"Restrain\" for holding back; \"hold together\" or \"press\" (Luke 8:45) may become their own senses."))
  (sense hold-together (verb "hold together" "held together" "held together") (gloss "hold together" "held together" "holds together" "holding together") (why "To hold together, join: five curtains συνεχόμεναι ἑτέρα τῇ ἑτέρᾳ, \"being held together one to the other\" (Exodus 26:3; 36). Chosen by form row there; \"restrain\" would mislead.")))

(lemma "σύνθεσις" (sense composition (gloss "composition" "compositions") (why "(LXX, supplied.) A putting together, composition, the recipe of the anointing oil and the incense (Exodus 30:32, 37 κατὰ τὴν σύνθεσιν ταύτην; 31:11; 35:28 τὸ θυμίαμα τῆς συνθέσεως). Tabernacle term: always \"composition\"; the adjective σύνθετος is \"compounded\".")))

(lemma "σύνθετος" (sense compounded (gloss "compounded") (why "(LXX, supplied.) Put together, compounded (Exodus 30:7 θυμίαμα σύνθετον λεπτόν, \"compounded fine incense\"). Kept apart from σύνθεσις \"composition\".")))

(lemma "συννεφέω" (sense mass (gloss "mass" "massed" "masses" "massing") (why "(LXX, supplied.) To gather clouds, cloud over (σύν + νέφος); Genesis 9:14, ἐν τῷ συννεφεῖν με νεφέλας, with the cognate object, \"in my massing clouds\". \"Mass\" renders the σύν- and lets the object νεφέλας say \"clouds\"; \"gather\" is συνάγω's.")))

(lemma "συνίστημι" (sense commend (gloss "commend" "commended" "commends" "commending") (why "Transitive: to set together, introduce, commend, put in someone's charge (Genesis 40:4, the prisoners commended to Joseph; Romans 16:1; 2 Corinthians 3:1). Other senses (stand with, hold together) will be their own.")) (sense stand-together (intransitive) (verb "stand together" "stood together" "stood together") (gloss "stand together" "stood together" "stands together" "standing together") (why "Intransitive (perfect active): to have come to stand together, stand gathered: Exodus 7:19 πᾶν συνεστηκὸς ὕδωρ, all water standing together, pooled; 2 Peter 3:5, the earth συνεστῶσα out of water; Colossians 1:17 (\"hold together\" there may be its own sense). Chosen by form row.")))

(lemma "συνοικέω" (sense dwell-with (dative "") (verb "dwell with" "dwelt with" "dwelt with") (gloss "dwell with" "dwelt with" "dwells with" "dwelling with") (why "To live together with, dwell with, of marriage (Genesis 20:3 συνῳκηκυῖα ἀνδρί; 1 Peter 3:7). Built on οἰκέω \"dwell\".")))

(lemma "σύνταξις" (sense quota (gloss "quota" "quotas") (why "(LXX sense.) What is ordered or set, here the fixed daily tally of bricks (Exodus 5:8, 11, 14, 18 τὴν σύνταξιν τῆς πλινθίας), the noun of συντάσσω \"direct\". Not in the New Testament.")))

(lemma "συνταράσσω" (sense confound (gloss "confound" "confounded" "confounds" "confounding") (why "(LXX, supplied.) To throw into confusion, confound (Exodus 14:24, συνετάραξεν τὴν παρεμβολὴν τῶν Αἰγυπτίων). \"Confuse\" is συγχέω's.")))

(lemma "συντάσσω" (sense direct (dative "") (gloss "direct" "directed" "directs" "directing") (why "To arrange, give orders, direct, with the dative of the person (Genesis 18:19 συντάξει τοῖς υἱοῖς αὐτοῦ; Matthew 21:6; 26:19). \"Direct\" keeps it apart from ἐντέλλομαι \"command\" and τάσσω.")))

(lemma "συντέλεια" (sense completion (gloss "completion" "completions") (why "A bringing to an end, completion (Exodus 23:16 ἑορτὴν συντελείας, the feast at the year's completion; Matthew 13:39-40 συντέλεια αἰῶνος; Hebrews 9:26). The noun of συντελέω.")))

(lemma "συντελέω"
  (sense complete
    (gloss "complete" "completed" "completes" "completing")
    (why "(Some forms supplied.) To bring to an end, complete (Genesis 2:1-2; Hebrews 8:8, \"I will complete a new covenant\"). Against τελειόω, which will take \"perfect\", and τελέω \"finish\".")))

(lemma "Συρία" (sense name (gloss "Syria") (why "Syria, the Greek name where the Hebrew has Aram (Genesis 28:2, 5-7 Μεσοποταμία Συρίας, for Paddan-aram; Matthew 4:24; Luke 2:2). The Greek gives a different name, so the English follows the Greek.")))

(lemma "συντρίβω" (sense crush (gloss "crush" "crushed" "crushes" "crushing") (why "To break in pieces, shatter, crush (Genesis 19:9 ἤγγισαν συντρίψαι τὴν θύραν; Mark 14:3; Romans 16:20). Kept apart from κλάω \"break\" (bread).")))

(lemma "Σύρος" (sense syrian (person) (gloss "Syrian" "Syrians") (why "A Syrian (Genesis 22:21 πατέρα Σύρων, where the Hebrew has Aram; Luke 4:27 Ναιμὰν ὁ Σύρος). The Greek gives the people's name, so the English follows it.")))

(lemma "συνυφαίνω" (sense weave-together (verb "weave together" "wove together" "woven together") (gloss "weave together" "wove together" "woven together" "weaves together" "weaving together") (why "(LXX, supplied.) To weave together (σύν + ὑφαίνω \"weave\"): the undergarment's opening τὴν συμβολὴν συνυφασμένην ἐξ αὐτοῦ \"the coupling woven together from it\" (Exodus 28:32; 36:30). Kept with καθυφαίνω \"weave in\", ὑφάντης \"weaver\", ὕφασμα \"weaving\".")))

(lemma "συνωμότης" (sense confederate (person) (gloss "confederate" "confederates") (why "(LXX, supplied.) One bound by oath with another, a sworn ally (Genesis 14:13, who were confederates of Abram), from σύν + ὄμνυμι \"swear\".")))

(lemma "σύσκηνος" (sense tent-mate (person) (gloss "tent-mate" "tent-mates") (why "(LXX, supplied.) One sharing the same tent, a fellow lodger (σύν + σκηνή): Exodus 3:22, παρὰ γείτονος καὶ συσκήνου αὐτῆς. \"Tent-mate\" is made the same way.")))

(lemma "συσκιάζω" (sense shade (gloss "shade" "shaded" "shades" "shading") (why "(LXX, supplied.) To shade over, cover with shadow: the cherubim συσκιάζοντες ἐν ταῖς πτέρυξιν αὐτῶν ἐπὶ τοῦ ἱλαστηρίου, \"shading with their wings upon the propitiatory\" (Exodus 25:20; 37:9). \"Shade\" keeps it apart from ἐπισκιάζω and κατασκιάζω (Hebrews 9:5), which should take \"overshadow\".")))

(lemma "σύστασις" (sense league (gloss "league" "leagues") (why "(LXX, supplied.) A standing together: a band, a league, a conspiracy (Genesis 49:6, ἐπὶ τῇ συστάσει αὐτῶν, of Simeon and Levi). \"League\" keeps it apart from συναγωγή \"gathering\" and σύστημα.")))

(lemma "σύστημα"
  (sense collection
    (gloss "collection" "collections")
    (why "(LXX, supplied; Swete prints συστέματα.) A whole made of parts, a body or collection (Genesis 1:10, \"the collections of the waters\"). Not in the New Testament.")))

(lemma "συστρέφω" (sense twist-together (verb "twist together" "twisted together" "twisted together") (gloss "twist together" "twisted together" "twists together" "twisting together") (why "(LXX, supplied.) To twist or roll together, gather up; passive of the inward parts, to be wrung, churned (Genesis 43:30 συνεστρέφετο γὰρ τὰ ἔντερα αὐτοῦ, Joseph's bowels; Acts 28:3, gathering sticks). Kept apart from στρέφω \"turn\".")))

(lemma "Συχέμ" (sense name (gloss "Shechem") (why "The place in Canaan (Genesis 12:6; Acts 7:16), traditional English Shechem.")))

(lemma "σφάζω" (sense slaughter (gloss "slaughter" "slaughtered" "slaughters" "slaughtering") (why "To slaughter, kill by cutting the throat, as a sacrifice (Genesis 22:10; 1 John 3:12; Revelation 5:6, 9, 12 τὸ ἀρνίον τὸ ἐσφαγμένον).")))

(lemma "σφαιρωτήρ" (sense thong (gloss "thong" "thongs") (why "(LXX, supplied.) A strap, thong, of a sandal (Genesis 14:23, from a thread to a sandal's thong).")) (sense knob (gloss "knob" "knobs") (why "(LXX, supplied.) A ball-shaped thing (σφαῖρα \"ball\"), a round knob: the knobs on the lampstand's stalk and small reeds (Exodus 25:31-36; 37:17-22), where the Hebrew has knops or bulbs. Chosen in the form rows of those chapters. Tabernacle term.")))

(lemma "σφηκία" (sense hornet (gloss "hornet" "hornets") (why "(LXX, supplied.) A hornet, a wasp's nest (Exodus 23:28 ἀποστελῶ τὰς σφηκίας προτέρας σου).")))

(lemma "σφόδρα" (sense exceedingly (gloss "exceedingly") (why "Exceedingly, greatly (Genesis 7:18-19; Matthew 2:10, they rejoiced with exceedingly great joy). \"Exceedingly\" keeps it apart from λίαν-type \"very\" and from σφοδρῶς \"vehemently\" (Genesis 7:19, σφόδρα σφοδρῶς).")))

(lemma "σφοδρός" (sense violent (gloss "violent") (why "(LXX, supplied.) Vehement, violent, mighty (Exodus 15:10 ἐν ὕδατι σφοδρῷ, \"in violent water\"). The adjective of σφόδρα; \"violent\" because δυνατός has \"mighty\".")))

(lemma "σφοδρῶς" (sense vehemently (gloss "vehemently") (why "Violently, vehemently (Genesis 7:19, σφόδρα σφοδρῶς, \"exceedingly vehemently\"; Acts 27:18). Kept apart from σφόδρα \"exceedingly\" so the doubled Greek stays visible.")))

(lemma "σφραγίς" (sense seal (gloss "seal" "seals") (why "A seal, signet, and its impression (Romans 4:11; Revelation 5:1; 6:1): of the stones cut like signets, γλύμμα σφραγῖδος \"carved work of seal\", γλυφαὶ σφραγίδων \"engravings of seals\" (Exodus 28:11, 21, 36).")))

(lemma "σφυροκόπος" (sense hammerer (person) (gloss "hammerer") (why "(LXX, supplied.) One who strikes with a hammer, a smith at the forge (Genesis 4:22).")))

(lemma "σχολάζω" (sense loaf (intransitive) (gloss "loaf" "loafed" "loafs" "loafing") (why "(LXX sense.) To have leisure, be idle, loaf (Exodus 5:8, 17, Pharaoh's charge: σχολάζουσιν γάρ; Σχολάζετε, σχολασταί ἐστε, \"You loaf, you are loafers\"). \"Loaf\" keeps it apart from ῥᾳθυμέω \"idle\" and pairs with σχολαστής \"loafer\"; the New Testament's \"devote oneself\" (1 Corinthians 7:5) and \"be empty\" (Matthew 12:44) become senses of their own.")))

(lemma "σχολαστής" (sense loafer (person) (gloss "loafer" "loafers") (why "(LXX, supplied.) One at leisure, an idler (Exodus 5:17 σχολασταί ἐστε), the noun of σχολάζω \"loaf\".")))

(lemma "σῴζω" (sense save (gloss "save" "saved" "saves" "saving") (why "To save, rescue, keep safe (Genesis 19:17 Σώζων σῶζε τὴν σεαυτοῦ ψυχήν, 19:20, 22; Matthew 1:21). The middle σώζου, \"save [yourself]\", is rendered active.")))

(lemma "σῶμα" (sense body (gloss "body" "bodies") (why "Body; a dead body, carcass (Genesis 15:11, the birds came down on the bodies; Matthew 6:22; Luke 17:37).")))

(lemma "σχίζω" (sense split (verb "split" "split" "split") (gloss "split" "splits" "splitting") (why "To split, cleave, tear (Genesis 22:3 σχίσας ξύλα; Matthew 27:51 τὸ καταπέτασμα ἐσχίσθη, Luke 5:36).")))

(lemma "σχολή" (sense leisure (gloss "leisure") (why "Leisure, ease (Genesis 33:14, κατὰ σχολήν, at leisure, at an easy pace); in Acts 19:9 a lecture hall, which would be its own sense.")))

(lemma "Σωβάλ" (sense name (gloss "Shobal") (why "(LXX, supplied.) A son of Seir the Horite, and a chief (Genesis 36:20, 23, 29), Greek Σωβάλ; traditional English Shobal.")))

(lemma "σωτηρία"(sense safety (gloss "safety") (why "Deliverance, preservation, safety (Genesis 28:21 ἀποστρέψῃ με μετὰ σωτηρίας, \"bring me back with safety\"; Acts 27:34; Hebrews 11:7). \"Salvation\" is σωτήριον's gloss; whether the New Testament's σωτηρία \"salvation\" (Luke 1:69; Romans 1:16) becomes a second sense sharing it is for the owner. (LXX form supplied.)")))

(lemma "σωτήριον" (sense salvation (gloss "salvation" "salvations") (why "That which brings deliverance (Luke 2:30); τὰ σωτήρια, the peace offerings of the Law (Exodus 20:24), literally \"the salvations\".")))

(lemma "Σωύε" (sense name (gloss "Shuah") (why "(LXX, supplied.) A son of Abraham and Keturah (Genesis 25:2), Greek Σωύε; traditional English Shuah.")))

(lemma "Σώφ" (sense name (gloss "Shepho") (why "(LXX, supplied.) A son of Shobal the Horite (Genesis 36:23), Greek Σώφ for the Hebrew Shepho, the same name shortened: traditional English Shepho.")))

(lemma "Σωφάρ" (sense name (gloss "Zophar") (why "(LXX, supplied.) A son of Eliphaz (Genesis 36:11, 15), where the Hebrew has Zepho. The Greek gives the name of Job's friend Σωφάρ, Zophar (Job 2:11), so the English follows the Greek name (as Μαθουσαλά for Methushael).")))

(lemma "Σωφήρα"(sense name (gloss "Sephar") (why "(LXX, supplied.) The limit of the residence of Joktan's sons (Genesis 10:30), Greek Σωφήρα; traditional English Sephar.")))
