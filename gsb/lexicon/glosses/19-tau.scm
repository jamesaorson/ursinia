;; Greek Source Bible concordance, lemmas beginning with τ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Τάαμ" (sense name (gloss "Gaham") (why "(LXX, supplied.) Son of Nahor and Reumah (Genesis 22:24); Τάαμ is the Greek form of the Hebrew Gaham, the first letter lost or misread (Γ/Τ). Taken as the same name, so the traditional English Gaham; an open question for the owner whether the Greek differs enough to give \"Taam\".")))

(lemma "Τάβεκ" (sense name (gloss "Tebah") (why "(LXX, supplied.) Son of Nahor and Reumah (Genesis 22:24); the Greek form of the Hebrew Tebah. Traditional English Tebah.")))

(lemma "ταμεῖον" (sense inner-room (gloss "inner room" "inner rooms") (why "(LXX form supplied; Swete spells ταμιεῖον.) A storeroom, an inner private room (Genesis 43:30, Joseph going into it to weep; Matthew 6:6; 24:26; Luke 12:3).")))

(lemma "ταπεινόω" (sense humble (gloss "humble" "humbled" "humbles" "humbling") (why "To make low, humble, afflict (Genesis 15:13 ταπεινώσουσιν αὐτούς; 16:9 ταπεινώθητι, \"be humbled\"; Luke 14:11; Philippians 2:8).")))

(lemma "ταπείνωσις" (sense humiliation (gloss "humiliation") (why "Lowness, humiliation, affliction (Genesis 16:11, the Lord listened to your humiliation; Luke 1:48; Acts 8:33). The noun of ταπεινόω \"humble\".")))

(lemma "ταράσσω" (sense trouble (gloss "trouble" "troubled" "troubles" "troubling") (why "To stir up, trouble, disturb; passive, be troubled (Genesis 19:16 καὶ ἐταράχθησαν; Matthew 2:3; John 14:1).")))

(lemma "τάσσω"
  (sense appoint
    (gloss "appoint" "appointed" "appoints" "appointing")
    (why "(Supplied in Genesis 3:24.) To station, appoint, put in order (Acts 13:48; Romans 13:1). \"Appoint\" serves both the cherubim posted at Eden and the authorities appointed by God.")))

(lemma "ταῦρος" (sense bull (gloss "bull" "bulls") (why "(LXX form supplied.) A bull (Genesis 49:6, they hamstrung a bull; Matthew 22:4; Acts 14:13). Kept apart from μόσχος \"calf\".")))

(lemma "ταφή" (sense burial (gloss "burial" "burials") (why "(LXX form supplied.) Burial, the rites of burial (Genesis 50:3, the days of the burial; Matthew 27:7). Kept apart from τάφος \"tomb\".")))

(lemma "τάφος" (sense grave (gloss "grave" "graves") (why "A burial, a grave (Genesis 23:4, 20, κτῆσιν τάφου; Matthew 23:27; 27:61). \"Grave\" keeps it apart from μνημεῖον \"tomb\".")))

(lemma "ταχύνω" (sense hurry (gloss "hurry" "hurried" "hurries" "hurrying") (why "(LXX, supplied.) To make haste, hurry (Genesis 18:7 ἐτάχυνεν τοῦ ποιῆσαι αὐτό). From ταχύς \"quick\"; kept apart from σπεύδω \"hasten\" (18:6).")))

(lemma "ταχύς" (sense quickly (gloss "quickly") (why "The neuter ταχύ as an adverb, quickly (Genesis 27:20 Τί τοῦτο ὃ ταχὺ εὗρες; Matthew 28:7-8; Revelation 22:7). The adjective \"quick\" (James 1:19) will be its own sense. (LXX form supplied.)")))

(lemma "τέ"
  (sense both
    (gloss "both")
    (why "τε ... καί, \"both ... and\" (Genesis 2:25; 3:8)."))
  (sense and
    (gloss "and")
    (why "τε alone, a light \"and\" joining a clause (Genesis 2:20). It shares \"and\" with καί; the alignment shows which.")))

(lemma "τέκνον"
  (sense child
    (gloss "child" "children")
    (why "A child (Genesis 3:16; John 1:12).")))

(lemma "τεκνοποιέω" (sense bear-children (gloss "bear children" "bore children" "borne children" "bears children" "bearing children") (why "(LXX, supplied.) To produce children, bear children (Genesis 11:30, Sarai \"was not bearing children\"; 16:1). Built on τέκνον \"child\"; \"bear\" as τίκτω.")))

(lemma "τέλειος" (sense perfect (gloss "perfect") (why "Complete, whole, perfect (Genesis 6:9, Noah; Matthew 5:48). τελειόω, when it comes, will share \"perfect\" as the verb of this adjective; συντελέω keeps \"complete\".")))

(lemma "τελευτάω" (sense expire (intransitive) (gloss "expire" "expired" "expires" "expiring") (why "To come to the end (τελευτή) of life, die (Genesis 6:17; Matthew 2:19). \"Expire\" to keep it apart from ἀποθνῄσκω \"die\".")))

(lemma "τερέμινθος" (sense terebinth (gloss "terebinth" "terebinths") (why "(LXX, supplied.) The terebinth tree (Genesis 14:6, as far as the terebinth of Paran). Kept apart from δρῦς \"oak\".")))

(lemma "τελευτή" (sense end (gloss "end") (why "The end of life, death (Genesis 27:2 τὴν ἡμέραν τῆς τελευτῆς μου; Matthew 2:15, the end of Herod). \"End\" keeps it apart from θάνατος \"death\" and beside τελευτάω \"expire\". (LXX form supplied.)")))

(lemma "τέλος" (sense end (gloss "end" "ends") (why "End, goal, completion (Genesis 46:4 εἰς τέλος, \"into end\"; Matthew 10:22; 24:6; Romans 10:4). It shares \"end\" with τελευτή, the end of life: English has no second plain word; the alignment shows which Greek word stands behind it.")))

(lemma "τέσσαρες"
  (sense four
    (gloss "four")
    (why "The numeral \"four\".")))

(lemma "τεσσαρεσκαιδέκατος" (sense fourteenth (gloss "fourteenth") (why "(LXX, supplied.) Fourteenth (Genesis 14:5, in the fourteenth year; Acts 27:27).")))

(lemma "τεσσεράκοντα" (sense forty (gloss "forty") (why "The numeral forty (Genesis 5:13; 7:4; Matthew 4:2). Swete and the New Testament table spell τεσσεράκοντα.")))

(lemma "τέταρτος"
  (sense fourth
    (gloss "fourth")
    (why "The ordinal \"fourth\".")))

(lemma "τετράγωνος" (sense squared (gloss "squared") (why "(LXX, supplied.) Four-cornered, squared (Genesis 6:14, squared timbers; Revelation 21:16, the city lies τετράγωνος).")))

(lemma "τετρακόσιοι" (sense four-hundred (gloss "four hundred") (why "The numeral four hundred (Genesis 11:13-17; Acts 7:6).")))

(lemma "τετράπους"
  (sense four-footed
    (gloss "four-footed")
    (why "Four-footed; as a noun, a quadruped (Genesis 1:24; Acts 10:12; Romans 1:23).")))

(lemma "τηρέω"
  (sense watch
    (gloss "watch" "watches" "watched" "watching")
    (why "(Some forms supplied.) To watch, keep watch on (Matthew 27:36, 54). Genesis 3:15 τηρήσει / τηρήσεις, \"will watch\", where translations from the Hebrew have \"bruise\" or \"strike\". The commoner New Testament sense \"keep\" (John 14:15) becomes its own sense; φυλάσσω takes \"guard\".")))

(lemma "Τίγρις"
  (sense name
    (gloss "Tigris")
    (why "(LXX, supplied.) The river, by its Greek and traditional English name (Genesis 2:14), where the Hebrew has Hiddekel.")))

(lemma "τίθημι"
  (sense put
    (gloss "put" "puts" "putting")
    (why "To put, place, set (Genesis 1:17; 2:8, 15; 3:15). \"Lay down\" (John 10:11) will be its own sense.")))

(lemma "τίκτω"
  (sense bear
    (gloss "bear" "bears" "bore" "bearing" "borne")
    (why "To bear, give birth to (Genesis 3:16; Luke 2:7; John 16:21). γεννάω will take \"beget\" / \"be born\".")))

(lemma "τιμάω" (sense honor (gloss "honor" "honored" "honors" "honoring") (why "To honor.")))

(lemma "τιμή" (sense honor (gloss "honor" "honors") (why "Honor, value, price (Genesis 20:16 εἰς τιμὴν τοῦ προσώπου σου; Romans 2:7; 1 Peter 2:7). The noun of τιμάω and sharing its English \"honor\", as English uses one word for both; \"price\" (Matthew 27:6) will be its own sense."))
  (sense price (gloss "price" "prices") (why "(LXX sense, supplied.) The price paid for a thing (Genesis 44:2 τὴν τιμὴν τοῦ σίτου αὐτοῦ, the silver paid for the youngest's grain; Matthew 27:6, 9 τιμὴ αἵματος; Acts 4:34). Chosen by word override.")))

(lemma "τίς"
  (sense who
    (gloss "who" "what" "whom")
    (why "The interrogative pronoun: \"who\" of persons, \"what\" of things (Genesis 2:19; 3:11, 13)."))
  (sense why
    (gloss "why")
    (why "τί used adverbially, \"why\" (Genesis 3:1, τί ὅτι, \"why [is it] that\"; Matthew 6:28).")))

(lemma "τὶς" (sense one (gloss "one") (why "The indefinite pronoun, someone, anyone, a certain one. Genesis 6:5 πᾶς τις is \"every one\"; it shares \"one\" with the numeral εἷς there, and the alignment shows which. \"Someone\" and \"a certain\" (Luke 10:30) will be their own senses."))
  (sense certain (gloss "certain") (why "With a noun, \"certain\", some (Genesis 27:44 ἡμέρας τινάς, \"days certain\"; Luke 10:30 ἄνθρωπός τις; Acts 9:19 ἡμέρας τινάς). Chosen by word override."))
  (sense anything (gloss "anything") (why "The neuter τι with μή, \"[not] anything\", \"[in] anything\" (Genesis 18:30, 32 Μή τι, κύριε; 20:9 μή τι ἡμάρτομεν): \"one\" there would assert that no one is meant. Shares \"anything\" with οὐδείς/μηδείς after a negation. Chosen by word override.")))

(lemma "τμητός" (sense hewn (gloss "hewn") (why "(LXX, supplied.) Cut, hewn (of stone).")))

(lemma "τοιοῦτος" (sense such (gloss "such") (why "Of this kind, such (Genesis 39:11 τοιαύτη τις ἡμέρα; Matthew 9:8; John 4:23).")))

(lemma "τόξευμα" (sense arrow (gloss "arrow" "arrows") (why "(LXX, supplied.) An arrow, a shot (Genesis 49:23, κύριοι τοξευμάτων, \"lords of arrows\"). The noun of τοξεύω; beside τόξον \"bow\" and τοξότης \"archer\".")))

(lemma "τοκετός" (sense childbirth (gloss "childbirth" "childbirths") (why "(LXX, supplied.) Childbirth, delivery (Genesis 35:16 ἐδυστόκησεν ἐν τῷ τοκετῷ; 38:27). The noun of τίκτω \"bear\".")))

(lemma "τόξον"(sense bow (gloss "bow" "bows") (why "A bow; in Genesis 9:13-16 the bow set in the cloud (the rainbow; Revelation 4:3 has ἶρις). \"Bow\" keeps the Greek's one word for the weapon and the sign; \"rainbow\" is a reading for the readable layer.")))

(lemma "τοξότης" (sense archer (person) (gloss "archer" "archers") (why "(LXX, supplied.) A bowman, archer (Genesis 21:20), from τόξον \"bow\".")))

(lemma "τοπάρχης" (sense local-ruler (person) (gloss "local ruler" "local rulers") (why "(LXX, supplied.) The governor of a district (τόπος + ἄρχω), a local ruler (Genesis 41:34 καταστησάτω τοπάρχας ἐπὶ τῆς γῆς). \"Local ruler\" keeps it apart from ἄρχων \"ruler\".")))

(lemma "τόπος" (sense place (gloss "place" "places") (why "Place.")))

(lemma "τότε" (sense at-that-time (gloss "at that time") (why "Then, at that time (Genesis 12:6, \"the Canaanites at that time were inhabiting the land\"; Matthew 4:1). \"At that time\" because \"then\" is ἄρα's English.")))

(lemma "Τόχος" (sense name (gloss "Tahash") (why "(LXX, supplied.) Son of Nahor and Reumah (Genesis 22:24); the Greek form of the Hebrew Tahash. Traditional English Tahash.")))

(lemma "τράγος" (sense male-goat (gloss "male goat" "male goats") (why "A he-goat, male goat (Genesis 30:35; 31:10-12, Jacob's flocks; Hebrews 9:12-13, 19). Kept apart from αἴξ \"goat\" and ἔριφος \"kid\".")))

(lemma "τραῦμα" (sense wound (gloss "wound" "wounds") (why "Wound (Luke 10:34).")))

(lemma "τραυματίας" (sense wounded (person) (plural "wounded") (gloss "wounded") (why "(LXX, supplied.) One wounded, wounded or slain in battle (Genesis 34:27, the sons of Jacob went in upon the wounded). The noun of τραῦμα \"wound\".")))

(lemma "τράχηλος" (sense neck (gloss "neck" "necks") (why "The neck (Genesis 27:16, 40, the skins on Jacob's neck, the yoke on Esau's; Luke 15:20; Acts 15:10). (LXX form supplied.)")))

(lemma "τρεῖς" (sense three (gloss "three") (why "The numeral three (Genesis 5:31-32; 6:10; Matthew 12:40).")))

(lemma "τρέμω" (sense tremble (gloss "tremble" "trembled" "trembles" "trembling") (why "To tremble.")))

(lemma "τρέφω" (sense nourish (gloss "nourish" "nourished" "nourishes" "nourishing") (why "To feed, nourish, rear (Genesis 6:19-20, the animals kept alive in the ark; Matthew 6:26). \"Nourish\" so that βόσκω can keep \"feed\".")))

(lemma "τρέχω" (sense run (verb "run" "ran" "run") (gloss "run" "ran" "runs" "running") (why "To run (Genesis 18:7 εἰς τὰς βόας ἔδραμεν Ἀβραάμ; Luke 15:20; 1 Corinthians 9:24).")))

(lemma "τριάκοντα" (sense thirty (gloss "thirty") (why "The numeral thirty (Genesis 5; 6:15; Matthew 13:8).")))

(lemma "τριακόσιοι" (sense three-hundred (gloss "three hundred") (why "The numeral three hundred (Genesis 5:22-23; 6:15; Mark 14:5).")))

(lemma "τρίβολος"
  (sense thistle
    (gloss "thistle" "thistles")
    (why "A thistle, caltrop (Genesis 3:18; Matthew 7:16; Hebrews 6:8, \"thorns and thistles\", echoing Genesis).")))

(lemma "τρίβος" (sense path (gloss "path" "paths") (why "(LXX form supplied.) A beaten track, path (Genesis 49:17, a snake lurking upon a path; Matthew 3:3 quoting Isaiah 40:3). Kept apart from ὁδός \"way\".")))

(lemma "τριετίζω" (sense be-three-years-old (gloss "be three years old" "three years old") (why "(LXX, supplied.) To be three years old (Genesis 15:9, the heifer, goat and ram τριετίζουσαν, τριετίζοντα, \"being three years old\").")))

(lemma "τρίμηνος" (sense three-months (gloss "three months") (why "Of three months; as a noun, a space of three months (Genesis 38:24, μετὰ τρίμηνον, \"after three months\"; Hebrews 11:23, Moses hidden τρίμηνον).")))

(lemma "τρισκαιδέκατος" (sense thirteenth (gloss "thirteenth") (why "(LXX, supplied.) Thirteenth (Genesis 14:4, in the thirteenth year).")))

(lemma "τρίτος"
  (sense third
    (gloss "third")
    (why "The ordinal \"third\".")))

(lemma "τριώροφος" (sense three-storied (gloss "three-storied") (why "(LXX, supplied.) Having three stories or decks (Genesis 6:16; Acts 20:9 has τρίστεγον).")))

(lemma "τρόπος" (sense manner (gloss "manner" "manners") (why "A way, manner (Genesis 26:29 ὃν τρόπον, \"which manner\", the accusative of manner; Matthew 23:37; Acts 1:11).")))

(lemma "τροφή" (sense nourishment (gloss "nourishment") (why "(LXX form supplied.) Food, nourishment (Genesis 49:27, in the evening he gives nourishment; Matthew 3:4; 6:25). The noun of τρέφω \"nourish\"; βρῶμα has \"food\".")))

(lemma "τροφός" (sense nurse (person) (gloss "nurse" "nurses") (why "(LXX, supplied form.) A nurse, one who feeds a child (Genesis 35:8 Δεββωρὰ ἡ τροφὸς Ῥεβέκκας; 1 Thessalonians 2:7). From τρέφω \"feed\".")))

(lemma "τρυγών"(sense turtledove (gloss "turtledove" "turtledoves") (why "A turtledove (Genesis 15:9; Luke 2:24).")))

(lemma "τρόμος" (sense trembling (gloss "trembling") (why "Trembling, quaking from fear (Genesis 9:2, ὁ τρόμος ὑμῶν καὶ ὁ φόβος; Mark 16:8; 1 Corinthians 2:3, \"in fear and in much trembling\"). It shares \"trembling\" with the participle of its own verb τρέμω; φόβος is \"fear\".")))

(lemma "τρυφή"
  (sense delight
    (gloss "delight")
    (why "(Supplied in Genesis 3:23-24.) Luxury, delight, soft living (Luke 7:25; 2 Peter 2:13). In Genesis 3:23-24 the Septuagint translates the name Eden by its meaning: \"the paradise of the delight\". \"Delight\" (not \"luxury\") because it is a translation of the place name; the New Testament uses may want \"luxury\" as a second sense.")))

(lemma "τύμπανον" (sense drum (gloss "drum" "drums") (why "(LXX, supplied.) A hand drum, tambourine (Genesis 31:27 μετὰ μουσικῶν, τυμπάνων καὶ κιθάρας). The verb τυμπανίζω is in Hebrews 11:35.")))

(lemma "τύχη" (sense fortune (gloss "fortune") (why "(LXX, supplied.) What befalls one, fortune, luck (Genesis 30:11, Leah at Gad's birth: Ἐν τύχῃ, \"In fortune\"). From τυγχάνω \"happen upon\".")))
