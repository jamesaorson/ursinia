;; Greek Source Bible concordance, lemmas beginning with γ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Γάδ" (sense name (gloss "Gad") (why "Jacob's son by Zilpah (Genesis 30:11, named Ἐν τύχῃ \"In fortune\"); Revelation 7:5 Γάδ. Traditional English Gad.")))

(lemma "Γάζα" (sense name (gloss "Gaza") (why "Gaza (Genesis 10:19; Acts 8:26).")))

(lemma "Γάθερ" (sense name (gloss "Gether") (why "(LXX, supplied.) A son of Aram (Genesis 10:23), Greek Γάθερ; traditional English Gether.")))

(lemma "Γάδερ" (sense name (gloss "Eder") (why "(LXX, supplied.) ὁ πύργος Γάδερ, the tower of Eder (Genesis 35:21; Hebrew Migdal-eder); Γάδερ renders the Hebrew Eder with its guttural as γ, the same name: traditional English Eder.")))

(lemma "Γαιβήλ" (sense name (gloss "Ebal") (why "(LXX, supplied.) A son of Shobal the Horite (Genesis 36:23), Greek Γαιβήλ for the Hebrew Ebal (ayin heard as γ), the same name: traditional English Ebal.")))

(lemma "Γαιδάδ"(sense name (gloss "Irad") (why "(LXX, supplied.) Genesis 4:18: Greek Γαιδάδ for the Hebrew Irad; the traditional English name.")))

(lemma "γάλα" (sense milk (gloss "milk") (why "Milk (Genesis 18:8; 1 Corinthians 3:2; 1 Peter 2:2).")))

(lemma "Γαλαάδ" (sense name (gloss "Gilead") (why "(LXX, supplied.) Gilead, the hill country east of the Jordan (Genesis 31:21, 23, 25); Greek Γαλαάδ, indeclinable, traditional English Gilead.")))

(lemma "γαμβρεύω" (sense wed (gloss "wed" "wedded" "weds" "wedding") (why "(LXX, supplied.) To make a marriage tie, from γαμβρός \"son-in-law\"; in Genesis 38:8 the levirate duty, Judah to Onan: γάμβρευσαι αὐτήν, \"wed her\" (the wife of the dead brother). Matthew 22:24 has the compound ἐπιγαμβρεύω for the same duty. \"Wed\" keeps it apart from γαμέω, which should have \"marry\" when it comes.")))

(lemma "γαμβρός" (sense son-in-law (person) (plural "sons-in-law") (gloss "son-in-law" "sons-in-law") (why "(LXX, supplied.) A daughter's husband, son-in-law (Genesis 19:12, 14, Lot's sons-in-law)."))
  (sense father-in-law (person) (plural "fathers-in-law") (gloss "father-in-law" "fathers-in-law") (why "The word names a relative by marriage either way; Jethro is Moses' γαμβρός, his wife's father (Exodus 3:1; 4:18; 18:1-27), chosen by the Exodus form rows. It shares \"father-in-law\" with πενθερός (Genesis 38:13, 25): English has no second word; the alignment shows which Greek word stands behind it.")))

(lemma "Γάμερ" (sense name (gloss "Gomer") (why "(LXX, supplied.) Japheth's son (Genesis 10:2-3), Greek Γάμερ; traditional English Gomer.")))

(lemma "γάμος" (sense wedding (gloss "wedding" "weddings") (why "A wedding, marriage feast (Genesis 29:22, Laban ἐποίησεν γάμον; Matthew 22:2-10; John 2:1-2).")))

(lemma "γάρ"
  (sense for
    (gloss "for")
    (why "The explanatory particle, always rendered \"for\" and always placed first in its English clause (the Greek puts it second).")))

(lemma "γαστήρ" (sense womb (gloss "womb") (why "Belly, womb; ἐν γαστρὶ ἔχειν, \"to have in womb\", to be pregnant (Genesis 16:4-5, 11; Matthew 1:18). \"Womb\" because κοιλία has \"belly\".")))

(lemma "γέ" (sense even (gloss "even") (why "The intensive enclitic particle, stressing the word before it (Genesis 18:13 Ἆρά γε \"is it even\"; Luke 11:8; Romans 8:32). \"Even\" is used because δή takes \"indeed\"; καί's adverbial \"even\" (still unused) would share it, and its entry should take another word or a note.")))

(lemma "Γεθθάιμ" (sense name (gloss "Gittaim") (why "(LXX, supplied.) The city of the Edomite king Hadad (Genesis 36:35), where the Hebrew has Avith. The Greek gives a different name, the Gittaim of 2 Kingdoms 4:3, so the English follows the Greek (as Αἰθιοπία for Cush).")))

(lemma "γείτων" (sense neighbor (person) (gloss "neighbor" "neighbors") (why "(LXX, supplied.) One living near, a neighbor (Exodus 3:22 παρὰ γείτονος, the Hebrew women asking of their Egyptian neighbors; Luke 14:12; 15:6, 9; John 9:8). Shares \"neighbor\" with πλησίον (Exodus 20:16-17): English has no second plain word for the one living next door; the alignment shows which Greek word stands behind it.")))

(lemma "γελάω"(sense laugh (gloss "laugh" "laughed" "laughs" "laughing") (why "To laugh (Genesis 17:17; 18:12-15, Abraham's and Sarah's laughter, behind the name Isaac; Luke 6:21, 25).")))

(lemma "γελοιάζω" (sense jest (gloss "jest" "jested" "jests" "jesting") (why "(LXX, supplied.) To joke, jest (Genesis 19:14, Lot seemed to his sons-in-law to be jesting). Kept apart from γελάω \"laugh\".")))

(lemma "γέλως" (sense laughter (gloss "laughter") (why "Laughter (Genesis 21:6, Γέλωτά μοι ἐποίησεν Κύριος; James 4:9).")))

(lemma "γεμίζω" (sense load (genitive "with") (gloss "load" "loaded" "loads" "loading") (why "To fill, load, the causative of γέμω, with the genitive of what fills (Genesis 45:17, load your pack animals; Mark 15:36; John 2:7, fill the jars). \"Load\" keeps it apart from πίμπλημι and πληρόω \"fill\".")))

(lemma "γέμω" (sense be-full (verb "be full" "was full" "been full") (genitive "of") (gloss "be full" "is full" "are full" "was full" "were full" "been full" "being full") (why "To be full of, laden with, with the genitive (Genesis 37:25, the camels ἔγεμον θυμιαμάτων, \"were full of incenses\"; Matthew 23:27; Revelation 4:6, 8). \"Be full\" so every tense can be formed.")))

(lemma "γενεά" (sense generation (gloss "generation" "generations") (why "Generation.")))

(lemma "γένεσις"
  (sense genesis
    (gloss "genesis" "geneses")
    (plural "geneses")
    (why "Origin, coming into being, birth; the noun of γίνομαι. Genesis 2:4 αὕτη ἡ βίβλος γενέσεως and Matthew 1:1 βίβλος γενέσεως open with the same two words; one gloss keeps that visible. \"Genesis\" (the English loanword) is used rather than \"origin\" or \"generation\" because it is the only English word that carries the link to the book's name; the owner may prefer \"origin\" (see the Genesis book notes).")))

(lemma "γένημα" (sense product (gloss "product" "products") (why "What is produced, the yield of the land (Genesis 40:17, the baked products Pharaoh eats; Matthew 26:29 τοῦ γενήματος τῆς ἀμπέλου; 2 Corinthians 9:10). Kept apart from γέννημα \"offspring\" and καρπός \"fruit\".")))

(lemma "γεννάω" (sense beget (gloss "beget" "begot" "begotten" "begets" "begetting") (why "To beget (of the father), as in the genealogies of Genesis and Matthew 1. \"Beget\" keeps the genealogy formula recognizable.")))

(lemma "γένος"
  (sense kind
    (gloss "kind" "kinds")
    (why "Kind, sort, race (Genesis 1:11-25; Matthew 13:47, every kind of fish). \"Race\" or \"nation\" (1 Peter 2:9) will be a separate sense if needed."))
  (sense race
    (gloss "race" "races")
    (why "A people of common descent, race, kin (Genesis 19:38 ὁ υἱὸς τοῦ γένους μου, explaining the name Ἀμμάν; Acts 7:13, 19; 1 Peter 2:9 γένος ἐκλεκτόν).")))

(lemma "Γέραρα" (sense name (gloss "Gerar") (plural "Gerar") (why "(LXX, supplied.) The town in the south where Abimelech is king (Genesis 20:1-2; 26:1), a neuter plural in Greek (ἐν Γεράροις, Γεράρων); traditional English Gerar.")))

(lemma "Γεργεσαῖος" (sense name (person) (gloss "Girgashite" "Girgashites") (why "(LXX, supplied.) The Girgashites, a people of Canaan (Genesis 10:16; 15:21), by the traditional English name.")))

(lemma "γερουσία" (sense senate (gloss "senate" "senates") (why "(LXX, supplied.) The body of elders, council of old men (γέρων): Exodus 3:16, 18; 4:29, ἡ γερουσία (τῶν υἱῶν) Ἰσραήλ. \"Senate\" (Latin senex, old man) is made the same way and is the English of Acts 5:21, which uses the very phrase πᾶσαν τὴν γερουσίαν τῶν υἱῶν Ἰσραήλ.")))

(lemma "γεῦμα" (sense taste (gloss "taste" "tastes") (why "(LXX, supplied.) Taste, flavor (Exodus 16:31, the taste of the manna like a wafer in honey); the noun of γεύομαι.")))

(lemma "γεύω" (sense feed (gloss "feed" "fed" "feeds" "feeding") (why "(LXX, supplied.) The active of γεύομαι \"taste\": to make someone taste, give a taste of (Genesis 25:30 Γεῦσόν με ἀπὸ τοῦ ἑψέματος, Esau to Jacob). \"Feed\" because English \"taste\" cannot take the person as its object.")))

(lemma "Γέσεμ" (sense name (gloss "Goshen") (why "(LXX, supplied.) The district of Egypt where Jacob's family settled (Genesis 45:10; 46:28-34; 47:1-6, 27), Greek Γέσεμ; traditional English Goshen.")))

(lemma "Γεφάρ" (sense name (gloss "Ephah") (why "(LXX, supplied.) A son of Midian (Genesis 25:4); the Greek Γεφάρ renders the Hebrew Ephah with a different ending, traditional English Ephah.")))

(lemma "γεώργιον" (sense farmland (gloss "farmland" "farmlands") (why "Tilled land, a farmed field (Genesis 26:14 γεώργια πολλά, Isaac's many farmlands; 1 Corinthians 3:9 θεοῦ γεώργιον, \"God's farmland\"). Kept with γεωργός \"farmer\" (one root, γῆ + ἔργον); ἀγρός is \"field\".")))

(lemma "γεωργός" (sense farmer (person) (gloss "farmer" "farmers") (why "One who works the ground, a farmer (Genesis 9:20, Noah ἄνθρωπος γεωργὸς γῆς; Matthew 21:33-41; John 15:1; James 5:7). \"Farmer\" serves the γῆ + ἔργον of the word; \"vinedresser\" (John 15:1) is left to the readable layer.")))

(lemma "γῆ"
  (sense earth
    (gloss "earth")
    (why "The earth, as opposed to heaven or sea, and its soil. The Septuagint uses γῆ both for the Hebrew 'erets (earth, land) and 'adamah (ground); the literal layer keeps \"earth\" for all of them so the Greek's own links stay visible (Genesis 2:7 \"dust from the earth\", 3:19 \"earth you are, and into earth you will go away\")."))
  (sense land
    (gloss "land" "lands")
    (why "A particular land or region: \"the land of Havilah\", \"the land of Ethiopia\" (Genesis 2:11-13), \"the land of Judah\" (Matthew 2:6).")))

(lemma "Γηρά" (sense name (gloss "Gera") (why "(LXX, supplied.) A son of Bela in Benjamin's line (Genesis 46:21), Greek Γηρά; traditional English Gera. The table guessed γῆρας \"old age\".")))

(lemma "γῆρας" (sense old-age (gloss "old age") (why "Old age (Genesis 15:15 ἐν γήρει καλῷ; Luke 1:36).")))

(lemma "γηράσκω" (sense grow-old (intransitive) (verb "grow old" "grew old" "grown old") (gloss "grow old" "grew old" "grown old" "grows old" "growing old") (why "To grow old (Genesis 18:13 ἐγὼ δὲ γεγήρακα \"but I have grown old\"; John 21:18; Hebrews 8:13).")))

(lemma "Γηρσάμ" (sense name (gloss "Gershom") (why "(LXX, supplied.) Moses' son by Zipporah (Exodus 2:22; 18:3), named for Moses' being a sojourner (πάροικος) in a foreign land; Acts 7:29 mentions the two sons. Greek Γηρσάμ; traditional English Gershom, kept apart from Levi's son Γηρσών \"Gershon\".")))

(lemma "Γηρσών" (sense name (gloss "Gershon") (why "(LXX, supplied.) Levi's firstborn (Genesis 46:11), Greek Γηρσών; traditional English Gershon.")))

(lemma "Γηών"
  (sense name
    (gloss "Gihon")
    (why "(LXX, supplied.) The second river of Genesis 2:13, given its traditional English name.")))

(lemma "γίγας" (sense giant (person) (gloss "giant" "giants") (why "(LXX, supplied.) Giant (Genesis 6:4), the Septuagint's word for the Hebrew Nephilim and Gibborim of that verse; we translate the Greek.")))

(lemma "γίνομαι"
  (sense come-to-be
    ;; Impersonal (gsb/AGENTS.md rule 16a): with no subject, ἐγένετο is
    ;; "it came to be" (καὶ ἐγένετο οὕτως), not the open "he/she/it".
    (subject "it")
    (gloss "come to be" "came to be" "comes to be" "coming to be" "has come to be" "have come to be" "had come to be" "will come to be")
    (why "γίνομαι is coming into existence or into a state, against εἰμί, being. \"Come to be\" keeps that contrast everywhere (John 1:1-3 sets ἦν against ἐγένετο; Genesis 1:3 γενηθήτω φῶς καὶ ἐγένετο φῶς); \"was made\" would wrongly suggest a passive, and \"became\" needs a complement. Aorist: \"came to be\"; perfect: \"has come to be\". γίνομαι εἰς (Genesis 2:7) is literally \"come to be into\"; the readable layer says \"became\".")))

(lemma "γινώσκω"
  (sense know
    (gloss "know" "knew" "known" "knows" "knowing")
    (why "To know, come to know. It shares \"know\" with οἶδα: no English pair keeps the two apart without distorting one of them, so the alignment, not the English, shows which verb the Greek uses (Genesis 2:9 has οἶδα, 2:17 γινώσκω). The owner may prefer \"come to know\" or \"recognize\" for γινώσκω.")))

(lemma "γιώρας" (sense stranger (person) (gloss "stranger" "strangers") (why "(LXX, supplied.) A resident foreigner, a loanword from the Aramaic form of the Hebrew ger (Exodus 12:19 ἔν τε τοῖς γιώραις καὶ αὐτόχθοσιν τῆς γῆς). \"Stranger\" keeps it apart from προσήλυτος \"proselyte\", πάροικος \"sojourner\" and ἀλλογενής \"alien\".")))

(lemma "γλυκαίνω" (sense sweeten (gloss "sweeten" "sweetened" "sweetens" "sweetening") (why "(LXX, supplied.) To make sweet; passive, to become sweet (Exodus 15:25 ἐγλυκάνθη τὸ ὕδωρ, \"the water was sweetened\"); from γλυκύς \"sweet\" (James 3:11).")))

(lemma "γλύμμα" (sense carved-work (gloss "carved work" "carved works") (plural "carved works") (why "(LXX, supplied.) A thing carved, an intaglio: γλύμμα σφραγῖδος \"carved work of seal\", the names cut into the stones like a signet (Exodus 28:11; 36:13). From γλύφω \"carve\"; kept apart from γλυφή \"engraving\". Use this English in every tabernacle chapter.")))

(lemma "γλυφή" (sense engraving (gloss "engraving" "engravings") (why "(LXX, supplied.) Carving, engraving (from γλύφω \"carve\"): the engraved stones of the shoulder-piece and the oracle (Exodus 25:7 λίθους εἰς τὴν γλυφήν; 28:21; 35:9).")))

(lemma "γλύφω" (sense carve (gloss "carve" "carved" "carves" "carving") (why "(LXX, supplied.) To carve, cut letters or figures into stone: γλύψεις ἐν αὐτοῖς τὰ ὀνόματα \"you will carve on them the names\" (Exodus 28:9; 36:13). \"Carve\", as γλυφή's entry has it; διαγλύφω is \"engrave\", γλύμμα \"carved work\". Use this English in every tabernacle chapter.")))

(lemma "γλῶσσα" (sense tongue (gloss "tongue" "tongues") (why "Tongue, and so a language (Genesis 11:7, \"let us confuse their tongue\"; Acts 2:4, 11). \"Tongue\" in both, so Babel and Pentecost stay visibly linked.")))

(lemma "γνόφος" (sense gloom (gloss "gloom") (why "(LXX.) Thick darkness, gloom (Exodus 20:21; Hebrews 12:18). Kept apart from σκότος \"darkness\".")))

(lemma "γνοφώδης" (sense murky (gloss "murky") (why "(LXX, supplied.) Dark with gloom (γνόφος \"gloom\"), murky (Exodus 19:16, νεφέλη γνοφώδης over Sinai). \"Murky\" keeps it apart from σκυθρωπός \"gloomy\".")))

(lemma "γνωρίζω" (sense make-known (verb "make known" "made known" "made known") (gloss "make known" "made known" "makes known" "making known") (why "To make known, and in the passive to be known, recognized (Exodus 21:36, ἐὰν δὲ γνωρίζηται ὁ ταῦρος ὅτι κερατιστής ἐστιν, \"if the bull is made known that it is gorer\"; Luke 2:15; John 15:15; Romans 9:22). The English is shared with ἀναγνωρίζω \"make known\" (Genesis 45:1), the compound of the same verb; a separate sense \"recognize\" may be wanted later. (LXX form supplied.)")))

(lemma "γνωστός"
  (sense known
    (gloss "known")
    (why "Known, knowable (Acts 1:19; Romans 1:19, τὸ γνωστὸν τοῦ θεοῦ). Genesis 2:9 has the tree τοῦ εἰδέναι γνωστὸν καλοῦ καὶ πονηροῦ, \"of knowing [what is] known of good and evil\".")))

(lemma "γνωστῶς" (sense knowably (gloss "knowably") (why "(LXX, supplied.) The adverb of γνωστός \"known\": so as to be known, clearly (Exodus 33:13, γνωστῶς ἴδω σε, Moses asking to see the Lord). \"Knowably\" keeps the tie to \"known\".")))

(lemma "γογγύζω" (sense murmur (intransitive) (gloss "murmur" "murmured" "murmurs" "murmuring") (why "(LXX form supplied.) To mutter in discontent, murmur, grumble (Exodus 17:3, the people ἐγόγγυζεν against Moses; John 6:41; 1 Corinthians 10:10, recalling the wilderness). Traditional \"murmur\".")))

(lemma "γογγυσμός" (sense murmuring (gloss "murmuring" "murmurings") (why "A muttering in discontent, murmuring (Exodus 16:7-12, the people's murmuring heard by the Lord; John 7:12; Acts 6:1; Philippians 2:14). The noun of γογγύζω \"murmur\", sharing its English deliberately.")))

(lemma "Γοθόμ" (sense name (gloss "Gatam") (why "(LXX, supplied.) A son of Eliphaz (Genesis 36:11; Swete prints Γοθά at 36:16), Greek Γοθόμ; traditional English Gatam.")))

(lemma "γόμορ" (sense omer (gloss "omer" "omers") (why "(LXX, supplied.) Indeclinable, the Hebrew dry measure omer (Exodus 16:16-36; 16:36, the tenth of three measures); traditional English omer.")))

(lemma "γόμος" (sense burden (gloss "burden" "burdens") (why "A load, a beast's burden, a ship's cargo (Exodus 23:5 πεπτωκὸς ὑπὸ τὸν γόμον αὐτοῦ; Acts 21:3; Revelation 18:11-12). \"Burden\" because the verb γεμίζω has \"load\".")))

(lemma "γόνυ"(sense knee (gloss "knee" "knees") (why "The knee (Genesis 48:12, Joseph brought the boys out from Israel's knees, where they had been set as his own; Mark 15:19; Romans 11:4; Philippians 2:10). (LXX form supplied.)")))

(lemma "Γόμορρα" (sense name (gloss "Gomorrah") (why "The city (Genesis 10:19; 18:20; 19:24; Matthew 10:15; Romans 9:29); traditional English Gomorrah. Swete has the genitive Γομόρρας.")))

(lemma "γραμματεύς" (sense scribe (person) (gloss "scribe" "scribes") (why "A writer, clerk. In Exodus 5:6-19 the Israelite officers who kept the tally of the brick quota under the taskmasters (the Hebrew has shoterim, officers); in the Gospels the scribes, teachers of the Law (Matthew 2:4; 23:2). One English word, \"scribe\", for both.")))

(lemma "γραφή" (sense writing (gloss "writing" "writings") (why "A writing, what is written (Exodus 32:16, ἡ γραφὴ γραφὴ θεοῦ, the writing on the tablets). In the New Testament \"the writing\" is Scripture (John 2:22; 2 Timothy 3:16); one English word, \"writing\", shared with γράφω's -ing form, its verb.")))

(lemma "γραφίς" (sense stylus (dative "with") (gloss "stylus" "styluses") (why "(LXX, supplied.) A pointed tool for writing or engraving, stylus, graving tool (Exodus 32:4, ἔπλασεν αὐτὰ ἐν τῇ γραφίδι, Aaron shaping the gold). From γράφω \"write\".")))

(lemma "γράφω" (sense write (verb "write" "wrote" "written") (gloss "write" "wrote" "written" "writes" "writing") (why "To write (Exodus 24:4, Moses wrote all the utterances of the Lord; 24:12; 32:15; John 1:45). The perfect γέγραπται \"it has been written\" introduces Scripture in the New Testament (Matthew 4:4).")))

(lemma "γρύζω" (sense growl (intransitive) (gloss "growl" "growled" "growls" "growling") (why "(LXX, supplied.) To grunt, mutter, make the least sound (Exodus 11:7 οὐ γρύξει κύων τῇ γλώσσῃ αὐτοῦ, \"dog will not growl with its tongue\" against Israel). \"Growl\" for the dog's sound; kept apart from γογγύζω \"murmur\".")))

(lemma "γυμνός"
  (sense naked
    (gloss "naked")
    (why "Naked, without the outer garment (Genesis 2:25; 3:7-11; Matthew 25:36).")))

(lemma "γυμνόω" (sense make-naked (gloss "make naked" "made naked" "makes naked" "making naked") (why "(LXX, supplied.) To strip, lay bare; passive, to be made naked (Genesis 9:21, Noah ἐγυμνώθη in his house). \"Make naked\" keeps the link with γυμνός \"naked\" and γύμνωσις \"nakedness\".")))

(lemma "γύμνωσις" (sense nakedness (gloss "nakedness") (why "(LXX, supplied.) Nakedness, the uncovered body (Genesis 9:22-23, the nakedness of their father). Kept with γυμνός \"naked\"; against ἀσχημοσύνη.")))

(lemma "γυναικεῖος" (sense womanly (gloss "womanly") (why "(LXX, supplied.) Belonging to women; τὰ γυναικεῖα (Genesis 18:11, Swete γυναίκια) \"the womanly [things]\", a woman's monthly periods. 1 Peter 3:7 has τῷ γυναικείῳ \"the womanly [vessel]\".")))

(lemma "γυνή"
  (sense woman
    (person)
    (gloss "woman" "women")
    (why "A woman, and so also a wife. One gloss, \"woman\", in the literal layer (\"his woman\", Genesis 2:24) because the Greek has one word; the readable layer says \"wife\" where English needs it. This also keeps Genesis 2:22-23 (\"built ... into [a] woman\", \"this [one] will be called Woman\") continuous with \"his woman\" in 2:24-25.")))

(lemma "Γωλά" (sense name (gloss "Alvah") (why "(LXX, supplied.) A chief of Esau (Genesis 36:40), Greek Γωλά for the Hebrew Alvah (the Hebrew ayin heard as γ), the same name: traditional English Alvah.")))

(lemma "Γωλών" (sense name (gloss "Alvan") (why "(LXX, supplied.) A son of Shobal the Horite (Genesis 36:23), Greek Γωλών for the Hebrew Alvan, the same name: traditional English Alvan.")))

(lemma "γωνία" (sense corner (gloss "corner" "corners") (why "A corner, angle (Exodus 26:23-24, the corners of the tabernacle; 27:2, the four corners of the altar; Matthew 21:42, the head of the corner, from Psalm 117:22; Acts 4:11; Revelation 7:1).")))

(lemma "Γωυνί" (sense name (gloss "Guni") (why "(LXX, supplied.) A son of Naphtali (Genesis 46:24), Greek Γωυνί; traditional English Guni.")))
