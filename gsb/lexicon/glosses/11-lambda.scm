;; Greek Source Bible concordance, lemmas beginning with λ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Λαβάν" (sense name (gloss "Laban") (why "(LXX, supplied.) Rebekah's brother, son of Bethuel (Genesis 24:29; 27:43; 28:2, 5; chapters 29-31); traditional English Laban.")))

(lemma "Λαβιείμ" (sense name (person) (plural "Lehabim") (gloss "Lehabim") (why "(LXX, supplied.) A people descended from Mizraim (Genesis 10:13), Greek Λαβιείμ; traditional English Lehabim.")))

(lemma "λάγανον" (sense wafer (gloss "wafer" "wafers") (why "(LXX, supplied.) A thin cake, wafer: λάγανα ἄζυμα κεχρισμένα ἐν ἐλαίῳ \"unleavened wafers anointed in oil\" (Exodus 29:2, 23; Leviticus 2:4).")))

(lemma "λάκκος" (sense pit (gloss "pit" "pits") (why "(LXX, supplied.) A pit, cistern; a dungeon (Genesis 37:20-29, the pit Joseph was thrown into; 40:15, the prison called \"this pit\").")))

(lemma "λαλέω" (sense speak (gloss "speak" "spoke" "spoken" "speaks" "speaking") (why "To speak; kept apart from λέγω \"say\".")))

(lemma "λαμβάνω"
  (sense take
    (gloss "take" "took" "taken" "takes" "taking")
    (why "To take, receive. \"Take\" in Genesis 2-3; \"receive\" (John 1:12) will be its own sense.")))

(lemma "Λάμεχ" (sense name (gloss "Lamech") (why "Traditional English form; also Luke 3:36.")))

(lemma "λαμπάς" (sense torch (gloss "torch" "torches") (why "Torch, lamp (Exodus 20:18; Matthew 25:1).")))

(lemma "λαός" (sense people (gloss "people" "peoples") (why "A people.")))

(lemma "Λατουσιείμ" (sense name (gloss "Letushim") (why "(LXX, supplied.) A son of Dedan (Genesis 25:3), traditional English Letushim.")))

(lemma "λατομέω" (sense quarry (gloss "quarry" "quarried" "quarries" "quarrying") (why "To cut stone, quarry, hew out (Exodus 21:33, ἀνοίξῃ λάκκον ἢ λατομήσῃ, of a pit; Matthew 27:60 and Mark 15:46, a tomb hewn in rock, which may need its own sense). (LXX form supplied.)")))

(lemma "λατρεία" (sense service (gloss "service") (why "Service, worship rendered to God (Exodus 13:5, ποιήσεις τὴν λατρίαν ταύτην, Swete's spelling λατρία; John 16:2; Romans 12:1). The noun of λατρεύω \"serve\".")))

(lemma "λατρευτός" (sense servile (gloss "servile") (why "(LXX, supplied.) Of service, of hired or servant's labor: πᾶν ἔργον λατρευτόν, \"every servile work\", forbidden on the feast days (Exodus 12:16; Leviticus 23 passim). The adjective of λατρεύω \"serve\"; \"servile\" keeps it apart from λατρεία \"service\".")))

(lemma "λατρεύω" (sense serve (gloss "serve" "served" "serves" "serving") (dative "") (why "To serve (in worship), Exodus 20:5; Matthew 4:10.")))

(lemma "λάχανον" (sense vegetable (gloss "vegetable" "vegetables") (why "A garden plant, vegetable, green (Genesis 9:3, ὡς λάχανα χόρτου, \"as vegetables of grass\"; Matthew 13:32; Romans 14:2). \"Vegetable\" against χόρτος \"grass\" and βοτάνη.")))

(lemma "λέβης" (sense cauldron (gloss "cauldron" "cauldrons") (why "(LXX, supplied.) A cooking pot, cauldron (Exodus 16:3, the cauldrons of meat in Egypt).")))

(lemma "λέγω"
  (sense say
    (gloss "say" "said" "says" "saying")
    (why "To say. The table lemmatizes εἶπον under λέγω; both are \"say\".")))

(lemma "Λεία" (sense name (gloss "Leah") (why "(LXX, supplied.) Laban's older daughter, Jacob's wife (Genesis 29:16-35; 30-31; 49:31), Greek Λεία, declined (Λείας, Λείᾳ, Λείαν); traditional English Leah.")))

(lemma "λεῖος" (sense smooth (gloss "smooth") (why "Smooth (Genesis 27:11, Jacob ἀνὴρ λεῖος against Esau ἀνὴρ δασύς; Luke 3:5 quoting Isaiah 40:4). (LXX form supplied.)")))

(lemma "λειτουργέω" (sense minister (intransitive) (gloss "minister" "ministered" "ministers" "ministering") (why "To perform a public or sacred service, minister (Hebrews 10:11, every priest stands λειτουργῶν; Acts 13:2; Romans 15:27): Aaron ἐν τῷ λειτουργεῖν \"in ministering\" (Exodus 28:35, 43; 29:30; 30:20). \"Minister\" keeps it apart from λατρεύω \"serve\" and διακονέω. Use this English in every tabernacle chapter.")))

(lemma "λειτουργικός" (sense ministerial (gloss "ministerial") (why "Of ministering, used in sacred service (Exodus 31:10 τὰς στολὰς τὰς λειτουργικάς, Aaron's robes; 39:1, 41; Numbers 4:12, 26; Hebrews 1:14 λειτουργικὰ πνεύματα). The adjective of λειτουργέω \"minister\"; \"ministerial\" keeps the root without repeating the verb's participle \"ministering\". Tabernacle term. (LXX form supplied.)")))

(lemma "λεπίζω" (sense peel (gloss "peel" "peeled" "peels" "peeling") (why "(LXX, supplied.) To strip off the bark or rind, peel (Genesis 30:37-38, Jacob peeled the rods in white peelings, λεπίσματα).")))

(lemma "λέπισμα" (sense peeling (gloss "peeling" "peelings") (why "(LXX, supplied.) A strip peeled off, peeling (Genesis 30:37 ἐλέπισεν αὐτὰς λεπίσματα λευκά), the noun of λεπίζω \"peel\".")))

(lemma "λεπτός" (sense thin (gloss "thin") (why "Fine, small, thin (Genesis 41:3-27, the thin cows and thin ears of Pharaoh's dreams; Mark 12:42 λεπτά, the small coins, a sense of its own).")))

(lemma "Λευί" (sense name (gloss "Levi") (why "Jacob's third son by Leah (Genesis 29:34; 34:25; 49:5); Hebrews 7:5, 9 and Revelation 7:7 Λευί (Nestle spells Λευεί), the same name as the tax collector Levi (Mark 2:14). Traditional English Levi.")))

(lemma "Λευίτης" (sense name (person) (gloss "Levite" "Levites") (why "A Levite, a man of the tribe of Levi (Exodus 4:14, Ἀαρὼν ... ὁ Λευείτης, Swete's spelling; Luke 10:32; John 1:19); traditional English.")))

(lemma "λευκός" (sense white (gloss "white") (why "White (Genesis 30:35, 37; 31:8; 49:12; Matthew 5:36; 17:2; Revelation 1:14).")))

(lemma "λέων" (sense lion (gloss "lion" "lions") (why "(LXX form supplied.) A lion (Genesis 49:9, Judah a lion's whelp; Revelation 5:5 ὁ λέων ὁ ἐκ τῆς φυλῆς Ἰούδα; 1 Peter 5:8).")))

(lemma "ληνός" (sense vat (gloss "vat" "vats") (why "A trough or tub; the winepress vat (Revelation 14:19-20; Matthew 21:33). Genesis 30:38, 41 ἐν ταῖς ληνοῖς τῶν ποτιστηρίων, the vats of the watering troughs. \"Vat\" keeps it apart from ποτιστήριον \"trough\".")))

(lemma "λίαν"
  (sense very
    (gloss "very")
    (why "Very, exceedingly (Genesis 1:31; Matthew 2:16).")))

(lemma "λίβανος" (sense frankincense (gloss "frankincense") (why "(LXX, supplied.) Frankincense, the resin (Exodus 30:34 λίβανον διαφανῆ, in the incense; Matthew 2:11 χρυσὸν καὶ λίβανον καὶ σμύρναν; Revelation 18:13). Kept apart from θυμίαμα \"incense\". Tabernacle term.")))

(lemma "λιγύριον" (sense ligure (gloss "ligure" "ligures") (why "(LXX, supplied.) A precious stone of uncertain identity, the first of the oracle's third row (Exodus 28:19; 36:19). \"Ligure\" is the English form of the Greek name (the KJV's word); the identification is not resolved. The stones of the oracle keep the names the Greek gives them, in their English forms.")))

(lemma "λίθινος" (sense stony (gloss "stony") (why "Of stone, made of stone (Genesis 35:14 στήλην λιθίνην; John 2:6 λίθιναι ὑδρίαι; 2 Corinthians 3:3). \"Stony\" in its old sense \"made of stone\" (KJV Ezekiel 36:26 \"the stony heart\") keeps it apart from λίθος \"stone\".")))

(lemma "λιθοβολέω" (sense stone (gloss "stone" "stoned" "stones" "stoning") (why "To throw stones at, stone (Exodus 8:26, the Egyptians would stone Israel for sacrificing their abominations; Matthew 21:35; 23:37; Acts 7:58). The verb shares the English \"stone\" with the noun λίθος, as the Greek verb is built on it; the alignment shows which.")))

(lemma "λίθος"
  (sense stone
    (dative "with")
    (gloss "stone" "stones")
    (why "A stone, including a precious stone (Genesis 2:12).")))

(lemma "λιθουργικός" (sense stoneworking (gloss "stoneworking") (why "(LXX, supplied.) Of the stone-worker's craft (λίθος + ἔργον): ἔργον λιθουργικῆς τέχνης \"work of stoneworking craft\" (Exodus 28:11; 31:5; 35:33). Use this English in every tabernacle chapter.")))

(lemma "λιμός" (sense famine (gloss "famine" "famines") (why "Hunger, famine (Genesis 12:10; Luke 4:25; 15:14).")))

(lemma "λίνον" (sense flax (gloss "flax" "flaxes") (why "Flax, and what is made of it, linen, a wick (Exodus 9:31 τὸ δὲ λίνον καὶ ἡ κριθὴ ἐπλήγη, the flax struck by the hail; Matthew 12:20 quoting Isaiah 42:3; Revelation 15:6).")))

(lemma "λινοῦς" (sense linen (gloss "linen") (why "(LXX, supplied.) Of flax (λίνον \"flax\"), linen: περισκελῆ λινᾶ \"linen breeches\" (Exodus 28:42; Leviticus 6:10; 16:4). Plain \"linen\", kept apart from βύσσος/βύσσινος \"fine linen\".")))

(lemma "λίψ" (sense southwest (gloss "southwest") (why "(LXX, supplied.) The southwest wind, the southwest (Genesis 13:14 πρὸς βορρᾶν καὶ λίβα; Acts 27:12). The Hebrew has \"south\"; we translate the Greek.")))

(lemma "Λοβενί" (sense name (gloss "Libni") (why "(LXX, supplied.) A son of Gershon (Exodus 6:17), Greek Λοβενί; traditional English Libni.")))

(lemma "λοβός" (sense lobe (gloss "lobe" "lobes") (why "(LXX, supplied.) A lobe: of the liver, τὸν λοβὸν τοῦ ἥπατος \"the lobe of the liver\" (Exodus 29:13, 22), and of the ear, τὸν λοβὸν τοῦ ὠτός (29:20).")))

(lemma "λογίζομαι" (sense reckon (gloss "reckon" "reckoned" "reckons" "reckoning") (why "To reckon, count, credit to someone's account (Genesis 15:6 ἐλογίσθη αὐτῷ εἰς δικαιοσύνην, quoted in Romans 4:3, Galatians 3:6, James 2:23). \"Reckon\" keeps it apart from ἀριθμέω \"number\".")))

(lemma "λόγιον" (sense oracle (gloss "oracle" "oracles") (why "An utterance, oracle (Acts 7:38 λόγια ζῶντα; Romans 3:2; Hebrews 5:12; 1 Peter 4:11). In Exodus the high priest's breast pouch, which the Hebrew calls the breastpiece: λόγιον τῶν κρίσεων \"oracle of the judgments\" (28:15), τὸ λόγιον τῆς κρίσεως (28:29-30), carrying the disclosure and the truth (δήλωσις, ἀλήθεια). The Greek names it for its use, giving God's decision, and the literal layer keeps the Greek word (some texts spell it λογεῖον; Swete prints λόγιον). περιστήθιον is \"breastpiece\". Use this English in every tabernacle chapter (25:7; 29:5; 35-39).")))

(lemma "λόγος"
  (sense word
    (gloss "word" "words")
    (why "The traditional rendering. It keeps the link to God's creating word in Genesis 1 and to every other λόγος in Scripture. Capitalized when it is the Son's title (John 1:1, 14).")))

(lemma "λοιδορέω" (sense revile (dative "") (gloss "revile" "reviled" "reviles" "reviling") (why "(LXX form supplied.) To abuse with words, revile (Genesis 49:23, the archers ἐλοιδόρουν Joseph; John 9:28; 1 Corinthians 4:12; 1 Peter 2:23).")))

(lemma "λοιδόρησις" (sense revilement (gloss "revilement" "revilements") (why "(LXX, supplied.) A reviling, railing; Exodus 17:7, the second name of the place, Πειρασμός, καὶ Λοιδόρησις (Hebrew Meribah, \"strife\"). The noun of λοιδορέω \"revile\"; \"revilement\" keeps it apart from the participle \"reviling\" and from λοιδορία \"abuse\".")))

(lemma "λοιδορία" (sense abuse (gloss "abuse" "abuses") (why "(LXX form supplied.) Abusive speech, railing (Exodus 17:7, διὰ τὴν λοιδορίαν τῶν υἱῶν Ἰσραήλ; 1 Timothy 5:14; 1 Peter 3:9). \"Abuse\" keeps it apart from λοιδόρησις \"revilement\" in the same verse.")))

(lemma "λοιπός" (sense remaining (gloss "remaining") (why "Left, remaining, the rest (Genesis 45:6, further remaining five years; Matthew 22:6; Acts 2:37). It shares \"remaining\" with καταμένω's participle; the alignment shows which Greek word stands behind it.")))

(lemma "Λούδ" (sense name (gloss "Lud") (why "(LXX, supplied.) Shem's son (Genesis 10:22), traditional English Lud.")))

(lemma "Λουδιείμ" (sense name (person) (plural "Ludim") (gloss "Ludim") (why "(LXX, supplied.) A people descended from Mizraim (Genesis 10:13), Greek Λουδιείμ; traditional English Ludim.")))

(lemma "Λοῦζα" (sense name (gloss "Luz") (why "(LXX, supplied.) The old name of Bethel (Genesis 35:6; 48:3, where God appeared to Jacob), Greek Λοῦζα; traditional English Luz. Genesis 28:19 has Οὐλαμλούς for the same place.")))

(lemma "λουτήρ" (sense laver (gloss "laver" "lavers") (why "(LXX, supplied.) A washing basin (from λούω \"bathe\"): the bronze laver between the tent and the altar where the priests wash hands and feet (Exodus 30:18, 28; 31:9; 35:16; 38:8; 40). Tabernacle term: always \"laver\", the traditional English word for this basin, which keeps the washing root (Latin lavare) as the Greek keeps λούω.")))

(lemma "λούω" (sense bathe (voice middle) (gloss "bathe" "bathed" "bathes" "bathing") (why "To wash the whole body, bathe; middle, to bathe oneself (Exodus 2:5 κατέβη δὲ ἡ θυγάτηρ Φαραὼ λούσασθαι ἐπὶ τὸν ποταμόν; John 13:10 ὁ λελουμένος; Acts 9:37). \"Bathe\" keeps it apart from νίπτω \"wash\", washing a part of the body.")))

(lemma "λοχεύω" (sense bear-young (voice active) (verb "bear young" "bore young" "borne young") (gloss "bear young" "bore young" "borne young" "bears young" "bearing young") (why "(LXX, supplied.) To bring to birth; middle and passive, to be giving birth, have young (Genesis 33:13, the sheep and the cows are bearing young upon me). Kept apart from τίκτω \"bear\".")))

(lemma "Λοωμείμ" (sense name (gloss "Leummim") (why "(LXX, supplied.) A son of Dedan (Genesis 25:3), traditional English Leummim.")))

(lemma "λύκος" (sense wolf (plural "wolves") (gloss "wolf" "wolves") (why "(LXX form supplied.) A wolf (Genesis 49:27 Βενιαμεὶν λύκος ἅρπαξ; Matthew 7:15; 10:16; John 10:12).")))

(lemma "λυμαίνομαι" (sense mar (gloss "mar" "marred" "mars" "marring") (why "To maltreat, spoil, ravage (Exodus 23:8 τὰ γὰρ δῶρα ... λυμαίνεται ῥήματα δίκαια; Acts 8:3 Σαῦλος δὲ ἐλυμαίνετο τὴν ἐκκλησίαν). \"Mar\" because φθείρω has \"corrupt\" and καταφθείρω \"ruin\".")))

(lemma "λυπέω" (sense grieve (gloss "grieve" "grieved" "grieves" "grieving") (why "To grieve, cause sorrow; passive, be grieved. The verb of λύπη \"sorrow\".")))

(lemma "λύπη"
  (sense sorrow
    (gloss "sorrow" "sorrows")
    (why "Grief, sorrow, pain (Genesis 3:16-17; John 16:6, 20-22). John 16:21 (\"the woman, when she gives birth, has sorrow\") echoes Genesis 3:16; one gloss keeps it visible.")))

(lemma "λυπηρός" (sense grievous (gloss "grievous") (why "(LXX, supplied.) Painful, grievous (Genesis 34:7, λυπηρὸν ἦν αὐτοῖς σφόδρα, it was grievous to them exceedingly). The adjective of λύπη \"grief\".")))

(lemma "λύτρον" (sense ransom (gloss "ransom" "ransoms") (why "The price of release, ransom, usually plural λύτρα (Exodus 21:30, λύτρα τῆς ψυχῆς αὐτοῦ, for the owner of the goring bull; Matthew 20:28; Mark 10:45). (LXX form supplied.)")))

(lemma "λυτρόω" (sense redeem (voice middle) (gloss "redeem" "redeemed" "redeems" "redeeming") (why "To set free for a ransom, redeem; mostly middle, in the active sense (Exodus 13:13, 15, λυτρώσῃ, λυτρώσομαι, of the firstborn; Luke 24:21; Titus 2:14).")))

(lemma "λυχνία" (sense lampstand (gloss "lampstand" "lampstands") (why "A lampstand, the stand that holds the lamps (λύχνος): the gold lampstand of the tent (Exodus 25:31-35; 26:35; 31:8; 37:17; 40:4, 24), as in Hebrews 9:2 ἥ τε λυχνία καὶ ἡ τράπεζα and Revelation 1:12-20. Tabernacle term: always \"lampstand\".")))

(lemma "λύχνος" (sense lamp (gloss "lamp" "lamps") (why "A lamp, an oil lamp (Exodus 25:37, the seven lamps of the lampstand; 27:20; 30:7-8; Matthew 5:15; Revelation 21:23). Kept apart from λαμπάς \"torch\" and λυχνία \"lampstand\".")))

(lemma "λύω" (sense untie (gloss "untie" "untied" "unties" "untying") (why "To loose, untie (Genesis 42:27 λύσας δὲ εἷς τὸν μάρσιππον αὐτοῦ, opening his sack; Mark 1:7; John 1:27). \"Destroy\" (John 2:19) and \"release\" become their own senses when needed.")))

(lemma "λῶμα" (sense hem (gloss "hem" "hems") (why "(LXX, supplied.) The hem, the lower edge of a garment: ὑπὸ τὸ λῶμα τοῦ ὑποδύτου \"under the hem of the undergarment\" (Exodus 28:33-34; 36:31-33), where the little pomegranates and bells hang. Kept apart from ᾤα \"edging\" (28:32). Use this English in every tabernacle chapter.")))

(lemma "Λώτ" (sense name (gloss "Lot") (why "Haran's son, Abram's nephew (Genesis 11:27-31; 12:4-5; Luke 17:28-32; 2 Peter 2:7), traditional English Lot.")))

(lemma "Λωτάν" (sense name (gloss "Lotan") (why "(LXX, supplied.) A son of Seir the Horite, and a chief (Genesis 36:20, 22, 29), Greek Λωτάν; traditional English Lotan.")))
