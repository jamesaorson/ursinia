;; Greek Source Bible concordance, lemmas beginning with ω (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ὦ" (sense O (gloss "O") (why "The interjection of address, O (Genesis 27:20 ὦ τέκνον; Matthew 15:28; Galatians 3:1).")))

(lemma "ὧδε" (sense here (gloss "here") (why "Here, hither (Genesis 15:14, 16 ἐξελεύσονται ὧδε, \"they will come out here\"; Matthew 14:18).")))

(lemma "Ὠμάν" (sense name (gloss "Omar") (why "(LXX, supplied.) A son of Eliphaz (Genesis 36:11), Greek Ὠμάν (Ὠμάρ at 36:15) for the Hebrew Omar, the same name: traditional English Omar."))
  (sense onam (gloss "Onam") (why "(LXX, supplied.) A son of Shobal the Horite (Genesis 36:23), also printed Ὠμάν, for the Hebrew Onam: another man, traditional English Onam. Chosen by word override.")))

(lemma "Ὠμάρ" (sense name (gloss "Omar") (why "(LXX, supplied.) The chief Omar, son of Eliphaz (Genesis 36:15), Greek Ὠμάρ; the same man as Ὠμάν of 36:11. Traditional English Omar.")))

(lemma "ὦμος"(sense shoulder (gloss "shoulder" "shoulders") (why "The shoulder (Genesis 21:14; Matthew 23:4; Luke 15:5).")))

(lemma "Ὤν" (sense name (gloss "On") (why "(LXX, supplied.) On, the Egyptian city the Greek elsewhere calls Ἡλίου πόλις (Exodus 1:11 Ὤν, ἥ ἐστιν Ἡλίου πόλις). Swete prints Ὢν with a capital in Genesis 41:48, the city named; his transcription decision notes it as possibly a misprint.")))

(lemma "Ὠνάν" (sense name (gloss "Onan") (why "Genesis 36:24, a son of Zibeon (Ὠνάν, then ὁ Ὠνᾶς), where the Hebrew has Anah; the Greek gives the name of Judah's son Onan (Genesis 38:4-9), so the English follows the Greek name. Traditional English Onan.")))

(lemma "ὠνέομαι"(sense purchase (gloss "purchase" "purchased" "purchases" "purchasing") (why "(LXX, supplied.) To buy, purchase, with its aorist ἐπριάμην (Genesis 43:2 πρίασθε ἡμῖν μικρὰ βρώματα; 43:20 πρίασθαι; Acts 7:16 ὠνήσατο). \"Purchase\" keeps it apart from ἀγοράζω \"buy\".")))

(lemma "Ὤξ" (sense name (gloss "Uz") (why "(LXX, supplied.) Nahor's firstborn (Genesis 22:21); Ὤξ is the Greek for the Hebrew Uz. Traditional English Uz.")))

(lemma "ὥρα" (sense hour (gloss "hour" "hours") (why "An hour, a season, the due time (Genesis 18:10, 14 εἰς ὥρας \"into hours\", at the due season; Matthew 8:13; John 2:4). \"Hour\" in the literal layer so the New Testament's ὥρα keeps one English word; καιρός takes \"season\".")))

(lemma "ὡραῖος"
  (sense beautiful
    (gloss "beautiful")
    (why "(Supplied in Genesis 2:9; 3:6.) Timely, ripe, and so beautiful (Matthew 23:27; Acts 3:2, the Beautiful Gate; Romans 10:15).")))

(lemma "Ὤς" (sense name (gloss "Uz") (why "(LXX, supplied.) A son of Aram (Genesis 10:23), Greek Ὤς; traditional English Uz. Not the particle ὡς.")))

(lemma "ὡς"
  (sense as
    (gloss "as")
    (why "Comparison: \"as\" (Genesis 3:5, 22). ὅμοιος takes \"like\".")))

(lemma "ὡσεί" (sense about (gloss "about") (why "As it were, about, with a measure (Genesis 21:16 ὡσεὶ τόξου βολήν; Luke 3:23 ὡσεὶ ἐτῶν τριάκοντα; Acts 2:41). \"About\" keeps it apart from ὡς \"as\"."))
  (sense as-it-were (gloss "as it were") (why "Of likeness, not of a measure: as it were, like (Genesis 19:28 ὡσεὶ ἀτμὶς καμίνου; Matthew 3:16 ὡσεὶ περιστεράν; Luke 22:44). Chosen by word override.")))

(lemma "ὥσπερ" (sense as-if (gloss "as if") (why "Just as, as it were; in the telling of a dream, \"as if\" (Genesis 41:2, 18, 22 καὶ ἰδοὺ ὥσπερ ἐκ τοῦ ποταμοῦ ἀνέβαινον). \"As if\" keeps it apart from ὡσεί \"as it were\" and καθώς \"just as\"; the New Testament's comparative \"just as\" (Matthew 6:2) becomes its own sense when needed.")))

(lemma "ὥστε"
  (sense so-as
    (gloss "so as")
    (why "Result or purpose with the infinitive: \"so as to\" (Genesis 1:15, 17). \"So that\" is kept for ἵνα.")))
