;; Greek Source Bible concordance, lemmas beginning with α (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Ἅβελ" (sense name (gloss "Abel") (why "Traditional English form; also Matthew 23:35, Hebrews 11:4.")))

(lemma "ἅβρα" (sense maid (person) (gloss "maid" "maids") (why "(LXX, supplied.) A favorite maidservant, a lady's own maid (Genesis 24:61, Rebekah's maids). \"Maid\" keeps it apart from παιδίσκη \"maidservant\".")))

(lemma "Ἀβιμέλεχ" (sense name (gloss "Abimelech") (why "(LXX, supplied.) The king of Gerar (Genesis 20-21, 26); traditional English Abimelech.")))

(lemma "Ἀβιμεήλ" (sense name (gloss "Abimael") (why "(LXX, supplied.) A son of Joktan (Genesis 10:28), traditional English Abimael.")))

(lemma "Ἀβιρά" (sense name (gloss "Abida") (why "(LXX, supplied.) A son of Midian (Genesis 25:4). The Greek Ἀβιρά differs a little from the Hebrew Abida (ρ for δ); traditional English Abida.")))

(lemma "Ἀβραάμ" (sense name (gloss "Abraham" "Abraham's") (why "The name God gives Ἀβράμ in Genesis 17:5 (\"father of many nations\"); traditional English Abraham, as in the New Testament (Matthew 1:1; Romans 4).")))

(lemma "Ἀβράμ" (sense name (gloss "Abram") (why "(LXX, supplied.) The patriarch's name before Genesis 17:5 renames him Ἀβραάμ; traditional English Abram. Acts 7 and Hebrews use only Ἀβραάμ.")))

(lemma "ἄβυσσος"
  (sense abyss
    (gloss "abyss")
    (why "The deep of Genesis 1:2. Kept as \"abyss\" (not \"the deep\") so it matches the same word in Luke 8:31, Romans 10:7 and Revelation 9-20.")))

(lemma "ἀγαθός" (sense good (gloss "good") (why "Good. It shares \"good\" with καλός (Genesis 1); the alignment shows which word stands behind it. Whether to separate them (\"good\" / \"beautiful\" or \"fine\") is a decision for the owner.")))

(lemma "ἀγαπάω" (sense love (gloss "love" "loved" "loves" "loving") (why "To love.")))

(lemma "ἀγαπητός" (sense beloved (gloss "beloved") (why "Beloved; of an only son, the one dearly loved (Genesis 22:2, 12, 16 τὸν υἱόν σου τὸν ἀγαπητόν; Matthew 3:17 ὁ υἱός μου ὁ ἀγαπητός; Mark 12:6). From ἀγαπάω \"love\".")))

(lemma "Ἁγάρ" (sense name (gloss "Hagar") (why "Sarah's Egyptian slave-girl, mother of Ishmael (Genesis 16; 21; 25:12); traditional English Hagar, as in Galatians 4:24-25.")))

(lemma "Ἁγγαί" (sense name (gloss "Ai") (why "(LXX, supplied.) Genesis 12:8, the town east of Bethel: Greek Ἁγγαί, a transliteration of the Hebrew with its article (ha-Ai); traditional English Ai.")))

(lemma "ἄγγελος" (sense angel (person) (gloss "angel" "angels") (why "Messenger, angel (Matthew 1:20; Hebrews 1:4-7). Genesis 6:2 in Swete reads οἱ ἄγγελοι τοῦ θεοῦ, \"the angels of God\", where 6:4 has οἱ υἱοὶ τοῦ θεοῦ and the Hebrew has \"sons of God\" in both; we translate the Greek. A human messenger (Luke 7:24) may become its own sense.")))

(lemma "ἁγιάζω"
  (sense sanctify
    (gloss "sanctify" "sanctified" "sanctifies" "sanctifying")
    (why "To make or treat as holy (ἅγιος). \"Sanctify\" rather than \"make holy\" or \"hallow\", one English verb for one Greek verb; it keeps the link with the noun ἁγιασμός, \"sanctification\".")))

(lemma "ἀγνοέω" (sense be-ignorant (verb "be ignorant" "was ignorant" "been ignorant") (gloss "be ignorant" "is ignorant" "was ignorant" "been ignorant" "being ignorant") (why "Not to know, be ignorant (Genesis 20:4 ἔθνος ἀγνοοῦν, a nation acting in ignorance; Romans 10:3). \"Be ignorant\" keeps it apart from γινώσκω \"know\" and its negation.")))

(lemma "ἄγνοια" (sense ignorance (gloss "ignorance") (why "Not knowing, ignorance, and so a sin done unknowingly (Genesis 26:10, Abimelech: \"you brought on us ignorance\"; Acts 3:17; 17:30). Kept with ἀγνοέω \"be ignorant\".")))

(lemma "ἄγροικος" (sense rustic (gloss "rustic") (why "(LXX, supplied.) Of the country, rustic, a countryman (from ἀγρός \"field\"). Genesis 16:12, Ishmael \"will be rustic human\", where the Hebrew has \"a wild donkey of a man\"; we translate the Greek.")))

(lemma "ἀγρός"
  (sense field
    (gloss "field" "fields")
    (why "Open, uncultivated or farmed land outside a town: \"field\" in both testaments (\"the lilies of the field\", Matthew 6:28).")))

(lemma "ἄγω"
  (sense bring
    (gloss "bring" "brought" "bringing" "brings")
    (why "To lead or bring a person or animal somewhere (Genesis 2:19, 22). \"Lead\" (as in Romans 8:14) becomes its own sense if the context needs it.")))

(lemma "Ἀδά" (sense name (gloss "Adah") (why "(LXX, supplied.) Lamech's wife, Genesis 4:19-23, traditional English Adah.")))

(lemma "Ἀδάμ"
  (sense name
    (gloss "Adam")
    (why "The personal name. The Septuagint first uses it at Genesis 2:16; before that it says ἄνθρωπος, \"human\". We follow the Greek exactly: Ἀδάμ is always \"Adam\", ἄνθρωπος never is (see the Genesis book notes).")))

(lemma "Ἀδαμά" (sense name (gloss "Admah") (why "(LXX, supplied.) One of the five cities of the plain (Genesis 14:2, 8); traditional English Admah.")))

(lemma "ἀδελφή" (sense sister (person) (gloss "sister" "sisters") (why "Sister.")))

(lemma "ἀδελφός" (sense brother (person) (gloss "brother" "brothers") (why "Brother. \"Brother\" in the literal layer always, also for the wider \"brothers\" of the New Testament.")))

(lemma "ἀδικέω" (sense wrong (gloss "wrong" "wronged" "wrongs" "wronging") (why "To do wrong, to wrong someone; passive \"be wronged\" (Genesis 16:5 Ἀδικοῦμαι ἐκ σοῦ, \"I am wronged from you\"; Acts 7:24-27).")))

(lemma "ἀδικία" (sense unrighteousness (gloss "unrighteousness") (why "Wrongdoing, injustice: the opposite of δίκαιος \"righteous\" (Genesis 6:11, 13; Romans 1:18). \"Unrighteousness\" keeps that link visible.")))

(lemma "ἄδικος" (sense unrighteous (gloss "unrighteous") (why "Unrighteous, unjust (Genesis 19:8 μηδὲν ἄδικον; Matthew 5:45; 1 Corinthians 6:1): the adjective of ἀδικία \"unrighteousness\", the opposite of δίκαιος \"righteous\".")))

(lemma "ἀδολεσχέω" (sense muse (gloss "muse" "mused" "muses" "musing") (why "(LXX, supplied.) To talk at length, ponder, muse (Genesis 24:63, Isaac went out into the plain ἀδολεσχῆσαι; the Psalms use it of musing on God's works). The Hebrew word there is uncertain; the Greek is musing, talking with oneself.")))

(lemma "ἀδυνατέω" (sense be-impossible (intransitive) (verb "be impossible" "was impossible" "been impossible") (gloss "be impossible" "is impossible" "was impossible" "been impossible" "being impossible" "is not impossible") (why "(LXX, supplied.) To be impossible, unable (Genesis 18:14 μὴ ἀδυνατεῖ παρὰ τῷ θεῷ ῥῆμα; Luke 1:37 echoes it, οὐκ ἀδυνατήσει παρὰ τοῦ θεοῦ πᾶν ῥῆμα; Matthew 17:20). \"Be impossible\" keeps the δυνατός root (\"possible\") visible.")))

(lemma "Ἁζαῦ" (sense name (gloss "Hazo") (why "(LXX, supplied.) Nahor's son (Genesis 22:22); the Greek form of the Hebrew Hazo. Traditional English Hazo.")))

(lemma "ἄζυμος" (sense unleavened (gloss "unleavened") (why "Unleavened (Genesis 19:3, Lot bakes ἀζύμους, unleavened loaves; τὰ ἄζυμα, the feast of unleavened bread, Mark 14:1; 1 Corinthians 5:8).")))

(lemma "ἀθῷος" (sense innocent (gloss "innocent") (why "Guiltless, free of a charge or obligation (Genesis 24:41, ἀθῷος ἔσῃ ἐκ τῆς ἀρᾶς μου; Matthew 27:4, 24). Kept apart from καθαρός \"clean\", which Genesis 24:8 uses for the same release.")))

(lemma "Αἰγύπτιος" (sense name (person) (gloss "Egyptian" "Egyptians") (why "(Supplied for Genesis 12.) An Egyptian, one of the people of Αἴγυπτος (Genesis 12:12, 14; Acts 7:22, 24).")))

(lemma "Αἴγυπτος" (sense name (gloss "Egypt") (why "Egypt.")))

(lemma "Αἰζήλ" (sense name (gloss "Uzal") (why "(LXX, supplied.) A son of Joktan (Genesis 10:27), Greek Αἰζήλ; traditional English Uzal.")))

(lemma "Αἰθιοπία"
  (sense name
    (gloss "Ethiopia")
    (why "(LXX, supplied.) The country name as the Greek gives it (Genesis 2:13), where the Hebrew has Cush. Same English as Αἰθίοψ in Acts 8:27 (\"an Ethiopian\").")))

(lemma "Αἰλάμ" (sense name (gloss "Elam") (why "(LXX, supplied.) The land of Chedorlaomer (Genesis 14:1, 9), Greek Αἰλάμ; traditional English Elam (the people are Ἐλαμῖται in Acts 2:9).")))

(lemma "Αἰλώμ" (sense name (gloss "Elon") (why "(LXX, supplied.) Father of Esau's wife Basemath (Genesis 26:34), traditional English Elon. Swete's Greek makes him a Hivite (Εὑαῖος) where the Hebrew has \"the Hittite\"; we translate the Greek.")))

(lemma "αἷμα" (sense blood (gloss "blood" "bloods") (why "Blood. Genesis 4:10-11, Abel's blood; Hebrews 12:24.")))

(lemma "Αἰνεμετιείμ" (sense name (person) (plural "Anamim") (gloss "Anamim") (why "(LXX, supplied.) A people descended from Mizraim (Genesis 10:13), Greek Αἰνεμετιείμ; traditional English Anamim.")))

(lemma "αἴξ" (sense goat (gloss "goat" "goats") (why "(LXX, supplied.) A goat, she-goat (Genesis 15:9). τράγος \"male goat\" (Hebrews 9:12) and ἔριφος \"kid\" will need other words.")))

(lemma "αἰσχύνω"
  (sense ashamed
    (verb "be ashamed")
    (voice active)
    (gloss "ashamed")
    (why "Lemma form as in the New Testament table. The middle/passive, the only voice used so far, is \"be ashamed\"; the imperfect is \"were being ashamed\" in the literal layer (Genesis 2:25).")))

(lemma "αἰτία" (sense charge (gloss "charge" "charges") (why "Cause, accusation, the charge against someone (Matthew 27:37, the charge over the cross). Genesis 4:13 \"greater [is] my charge\".")))

(lemma "αἰχμαλωτεύω" (sense capture (gloss "capture" "captured" "captures" "capturing") (why "(LXX, supplied.) To take a prisoner of war, from αἰχμάλωτος \"captive\" (Genesis 14:14, Lot was captured; Ephesians 4:8 quoting Psalm 67:19 has the same verb).")))

(lemma "αἰών"
  (sense age
    (gloss "age" "ages")
    (why "An age, a long or unending span of time. Kept as \"age\" in the literal layer so εἰς τὸν αἰῶνα reads \"into the age\" and its plural forms (\"into the ages of the ages\") stay visible; the readable layer says \"forever\".")))

(lemma "αἰώνιος" (sense everlasting (gloss "everlasting") (why "Belonging to the age (αἰών), lasting for ages, everlasting: Genesis 17:7, 13, 19 διαθήκη αἰώνιος \"everlasting covenant\" (Hebrews 13:20); 17:8 κατάσχεσις αἰώνιος. \"Everlasting\" rather than \"eternal\", one word kept throughout, as ζωὴ αἰώνιος will be \"everlasting life\"; the link with αἰών \"age\" is noted, not forced.")))

(lemma "ἄκανθα"
  (sense thorn
    (gloss "thorn" "thorns")
    (why "Thorn, thornbush (Genesis 3:18; Matthew 7:16; 27:29, the crown of thorns; Hebrews 6:8).")))

(lemma "ἀκατασκεύαστος"
  (sense unfurnished
    (gloss "unfurnished")
    (why "(LXX, supplied.) \"Not built, not equipped\", from κατασκευάζω, \"to prepare, build, furnish\" (Hebrews 3:3-4, God the builder of all things; 11:7, the ark). Genesis 1:2 describes an earth not yet furnished with what days 3-6 bring. \"Unformed\" would import the Hebrew-based \"without form\"; \"unfurnished\" is the Greek word's own sense.")))

(lemma "ἀκούω"
  (sense hear
    (genitive "")
    (dative "")
    (gloss "hear" "heard" "hears" "hearing")
    (why "To hear. With the genitive of a person's voice it can mean \"heed, obey\" (Genesis 3:17); the literal layer keeps \"hear\" and the readable layer may say \"listen to\".")))

(lemma "ἀκροβυστία" (sense foreskin (gloss "foreskin" "foreskins") (why "The foreskin (Genesis 17:11-25, ἡ σὰρξ τῆς ἀκροβυστίας \"the flesh of the foreskin\"; Acts 11:3); in Paul also uncircumcision as a state (Romans 2:25-29), which will be its own sense.")))

(lemma "ἄκρον" (sense top (gloss "top" "tops") (why "The extremity, top, tip (Genesis 28:18, poured oil on the top of the stone; Luke 16:24 τὸ ἄκρον τοῦ δακτύλου; Hebrews 11:21). (LXX, supplied.)")))

(lemma "ἀλήθεια" (sense truth (gloss "truth" "truths") (why "Truth, faithfulness (Genesis 24:27, 48, God's righteousness and truth; John 1:14, 17).")))

(lemma "ἀληθεύω" (sense speak-truth (verb "speak truth" "spoke" "spoken") (gloss "speak truth" "spoke truth" "spoken truth" "speaks truth" "speaking truth") (why "(LXX form supplied.) To speak the truth, be truthful (Genesis 20:16 πάντα ἀλήθευσον; Galatians 4:16; Ephesians 4:15). \"Speak truth\" keeps the ἀληθ- root (ἀληθῶς \"truly\").")))

(lemma "ἀληθῶς" (sense truly (gloss "truly") (why "Truly, really (Genesis 18:13; Matthew 14:33; John 1:47). The adverb of ἀληθής \"true\".")))

(lemma "ἀλλά" (sense rather (gloss "rather") (why "The strong adversative, usually after a negative: \"not ... rather\" (Genesis 17:5, 15; 18:15 Οὐχί, ἀλλὰ ἐγέλασας \"No, rather you laughed\"). Not \"but\", which δέ always takes so the two stay apart (see δέ); \"rather\" keeps the correction ἀλλά makes. The owner may prefer a different split.")))

(lemma "ἀλλήλων" (sense one-another (gloss "one another") (why "The reciprocal pronoun: one another (Genesis 15:10; John 13:34).")))

(lemma "ἀλλογενής" (sense alien (gloss "alien") (why "(LXX, supplied.) Of another race, foreign-born (Genesis 17:27 ἐξ ἀλλογενῶν ἐθνῶν; Luke 17:18, the Samaritan). \"Alien\" keeps it apart from ἀλλότριος \"foreign\".")))

(lemma "ἄλλος" (sense another (gloss "another" "others") (why "Other, another (of the same kind): Genesis 19:12 εἴ τίς σοι ἄλλος ἐστίν; Matthew 2:12; John 4:37. \"Another\" because ἕτερος already has \"other\"; the plural is \"others\".")))

(lemma "ἀλλότριος" (sense foreign (gloss "foreign") (why "Belonging to another, foreign (Genesis 17:12 υἱὸς ἀλλότριος \"foreign son\"; Hebrews 11:9, 34; Matthew 17:25-26).")))

(lemma "Ἁμαθί" (sense name (gloss "Hamathite") (why "(LXX, supplied.) The people of Hamath, last of Canaan's descendants (Genesis 10:18, τὸν Ἁμαθί, indeclinable); traditional English \"the Hamathite\".")))

(lemma "ἅλς" (sense salt (gloss "salt" "salts") (why "(LXX, supplied.) Salt; the plural ἅλες in ἡ θάλασσα τῶν ἁλῶν, \"the sea of the salts\" (Genesis 14:3), the Dead Sea. The New Testament's ἅλας (Matthew 5:13) is a different lemma.")))

(lemma "ἁλυκός" (sense salty (gloss "salty") (why "(LXX, supplied.) Salty, briny (Genesis 14:3, 8, 10, the salty ravine or valley; James 3:12). \"Salty\" keeps it apart from the noun ἅλς \"salt\".")))

(lemma "ἅμα" (sense together (gloss "together") (why "Together, at the same time (Genesis 13:6, they could not dwell together; Romans 3:12; 1 Thessalonians 4:17).")))

(lemma "Ἀμαλήκ" (sense name (gloss "Amalek") (why "(LXX, supplied.) Amalek (Genesis 14:7, the rulers of Amalek); traditional English.")))

(lemma "ἁμαρτάνω" (sense sin (intransitive) (gloss "sin" "sinned" "sins" "sinning") (why "To sin (Genesis 4:7).")))

(lemma "ἁμαρτία" (sense sin (gloss "sin" "sins") (why "Sin, the noun of ἁμαρτάνω.")))

(lemma "ἁμαρτωλός" (sense sinful (gloss "sinful") (why "Sinful, a sinner (Genesis 13:13, the men in Sodom evil and sinful; Luke 5:8; Romans 5:19). \"Sinful\" as the adjective it is; a substantival use (\"sinners\", Matthew 9:10) may become its own sense.")))

(lemma "Ἀμαρφάλ" (sense name (gloss "Amraphel") (why "(LXX, supplied.) King of Shinar (Genesis 14:1, 9); traditional English Amraphel.")))

(lemma "ἀμβλύνω" (sense dull (gloss "dull" "dulled" "dulls" "dulling") (why "(LXX, supplied.) To blunt, dull; passive of eyes grown dim (Genesis 27:1 ἠμβλύνθησαν οἱ ὀφθαλμοὶ αὐτοῦ, \"his eyes were dulled\"). \"Dull\" keeps the image of a blunted edge.")))

(lemma "ἄμεμπτος" (sense blameless (gloss "blameless") (why "Without blame (Genesis 17:1 γίνου ἄμεμπτος; Luke 1:6; Philippians 2:15; 3:6).")))

(lemma "ἀμνάς" (sense ewe-lamb (gloss "ewe lamb" "ewe lambs") (why "(LXX, supplied.) A female lamb (Genesis 21:28-30; 2 Kingdoms 12:3, the poor man's one ewe lamb).")))

(lemma "ἀμπελών" (sense vineyard (gloss "vineyard" "vineyards") (why "A vineyard (Genesis 9:20, Noah planted a vineyard; Matthew 20:1; Mark 12:1). Against ἄμπελος, which will take \"vine\".")))

(lemma "Ἀμμάν" (sense name (gloss "Amman") (why "(LXX, supplied.) Genesis 19:38, the younger daughter's son: the Greek names him Ἀμμάν and explains it, ὁ υἱὸς τοῦ γένους μου, \"the son of my race\"; the Hebrew has Ben-ammi. The Greek gives a different name, so the English follows it: Amman (rule 8). Question for the owner.")))

(lemma "Ἀμμανίτης" (sense name (person) (gloss "Ammonite" "Ammonites") (why "(LXX, supplied.) The people descended from Ἀμμάν (Genesis 19:38 πατὴρ Ἀμμανιτῶν); traditional English Ammonites, the Septuagint's usual spelling for them.")))

(lemma "ἄμμος" (sense sand (gloss "sand") (why "Sand (Genesis 28:14 ὡς ἡ ἄμμος τῆς θαλάσσης; Romans 9:27; Hebrews 11:12). (LXX form supplied.)")))

(lemma "Ἀμορραῖος" (sense name (person) (gloss "Amorite" "Amorites") (why "(LXX, supplied.) The Amorite, a people of Canaan (Genesis 10:16; 14:7, 13); traditional English Amorite. Swete prints the singular as Ἄμορις at 14:13 (Vaticanus's spelling); it is read as this word.")))

(lemma "ἀμφότεροι" (sense both (gloss "both") (why "Both, the two together (Genesis 21:27, 31; 22:8; Luke 1:6-7). It shares \"both\" with τε, which says \"both\" only before καί; the alignment shows which Greek word stands behind it.")))

(lemma "ἄν"
  (sense ever
    (gloss "ever")
    (why "The particle of contingency. After a relative (ᾗ ἂν ἡμέρᾳ, Genesis 2:17; 3:5) it makes the clause indefinite; rendered \"ever\" (\"in which ever day\") so the particle is visible rather than absorbed into \"whatever\". In conditions (\"would\") it becomes its own sense. ἐάν after a relative takes the same gloss.")))

(lemma "ἀνά"
  (sense meson
    (gloss "")
    (why "In the Septuagint ἀνά almost always stands in the fixed phrase ἀνὰ μέσον, \"between\" (also 1 Corinthians 6:5). The phrase is one English word, carried by μέσος (sense between); ἀνά is aligned with it and left unrendered. The distributive ἀνά (\"each\", Matthew 20:9) becomes its own sense when it occurs.")))

(lemma "ἀναβαθμίς" (sense step (gloss "step" "steps") (why "(LXX, supplied.) A step, stair (Exodus 20:26).")))

(lemma "ἀναβαίνω"
  (sense go-up
    (gloss "go up" "goes up" "going up" "went up" "gone up")
    (why "(Supplied in Genesis 2:6, where the form is LXX-only.) To go up, ascend. \"Go up\" covers both a spring rising (Genesis 2:6) and going up to Jerusalem (Mark 10:33).")))

(lemma "ἀναβοάω" (sense cry-aloud (gloss "cry aloud" "cried aloud" "cries aloud" "crying aloud") (why "(LXX, supplied.) To cry out loud, shout (Genesis 27:34, Esau ἀνεβόησεν φωνὴν μεγάλην; Matthew 27:46). \"Cry aloud\" keeps it apart from βοάω \"cry out\".")))

(lemma "ἀναβλέπω" (sense look-up (gloss "look up" "looked up" "looks up" "looking up") (why "To look up (Genesis 18:2 ἀναβλέψας τοῖς ὀφθαλμοῖς \"having looked up with the eyes\"; Mark 6:41); recovering sight (John 9:11) will be its own sense. Kept apart from βλέπω \"see\".")))

(lemma "ἀναγγέλλω"
  (sense declare
    (gloss "declare" "declared" "declares" "declaring")
    (why "To report, announce, declare (John 4:25; 16:13-15). \"Declare\" keeps it apart from λέγω \"say\" and ἀπαγγέλλω.")))

(lemma "ἀναιρέω" (sense take-away (verb "take away" "took away" "taken away") (gloss "take away" "took away" "taken away" "taking away") (why "To take up, take away, and so do away with, kill (Acts 2:23). Kept apart from ἀποκτείνω \"kill\".")))

(lemma "ἀναλαμβάνω" (sense take-up(gloss "take up" "took up" "taken up" "takes up" "taking up") (why "To take up, take along (Genesis 24:61, the servant took up Rebekah; Acts 1:2, 11; 2 Timothy 4:11). Kept apart from λαμβάνω \"take\" by the particle.")))

(lemma "ἀνάπαυσις" (sense rest (gloss "rest" "rests") (why "A resting, rest, a place to rest (Genesis 8:9, the dove found no rest for her feet; Matthew 11:29; 12:43, seeking rest and not finding it). The noun shares \"rest\" with the verb καταπαύω (Genesis 2:2); English has one word for both.")))

(lemma "ἀναπληρόω"
  (sense fill-up
    (gloss "fill up" "filled up" "fills up" "filling up")
    (why "(Supplied in Genesis 2:21.) To fill up, make complete (Galatians 6:2; 1 Thessalonians 2:16). The ἀνα- prefix is kept as \"up\" to distinguish it from πληρόω \"fill\".")))

(lemma "ἀνάστημα" (sense standing-thing (gloss "standing thing" "standing things") (why "(LXX, supplied.) That which stands up or has been raised up: every living thing standing on the earth (Genesis 7:4, 23, πᾶν τὸ ἀνάστημα, all that the flood wipes out). Swete prints the spelling ἀνάστεμα. \"Standing thing\" keeps the root ἀνίστημι \"stand up\" visible.")))

(lemma "ἀναστρέφω" (sense come-back (gloss "come back" "came back" "comes back" "coming back") (why "(LXX sense, supplied.) Intransitive: to turn back, come back (Genesis 8:9, 11, the dove came back to Noah; Acts 5:22). \"Come back\" keeps it apart from ἀποστρέφω \"turn back\", ὑποστρέφω \"return\" and ἐπιστρέφω \"turn again\". The New Testament's middle \"conduct oneself\" (1 Peter 1:17) will be its own sense.")))

(lemma "ἀνασῴζω" (sense escape (voice active) (gloss "escape" "escaped" "escapes" "escaping") (why "(LXX, supplied.) To bring safely back; the passive \"be brought safely through\" is rendered active, \"escape\" (Genesis 14:13, one of the ones having escaped). Kept apart from σῴζω \"save\".")))

(lemma "ἀνατέλλω"
  (sense rise
    (gloss "rise" "rose" "risen" "rises" "rising")
    (why "(Supplied in Genesis 2:5, 3:18.) Intransitive: to rise, spring up, of the sun (Matthew 5:45), light (Matthew 4:16) or plants (Genesis 2:5). \"Rise\" serves all of these and keeps the link with ἀνατολή, the rising of the sun, the east."))
  (sense raise
    (gloss "raise" "raised" "raises" "raising")
    (why "Transitive: to make rise, make spring up (Genesis 3:18, the earth raising thorns). A separate English verb because English \"rise\" cannot take an object.")))

(lemma "ἀνατολή"
  (sense east
    (gloss "east" "easts")
    (why "(Supplied in Genesis 2:8.) The rising (of the sun), hence the east: Matthew 2:1-2. Genesis 2:8 has the plural κατὰ ἀνατολάς, an idiom for \"eastward\"; the literal layer gives \"[the] east\" and the plural is noted there.")))

(lemma "ἀναφέρω" (sense bring-up (gloss "bring up" "brought up" "brings up" "bringing up") (why "To carry up, bring up, and so offer up a sacrifice on an altar (Genesis 8:20, Noah brought up a whole offering on the altar; Hebrews 7:27; James 2:21). \"Bring up\" keeps the ἀνα- and the literal motion; it is kept apart from φέρω \"carry\".")))

(lemma "ἀνήρ"
  (sense man
    (person)
    (gloss "man" "men")
    (why "A male human, and so also a husband. One gloss, \"man\", in the literal layer (\"her man\", Genesis 3:6, 16), because the Greek has one word; the readable layer says \"husband\" where English needs it. Never used for ἄνθρωπος (sense human).")))

(lemma "ἄνθραξ"
  (sense carbuncle
    (gloss "carbuncle")
    (why "(Supplied in Genesis 2:12.) A glowing-red precious stone, the carbuncle (also Exodus 28:18). The same word means a live coal in Romans 12:20; that becomes its own sense, \"coal\", there.")))

(lemma "ἄνθρωπος"
  (sense human
    (person)
    (gloss "human" "humans")
    (why "The literal layer keeps ἄνθρωπος (a human being, of either sex) apart from ἀνήρ (a man, a husband), so the two cannot share \"man\". \"Human\" is the one English noun with exactly that sense. The readable layer may say \"people\" or \"men\" where English idiom wants it, and \"man\" for the first human in Genesis 1-2.")))

(lemma "ἀνίημι" (sense spare (gloss "spare" "spared" "spares" "sparing") (why "(LXX, supplied.) To let go, let up on, and so spare (Genesis 18:24 οὐκ ἀνήσεις τὸν τόπον \"will you not spare the place\"; Hebrews 13:5, \"let go\"; Acts 16:26). \"Spare\" for the sense of Genesis 18; \"let go, loosen\" (Acts 16:26; 27:40) will be its own sense, kept apart from ἀφίημι \"forgive\".")))

(lemma "ἀνίστημι" (sense stand-up (gloss "stand up" "stood up" "stands up" "standing up") (why "Intransitive: to stand up, rise up (Genesis 4:8; the resurrection verb of the New Testament). \"Stand up\" so as not to share \"rise\" with ἀνατέλλω."))
  (sense set-up
    (gloss "set up" "sets up" "setting up")
    (why "Transitive: to make stand, set up (Genesis 9:9, ἀνίστημι τὴν διαθήκην μου, \"I set up my covenant\"). \"Set up\" because \"raise up\" is ἐξανίστημι's and \"establish\" is ἵστημι's (Genesis 6:18; 9:11 στήσω). The New Testament's transitive \"raise up\" (Acts 2:24) may need its own sense.")))

(lemma "ἀνοίγω" (sense open (gloss "open" "opened" "opens" "opening") (why "To open (Genesis 7:11, the floodgates of heaven were opened; 8:6, Noah opened the window; Matthew 7:7). The plain word for opening; it shares \"open\" with the compound διανοίγω (Genesis 3:5), which the readable layer may render \"open fully\" where the difference matters.")))

(lemma "ἀνομία" (sense lawlessness (gloss "lawlessness" "lawlessnesses") (why "Lawlessness, the state of being without law (ἀ- + νόμος): Genesis 19:15 ταῖς ἀνομίαις τῆς πόλεως; Matthew 7:23; 1 John 3:4. The plural, \"lawlessnesses\", is kept as the Greek has it.")))

(lemma "ἀντί"
  (sense in-place-of
    (gloss "in place of")
    (why "(Supplied in Genesis 2:21, where it is elided ἀντ’.) Substitution: \"in place of\" (Matthew 2:22; 20:28, a ransom in place of many). \"Instead of\" would serve equally; one phrase is chosen and kept.")))

(lemma "ἀντιλέγω" (sense speak-against(gloss "speak against" "spoke against" "spoken against" "speaks against" "speaking against") (why "To speak against, contradict (Luke 2:34; John 19:12). The table lemmatizes the aorist ἀντειπεῖν under it (Genesis 24:50; Acts 4:14).")))

(lemma "ἀντιπρόσωπος" (sense face-to-face (gloss "face to face") (why "(LXX, supplied.) Facing, set opposite (ἀντί + πρόσωπον \"face\"): Genesis 15:10, the halves set \"face to face to one another\". Not \"facing\", which ἀπέναντι has.")))

(lemma "ἀντλέω" (sense draw (gloss "draw" "drew" "drawn" "draws" "drawing") (why "To draw water (Genesis 24:13, 20; John 2:8-9; 4:7, 15). Kept apart from ὑδρεύομαι \"fetch water\".")))

(lemma "ἄνω" (sense above (gloss "above") (why "Above (Exodus 20:4; John 8:23).")))

(lemma "ἄνωθεν" (sense from-above (gloss "from above") (why "From above, from the top (Genesis 6:16; John 3:31; 19:23). The sense \"again, anew\" (John 3:3) will be discussed when John is translated.")))

(lemma "ἄξιος" (sense worthy (gloss "worthy") (why "Worthy, of full value (Genesis 23:9, ἀργυρίου τοῦ ἀξίου, \"for the worthy silver\", the full price; Matthew 10:10; Luke 15:19).")))

(lemma "ἀορασία" (sense blindness (dative "with") (gloss "blindness") (why "(LXX, supplied.) Blindness, inability to see (ἀ- + ὁράω): Genesis 19:11 ἐπάταξαν ἀορασίᾳ, struck with blindness. The dative is instrumental, \"with blindness\".")))

(lemma "ἀόρατος"
  (sense invisible
    (gloss "invisible")
    (why "(Supplied in Genesis 1:2.) Unseen, invisible. Same gloss as Colossians 1:15-16 (\"the image of the invisible God\") and Romans 1:20, so the Greek link between the invisible earth of Genesis 1:2 and the New Testament's invisible things stays visible.")))

(lemma "ἀπαγγέλλω" (sense report (gloss "report" "reported" "reports" "reporting") (why "To bring back word, report, tell (Genesis 12:18; Matthew 2:8; Luke 7:22). \"Report\" keeps it apart from ἀναγγέλλω \"declare\" and λέγω \"say\".")))

(lemma "ἀπαίρω" (sense depart (gloss "depart" "departed" "departs" "departing") (why "(LXX sense, supplied.) Intransitive in the Septuagint: to lift off, break camp, depart (Genesis 12:9). The New Testament has only the passive \"be taken away\" (Mark 2:20), which would be its own sense.")))

(lemma "ἀπαλείφω" (sense wipe-out (gloss "wipe out" "wiped out" "wipes out" "wiping out") (why "(LXX, supplied.) To wipe off, wipe out (Genesis 6:7; 7:4, of the flood). Kept apart from ἐξαλείφω (Acts 3:19), which will need its own English.")))

(lemma "ἁπαλός" (sense tender (gloss "tender") (why "Soft, tender (Genesis 27:9, two tender kids; Matthew 24:32, the branch becomes tender). (LXX form supplied.)")))

(lemma "ἀπαντάω" (sense meet (dative "") (gloss "meet" "met" "meets" "meeting") (why "To meet, come upon, with the dative (Genesis 28:11 ἀπήντησεν τόπῳ, \"met [a] place\", came upon it; Mark 14:13). (LXX form supplied.)")))

(lemma "ἅπαξ" (sense once (gloss "once") (why "Once, a single time (Genesis 18:32 ἔτι ἅπαξ \"yet once\", as Hebrews 12:26-27; 9:7).")))

(lemma "ἅπας" (sense entire (gloss "entire") (why "All, the whole, a stronger πᾶς (Genesis 19:4 ἅπας ὁ λαός; Luke 3:21; Acts 2:44). \"Entire\" because πᾶς has \"all\".")))

(lemma "ἀπατάω"
  (sense deceive
    (gloss "deceive" "deceived" "deceives" "deceiving")
    (why "(Supplied in Genesis 3:13.) To deceive (1 Timothy 2:14; Ephesians 5:6). The compound ἐξαπατάω (2 Corinthians 11:3, retelling Genesis 3:13) will need its own gloss, such as \"deceive thoroughly\", so the difference shows.")))

(lemma "ἀπειλέω" (sense threaten (dative "") (gloss "threaten" "threatened" "threatens" "threatening") (why "To threaten (Genesis 27:42 ἀπειλεῖ σοι τοῦ ἀποκτεῖναί σε; Acts 4:17; 1 Peter 2:23). (LXX form supplied.)")))

(lemma "ἀπέναντι"
  (sense facing
    (gloss "facing")
    (why "Over against, facing (Matthew 27:61, sitting facing the tomb). Kept apart from κατέναντι \"opposite\" (Genesis 2:14) so the two prepositions are distinguishable in English.")))

(lemma "ἀπερίτμητος" (sense uncircumcised (gloss "uncircumcised") (why "(LXX, supplied.) Not circumcised (Genesis 17:14; Acts 7:51). Negative of περιτέμνω \"circumcise\", whose English it keeps.")))

(lemma "ἀπέρχομαι"
  (sense go-away
    (gloss "go away" "goes away" "going away" "went away" "gone away")
    (why "(Supplied in Genesis 3:19.) To go away, depart. \"Go away\" keeps the ἀπο- of the compound against πορεύομαι \"go\".")))

(lemma "ἄπλαστος" (sense plain (gloss "plain") (why "(LXX, supplied.) Literally \"unmolded\", not shaped or put on: simple, plain, without guile. Genesis 25:27, Jacob \"plain human dwelling [a] house\", over against Esau the hunter. \"Plain\" is an adjective; πεδίον has the noun \"plain\", a different part of speech.")))

(lemma "ἀπό"
  (sense from
    (gloss "from")
    (why "Separation or source: \"from\". Partitive uses (\"from every tree\", \"of\") keep \"from\" in the literal layer.")))

(lemma "ἀπογαλακτίζω" (sense wean (gloss "wean" "weaned" "weans" "weaning") (why "(LXX, supplied.) To wean a child from milk (γάλα): Genesis 21:8.")))

(lemma "ἀποδιδράσκω" (sense run-away (gloss "run away" "ran away" "runs away" "running away") (why "(LXX, supplied.) To run away, flee from a master (Genesis 16:6, 8, Hagar from Sarai). Kept apart from φεύγω \"flee\".")))

(lemma "ἀποδεκατόω" (sense tithe (gloss "tithe" "tithed" "tithes" "tithing") (why "To give or take the tenth, tithe (Genesis 28:22 δεκάτην ἀποδεκατώσω, \"[a] tenth I will tithe\"; Matthew 23:23; Luke 18:12). (LXX form supplied.)")))

(lemma "ἀποδίδωμι" (sense repay (verb "repay" "repaid" "repaid") (gloss "repay" "repaid" "repays" "repaying") (why "To give back, repay, render (Exodus 20:5; Romans 12:17)."))
  (sense give-back (verb "give back" "gave" "given") (gloss "give back" "gave back" "given back" "gives back" "giving back") (why "To give back what was taken, restore (Genesis 20:7 ἀπόδος τὴν γυναῖκα, 20:14 ἀπέδωκεν αὐτῷ Σάρραν; Luke 4:20, the scroll given back). \"Repay\" would say a debt was paid."))
  (sense sell (gloss "sell" "sold" "sells" "selling") (why "The middle, \"give away for oneself\", is \"sell\" (Genesis 25:31, 33, Esau sold the birthright; Acts 5:8; Hebrews 12:16 quotes it). The form rows choose this sense for the middle.")))

(lemma "ἀποθνῄσκω"
  (sense die
    (intransitive)
    (gloss "die" "died" "dies" "dying")
    (why "To die. θανάτῳ ἀποθανεῖσθε (Genesis 2:17; 3:4) is \"by death you will die\" in the literal layer.")))

(lemma "ἀποίχομαι" (sense go-off (verb "go off" "went" "gone") (gloss "go off" "went off" "gone off" "goes off" "going off") (why "(LXX, supplied.) To be gone, go off (Genesis 14:12, the kings took Lot and were going off). \"Go off\" keeps it apart from ἀπέρχομαι \"go away\" and ἀπαίρω \"depart\".")))

(lemma "ἀποκαθίστημι" (sense restore (gloss "restore" "restored" "restores" "restoring") (why "To restore, give back (Matthew 12:13; Acts 1:6); in Genesis 23:16 of paying over the silver to Ephron. Swete's ἀπεκατέστησεν has the double augment.")))

(lemma "ἀποκαλύπτω" (sense uncover (gloss "uncover" "uncovered" "uncovers" "uncovering") (why "To uncover, reveal. \"Uncover\" for the literal sense (Exodus 20:26); \"reveal\" becomes its own sense for revelation (Matthew 11:25).")))

(lemma "ἀποκλείω" (sense shut-off (verb "shut off" "shut" "shut") (gloss "shut off" "shuts off" "shutting off") (why "To shut, close off (Genesis 19:10 τὴν θύραν ... ἀπέκλεισαν; Luke 13:25, the master shuts the door). \"Shut off\" keeps the ἀπο- of the compound against κλείω \"shut\" and συγκλείω.")))

(lemma "ἀποκρίνομαι" (sense answer (gloss "answer" "answered" "answers" "answering") (why "To answer, reply (Genesis 18:9, 27 ὁ δὲ ἀποκριθεὶς εἶπεν; very often in the Gospels). The passive-deponent aorist is rendered active.")))

(lemma "ἀποκτείνω" (sense kill (gloss "kill" "killed" "kills" "killing") (why "To kill.")))

(lemma "ἀπόλλυμι" (sense destroy (gloss "destroy" "destroyed" "destroys" "destroying") (why "Active: to destroy (Genesis 18:24-32, ἀπολεῖς, οὐ μὴ ἀπολέσω; Matthew 10:28). The middle \"perish\" (Luke 13:3) and \"lose\" (Luke 15:4) will be their own senses.")))

(lemma "ἀποσάσσω" (sense unload (gloss "unload" "unloaded" "unloads" "unloading") (why "(LXX, supplied.) To unpack, unload a beast (Genesis 24:32, ἀπέσαξεν τὰς καμήλους). ἀπέσαξεν may also be referred to the Attic spelling ἀποσάττω.")))

(lemma "ἀποσκευή" (sense baggage (gloss "baggage") (why "(LXX, supplied.) Baggage, movable goods, household (Genesis 14:12, Lot and his baggage; Acts 21:15 has the verb ἀποσκευάζομαι).")))

(lemma "ἀποσκηνόω" (sense decamp (gloss "decamp" "decamped" "decamps" "decamping") (why "(LXX, supplied.) To strike one's tent and move off (Genesis 13:18), from σκηνή \"tent\". \"Decamp\" keeps it apart from ἀπαίρω \"depart\" and σκηνόω \"tent\".")))

(lemma "ἀπολύω" (sense release (gloss "release" "released" "releases" "releasing") (why "To release, let go, send away (Matthew 27:15; Luke 2:29, \"now you release your slave ... in peace\", of dying). Genesis 15:2 ἀπολύομαι ἄτεκνος, \"I am released childless\": I depart this life without children.")))

(lemma "ἀποστέλλω" (sense send (verb "send" "sent" "sent") (gloss "send" "sent" "sends" "sending") (why "To send, send off (Genesis 8:7-8, Noah sent the raven and the dove; John 3:17). \"Send\", kept apart from ἐξαποστέλλω \"send out\" (Genesis 3:23; 8:10).")))

(lemma "ἀποστρέφω"
  (sense turn-back
    (voice active)
    (gloss "turn back" "turns back" "turning back" "turned back")
    (why "(Supplied in Genesis 3:19.) To turn back, return; transitive \"turn away\" (Romans 11:26) will be its own sense. \"Turn back\" rather than \"return\" keeps the link with στρέφω \"turn\" and ἀποστροφή \"turning\" (Genesis 3:16).")))

(lemma "ἀποστροφή"
  (sense turning
    (gloss "turning")
    (why "(LXX, supplied.) A turning (away or back) to someone, recourse. Genesis 3:16 \"your turning [is] to your man\", where translations from the Hebrew have \"desire\". Same root as ἀποστρέφω (sense turn-back), as in Genesis 3:19.")))

(lemma "ἀποτρέχω" (sense run-off (gloss "run off" "ran off" "runs off" "running off") (why "(LXX, supplied.) To run off, go away (Genesis 12:19, Pharaoh to Abram: \"having taken, run off\"). \"Run off\" keeps the run of τρέχω and leaves \"go away\" to ἀπέρχομαι.")))

(lemma "ἅπτω"
  (sense touch
    (genitive "")
    (gloss "touch" "touched" "touches" "touching")
    (why "(Supplied in Genesis 3:3.) Middle: to touch, take hold of (Matthew 8:3; John 20:17). The active \"kindle\" (Luke 8:16) becomes its own sense.")))

(lemma "ἀρά" (sense imprecation (gloss "imprecation" "imprecations") (why "A prayer calling down harm, a curse sworn into an oath (Genesis 26:28, the sworn pact between Abimelech and Isaac; Romans 3:14, quoting Psalm 9:28 LXX). \"Imprecation\" keeps it apart from καταράομαι \"curse\" and κατάρα.")))

(lemma "ἄρα" (sense then (gloss "then") (why "The inferential particle, \"then, so then\" (Genesis 18:3 εἰ ἄρα εὗρον χάριν \"if then I found grace\"; Matthew 12:28; Romans 8:1). Kept apart from οὖν \"therefore\" and τότε.")))

(lemma "ἆρα" (sense is-it (gloss "is it") (why "(LXX, supplied.) The interrogative particle (Genesis 18:13 Ἆρά γε ἀληθῶς τέξομαι; Luke 18:8; Acts 8:30), which marks a question, often doubtful. English has no particle for it; \"is it\" renders it as a word so it is not lost, and is kept apart from ἄρα \"then\". The owner may prefer another rendering.")))

(lemma "Ἀρβόκ" (sense name (gloss "Arba") (why "(LXX, supplied.) ἐν πόλει Ἀρβόκ (Genesis 23:2) renders the Hebrew Kiriath-arba, \"city of Arba\": πόλει translates Kiriath, and Ἀρβόκ is the name Arba with a final κ. Traditional English Arba (Joshua 14:15), the spelling difference being small (rule 8); the owner may prefer Arbok.")))

(lemma "Ἀράδιος" (sense name (gloss "Arvadite" "Arvadites") (why "(LXX, supplied.) The people of Arvad, descended from Canaan (Genesis 10:18), Greek Ἀράδιος; traditional English Arvadite.")))

(lemma "Ἀράμ" (sense name (gloss "Aram") (why "(Name supplied for the Septuagint.) Shem's son (Genesis 10:22-23), traditional English Aram. The New Testament table's Ἀράμ (Matthew 1:3-4) is another man, the Ram of Ruth 4:19.")))

(lemma "Ἀραράτ" (sense name (gloss "Ararat") (why "(LXX, supplied.) Genesis 8:4, τὰ ὄρη τὰ Ἀραράτ, the mountains of Ararat, where the ark settled; indeclinable. Greek and traditional English agree.")))

(lemma "ἀργύριον" (sense silver (gloss "silver") (why "Silver, as metal and as money (Genesis 13:2, rich in silver and gold; Matthew 25:18; Acts 3:6). It shares \"silver\" with the adjective ἀργυροῦς \"of silver\"; a sense \"money\" (Matthew 28:12) may be added where the coins are meant.")))

(lemma "ἀργυροῦς" (sense silver (gloss "silver") (why "Made of silver (Exodus 20:23; Acts 19:24).")))

(lemma "ἀργυρώνητος" (sense bought-with-silver (gloss "bought with silver") (why "(LXX, supplied.) Bought with silver (ἄργυρος + ὠνέομαι), of a purchased slave (Genesis 17:12-27, beside the οἰκογενής \"home-born\"). Spelled out so both parts of the compound show.")))

(lemma "ἀρέσκω" (sense please (dative "") (gloss "please" "pleased" "pleases" "pleasing") (why "To please, be pleasing to, with the dative (Genesis 19:8 καθὰ ἀρέσκῃ ὑμῖν; 20:15; Romans 15:1-3). The verb of ἀρεστός \"pleasing\".")))

(lemma "ἀρεστός"
  (sense pleasing
    (gloss "pleasing")
    (why "Pleasing, acceptable (John 8:29, the things pleasing to him). \"Pleasing\" against εὐάρεστος, which will take \"well-pleasing\".")))

(lemma "ἀριθμέω" (sense number (gloss "number" "numbered" "numbers" "numbering") (why "To number, count (Genesis 13:16; 14:14; Matthew 10:30, the hairs are numbered). Kept apart from ἐξαριθμέω \"count\".")))

(lemma "ἀριστερός" (sense left (gloss "left") (why "Left, the left hand or side (Genesis 13:9, εἰς ἀριστερά \"into left [parts]\"; 14:15; Matthew 6:3).")))

(lemma "Ἀριώχ" (sense name (gloss "Arioch") (why "(LXX, supplied.) King of Ellasar (Genesis 14:1, 9); traditional English Arioch.")))

(lemma "ἀρνέομαι" (sense deny (gloss "deny" "denied" "denies" "denying") (why "To deny, disown (Genesis 18:15, Sarah denied; Matthew 26:70; Hebrews 11:24).")))

(lemma "Ἀρουκαῖος" (sense name (person) (gloss "Arkite" "Arkites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:17), Greek Ἀρουκαῖος; traditional English Arkite.")))

(lemma "ἄρουρα" (sense plowland (gloss "plowland" "plowlands") (why "(LXX, supplied.) Tilled, arable land, a plowed field (Genesis 21:33 ἐφύτευσεν Ἀβραὰμ ἄρουραν), where the Hebrew has a tamarisk tree (ʾešel read differently). \"Plowland\" keeps it apart from ἀγρός \"field\".")))

(lemma "Ἁρράν" (sense name (gloss "Haran") (why "(LXX, supplied.) Terah's son, Lot's father (Genesis 11:26-31), traditional English Haran. It shares \"Haran\" with the city Χαρράν (Genesis 11:31), as English Bibles do; the Greek on hover tells them apart.")))

(lemma "ἀρσενικός" (sense male (gloss "male") (why "(LXX, supplied.) Male, of the male sex; πᾶν ἀρσενικόν \"every male\" (Genesis 17:10-12). It shares \"male\" with ἄρσην, from which it is formed: English has no second word, and the alignment shows which Greek word stands behind it.")))

(lemma "ἄρσην"
  (sense male
    (gloss "male")
    (why "Male (Genesis 1:27; Matthew 19:4; Galatians 3:28). Against ἀνήρ \"man\".")))

(lemma "ἄρτος"
  (sense bread
    (gloss "bread" "breads")
    (why "Bread, a loaf; by extension food (Genesis 3:19). Kept as \"bread\" everywhere so \"our daily bread\" and \"you will eat your bread\" match.")))

(lemma "Ἀρφαξάδ" (sense name (gloss "Arpachshad") (why "Shem's son (Genesis 10:22-24; 11:10-13; Luke 3:36, KJV \"Arphaxad\"). The English follows the traditional Old Testament form Arpachshad, as Καινάν is \"Kenan\"; the Greek Arphaxad shows on hover, and whether to follow it is for the owner.")))

(lemma "Ἀρχάδ" (sense name (gloss "Accad") (why "(LXX, supplied.) A city of Nimrod's kingdom (Genesis 10:10), Greek Ἀρχάδ; traditional English Accad.")))

(lemma "ἀρχή"
  (sense beginning
    (gloss "beginning" "beginnings")
    (why "The start of time or of a thing, as in Genesis 1:1 (ἐν ἀρχῇ), which John 1:1 echoes word for word; one gloss in both keeps the echo visible. Also the head or source of a river (Genesis 2:10, \"four beginnings\")."))
  (sense rule
    (with-preposition "εἰς" for)
    (gloss "rule" "rules")
    (why "Rule, dominion, and (plural) rulers or powers: Genesis 1:16 εἰς ἀρχὰς τῆς ἡμέρας, \"for rules of the day\"; Luke 12:11; Ephesians 1:21; Colossians 1:16. Same English root as ἄρχω (sense rule).")))

(lemma "ἀρχιστράτηγος" (sense commander-in-chief (person) (gloss "commander-in-chief" "commanders-in-chief") (why "(LXX, supplied.) The chief general of an army (Genesis 21:22, 32; 26:26, Phicol, Abimelech's commander). One word, \"commander-in-chief\", for the compound ἀρχι- + στρατηγός.")))

(lemma "ἄρχω"
  (sense rule
    (genitive "over")
    (gloss "rule" "rules" "ruled" "ruling")
    (why "Active: to rule, govern (Genesis 1:16-28; Mark 10:42; Romans 15:12). With the genitive of what is ruled; the English \"over\" belongs to that noun's segment, like any case ending."))
  (sense begin
    (gloss "begin" "began" "begun" "begins" "beginning")
    (why "Middle: to begin (Genesis 2:3; Matthew 4:17, and very often in the Gospels).")))

(lemma "ἄρχων" (sense ruler (person) (gloss "ruler" "rulers") (why "A ruler, chief, official (Genesis 12:15, Pharaoh's officials; Matthew 9:18; John 3:1): the participle of ἄρχω used as a noun, so \"ruler\" beside ἄρχω \"rule\".")))

(lemma "Ἁσαρμώθ" (sense name (gloss "Hazarmaveth") (why "(LXX, supplied.) A son of Joktan (Genesis 10:26), Greek Ἁσαρμώθ; traditional English Hazarmaveth.")))

(lemma "Ἁσασάν" (sense name (gloss "Hazazon") (why "(LXX, supplied.) Ἁσασὰν Θαμάρ (Genesis 14:7), Hazazon-tamar: two Greek words, each glossed; traditional English Hazazon.")))

(lemma "ἀσεβής" (sense ungodly (person) (gloss "ungodly") (why "Without reverence for God, ungodly (Genesis 18:23, 25, the righteous against the ungodly; Romans 4:5; 5:6; 1 Peter 4:18). Against δίκαιος \"righteous\".")))

(lemma "Ἁσενναῖος" (sense name (person) (gloss "Sinite" "Sinites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:17), Greek Ἁσενναῖος; traditional English Sinite.")))

(lemma "ἀσκός" (sense skin (gloss "skin" "skins") (why "(LXX, supplied as to this use.) A leather bottle, a skin for water or wine (Genesis 21:14-19; Matthew 9:17 \"wineskins\"). \"Skin\" says what it is made of.")))

(lemma "Ἀσσούρ" (sense name (gloss "Asshur") (why "(LXX, supplied.) Genesis 10:11, who went out from Shinar and built Nineveh, and 10:22, Shem's son; traditional English Asshur. Against Ἀσσύριος \"Assyrian\".")))

(lemma "Ἀσουρίμ" (sense name (gloss "Asshurim") (why "(LXX, supplied.) A son of Dedan (Genesis 25:3), traditional English Asshurim.")))

(lemma "Ἀσσύριος"
  (sense name
    (gloss "Assyrian" "Assyrians")
    (why "(LXX, supplied.) The people name, plural in Genesis 2:14 (\"opposite [the] Assyrians\").")))

(lemma "Ἀσταρώθ" (sense name (gloss "Ashteroth") (why "(LXX, supplied.) Ἀσταρὼθ Καρνάιν (Genesis 14:5), Ashteroth-karnaim: two Greek words, each glossed; traditional English Ashteroth.")))

(lemma "ἀστήρ"
  (sense star
    (gloss "star" "stars")
    (why "A star (Genesis 1:16; Matthew 2:2). ἄστρον, a near synonym, will take \"constellation\" or a note if needed.")))

(lemma "ἄσφαλτος" (sense asphalt (dative "with") (gloss "asphalt") (why "(LXX, supplied.) Asphalt, bitumen, natural pitch (Genesis 6:14; 11:3). The dative of Genesis 6:14 is the means, \"with the asphalt\". The verb ἀσφαλτόω shares the English, as the Greek shares the word.")))

(lemma "ἀσφαλτόω" (sense asphalt (gloss "asphalt" "asphalted" "asphalts" "asphalting") (why "(LXX, supplied.) To coat with asphalt (Genesis 6:14). The verb made from ἄσφαλτος and given the same English deliberately, as in the Greek (\"you will asphalt it ... with the asphalt\").")))

(lemma "Ἀσχανάζ" (sense name (gloss "Ashkenaz") (why "(LXX, supplied.) Gomer's son (Genesis 10:3), traditional English Ashkenaz.")))

(lemma "ἀσχημοσύνη" (sense shame (gloss "shame") (why "Shamefulness, the shame of nakedness (Exodus 20:26; Revelation 16:15).")))

(lemma "ἀτεκνόω" (sense bereave (gloss "bereave" "bereaved" "bereaves" "bereaving") (why "(LXX, supplied.) To make childless, bereave; passive, to be bereaved of children (Genesis 27:45 μή ποτε ἀτεκνωθῶ ἀπὸ τῶν δύο ὑμῶν). From ἄτεκνος \"childless\" (Luke 20:28).")))

(lemma "Αὐνάν" (sense name (gloss "Onan") (why "(LXX, supplied.) Genesis 14:13, 24: the Greek gives Αὐνάν where the Hebrew has Aner. Αὐνάν is the Greek form of Judah's son Onan (Genesis 38), so the English follows the Greek name, as Θόβελ is \"Tubal\". For the owner: \"Aner\" if the traditional name of this man is preferred.")))

(lemma "ἀτμίς" (sense vapor (gloss "vapor") (why "Vapor, steam, smoke (Genesis 19:28 ὡσεὶ ἀτμὶς καμίνου; Acts 2:19 ἀτμίδα καπνοῦ; James 4:14).")))

(lemma "ἄτεκνος" (sense childless (gloss "childless") (why "Without children (Genesis 15:2; Luke 20:28-30).")))

(lemma "ἀτιμάζω" (sense dishonor (gloss "dishonor" "dishonored" "dishonors" "dishonoring") (why "To dishonor, treat with contempt (Genesis 16:4-5, Sarai slighted in Hagar's eyes; Romans 1:24; James 2:6).")))

(lemma "αὐξάνω"
  (sense grow
    (voice active)
    (gloss "grow" "grew" "grown" "grows" "growing")
    (why "(Supplied in Genesis 1:22, 28.) To grow, increase (Matthew 6:28; Luke 2:40; Acts 6:7). Genesis 1:22, 28 αὐξάνεσθε is \"grow\", where translations from the Hebrew have \"be fruitful\". The middle/passive forms are rendered with intransitive English \"grow\".")))

(lemma "αὐτός"
  (sense pronoun
    (gloss "he" "him" "his" "she" "her" "hers" "it" "its" "they" "them" "their" "theirs")
    (why "The third-person pronoun. The English form follows the Greek gender, number and case; a neuter referring to a thing is \"it\". The intensive (\"himself\") and identifying (\"the same\") uses become their own senses when they occur. A nominative αὐτός (Genesis 3:15-16) is emphatic; the literal layer still says \"he\" and the emphasis is noted, not added.")))

(lemma "αὐτοῦ" (sense right-here (gloss "right here") (why "The adverb αὐτοῦ, \"in the very place\", here or there (Genesis 22:5 Καθίσατε αὐτοῦ, as Matthew 26:36 Καθίσατε αὐτοῦ; Acts 18:19). The same spelling as the genitive of αὐτός; a word override picks it. \"Right here\" keeps it apart from ὧδε \"here\".")))

(lemma "ἀφαιρέω" (sense remove (gloss "remove" "removed" "removes" "removing") (why "To take away from, remove (Genesis 21:25, the wells which the servants removed, that is took for themselves; Luke 1:25; Matthew 26:51 ἀφεῖλεν αὐτοῦ τὸ ὠτίον). \"Remove\" keeps it apart from ἀναιρέω \"take away\".")))

(lemma "Ἄφερ" (sense name (gloss "Epher") (why "(LXX, supplied.) A son of Midian (Genesis 25:4), traditional English Epher.")))

(lemma "ἀφίημι" (sense forgive (gloss "forgive" "forgave" "forgiven" "forgives" "forgiving") (why "To let go, release, forgive. Genesis 4:13 τοῦ ἀφεθῆναί με, \"to be forgiven\"; other senses (leave, allow) become their own senses when met."))
  (sense allow (gloss "allow" "allowed" "allows" "allowing") (why "With an infinitive: to let, allow (Genesis 20:6 οὐκ ἀφῆκά σε ἅψασθαι αὐτῆς; Matthew 19:14 ἄφετε τὰ παιδία; Mark 1:34). Chosen by word override.")))

(lemma "ἀφικνέομαι" (sense reach (gloss "reach" "reached" "reaches" "reaching") (why "To arrive at, reach (Genesis 28:12, the ladder whose head was reaching into heaven; Romans 16:19). (LXX form supplied.)")))

(lemma "ἀφίστημι" (sense withdraw (verb "withdraw" "withdrew" "withdrawn") (gloss "withdraw" "withdrew" "withdrawn" "withdraws" "withdrawing") (why "Intransitive (second aorist ἀπέστη): to stand off, withdraw (Genesis 12:8; Luke 4:13; Acts 12:10). \"Withdraw\" keeps it apart from ἀπαίρω \"depart\" and ἀπέρχομαι \"go away\".")))

(lemma "ἀφορίζω"
  (sense set-apart
    (gloss "set apart" "sets apart" "setting apart")
    (why "(Supplied in Genesis 2:10.) To mark off by a boundary, set apart, separate (Romans 1:1; Galatians 1:15; Matthew 25:32). \"Set apart\" keeps it apart from διαχωρίζω \"separate\". Genesis 2:10, of the river: \"from there it is being set apart into four beginnings\".")))

(lemma "ἄχυρον" (sense straw (gloss "straw" "straws") (why "(LXX, supplied.) Straw, chaff (Genesis 24:25, 32, straw for the camels; Matthew 3:12, the chaff burned). \"Straw\" for fodder; the plural ἄχυρα stays \"straws\" in the literal layer.")))
