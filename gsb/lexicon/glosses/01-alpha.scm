;; Greek Source Bible concordance, lemmas beginning with α (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "Ἀαρών" (sense name (gloss "Aaron") (why "Moses' brother (Exodus 4:14; 17:10-12, holding up Moses' hands with Hur; Luke 1:5; Hebrews 5:4); traditional English Aaron.")))

(lemma "Ἅβελ" (sense name (gloss "Abel") (why "Traditional English form; also Matthew 23:35, Hebrews 11:4.")))

(lemma "Ἀβιασάρ" (sense name (gloss "Abiasaph") (why "(LXX, supplied.) A son of Korah (Exodus 6:24), Greek Ἀβιασάρ for the Hebrew Abiasaph, the same name with ρ for φ; traditional English Abiasaph (rule 8). Not Abiathar (Mark 2:26 Ἀβιαθάρ), another man.")))

(lemma "Ἀβιούδ" (sense name (gloss "Abihu") (why "Aaron's second son (Exodus 6:23), Greek Ἀβιούδ for the Hebrew Abihu; traditional English Abihu. Matthew 1:13 Ἀβιούδ (Abiud) is another man of the same Greek name; his English is a second sense when the New Testament is done.")))

(lemma "ἅβρα" (sense maid (person) (gloss "maid" "maids") (why "(LXX, supplied.) A favorite maidservant, a lady's own maid (Genesis 24:61, Rebekah's maids). \"Maid\" keeps it apart from παιδίσκη \"maidservant\".")))

(lemma "Ἀβιμέλεχ" (sense name (gloss "Abimelech") (why "(LXX, supplied.) The king of Gerar (Genesis 20-21, 26); traditional English Abimelech.")))

(lemma "Ἀβιμεήλ" (sense name (gloss "Abimael") (why "(LXX, supplied.) A son of Joktan (Genesis 10:28), traditional English Abimael.")))

(lemma "Ἀβιρά" (sense name (gloss "Abida") (why "(LXX, supplied.) A son of Midian (Genesis 25:4). The Greek Ἀβιρά differs a little from the Hebrew Abida (ρ for δ); traditional English Abida.")))

(lemma "Ἀβραάμ" (sense name (gloss "Abraham" "Abraham's") (why "The name God gives Ἀβράμ in Genesis 17:5 (\"father of many nations\"); traditional English Abraham, as in the New Testament (Matthew 1:1; Romans 4).")))

(lemma "Ἀβράμ" (sense name (gloss "Abram") (why "(LXX, supplied.) The patriarch's name before Genesis 17:5 renames him Ἀβραάμ; traditional English Abram. Acts 7 and Hebrews use only Ἀβραάμ.")))

(lemma "ἄβυσσος"
  (sense abyss
    (gloss "abyss")
    (why "The deep of Genesis 1:2. Kept as \"abyss\" (not \"the deep\") so it matches the same word in Luke 8:31, Romans 10:7 and Revelation 9-20.")))

(lemma "ἀγαθός" (sense good (gloss "good") (why "Good. It shares \"good\" with καλός (Genesis 1); the alignment shows which word stands behind it. Whether to separate them (\"good\" / \"beautiful\" or \"fine\") is a decision for the owner.")))

(lemma "ἀγαπάω" (sense love (gloss "love" "loved" "loves" "loving") (why "To love.")))

(lemma "ἀγαπητός" (sense beloved (gloss "beloved") (why "Beloved; of an only son, the one dearly loved (Genesis 22:2, 12, 16 τὸν υἱόν σου τὸν ἀγαπητόν; Matthew 3:17 ὁ υἱός μου ὁ ἀγαπητός; Mark 12:6). From ἀγαπάω \"love\".")))

(lemma "Ἁγάρ" (sense name (gloss "Hagar") (why "Sarah's Egyptian slave-girl, mother of Ishmael (Genesis 16; 21; 25:12); traditional English Hagar, as in Galatians 4:24-25.")))

(lemma "Ἁγγαί" (sense name (gloss "Ai") (why "(LXX, supplied.) Genesis 12:8, the town east of Bethel: Greek Ἁγγαί, a transliteration of the Hebrew with its article (ha-Ai); traditional English Ai.")))

(lemma "ἀγγεῖον" (sense container (gloss "container" "containers") (why "(LXX, supplied.) A vessel, container for carrying or storing (Genesis 43:11, Israel's sons take fruits of the land in their containers; Matthew 25:4, the flasks of oil). \"Container\" keeps it apart from σκεῦος, the general word for a vessel or article.")))

(lemma "Ἁγγείς" (sense name (gloss "Haggi") (why "(LXX, supplied.) A son of Gad (Genesis 46:16), Greek Ἁγγείς; traditional English Haggi.")))

(lemma "ἄγγελος" (sense angel (person) (gloss "angel" "angels") (why "Messenger, angel (Matthew 1:20; Hebrews 1:4-7). Genesis 6:2 in Swete reads οἱ ἄγγελοι τοῦ θεοῦ, \"the angels of God\", where 6:4 has οἱ υἱοὶ τοῦ θεοῦ and the Hebrew has \"sons of God\" in both; we translate the Greek. A human messenger (Luke 7:24) may become its own sense."))
  (sense messenger (person) (gloss "messenger" "messengers") (why "A human messenger: the men Jacob sends to Esau (Genesis 32:3, 6, ἀπέστειλεν δὲ Ἰακὼβ ἀγγέλους; Luke 7:24, 9:52; James 2:25). \"Angels\" there would say Jacob sent heavenly beings. Chosen by override where the sender and the story make them men; 32:1 οἱ ἄγγελοι τοῦ θεοῦ stays \"angels\".")))

(lemma "ἁγιάζω"
  (sense sanctify
    (gloss "sanctify" "sanctified" "sanctifies" "sanctifying")
    (why "To make or treat as holy (ἅγιος). \"Sanctify\" rather than \"make holy\" or \"hallow\", one English verb for one Greek verb; it keeps the link with the noun ἁγιασμός, \"sanctification\".")))

(lemma "ἁγίασμα" (sense sanctuary (gloss "sanctuary" "sanctuaries") (why "(LXX, supplied.) A holy place, sanctuary (Exodus 15:17, the sanctuary which the hands of the Lord prepared), from ἁγιάζω \"sanctify\"; kept apart from ἅγιος \"holy\".")) (sense holy-thing (gloss "holy thing" "holy things") (plural "holy things") (why "A thing made holy, consecrated to God: the gold plate on the high priest's miter, ἐκτύπωμα σφραγῖδος, ἁγίασμα Κυρίου \"figured work of seal, holy thing of [the] Lord\" (Exodus 28:36; 29:6 τὸ πέταλον τὸ ἁγίασμα), and the consecrated meat, ἁγίασμα γάρ ἐστιν (29:34). Not a place there, so not \"sanctuary\".")))

(lemma "ἅγιος" (sense holy (gloss "holy") (why "Holy, set apart to God (Exodus 3:5, γῆ ἁγία ἐστίν, \"is holy ground\" said of the place of the bush; Matthew 4:5 the holy city; 1 Peter 1:16 quoting Leviticus). The adjective of ἁγιάζω \"sanctify\". (LXX form supplied.)")))

(lemma "ἀγκύλη" (sense loop (gloss "loop" "loops") (why "(LXX, supplied.) A loop, a bent cord or eye (ἀγκ- \"bend\"): the fifty loops of blue on the edges of the tabernacle's curtains and skin-cloths, which the clasps (κρίκοι) join (Exodus 26:4-11; 36). Tabernacle term: always \"loop\".")))

(lemma "ἀγκωνίσκος" (sense little-elbow (gloss "little elbow" "little elbows") (why "(LXX, supplied.) Diminutive of ἀγκών \"elbow\": the two small bent arms at the foot of each column of the tabernacle, by which it stands in its bases (Exodus 26:17; 36), where the Hebrew has \"hands\" (tenons). \"Little elbow\" keeps the Greek picture. Tabernacle term.")))

(lemma "ἁγνίζω" (sense purify (gloss "purify" "purified" "purifies" "purifying") (why "To purify, make ritually clean (Exodus 19:10, the people purified before the third day at Sinai; John 11:55; James 4:8). Kept apart from ἁγιάζω \"sanctify\". (LXX form supplied.)")))

(lemma "ἀγνοέω"(sense be-ignorant (verb "be ignorant" "was ignorant" "been ignorant") (gloss "be ignorant" "is ignorant" "was ignorant" "been ignorant" "being ignorant") (why "Not to know, be ignorant (Genesis 20:4 ἔθνος ἀγνοοῦν, a nation acting in ignorance; Romans 10:3). \"Be ignorant\" keeps it apart from γινώσκω \"know\" and its negation.")))

(lemma "ἀγνόημα" (sense mistake (gloss "mistake" "mistakes") (why "(LXX, supplied.) A thing done in ignorance, an error, mistake (Genesis 43:12, the silver returned in the sacks: μή ποτε ἀγνόημά ἐστιν, \"lest it is mistake\"; Hebrews 9:7 τῶν τοῦ λαοῦ ἀγνοημάτων). \"Mistake\" keeps it apart from ἄγνοια \"ignorance\".")))

(lemma "ἄγνοια" (sense ignorance (gloss "ignorance") (why "Not knowing, ignorance, and so a sin done unknowingly (Genesis 26:10, Abimelech: \"you brought on us ignorance\"; Acts 3:17; 17:30). Kept with ἀγνοέω \"be ignorant\".")))

(lemma "ἄγονος" (sense infertile (gloss "infertile") (why "(LXX, supplied.) Not bearing offspring, infertile (Exodus 23:26 οὐκ ἔσται ἄγονος οὐδὲ στεῖρα ἐπὶ τῆς γῆς σου). \"Infertile\" keeps it apart from στεῖρα \"barren\" and ἄτεκνος \"childless\".")))

(lemma "ἀγοράζω" (sense buy (verb "buy" "bought" "bought") (gloss "buy" "bought" "buys" "buying") (why "To buy in the market (ἀγορά): Genesis 47:14, the grain the Egyptians were buying from Joseph; Matthew 13:44; 1 Corinthians 6:20. Kept apart from κτάομαι \"acquire\".")))

(lemma "ἀγορασμός" (sense buying (gloss "buying" "buyings") (why "(LXX, supplied.) A buying, what is bought (Genesis 42:19, 33 τὸν ἀγορασμὸν τῆς σιτοδοσίας ὑμῶν, the grain the brothers bought); from ἀγοράζω \"buy\". \"Buying\" because ὠνέομαι has \"purchase\".")))

(lemma "ἄγριος" (sense wild (gloss "wild") (why "Of the field, wild, not tame (Exodus 23:11 τὰ ἄγρια θηρία, the wild beasts; Matthew 3:4 μέλι ἄγριον; Jude 13).")))

(lemma "ἄγροικος"(sense rustic (gloss "rustic") (why "(LXX, supplied.) Of the country, rustic, a countryman (from ἀγρός \"field\"). Genesis 16:12, Ishmael \"will be rustic human\", where the Hebrew has \"a wild donkey of a man\"; we translate the Greek.")))

(lemma "ἀγρός"
  (sense field
    (gloss "field" "fields")
    (why "Open, uncultivated or farmed land outside a town: \"field\" in both testaments (\"the lilies of the field\", Matthew 6:28).")))

(lemma "Ἀγχείς" (sense name (gloss "Ehi") (why "(LXX, supplied.) A son of Benjamin's line (Genesis 46:21), Greek Ἀγχείς, standing where the Hebrew list has Ehi; traditional English Ehi.")))

(lemma "ἄγω"
  (sense bring
    (gloss "bring" "brought" "bringing" "brings")
    (why "To lead or bring a person or animal somewhere (Genesis 2:19, 22). \"Lead\" (as in Romans 8:14) becomes its own sense if the context needs it.")))

(lemma "Ἀδά" (sense name (gloss "Adah") (why "(LXX, supplied.) Lamech's wife, Genesis 4:19-23, traditional English Adah.")))

(lemma "Ἁδάδ" (sense name (gloss "Hadad") (why "(LXX, supplied.) A king of Edom, son of Bedad, who struck Midian (Genesis 36:35-36); traditional English Hadad.")))

(lemma "Ἀδάμ"
  (sense name
    (gloss "Adam")
    (why "The personal name. The Septuagint first uses it at Genesis 2:16; before that it says ἄνθρωπος, \"human\". We follow the Greek exactly: Ἀδάμ is always \"Adam\", ἄνθρωπος never is (see the Genesis book notes).")))

(lemma "Ἀδαμά" (sense name (gloss "Admah") (why "(LXX, supplied.) One of the five cities of the plain (Genesis 14:2, 8); traditional English Admah.")))

(lemma "ἀδελφή" (sense sister (person) (gloss "sister" "sisters") (why "Sister.")))

(lemma "ἀδελφός" (sense brother (person) (gloss "brother" "brothers") (why "Brother. \"Brother\" in the literal layer always, also for the wider \"brothers\" of the New Testament.")))

(lemma "ᾅδης" (sense name (gloss "Hades") (why "(LXX, supplied.) Hades, the place of the dead (Genesis 44:29, 31, εἰς ᾅδου, \"into Hades\", the elliptical genitive \"into [the house] of Hades\"; Matthew 11:23; Acts 2:27, quoting Psalm 16). The Greek name is kept, as in the New Testament.")))

(lemma "ἀδικέω" (sense wrong (gloss "wrong" "wronged" "wrongs" "wronging") (why "To do wrong, to wrong someone; passive \"be wronged\" (Genesis 16:5 Ἀδικοῦμαι ἐκ σοῦ, \"I am wronged from you\"; Acts 7:24-27).")))

(lemma "ἀδίκημα" (sense wrongdoing (gloss "wrongdoing" "wrongdoings") (why "A wrong done, a misdeed (Genesis 31:36 Τί τὸ ἀδίκημά μου; Acts 18:14; 24:20). \"Wrongdoing\" keeps it apart from the verb ἀδικέω \"wrong\".")))

(lemma "ἀδικία" (sense unrighteousness (gloss "unrighteousness") (why "Wrongdoing, injustice: the opposite of δίκαιος \"righteous\" (Genesis 6:11, 13; Romans 1:18). \"Unrighteousness\" keeps that link visible.")))

(lemma "ἄδικος" (sense unrighteous (gloss "unrighteous") (why "Unrighteous, unjust (Genesis 19:8 μηδὲν ἄδικον; Matthew 5:45; 1 Corinthians 6:1): the adjective of ἀδικία \"unrighteousness\", the opposite of δίκαιος \"righteous\".")))

(lemma "ἀδολεσχέω" (sense muse (gloss "muse" "mused" "muses" "musing") (why "(LXX, supplied.) To talk at length, ponder, muse (Genesis 24:63, Isaac went out into the plain ἀδολεσχῆσαι; the Psalms use it of musing on God's works). The Hebrew word there is uncertain; the Greek is musing, talking with oneself.")))

(lemma "ἁδρύνω" (sense grow-up (voice active) (intransitive) (verb "grow up" "grew up" "grown up") (gloss "grow up" "grew up" "grown up" "grows up" "growing up") (why "(LXX, supplied.) To ripen, bring to maturity; passive, to grow up, come of age (Exodus 2:10 ἁδρυνθέντος δὲ τοῦ παιδίου, the child having grown up). The passive is rendered active, \"grow up\"; kept apart from αὐξάνω \"grow\".")))

(lemma "ἀδυνατέω" (sense be-impossible (intransitive) (verb "be impossible" "was impossible" "been impossible") (gloss "be impossible" "is impossible" "was impossible" "been impossible" "being impossible" "is not impossible") (why "(LXX, supplied.) To be impossible, unable (Genesis 18:14 μὴ ἀδυνατεῖ παρὰ τῷ θεῷ ῥῆμα; Luke 1:37 echoes it, οὐκ ἀδυνατήσει παρὰ τοῦ θεοῦ πᾶν ῥῆμα; Matthew 17:20). \"Be impossible\" keeps the δυνατός root (\"possible\") visible.")))

(lemma "ᾄδω" (sense sing (dative "to") (verb "sing" "sang" "sung") (gloss "sing" "sang" "sung" "sings" "singing") (why "To sing (Exodus 15:1, 21, the song of the sea; Ephesians 5:19; Revelation 5:9; 15:3, the song of Moses). Its noun is ᾠδή \"song\".")))

(lemma "ἀέναος" (sense everflowing (gloss "everflowing") (why "(LXX, supplied.) Ever-flowing, and so everlasting (Genesis 49:26 θινῶν ἀενάων, \"of everflowing mounds\"). \"Everflowing\" keeps it apart from αἰώνιος and ἀΐδιος.")))

(lemma "ἀετός" (sense eagle (gloss "eagle" "eagles") (why "An eagle (Exodus 19:4, ὡσεὶ ἐπὶ πτερύγων ἀετῶν, \"as upon wings of eagles\"; Matthew 24:28; Revelation 4:7). (LXX form supplied.)")))

(lemma "Ἁζαῦ"(sense name (gloss "Hazo") (why "(LXX, supplied.) Nahor's son (Genesis 22:22); the Greek form of the Hebrew Hazo. Traditional English Hazo.")))

(lemma "ἄζυμος" (sense unleavened (gloss "unleavened") (why "Unleavened (Genesis 19:3, Lot bakes ἀζύμους, unleavened loaves; τὰ ἄζυμα, the feast of unleavened bread, Mark 14:1; 1 Corinthians 5:8).")))

(lemma "Ἀηδίς" (sense name (gloss "Eri") (why "(LXX, supplied.) A son of Gad (Genesis 46:16), Greek Ἀηδίς, standing where the Hebrew has Eri (the Greek δ for ρ); traditional English Eri.")))

(lemma "ἀθετέω" (sense reject (gloss "reject" "rejected" "rejects" "rejecting") (why "To set aside, reject, break faith with (Exodus 21:8, ὅτι ἠθέτησεν ἐν αὐτῇ, the master who has set aside the slave girl; Mark 6:26; Luke 10:16; Galatians 3:15). (LXX form supplied.)")))

(lemma "ἀθῷος"(sense innocent (gloss "innocent") (why "Guiltless, free of a charge or obligation (Genesis 24:41, ἀθῷος ἔσῃ ἐκ τῆς ἀρᾶς μου; Matthew 27:4, 24). Kept apart from καθαρός \"clean\", which Genesis 24:8 uses for the same release.")))

(lemma "αἴγειος" (sense goats (gloss "goat's") (why "(LXX, supplied.) Of a goat, goat's (Exodus 25:4 τρίχας αἰγίας, Swete's spelling, the goats' hair given for the tent; Hebrews 11:37 ἐν αἰγείοις δέρμασιν). \"Goat's\" goes before its noun as an adjective; αἴξ is the noun \"goat\".")))

(lemma "Αἰγύπτιος" (sense name (person) (gloss "Egyptian" "Egyptians") (why "(Supplied for Genesis 12.) An Egyptian, one of the people of Αἴγυπτος (Genesis 12:12, 14; Acts 7:22, 24).")))

(lemma "Αἴγυπτος" (sense name (gloss "Egypt") (why "Egypt.")))

(lemma "Ἀιέ" (sense name (gloss "Aiah") (why "(LXX, supplied.) A son of Zibeon (Genesis 36:24), Greek Ἀιέ; traditional English Aiah.")))

(lemma "Αἰζήλ"(sense name (gloss "Uzal") (why "(LXX, supplied.) A son of Joktan (Genesis 10:27), Greek Αἰζήλ; traditional English Uzal.")))

(lemma "αἰθάλη" (sense soot (gloss "soot" "soots") (why "(LXX, supplied.) Soot, the fine ash of a kiln (Exodus 9:8, 10, αἰθάλης καμιναίας, which Moses sprinkles toward heaven and which becomes sores).")))

(lemma "Αἰθιοπία"
  (sense name
    (gloss "Ethiopia")
    (why "(LXX, supplied.) The country name as the Greek gives it (Genesis 2:13), where the Hebrew has Cush. Same English as Αἰθίοψ in Acts 8:27 (\"an Ethiopian\").")))

(lemma "Αἰλάμ" (sense name (gloss "Elam") (why "(LXX, supplied.) The land of Chedorlaomer (Genesis 14:1, 9), Greek Αἰλάμ; traditional English Elam (the people are Ἐλαμῖται in Acts 2:9).")))

(lemma "Αἰλείμ" (sense name (gloss "Elim") (why "(LXX, supplied.) The oasis with twelve springs and seventy palms (Exodus 15:27; 16:1), Greek Αἰλείμ; traditional English Elim.")))

(lemma "Αἰλώμ" (sense name (gloss "Elon") (why "(LXX, supplied.) Father of Esau's wife Basemath (Genesis 26:34), traditional English Elon. Swete's Greek makes him a Hivite (Εὑαῖος) where the Hebrew has \"the Hittite\"; we translate the Greek.")))

(lemma "αἷμα" (sense blood (gloss "blood" "bloods") (why "Blood. Genesis 4:10-11, Abel's blood; Hebrews 12:24.")))

(lemma "Αἱμάν" (sense name (gloss "Hemam") (why "(LXX, supplied.) A son of Lotan the Horite (Genesis 36:22), Greek Αἱμάν; traditional English Hemam.")))

(lemma "Αἰνάν" (sense name (gloss "Enaim") (why "(LXX, supplied.) The place where Tamar sat, πρὸς ταῖς πύλαις Αἰνάν, on the way to Timnah (Genesis 38:14, 21). The Greek takes the Hebrew Enaim as a name in its own spelling; traditional English Enaim. Not Αἰνάν \"Enan\" of Numbers 1:15, if that comes, which would need its own sense.")))

(lemma "Αἰνεμετιείμ"(sense name (person) (plural "Anamim") (gloss "Anamim") (why "(LXX, supplied.) A people descended from Mizraim (Genesis 10:13), Greek Αἰνεμετιείμ; traditional English Anamim.")))

(lemma "αἰνέω" (sense laud (gloss "laud" "lauded" "lauds" "lauding") (why "(LXX form supplied.) To praise (Genesis 49:8 σὲ αἰνέσαισαν οἱ ἀδελφοί σου; Luke 2:13, 20; Romans 15:11). \"Laud\" because ἐπαινέω already has \"praise\"; the owner may prefer to give αἰνέω \"praise\" and ἐπαινέω \"commend\".")))

(lemma "αἴξ" (sense goat (gloss "goat" "goats") (why "(LXX, supplied.) A goat, she-goat (Genesis 15:9). τράγος \"male goat\" (Hebrews 9:12) and ἔριφος \"kid\" will need other words.")))

(lemma "αἵρεσις" (sense choosing (gloss "choosing" "choosings") (why "(LXX form supplied.) A taking, a choosing (Genesis 49:5 ἐξ αἱρέσεως αὐτῶν, \"out of their choosing\"). \"Choosing\" because ἐκλεκτός has \"choice\". The New Testament's \"sect, faction\" (Acts 5:17; 1 Corinthians 11:19) will be its own sense.")))

(lemma "αἱρετίζω" (sense prefer (gloss "prefer" "preferred" "prefers" "preferring") (why "To choose, take for oneself, prefer (Genesis 30:20, Leah: now my man αἱρετιεῖ με; Matthew 12:18 ὃν ᾑρέτισα). \"Prefer\" keeps it apart from ἐκλέγω \"choose\".")))

(lemma "αἴρω" (sense lift (gloss "lift" "lifted" "lifts" "lifting") (why "To lift, raise, take up and carry off (Genesis 47:30 ἀρεῖς με ἐξ Αἰγύπτου, \"you will lift me out of Egypt\", Jacob's body; Matthew 16:24; John 1:29). \"Lift\" keeps it apart from ἀναλαμβάνω \"take up\" and φέρω \"carry\"; the sense \"take away, remove\" (John 1:29) may become its own.")))

(lemma "αἴσθησις" (sense perception (gloss "perception" "perceptions") (why "Perception, discernment (Philippians 1:9 ἐν ἐπιγνώσει καὶ πάσῃ αἰσθήσει): Exodus 28:3, the wise in mind whom God filled πνεύματος αἰσθήσεως, \"of spirit of perception\". \"Perception\" keeps it apart from σύνεσις and φρόνησις.")))

(lemma "αἰσχρός" (sense ugly (comparative "uglier") (gloss "ugly" "uglier") (why "Shameful, base; of looks, ugly (Genesis 41:3-4, 19-21, the seven cows αἰσχραὶ τῷ εἴδει, \"ugly in the shape\"; 41:19 αἰσχροτέρας, \"uglier\"). The moral sense \"shameful\" (1 Corinthians 11:6; Ephesians 5:12) becomes its own sense when first needed. (LXX form supplied.)")))

(lemma "αἰσχύνω"
  (sense ashamed
    (verb "be ashamed")
    (voice active)
    (gloss "ashamed")
    (why "Lemma form as in the New Testament table. The middle/passive, the only voice used so far, is \"be ashamed\"; the imperfect is \"were being ashamed\" in the literal layer (Genesis 2:25).")))

(lemma "αἰτέω" (sense request (gloss "request" "requested" "requests" "requesting") (why "To ask for, request something (Exodus 3:22, each woman will request vessels of silver and gold from her neighbor; Matthew 7:7; John 14:13). \"Request\" keeps it apart from ἐρωτάω \"ask\", as that entry foresees.")))

(lemma "αἰτία" (sense charge (gloss "charge" "charges") (why "Cause, accusation, the charge against someone (Matthew 27:37, the charge over the cross). Genesis 4:13 \"greater [is] my charge\".")))

(lemma "αἰχμαλωτεύω" (sense capture (gloss "capture" "captured" "captures" "capturing") (why "(LXX, supplied.) To take a prisoner of war, from αἰχμάλωτος \"captive\" (Genesis 14:14, Lot was captured; Ephesians 4:8 quoting Psalm 67:19 has the same verb).")))

(lemma "αἰχμαλωτίς" (sense captive (person) (gloss "captive" "captives") (why "(LXX, supplied.) A woman taken captive in war (Genesis 31:26 ὡς αἰχμαλώτιδας μαχαίρᾳ, Laban's daughters led off \"as captives by blade\"). The feminine of αἰχμάλωτος (Luke 4:18), which should share \"captive\" when it comes.")))

(lemma "αἰχμάλωτος" (sense captive (gloss "captive" "captives") (why "Taken in war, captive (Exodus 22:10, 14, of an animal carried off, αἰχμάλωτον γένηται, \"come to be captive\"; Luke 4:18 κηρύξαι αἰχμαλώτοις ἄφεσιν). Shares \"captive\" with the feminine noun αἰχμαλωτίς, the same word for a woman taken captive; English has no second word.")))

(lemma "αἰών"
  (sense age
    (gloss "age" "ages")
    (why "An age, a long or unending span of time. Kept as \"age\" in the literal layer so εἰς τὸν αἰῶνα reads \"into the age\" and its plural forms (\"into the ages of the ages\") stay visible; the readable layer says \"forever\".")))

(lemma "αἰώνιος" (sense everlasting (gloss "everlasting") (why "Belonging to the age (αἰών), lasting for ages, everlasting: Genesis 17:7, 13, 19 διαθήκη αἰώνιος \"everlasting covenant\" (Hebrews 13:20); 17:8 κατάσχεσις αἰώνιος. \"Everlasting\" rather than \"eternal\", one word kept throughout, as ζωὴ αἰώνιος will be \"everlasting life\"; the link with αἰών \"age\" is noted, not forced.")))

(lemma "ἄκανθα"
  (sense thorn
    (gloss "thorn" "thorns")
    (why "Thorn, thornbush (Genesis 3:18; Matthew 7:16; 27:29, the crown of thorns; Hebrews 6:8).")))

(lemma "ἀκατασκεύαστος"
  (sense unfurnished
    (gloss "unfurnished")
    (why "(LXX, supplied.) \"Not built, not equipped\", from κατασκευάζω, \"to prepare, build, furnish\" (Hebrews 3:3-4, God the builder of all things; 11:7, the ark). Genesis 1:2 describes an earth not yet furnished with what days 3-6 bring. \"Unformed\" would import the Hebrew-based \"without form\"; \"unfurnished\" is the Greek word's own sense.")))

(lemma "ἀκίνητος" (sense immovable (gloss "immovable") (why "(LXX, supplied.) Not moved, immovable (Exodus 25:15, the carrying poles stay in the ark's rings, οἱ ἀναφορεῖς ἀκίνητοι). From κινέω \"move\"; kept apart from ἀσάλευτος.")))

(lemma "ἀκοή" (sense hearing (dative "by") (gloss "hearing" "hearings") (why "Hearing, the act or sense of hearing, and what is heard, a report (Exodus 19:5, ἐὰν ἀκοῇ ἀκούσητε, \"if you hear by hearing\", the Hebrew infinitive absolute in Greek dress; Matthew 13:14 quoting Isaiah; Romans 10:17). The English \"hearing\" is also a form of ἀκούω \"hear\"; the cognate noun cannot well avoid it. (LXX form supplied.)"))
  (sense report (gloss "report" "reports") (why "What is heard about something, a report, rumor (Exodus 23:1 Οὐ παραδέξῃ ἀκοὴν ματαίαν, \"You will not admit vain report\"; John 12:38 and Romans 10:16 quoting Isaiah 53:1, τίς ἐπίστευσεν τῇ ἀκοῇ ἡμῶν; Matthew 4:24 ἡ ἀκοὴ αὐτοῦ). \"Hearing\" there would say a sense was received, not a story. Chosen by word override. Shares \"report\" with the verb ἀπαγγέλλω; English uses the one word for both.")))

(lemma "ἀκουστός"(sense audible (gloss "audible") (why "(LXX, supplied.) Heard, audible, the verbal adjective of ἀκούω (Genesis 45:2, Joseph's weeping became audible into Pharaoh's house).")))

(lemma "ἀκούω"
  (sense hear
    (genitive "")
    (dative "")
    (gloss "hear" "heard" "hears" "hearing")
    (why "To hear. With the genitive of a person's voice it can mean \"heed, obey\" (Genesis 3:17); the literal layer keeps \"hear\" and the readable layer may say \"listen to\".")))

(lemma "ἀκρίς" (sense locust (gloss "locust" "locusts") (why "The locust (Exodus 10:4-19, the eighth plague; Matthew 3:4; Revelation 9:3, 7). The Greek singular is collective (ἀκρίδα πολλήν, \"much locust\"); the literal layer keeps the singular.")))

(lemma "ἀκροβυστία" (sense foreskin (gloss "foreskin" "foreskins") (why "The foreskin (Genesis 17:11-25, ἡ σὰρξ τῆς ἀκροβυστίας \"the flesh of the foreskin\"; Acts 11:3); in Paul also uncircumcision as a state (Romans 2:25-29), which will be its own sense.")))

(lemma "ἄκρον" (sense top (gloss "top" "tops") (why "The extremity, top, tip (Genesis 28:18, poured oil on the top of the stone; Luke 16:24 τὸ ἄκρον τοῦ δακτύλου; Hebrews 11:21). (LXX, supplied.)")))

(lemma "ἄλειμμα" (sense salve (gloss "salve" "salves") (why "(LXX, supplied.) What is rubbed on, an unguent, from ἀλείφω \"anoint\" (Exodus 30:31 Ἔλαιον ἄλειμμα χρίσεως ἅγιον, Swete's spelling ἄλιμμα). \"Salve\" keeps it apart from ἔλαιον \"oil\", μύρον \"perfume\" and χρῖσμα; tabernacle term, keep \"salve\" wherever it recurs.")))

(lemma "ἀλείφω" (sense anoint (gloss "anoint" "anointed" "anoints" "anointing") (why "(LXX form supplied.) To smear with oil, anoint (Genesis 31:13 ἤλειψάς μοι ἐκεῖ στήλην, the pillar at Bethel; Mark 6:13; James 5:14). χρίω, when it comes, will need another English word.")))

(lemma "ἀλήθεια" (sense truth (gloss "truth" "truths") (why "Truth, faithfulness (Genesis 24:27, 48, God's righteousness and truth; John 1:14, 17).")))

(lemma "ἀληθεύω" (sense speak-truth (verb "speak truth" "spoke truth" "spoken truth") (gloss "speak truth" "spoke truth" "spoken truth" "speaks truth" "speaking truth") (why "(LXX form supplied.) To speak the truth, be truthful (Genesis 20:16 πάντα ἀλήθευσον; Galatians 4:16; Ephesians 4:15). \"Speak truth\" keeps the ἀληθ- root (ἀληθῶς \"truly\").")))

(lemma "ἀληθής" (sense true (gloss "true") (why "True (Genesis 41:32 ἀληθὲς ἔσται τὸ ῥῆμα τὸ παρὰ τοῦ θεοῦ; John 3:33; 8:13). The adjective of ἀλήθεια.")))

(lemma "ἀληθῶς" (sense truly (gloss "truly") (why "Truly, really (Genesis 18:13; Matthew 14:33; John 1:47). The adverb of ἀληθής \"true\".")))

(lemma "ἁλίσκομαι" (sense be-caught (intransitive) (verb "be caught" "was caught" "been caught") (gloss "be caught" "was caught" "were caught" "is caught" "are caught" "been caught" "being caught") (why "(LXX, supplied.) To be taken, caught, convicted; the active aorist ἑάλων/ἁλούς has this passive sense (Exodus 22:9 ὁ ἁλοὺς διὰ τοῦ θεοῦ, \"the one having been caught through God\", found guilty). Kept apart from καταλαμβάνω, which is the active \"overtake\".")))

(lemma "ἀλλά" (sense rather (gloss "rather") (why "The strong adversative, usually after a negative: \"not ... rather\" (Genesis 17:5, 15; 18:15 Οὐχί, ἀλλὰ ἐγέλασας \"No, rather you laughed\"). Not \"but\", which δέ always takes so the two stay apart (see δέ); \"rather\" keeps the correction ἀλλά makes. The owner may prefer a different split.")))

(lemma "ἀλλάσσω" (sense change (gloss "change" "changed" "changes" "changing") (why "(LXX form supplied.) To change, exchange (Genesis 35:2 ἀλλάξατε τὰς στολὰς ὑμῶν, \"change your robes\"; Acts 6:14; Galatians 4:20)."))
  (sense exchange (dative "for") (gloss "exchange" "exchanged" "exchanges" "exchanging") (why "To give one thing for another, exchange, with the price in the dative (Exodus 13:13, ὄνου ἀλλάξεις προβάτῳ, \"you will exchange for sheep\"; Romans 1:23). Chosen by the form rows.")))

(lemma "ἀλλήλων"(sense one-another (gloss "one another") (why "The reciprocal pronoun: one another (Genesis 15:10; John 13:34).")))

(lemma "ἀλλογενής" (sense alien (gloss "alien") (why "(LXX, supplied.) Of another race, foreign-born (Genesis 17:27 ἐξ ἀλλογενῶν ἐθνῶν; Luke 17:18, the Samaritan). \"Alien\" keeps it apart from ἀλλότριος \"foreign\".")))

(lemma "ἄλλος" (sense another (gloss "another" "others") (why "Other, another (of the same kind): Genesis 19:12 εἴ τίς σοι ἄλλος ἐστίν; Matthew 2:12; John 4:37. \"Another\" because ἕτερος already has \"other\"; the plural is \"others\".")))

(lemma "ἀλλότριος" (sense foreign (gloss "foreign") (why "Belonging to another, foreign (Genesis 17:12 υἱὸς ἀλλότριος \"foreign son\"; Hebrews 11:9, 34; Matthew 17:25-26).")))

(lemma "ἄλογος" (sense speechless (gloss "speechless") (why "(LXX sense.) Without speech, without reason. Exodus 6:12 ἐγὼ δὲ ἄλογός εἰμι, Moses of himself (the Hebrew has \"uncircumcised of lips\"): \"speechless\", without the gift of speech, beside ἰσχνόφωνος \"thin-voiced\" (6:30). In 2 Peter 2:12 and Jude 10, of animals, \"unreasoning\", a later sense.")))

(lemma "Ἁλοήλ" (sense name (gloss "Jahleel") (why "(LXX, supplied.) A son of Zebulun (Genesis 46:14), Greek Ἁλοήλ; traditional English Jahleel.")))

(lemma "ἀλοιφή" (sense smearing (dative "with") (gloss "smearing") (why "(LXX, supplied.) A smearing, an ointment or plaster (the noun of ἀλείφω \"anoint\", smear). Exodus 17:14, ἀλοιφῇ ἐξαλείψω τὸ μνημόσυνον Ἀμαλήκ, \"with smearing I will blot out\": the noun is set beside its compound verb ἐξαλείφω, as the Hebrew doubles \"blot out\"; the literal keeps the noun's own sense. Not \"wiping\", which ἀπαλείφω \"wipe out\" has.")))

(lemma "ἀλλοτριόω"(sense estrange (gloss "estrange" "estranged" "estranges" "estranging") (why "(LXX, supplied.) To make strange, alienate; middle, to make oneself a stranger (Genesis 42:7 ἠλλοτριοῦτο ἀπ’ αὐτῶν, Joseph acting as a stranger to his brothers). From ἀλλότριος.")))

(lemma "Ἁμαθί" (sense name (gloss "Hamathite") (why "(LXX, supplied.) The people of Hamath, last of Canaan's descendants (Genesis 10:18, τὸν Ἁμαθί, indeclinable); traditional English \"the Hamathite\".")))

(lemma "ἅλς" (sense salt (gloss "salt" "salts") (why "(LXX, supplied.) Salt; the plural ἅλες in ἡ θάλασσα τῶν ἁλῶν, \"the sea of the salts\" (Genesis 14:3), the Dead Sea. The New Testament's ἅλας (Matthew 5:13) is a different lemma.")))

(lemma "ἁλυκός" (sense salty (gloss "salty") (why "(LXX, supplied.) Salty, briny (Genesis 14:3, 8, 10, the salty ravine or valley; James 3:12). \"Salty\" keeps it apart from the noun ἅλς \"salt\".")))

(lemma "ἁλυσιδωτός" (sense chained (gloss "chained") (why "(LXX, supplied.) Made like a chain, of chain links (ἅλυσις \"chain\"): the gold cords of the oracle, ἔργον ἁλυσιδωτοῦ \"work of chained [kind]\" and τὰ ἁλυσιδωτά \"the chained [things]\" (Exodus 28:22, 24; 36-39). Use this English in every tabernacle chapter.")))

(lemma "ἅλων" (sense threshing-floor (gloss "threshing floor" "threshing floors") (why "(LXX form supplied.) A threshing floor (Genesis 50:10-11, the threshing floor of Atad; Matthew 3:12; Luke 3:17).")))

(lemma "ἅμα" (sense together (gloss "together") (why "Together, at the same time (Genesis 13:6, they could not dwell together; Romans 3:12; 1 Thessalonians 4:17).")))

(lemma "Ἁμαδά" (sense name (gloss "Hemdan") (why "(LXX, supplied.) A son of Dishon (Genesis 36:26), Greek Ἁμαδά; traditional English Hemdan.")))

(lemma "Ἀμαλήκ"(sense name (gloss "Amalek") (why "(LXX, supplied.) Amalek (Genesis 14:7, the rulers of Amalek); traditional English.")))

(lemma "ἅμαξα" (sense wagon (gloss "wagon" "wagons") (why "(LXX, supplied.) A four-wheeled wagon, cart (Genesis 45:19-27, the wagons Joseph sent for his father; 46:5).")))

(lemma "ἁμαρτάνω" (sense sin (intransitive) (gloss "sin" "sinned" "sins" "sinning") (why "To sin (Genesis 4:7).")))

(lemma "ἁμάρτημα" (sense offense (gloss "offense" "offenses") (why "A single act of sin (Genesis 31:36 τί τὸ ἁμάρτημά μου; Mark 3:28; Romans 3:25). \"Offense\" keeps it apart from ἁμαρτία \"sin\".")))

(lemma "ἁμαρτία" (sense sin (gloss "sin" "sins") (why "Sin, the noun of ἁμαρτάνω.")))

(lemma "ἁμαρτωλός" (sense sinful (gloss "sinful") (why "Sinful, a sinner (Genesis 13:13, the men in Sodom evil and sinful; Luke 5:8; Romans 5:19). \"Sinful\" as the adjective it is; a substantival use (\"sinners\", Matthew 9:10) may become its own sense.")))

(lemma "Ἀμαρφάλ" (sense name (gloss "Amraphel") (why "(LXX, supplied.) King of Shinar (Genesis 14:1, 9); traditional English Amraphel.")))

(lemma "ἀμβλύνω" (sense dull (gloss "dull" "dulled" "dulls" "dulling") (why "(LXX, supplied.) To blunt, dull; passive of eyes grown dim (Genesis 27:1 ἠμβλύνθησαν οἱ ὀφθαλμοὶ αὐτοῦ, \"his eyes were dulled\"). \"Dull\" keeps the image of a blunted edge.")))

(lemma "Ἀμβράμ" (sense name (gloss "Amram") (why "(LXX, supplied.) Kohath's son, father of Aaron and Moses (Exodus 6:18, 20; Swete prints Ἀμβράμ and Ἀμβράν). The Greek has β inside the Hebrew Amram; the same name, traditional English Amram (rule 8).")))

(lemma "ἀμέθυστος" (sense amethyst (gloss "amethyst" "amethysts") (why "Amethyst, the purple stone (Revelation 21:20); the third stone of the oracle's third row (Exodus 28:19; 36:19). The stones of the oracle keep the names the Greek gives them, in their English forms.")))

(lemma "Ἀμειναδάβ" (sense name (gloss "Amminadab") (why "(LXX, supplied.) Father of Elisheba, Aaron's wife, and of Nahshon (Exodus 6:23); Matthew 1:4 and Luke 3:33 spell Ἀμιναδάβ, the same man. Traditional English Amminadab.")))

(lemma "ἄμεμπτος" (sense blameless (gloss "blameless") (why "Without blame (Genesis 17:1 γίνου ἄμεμπτος; Luke 1:6; Philippians 2:15; 3:6).")))

(lemma "ἄμητος" (sense reaping (gloss "reaping") (why "(LXX, supplied.) Reaping, the gathering of a harvest (Genesis 45:6, no plowing nor reaping). \"Reaping\" keeps it apart from θερισμός \"harvest\".")))

(lemma "ἀμνάς" (sense ewe-lamb (gloss "ewe lamb" "ewe lambs") (why "(LXX, supplied.) A female lamb (Genesis 21:28-30; 2 Kingdoms 12:3, the poor man's one ewe lamb).")))

(lemma "ἀμνήστευτος" (sense unbetrothed (gloss "unbetrothed") (why "(LXX, supplied.) Not promised in marriage, unbetrothed (Exodus 22:16 παρθένον ἀμνήστευτον). The negative of μνηστεύω \"betroth\" (Luke 1:27).")))

(lemma "ἀμνός" (sense lamb (gloss "lamb" "lambs") (why "A lamb (John 1:29, 36; Acts 8:32; 1 Peter 1:19). Genesis 33:19 ἑκατὸν ἀμνῶν, the price of Jacob's field, \"hundred lambs\" (the Hebrew has a unit of money). Kept apart from ἀμνάς \"ewe lamb\".")))

(lemma "ἄμπελος" (sense vine (gloss "vine" "vines") (why "A vine, grapevine (Genesis 40:9-10, the cupbearer's dream; John 15:1, 5 ἐγώ εἰμι ἡ ἄμπελος). The plant of ἀμπελών \"vineyard\".")))

(lemma "ἀμπελών" (sense vineyard (gloss "vineyard" "vineyards") (why "A vineyard (Genesis 9:20, Noah planted a vineyard; Matthew 20:1; Mark 12:1). Against ἄμπελος, which will take \"vine\".")))

(lemma "Ἀμμάν" (sense name (gloss "Amman") (why "(LXX, supplied.) Genesis 19:38, the younger daughter's son: the Greek names him Ἀμμάν and explains it, ὁ υἱὸς τοῦ γένους μου, \"the son of my race\"; the Hebrew has Ben-ammi. The Greek gives a different name, so the English follows it: Amman (rule 8). Question for the owner.")))

(lemma "Ἀμμανίτης" (sense name (person) (gloss "Ammonite" "Ammonites") (why "(LXX, supplied.) The people descended from Ἀμμάν (Genesis 19:38 πατὴρ Ἀμμανιτῶν); traditional English Ammonites, the Septuagint's usual spelling for them.")))

(lemma "ἄμμος" (sense sand (gloss "sand") (why "Sand (Genesis 28:14 ὡς ἡ ἄμμος τῆς θαλάσσης; Romans 9:27; Hebrews 11:12). (LXX form supplied.)")))

(lemma "Ἀμορραῖος" (sense name (person) (gloss "Amorite" "Amorites") (why "(LXX, supplied.) The Amorite, a people of Canaan (Genesis 10:16; 14:7, 13); traditional English Amorite. Swete prints the singular as Ἄμορις at 14:13 (Vaticanus's spelling); it is read as this word.")))

(lemma "ἀμφότεροι" (sense both (gloss "both") (why "Both, the two together (Genesis 21:27, 31; 22:8; Luke 1:6-7). It shares \"both\" with τε, which says \"both\" only before καί; the alignment shows which Greek word stands behind it.")))

(lemma "ἄμωμος" (sense unblemished (gloss "unblemished") (why "Without blemish (μῶμος), of sacrificial animals (Exodus 29:1, 38 κριοὺς δύο ἀμώμους; Leviticus passim) and in the New Testament of Christ and his people (1 Peter 1:19; Ephesians 1:4; Hebrews 9:14). \"Unblemished\" keeps the literal image in both testaments.")))

(lemma "ἄν"
  (sense ever
    (gloss "ever")
    (why "The particle of contingency. After a relative (ᾗ ἂν ἡμέρᾳ, Genesis 2:17; 3:5) it makes the clause indefinite; rendered \"ever\" (\"in which ever day\") so the particle is visible rather than absorbed into \"whatever\". In conditions (\"would\") it becomes its own sense. ἐάν after a relative takes the same gloss."))
  (sense unrendered
    (gloss "")
    (why "After ὅπως or ἵνα (ὅπως ἄν, Genesis 18:19; Acts 3:19) ἄν adds nothing English can say: \"in order that ever\" misreads as a time word, so it is aligned with the conjunction and left unrendered (chosen by the generator).")))

(lemma "ἀνά"
  (sense meson
    (gloss "")
    (why "In the Septuagint ἀνά almost always stands in the fixed phrase ἀνὰ μέσον, \"between\" (also 1 Corinthians 6:5). The phrase is one English word, carried by μέσος (sense between); ἀνά is aligned with it and left unrendered. The distributive ἀνά (\"each\", Matthew 20:9) becomes its own sense when it occurs."))
  (sense each
    (gloss "each")
    (why "Distributive, \"apiece, each\": ἐνώτια χρυσᾶ ἀνὰ δραχμὴν ὁλκῆς \"golden earrings, each [a] drachma of weight\" (Genesis 24:22; Matthew 20:9, 10 ἀνὰ δηνάριον). The generator takes it wherever ἀνά is not in ἀνὰ μέσον.")))

(lemma "Ἀνά" (sense name (gloss "Anah") (why "(LXX, supplied.) Anah the Horite, son of Zibeon and father of Oholibamah (Genesis 36:2, 14, 20, 25, 29), traditional English Anah. Spelled like the preposition ἀνά, so each occurrence is marked by a word override.")))

(lemma "ἀναβαθμίς"(sense step (gloss "step" "steps") (why "(LXX, supplied.) A step, stair (Exodus 20:26).")))

(lemma "ἀναβαίνω"
  (sense go-up
    (gloss "go up" "goes up" "going up" "went up" "gone up")
    (why "(Supplied in Genesis 2:6, where the form is LXX-only.) To go up, ascend. \"Go up\" covers both a spring rising (Genesis 2:6) and going up to Jerusalem (Mark 10:33).")))

(lemma "ἀναβάτης" (sense rider (person) (gloss "rider" "riders") (why "(LXX, supplied.) One mounted, a rider (Exodus 14:23, 26, 28, οἱ ἀναβάται with Pharaoh's chariots; 15:1). From ἀναβαίνω, go up, mount.")))

(lemma "ἀναβιβάζω" (sense mount-up (verb "mount up" "mounted up" "mounted up") (gloss "mount up" "mounted up" "mounts up" "mounting up") (why "To make go up, set up on (Genesis 41:43 ἀνεβίβασεν αὐτὸν ἐπὶ τὸ ἅρμα, Pharaoh putting Joseph on the chariot; Matthew 13:48, drawing up the net). \"Mount up\" (transitive) keeps it apart from ἐπιβαίνω \"mount\" and ἀναφέρω \"bring up\"."))
  (sense make-go-up (verb "make go up" "made go up" "made go up") (gloss "make go up" "made go up" "makes go up" "making go up") (why "The causative of ἀναβαίνω, of bringing a people up out of a land (Exodus 17:3, Ἵνα τί τοῦτο ἀνεβίβασας ἡμᾶς ἐξ Αἰγύπτου;). \"Make go up\" because \"bring up\" is ἀναφέρω's and \"lead up\" ἀνάγω's; chosen by the form row of ἀνεβίβασας.")))

(lemma "ἀναβοάω" (sense cry-aloud (gloss "cry aloud" "cried aloud" "cries aloud" "crying aloud") (why "(LXX, supplied.) To cry out loud, shout (Genesis 27:34, Esau ἀνεβόησεν φωνὴν μεγάλην; Matthew 27:46). \"Cry aloud\" keeps it apart from βοάω \"cry out\".")))

(lemma "ἀναβλέπω" (sense look-up (dative "with") (gloss "look up" "looked up" "looks up" "looking up") (why "To look up (Genesis 18:2 ἀναβλέψας τοῖς ὀφθαλμοῖς \"having looked up with the eyes\"; Mark 6:41); recovering sight (John 9:11) will be its own sense. Kept apart from βλέπω \"see\".")))

(lemma "ἀναγγέλλω"
  (sense declare
    (gloss "declare" "declared" "declares" "declaring")
    (why "To report, announce, declare (John 4:25; 16:13-15). \"Declare\" keeps it apart from λέγω \"say\" and ἀπαγγέλλω.")))

(lemma "ἀναγινώσκω" (sense read (verb "read" "read" "read") (gloss "read" "reads" "reading") (why "(LXX form supplied.) To read, read aloud (Exodus 24:7, Moses read the book of the covenant into the ears of the people; Luke 4:16; Acts 8:28).")))

(lemma "ἀνάγω" (sense lead-up (verb "lead up" "led up" "led up") (gloss "lead up" "led up" "leads up" "leading up") (why "(LXX form supplied.) To lead or bring up (Genesis 50:24, God will lead you up out of this land; Luke 2:22; Matthew 4:1). \"Lead up\" because ἀναφέρω has \"bring up\".")))

(lemma "ἀναγνωρίζω" (sense make-known (verb "make known" "made known" "made known") (gloss "make known" "made known" "makes known" "making known") (why "(LXX, supplied.) Passive: to be recognized, make oneself known again (Genesis 45:1, ἀνεγνωρίζετο Ἰωσὴφ τοῖς ἀδελφοῖς αὐτοῦ, \"Joseph was being made known to his brothers\"; Acts 7:13 quotes it).")))

(lemma "ἀναζεύγνυμι" (sense break-camp (intransitive) (verb "break camp" "broke camp" "broken camp") (gloss "break camp" "broke camp" "broken camp" "breaks camp" "breaking camp") (why "(LXX, supplied.) To yoke up again, so to break camp and move on (Exodus 14:15, λάλησον τοῖς υἱοῖς Ἰσραὴλ καὶ ἀναζευξάτωσαν, \"let them break camp\"). Kin to ζεύγνυμι \"yoke\".")))

(lemma "ἀναζέω" (sense boil-up (intransitive) (verb "boil up" "boiled up" "boiled up") (gloss "boil up" "boiled up" "boils up" "boiling up") (why "(LXX, supplied.) To boil up, break out (Exodus 9:9-10, φλυκτίδες ἀναζέουσαι, \"blisters boiling up\", of the sores).")))

(lemma "ἀναζωπυρέω" (sense rekindle (intransitive) (gloss "rekindle" "rekindled" "rekindles" "rekindling") (why "To kindle again, come to life again (Genesis 45:27, the spirit of Jacob rekindled; 2 Timothy 1:6, ἀναζωπυρεῖν τὸ χάρισμα). Intransitive in Genesis.")))

(lemma "ἀναιρέω" (sense take-away (verb "take away" "took away" "taken away") (gloss "take away" "took away" "taken away" "taking away") (why "To take up, take away, and so do away with, kill (Acts 2:23). Kept apart from ἀποκτείνω \"kill\"."))
  (sense take-up (verb "take up" "took up" "taken up") (gloss "take up" "took up" "taken up" "takes up" "taking up") (why "The middle, to take up for oneself, pick up, of a foundling (Exodus 2:5 ἀνείλατο αὐτήν, Pharaoh's daughter took up the basket; 2:10 ἐκ τοῦ ὕδατος αὐτὸν ἀνειλόμην; Acts 7:21 ἀνείλατο αὐτόν). \"Take away\" would say she removed him; chosen by form row or override."))
  (sense slay (verb "slay" "slew" "slain") (gloss "slay" "slew" "slain" "slays" "slaying") (why "To make away with, kill (Exodus 21:29, a goring bull ἀνέλῃ δὲ ἄνδρα ἢ γυναῖκα; Acts 2:23; 7:28). \"Take away\" would not say the person died; \"slay\" keeps it apart from ἀποκτείνω \"kill\". Chosen by form row or override.")))

(lemma "ἀνακαλέω" (sense call-up (verb "call up" "called up" "called up") (gloss "call up" "called up" "calls up" "calling up") (why "(LXX, supplied.) To call up, summon (Exodus 31:2 Ἰδοὺ ἀνακέκλημαι ἐξ ὀνόματος τὸν Βεσελεήλ, the perfect middle \"I have called up by name\"; 35:30). \"Call up\" renders the ἀνα- and keeps it apart from καλέω \"call\" and ἐπικαλέω \"call upon\".")))

(lemma "ἀνακάμπτω" (sense bend-back (intransitive) (verb "bend back" "bent back" "bent back") (gloss "bend back" "bent back" "bends back" "bending back") (why "(LXX, supplied.) To bend back, turn back the way one came, return (Exodus 32:27, διέλθατε καὶ ἀνακάμψατε ἀπὸ πύλης ἐπὶ πύλην, the Levites through the camp; Matthew 2:12; Luke 10:6). \"Bend back\" renders the verb's own picture and keeps it apart from ἀποστρέφω \"turn back\", ἀναστρέφω \"come back\", ὑποστρέφω \"return\" and μεταστρέφω \"turn about\".")))

(lemma "ἀναλαμβάνω" (sense take-up(gloss "take up" "took up" "taken up" "takes up" "taking up") (why "To take up, take along (Genesis 24:61, the servant took up Rebekah; Acts 1:2, 11; 2 Timothy 4:11). Kept apart from λαμβάνω \"take\" by the particle.")))

(lemma "ἀναλίσκω" (sense consume (gloss "consume" "consumed" "consumes" "consuming") (why "To use up, consume (Genesis 41:30 ἀναλώσει ὁ λιμὸς τὴν γῆν; Luke 9:54; Galatians 5:15).")))

(lemma "ἀναμιμνῄσκω" (sense call-to-mind (verb "call to mind" "called to mind" "called to mind") (gloss "call to mind" "called to mind" "calls to mind" "calling to mind") (why "To remind; to recall to mind (Genesis 41:9 Τὴν ἁμαρτίαν μου ἀναμιμνήσκω σήμερον, the cupbearer; Mark 14:72; 2 Timothy 1:6). \"Call to mind\" keeps it apart from μιμνῄσκω \"remember\".")))

(lemma "ἀνανεύω" (sense refuse (intransitive) (gloss "refuse" "refused" "refuses" "refusing") (why "(LXX, supplied.) To throw the head back, the Greek gesture of \"no\", and so to refuse (Exodus 22:17 ἐὰν δὲ ἀνανεύων ἀνανεύσῃ, \"if but refusing he/she/it refuse\", the Hebrew infinitive absolute in Greek dress).")))

(lemma "ἀνάπαυσις" (sense rest (gloss "rest" "rests") (why "A resting, rest, a place to rest (Genesis 8:9, the dove found no rest for her feet; Matthew 11:29; 12:43, seeking rest and not finding it). The noun shares \"rest\" with the verb καταπαύω (Genesis 2:2); English has one word for both.")))

(lemma "ἀναπαύω" (sense repose (gloss "repose" "reposed" "reposes" "reposing") (why "To give rest; middle, to rest, take one's rest (Genesis 29:2, three flocks of sheep ἀναπαυόμενα by the well; Matthew 11:28; Mark 6:31). \"Repose\" keeps it apart from καταπαύω \"rest\" and the noun ἀνάπαυσις \"rest\".")))

(lemma "ἀναπίπτω" (sense recline (gloss "recline" "reclined" "reclines" "reclining") (why "(LXX form supplied.) To fall back, lie down, recline (Genesis 49:9 ἀναπεσὼν ἐκοιμήθης ὡς λέων; Luke 11:37; John 13:25).")))

(lemma "ἀναπληρόω"
  (sense fill-up
    (gloss "fill up" "filled up" "fills up" "filling up")
    (why "(Supplied in Genesis 2:21.) To fill up, make complete (Galatians 6:2; 1 Thessalonians 2:16). The ἀνα- prefix is kept as \"up\" to distinguish it from πληρόω \"fill\".")))

(lemma "ἀνάστημα" (sense standing-thing (gloss "standing thing" "standing things") (why "(LXX, supplied.) That which stands up or has been raised up: every living thing standing on the earth (Genesis 7:4, 23, πᾶν τὸ ἀνάστημα, all that the flood wipes out). Swete prints the spelling ἀνάστεμα. \"Standing thing\" keeps the root ἀνίστημι \"stand up\" visible.")))

(lemma "ἀναστρέφω" (sense come-back (gloss "come back" "came back" "comes back" "coming back") (why "(LXX sense, supplied.) Intransitive: to turn back, come back (Genesis 8:9, 11, the dove came back to Noah; Acts 5:22). \"Come back\" keeps it apart from ἀποστρέφω \"turn back\", ὑποστρέφω \"return\" and ἐπιστρέφω \"turn again\". The New Testament's middle \"conduct oneself\" (1 Peter 1:17) will be its own sense.")))

(lemma "ἀνασῴζω" (sense escape (voice active) (gloss "escape" "escaped" "escapes" "escaping") (why "(LXX, supplied.) To bring safely back; the passive \"be brought safely through\" is rendered active, \"escape\" (Genesis 14:13, one of the ones having escaped). Kept apart from σῴζω \"save\".")))

(lemma "ἀνατέλλω"
  (sense rise
    (gloss "rise" "rose" "risen" "rises" "rising")
    (why "(Supplied in Genesis 2:5, 3:18.) Intransitive: to rise, spring up, of the sun (Matthew 5:45), light (Matthew 4:16) or plants (Genesis 2:5). \"Rise\" serves all of these and keeps the link with ἀνατολή, the rising of the sun, the east."))
  (sense raise
    (gloss "raise" "raised" "raises" "raising")
    (why "Transitive: to make rise, make spring up (Genesis 3:18, the earth raising thorns). A separate English verb because English \"rise\" cannot take an object.")))

(lemma "ἀνατολή"
  (sense east
    (gloss "east" "easts")
    (why "(Supplied in Genesis 2:8.) The rising (of the sun), hence the east: Matthew 2:1-2. Genesis 2:8 has the plural κατὰ ἀνατολάς, an idiom for \"eastward\"; the literal layer gives \"[the] east\" and the plural is noted there.")))

(lemma "ἀναφέρω" (sense bring-up (gloss "bring up" "brought up" "brings up" "bringing up") (why "To carry up, bring up, and so offer up a sacrifice on an altar (Genesis 8:20, Noah brought up a whole offering on the altar; Hebrews 7:27; James 2:21). \"Bring up\" keeps the ἀνα- and the literal motion; it is kept apart from φέρω \"carry\".")))

(lemma "ἀναφορεύς" (sense carrying-pole (gloss "carrying pole" "carrying poles") (why "(LXX, supplied.) A bearer, the pole by which a thing is carried (from ἀναφέρω \"bring up\", φέρω \"carry\"): the poles of the ark and the table, put through their rings (Exodus 25:13-15, 27-28; 35:12). Tabernacle term: always \"carrying pole\", kept apart from ῥάβδος \"rod\" and στῦλος.")))

(lemma "ἀνάψυξις" (sense respite (gloss "respite") (why "(LXX, supplied.) A cooling off, a breathing space, relief (Exodus 8:15, Pharaoh saw that respite had come when the frogs died; Acts 3:20 καιροὶ ἀναψύξεως). \"Respite\" keeps it apart from ἀνάπαυσις \"rest\".")))

(lemma "ἄνεμος" (sense wind (gloss "wind" "winds") (why "Wind (Exodus 10:13, 19, the south wind that brings the locust and the sea wind that takes it away; Matthew 7:25; 8:26). Kept apart from πνεῦμα \"spirit, breath\".")))

(lemma "ἀνέχομαι" (sense bear-with (genitive "") (verb "bear with" "bore with" "borne with") (gloss "bear with" "bore with" "borne with" "bears with" "bearing with") (why "To hold up under, bear with, endure, with the genitive (Genesis 45:1, Joseph could not bear with all those standing by him; Matthew 17:17; 2 Corinthians 11:1).")))

(lemma "ἀναφύω" (sense spring-up (verb "spring up" "sprang up" "sprung up") (gloss "spring up" "sprang up" "sprung up" "springs up" "springing up") (why "(LXX, supplied.) To make grow up; middle, to spring up, sprout (Genesis 41:6, 23 ἀνεφύοντο, the thin ears springing up after the full ones). Compare φύω, \"grow\" (Luke 8:6).")))

(lemma "ἀναχωρέω" (sense retreat (intransitive) (gloss "retreat" "retreated" "retreats" "retreating") (why "To go back, withdraw, take refuge away from danger (Exodus 2:15 ἀνεχώρησεν δὲ Μωυσῆς ἀπὸ προσώπου Φαραώ; Matthew 2:14, 22; 12:15). \"Retreat\" keeps it apart from ἀφίστημι \"withdraw\".")))

(lemma "ἀνεμόφθορος" (sense wind-blighted (gloss "wind-blighted") (why "(LXX, supplied.) Spoiled by wind (ἄνεμος + φθείρω), of ears of grain blasted by the east wind (Genesis 41:6-27).")))

(lemma "ἄνευ" (sense without (gloss "without") (why "Without, apart from, with the genitive (Genesis 41:16 Ἄνευ τοῦ θεοῦ; 41:44 ἄνευ σοῦ; Matthew 10:29; 1 Peter 3:1).")))

(lemma "ἀνήρ"
  (sense man
    (person)
    (gloss "man" "men")
    (why "A male human, and so also a husband. One gloss, \"man\", in the literal layer (\"her man\", Genesis 3:6, 16), because the Greek has one word; the readable layer says \"husband\" where English needs it. Never used for ἄνθρωπος (sense human).")))

(lemma "ἄνθινος" (sense flowered (gloss "flowered") (why "(LXX, supplied.) Of flowers, flowered: Exodus 28:34, beside each little pomegranate κώδωνα καὶ ἄνθινον, \"bell and flowered [work]\". The adjective of ἄνθος \"flower\".")))

(lemma "ἄνθος" (sense flower (gloss "flower" "flowers") (why "A flower, blossom (James 1:10-11; 1 Peter 1:24): of the gold work of the shoulder-piece, καταμεμιγμένα ἐν ἄνθεσιν \"mingled in flowers\" (Exodus 28:14).")))

(lemma "ἄνθραξ"
  (sense carbuncle
    (gloss "carbuncle")
    (why "(Supplied in Genesis 2:12.) A glowing-red precious stone, the carbuncle (also Exodus 28:18). The same word means a live coal in Romans 12:20; that becomes its own sense, \"coal\", there.")))

(lemma "ἄνθρωπος"
  (sense human
    (person)
    (gloss "human" "humans")
    (why "The literal layer keeps ἄνθρωπος (a human being, of either sex) apart from ἀνήρ (a man, a husband), so the two cannot share \"man\". \"Human\" is the one English noun with exactly that sense. The readable layer may say \"people\" or \"men\" where English idiom wants it, and \"man\" for the first human in Genesis 1-2.")))

(lemma "ἀνίημι" (sense spare (gloss "spare" "spared" "spares" "sparing") (why "(LXX, supplied.) To let go, let up on, and so spare (Genesis 18:24 οὐκ ἀνήσεις τὸν τόπον \"will you not spare the place\"; Hebrews 13:5, \"let go\"; Acts 16:26). \"Spare\" for the sense of Genesis 18; \"let go, loosen\" (Acts 16:26; 27:40) will be its own sense, kept apart from ἀφίημι \"forgive\"."))
  (sense let-loose (verb "let loose" "let loose" "let loose") (gloss "let loose" "lets loose" "letting loose") (why "(LXX form supplied.) To let go free, let loose, of a plant spreading unchecked (Genesis 49:21 στέλεχος ἀνειμένον, \"let loose stem\"); also Acts 16:26; 27:40, unfastened. \"Let loose\" keeps it apart from λύω \"loose\".")))

(lemma "ἀνίστημι" (sense stand-up (gloss "stand up" "stood up" "stands up" "standing up") (why "Intransitive: to stand up, rise up (Genesis 4:8; the resurrection verb of the New Testament). \"Stand up\" so as not to share \"rise\" with ἀνατέλλω."))
  (sense set-up
    (gloss "set up" "sets up" "setting up")
    (why "Transitive: to make stand, set up (Genesis 9:9, ἀνίστημι τὴν διαθήκην μου, \"I set up my covenant\"). \"Set up\" because \"raise up\" is ἐξανίστημι's and \"establish\" is ἵστημι's (Genesis 6:18; 9:11 στήσω). The New Testament's transitive \"raise up\" (Acts 2:24) may need its own sense.")))

(lemma "ἀνοίγω" (sense open (gloss "open" "opened" "opens" "opening") (why "To open (Genesis 7:11, the floodgates of heaven were opened; 8:6, Noah opened the window; Matthew 7:7). The plain word for opening; it shares \"open\" with the compound διανοίγω (Genesis 3:5), which the readable layer may render \"open fully\" where the difference matters.")))

(lemma "ἀνομέω" (sense act-lawlessly (intransitive) (verb "act lawlessly" "acted lawlessly" "acted lawlessly") (gloss "act lawlessly" "acted lawlessly" "acts lawlessly" "acting lawlessly") (why "(LXX, supplied.) To act lawlessly, break the law (Exodus 32:7, ἠνόμησεν γὰρ ὁ λαός σου, the golden calf). The verb of ἀνομία \"lawlessness\" and ἄνομος, so \"act lawlessly\".")))

(lemma "ἀνομία" (sense lawlessness (gloss "lawlessness" "lawlessnesses") (why "Lawlessness, the state of being without law (ἀ- + νόμος): Genesis 19:15 ταῖς ἀνομίαις τῆς πόλεως; Matthew 7:23; 1 John 3:4. The plural, \"lawlessnesses\", is kept as the Greek has it.")))

(lemma "ἀνταποδίδωμι" (sense pay-back (verb "pay back" "paid back" "paid back") (gloss "pay back" "paid back" "pays back" "paying back") (why "(LXX form supplied.) To give back in return, repay in kind (Genesis 44:4 ἀνταπεδώκατέ μοι πονηρὰ ἀντὶ καλῶν, \"you paid back to me bad [things] in place of good\"; Luke 14:14; Romans 12:19). \"Pay back\" keeps it apart from ἀποδίδωμι \"give back, repay\".")))

(lemma "ἀνταπόδομα" (sense repayment (gloss "repayment" "repayments") (why "(LXX form supplied.) A return, requital (Genesis 50:15 ἀνταπόδομα ἀνταποδῷ, \"pay back repayment\"; Luke 14:12; Romans 11:9). The noun of ἀνταποδίδωμι \"pay back\".")))

(lemma "ἀνταποθνῄσκω" (sense die-in-return (intransitive) (verb "die in return" "died in return" "died in return") (gloss "die in return" "died in return" "dies in return" "dying in return") (why "(LXX, supplied.) To die in return, be put to death for a death caused (Exodus 22:3, the thief killed after sunrise: ἔνοχός ἐστιν, ἀνταποθανεῖται). From ἀντί + ἀποθνῄσκω \"die\".")))

(lemma "ἀντί"
  (sense in-place-of
    (gloss "in place of")
    (why "(Supplied in Genesis 2:21, where it is elided ἀντ’.) Substitution: \"in place of\" (Matthew 2:22; 20:28, a ransom in place of many). \"Instead of\" would serve equally; one phrase is chosen and kept.")))

(lemma "ἀντίκειμαι" (sense oppose (dative "") (gloss "oppose" "opposed" "opposes" "opposing") (why "To lie against, be opposed to, with the dative (Exodus 23:22 ἀντικείσομαι τοῖς ἀντικειμένοις σοι, \"I will oppose the [ones] opposing you\"; Luke 13:17; 21:15; Galatians 5:17).")))

(lemma "ἀντιλαμβάνω" (sense lay-hold (genitive "of") (verb "lay hold" "laid hold" "laid hold") (gloss "lay hold" "laid hold" "lays hold" "laying hold") (why "Middle, with the genitive: to take hold of, lay hold of (Genesis 48:17, Joseph laid hold of his father's hand; Luke 1:54; Acts 20:35, \"help\"). \"Lay hold\" keeps it apart from ἐπιλαμβάνω \"take hold\". The sense \"help\" may become its own.")))

(lemma "ἀντιλογία" (sense contention (gloss "contention" "contentions") (why "(LXX form supplied.) Speaking against, a dispute brought for judgment (Exodus 18:16, ὅταν γένηται αὐτοῖς ἀντιλογία, the cases brought to Moses; Hebrews 6:16; Jude 11). \"Contention\" because \"dispute\" is κρίνω's middle sense.")))

(lemma "ἀντιλέγω"(sense speak-against(gloss "speak against" "spoke against" "spoken against" "speaks against" "speaking against") (why "To speak against, contradict (Luke 2:34; John 19:12). The table lemmatizes the aorist ἀντειπεῖν under it (Genesis 24:50; Acts 4:14)."))
  (sense reply (gloss "reply" "replied" "replies" "replying") (why "(LXX sense, supplied.) The future ἀντερῶ, \"I will say back, reply\" (Genesis 44:16 Τί ἀντεροῦμεν τῷ κυρίῳ; \"What will we reply to the lord?\"), Judah with no defense to make, not contradicting. Chosen in the form row for ἀντεροῦμεν.")))

(lemma "ἀντιπίπτω" (sense fall-opposite (intransitive) (verb "fall opposite" "fell opposite" "fallen opposite") (gloss "fall opposite" "fell opposite" "fallen opposite" "falls opposite" "falling opposite") (why "To fall against, lie over against: the loops of two curtains facing one another (Exodus 26:5, ἀντιπρόσωποι ἀντιπίπτουσαι ἀλλήλαις) and the two little elbows of a column (26:17). The New Testament's resisting (Acts 7:51, ἀντιπίπτετε, falling against the Spirit) will be its own sense.")))

(lemma "ἀντιπρόσωπος" (sense face-to-face (gloss "face to face") (why "(LXX, supplied.) Facing, set opposite (ἀντί + πρόσωπον \"face\"): Genesis 15:10, the halves set \"face to face to one another\". Not \"facing\", which ἀπέναντι has.")))

(lemma "ἀντλέω" (sense draw (gloss "draw" "drew" "drawn" "draws" "drawing") (why "To draw water (Genesis 24:13, 20; John 2:8-9; 4:7, 15). Kept apart from ὑδρεύομαι \"fetch water\".")))

(lemma "ἀνυπομόνητος" (sense unendurable (gloss "unendurable") (why "(LXX, supplied.) Not to be endured, unbearable (ἀ- + ὑπομένω; Exodus 18:18, φθορᾷ ... ἀνυπομονήτῳ, Jethro on Moses judging alone).")))

(lemma "ἄνω" (sense above (gloss "above") (why "Above (Exodus 20:4; John 8:23).")))

(lemma "ἄνωθεν" (sense from-above (gloss "from above") (why "From above, from the top (Genesis 6:16; John 3:31; 19:23). The sense \"again, anew\" (John 3:3) will be discussed when John is translated.")))

(lemma "ἄξιος" (sense worthy (gloss "worthy") (why "Worthy, of full value (Genesis 23:9, ἀργυρίου τοῦ ἀξίου, \"for the worthy silver\", the full price; Matthew 10:10; Luke 15:19).")))

(lemma "ἀξιόω" (sense deem-worthy (verb "deem worthy" "deemed worthy" "deemed worthy") (gloss "deem worthy" "deemed worthy" "deems worthy" "deeming worthy") (why "To count worthy (Genesis 31:28 οὐκ ἠξιώθην καταφιλῆσαι, \"I was not deemed worthy to kiss\"; Luke 7:7; 2 Thessalonians 1:11). The verb of ἄξιος.")))

(lemma "ἀξίωμα" (sense assessment (gloss "assessment" "assessments") (why "(LXX, supplied.) What is reckoned fit (ἀξιόω \"deem worthy\"), a valuation or an assessed amount (Exodus 21:22, δώσει μετὰ ἀξιώματος, the fine paid \"with assessment\").")))

(lemma "ἄξων"(sense axle (gloss "axle" "axles") (why "(LXX, supplied.) The axle of a wheel (Exodus 14:25, συνέδησεν τοὺς ἄξονας τῶν ἁρμάτων αὐτῶν).")))

(lemma "ἀορασία" (sense blindness (dative "with") (gloss "blindness") (why "(LXX, supplied.) Blindness, inability to see (ἀ- + ὁράω): Genesis 19:11 ἐπάταξαν ἀορασίᾳ, struck with blindness. The dative is instrumental, \"with blindness\".")))

(lemma "ἀόρατος"
  (sense invisible
    (gloss "invisible")
    (why "(Supplied in Genesis 1:2.) Unseen, invisible. Same gloss as Colossians 1:15-16 (\"the image of the invisible God\") and Romans 1:20, so the Greek link between the invisible earth of Genesis 1:2 and the New Testament's invisible things stays visible.")))

(lemma "ἀπαγγέλλω" (sense report (gloss "report" "reported" "reports" "reporting") (why "To bring back word, report, tell (Genesis 12:18; Matthew 2:8; Luke 7:22). \"Report\" keeps it apart from ἀναγγέλλω \"declare\" and λέγω \"say\".")))

(lemma "ἀπάγω" (sense lead-away (verb "lead away" "led away" "led away") (gloss "lead away" "led away" "leads away" "leading away") (why "To lead away, take off under guard (Genesis 39:22 τοὺς ἀπηγμένους, the prisoners led away; 40:3; Mark 14:44, 53; Acts 12:19). \"Lead away\" keeps the ἀπο- and apart from ἄγω.")))

(lemma "ἀπαίρω" (sense depart (gloss "depart" "departed" "departs" "departing") (why "(LXX sense, supplied.) Intransitive in the Septuagint: to lift off, break camp, depart (Genesis 12:9). The New Testament has only the passive \"be taken away\" (Mark 2:20), which would be its own sense.")))

(lemma "ἀπαλείφω" (sense wipe-out (gloss "wipe out" "wiped out" "wipes out" "wiping out") (why "(LXX, supplied.) To wipe off, wipe out (Genesis 6:7; 7:4, of the flood). Kept apart from ἐξαλείφω (Acts 3:19), which will need its own English.")))

(lemma "ἀπαλλάσσω" (sense be-rid (verb "be rid" "was rid" "been rid") (intransitive) (gloss "be rid" "was rid" "is rid" "been rid" "being rid") (why "(LXX, supplied.) To set free, remove, and intransitively to be quit of, be rid, depart (Exodus 19:22, μή ποτε ἀπαλλάξῃ ἀπ’ αὐτῶν Κύριος, \"lest the Lord be rid from them\"; the sense there, whether the Lord withdraws or does away with some of them, is uncertain; Luke 12:58, Hebrews 2:15, \"set free\", will be its own sense). Kept apart from ἀφίστημι \"withdraw\" and ἀφαιρέω \"remove\".")))

(lemma "ἁπαλός"(sense tender (comparative "more tender") (gloss "tender") (why "Soft, tender (Genesis 27:9, two tender kids; Matthew 24:32, the branch becomes tender). (LXX form supplied.)")))

(lemma "ἀπαντάω" (sense meet (dative "") (gloss "meet" "met" "meets" "meeting") (why "To meet, come upon, with the dative (Genesis 28:11 ἀπήντησεν τόπῳ, \"met [a] place\", came upon it; Mark 14:13). (LXX form supplied.)")))

(lemma "ἀπαρχή" (sense firstfruit (gloss "firstfruit" "firstfruits") (why "The first part taken off, firstfruits (Romans 8:23; 1 Corinthians 15:20), and so an offering set apart: Exodus 25:2-3, the gifts for the tent, λάβετε ἀπαρχάς. \"Firstfruit\" kept in both uses so the word stays recognizable.")))

(lemma "ἅπαξ" (sense once (gloss "once") (why "Once, a single time (Genesis 18:32 ἔτι ἅπαξ \"yet once\", as Hebrews 12:26-27; 9:7).")))

(lemma "ἅπας" (sense entire (gloss "entire") (why "All, the whole, a stronger πᾶς (Genesis 19:4 ἅπας ὁ λαός; Luke 3:21; Acts 2:44). \"Entire\" because πᾶς has \"all\".")))

(lemma "ἀπατάω"
  (sense deceive
    (gloss "deceive" "deceived" "deceives" "deceiving")
    (why "(Supplied in Genesis 3:13.) To deceive (1 Timothy 2:14; Ephesians 5:6). The compound ἐξαπατάω (2 Corinthians 11:3, retelling Genesis 3:13) will need its own gloss, such as \"deceive thoroughly\", so the difference shows.")))

(lemma "ἀπειθέω" (sense disobey (dative "") (gloss "disobey" "disobeyed" "disobeys" "disobeying") (why "To refuse to be persuaded, disobey, with the dative (Exodus 23:21 μὴ ἀπείθει αὐτῷ, of the angel; John 3:36; Romans 2:8; 1 Peter 2:8).")))

(lemma "ἀπειλέω" (sense threaten (dative "") (gloss "threaten" "threatened" "threatens" "threatening") (why "To threaten (Genesis 27:42 ἀπειλεῖ σοι τοῦ ἀποκτεῖναί σε; Acts 4:17; 1 Peter 2:23). (LXX form supplied.)")))

(lemma "ἄπειμι (II)" (sense move-away (intransitive) (gloss "move away" "moved away" "moves away" "moving away") (why "To go away, depart, from εἶμι \"go\" (Exodus 33:8, ἀπιόντος Μωσῆ, Moses going off to the tent; Acts 17:10 ἀπῄεσαν). Lemma spelled as the New Testament table spells it, apart from ἄπειμι \"be absent\" (from εἰμί). \"Move away\" because \"go away\" is ἀπέρχομαι's, \"go off\" ἀποίχομαι's and \"depart\" ἀπαίρω's.")))

(lemma "ἀπέναντι"
  (sense facing
    (gloss "facing")
    (why "Over against, facing (Matthew 27:61, sitting facing the tomb). Kept apart from κατέναντι \"opposite\" (Genesis 2:14) so the two prepositions are distinguishable in English.")))

(lemma "ἀπερίτμητος" (sense uncircumcised (gloss "uncircumcised") (why "(LXX, supplied.) Not circumcised (Genesis 17:14; Acts 7:51). Negative of περιτέμνω \"circumcise\", whose English it keeps.")))

(lemma "ἀπέρχομαι"
  (sense go-away
    (gloss "go away" "goes away" "going away" "went away" "gone away")
    (why "(Supplied in Genesis 3:19.) To go away, depart. \"Go away\" keeps the ἀπο- of the compound against πορεύομαι \"go\".")))

(lemma "ἀπέχω"
  (sense have-in-full (verb "have in full" "had in full" "had in full") (gloss "have in full" "had in full" "has in full" "having in full") (why "(LXX form supplied.) Transitive: to have received in full, have paid (Genesis 43:23 τὸ δὲ ἀργύριον ὑμῶν εὐδοκιμοῦν ἀπέχω, \"but your silver, being approved, I have in full\"; Matthew 6:2, they have their reward in full; Philippians 4:18)."))
  (sense be-distant (verb "be distant" "was distant" "been distant") (gloss "be distant" "is distant" "was distant" "were distant" "been distant" "being distant" "were not distant" "was not distant") (why "(LXX, supplied.) Intransitive: to be away, be distant (Genesis 44:4 οὐκ ἀπέσχον μακράν, \"they were not distant far off\"; Luke 7:6; 15:20). Chosen in the form row for ἀπέσχον.")))

(lemma "ἀπηλιώτης" (sense east-wind (gloss "east wind" "east winds") (why "(LXX, supplied.) The wind from the sunrise (ἀπὸ ἡλίου), and so the east as a quarter: the side of the court τῷ πρὸς ἀπηλιώτην, \"toward east wind\" (Exodus 27:11; 38). Kept apart from ἀνατολή \"east\" (the rising) and from νότος \"south\", βορρᾶς \"north\", λίψ \"southwest\", θάλασσα \"sea\" (west).")))

(lemma "ἄπλαστος" (sense plain (gloss "plain") (why "(LXX, supplied.) Literally \"unmolded\", not shaped or put on: simple, plain, without guile. Genesis 25:27, Jacob \"plain human dwelling [a] house\", over against Esau the hunter. \"Plain\" is an adjective; πεδίον has the noun \"plain\", a different part of speech.")))

(lemma "ἀπό"
  (sense from
    (gloss "from")
    (why "Separation or source: \"from\". Partitive uses (\"from every tree\", \"of\") keep \"from\" in the literal layer.")))

(lemma "ἀποβαίνω" (sense turn-out (intransitive) (verb "turn out" "turned out" "turned out") (gloss "turn out" "turned out" "turns out" "turning out") (why "To step off, and so to come out, result, turn out (Exodus 2:4 μαθεῖν τί τὸ ἀποβησόμενον αὐτῷ, to learn what would turn out for him; Luke 21:13; Philippians 1:19). Kept apart from στρέφω \"turn\".")))

(lemma "ἀπογαλακτίζω" (sense wean (gloss "wean" "weaned" "weans" "weaning") (why "(LXX, supplied.) To wean a child from milk (γάλα): Genesis 21:8.")))

(lemma "ἀποδιδράσκω" (sense run-away (intransitive) (gloss "run away" "ran away" "runs away" "running away") (why "(LXX, supplied.) To run away, flee from a master (Genesis 16:6, 8, Hagar from Sarai). Kept apart from φεύγω \"flee\".")))

(lemma "ἀποδεκατόω" (sense tithe (gloss "tithe" "tithed" "tithes" "tithing") (why "To give or take the tenth, tithe (Genesis 28:22 δεκάτην ἀποδεκατώσω, \"[a] tenth I will tithe\"; Matthew 23:23; Luke 18:12). (LXX form supplied.)")))

(lemma "ἀποδίδωμι" (sense repay (verb "repay" "repaid" "repaid") (gloss "repay" "repaid" "repays" "repaying") (why "To give back, repay, render (Exodus 20:5; Romans 12:17)."))
  (sense give-back (verb "give back" "gave back" "given back") (gloss "give back" "gave back" "given back" "gives back" "giving back") (why "To give back what was taken, restore (Genesis 20:7 ἀπόδος τὴν γυναῖκα, 20:14 ἀπέδωκεν αὐτῷ Σάρραν; Luke 4:20, the scroll given back). \"Repay\" would say a debt was paid."))
  (sense sell (gloss "sell" "sold" "sells" "selling") (why "The middle, \"give away for oneself\", is \"sell\" (Genesis 25:31, 33, Esau sold the birthright; Acts 5:8; Hebrews 12:16 quotes it). The form rows choose this sense for the middle.")))

(lemma "ἀποθήκη" (sense storehouse (gloss "storehouse" "storehouses") (why "A place where things are put away, storehouse, barn (Exodus 16:23, 32, the manna kept εἰς ἀποθήκην, \"for storehouse\"; Matthew 3:12; Luke 12:18). \"Storehouse\" for the storing; the New Testament's barn is the same word.")))

(lemma "ἀποθνῄσκω"
  (sense die
    (intransitive)
    (gloss "die" "died" "dies" "dying")
    (why "To die. θανάτῳ ἀποθανεῖσθε (Genesis 2:17; 3:4) is \"by death you will die\" in the literal layer.")))

(lemma "ἀποίχομαι" (sense go-off (verb "go off" "went off" "gone off") (gloss "go off" "went off" "gone off" "goes off" "going off") (why "(LXX, supplied.) To be gone, go off (Genesis 14:12, the kings took Lot and were going off). \"Go off\" keeps it apart from ἀπέρχομαι \"go away\" and ἀπαίρω \"depart\".")))

(lemma "ἀποκαθίστημι" (sense restore (gloss "restore" "restored" "restores" "restoring") (why "To restore, give back (Matthew 12:13; Acts 1:6); in Genesis 23:16 of paying over the silver to Ephron. Swete's ἀπεκατέστησεν has the double augment."))
  (sense be-restored (intransitive) (verb "be restored" "was restored" "been restored") (gloss "be restored" "was restored" "been restored" "is restored" "being restored") (why "(LXX, supplied.) The intransitive second aorist ἀπεκατέστη: to be restored, return to a former state (Exodus 4:7, Moses' hand restored to the color of its flesh; Mark 8:25 ἀπεκατέστη, the blind man restored). Active Greek, but English \"restored\" with no object reads as if the hand restored something; \"was restored\" says what the Greek says. Chosen by the form row.")))

(lemma "ἀποκαλύπτω" (sense uncover (gloss "uncover" "uncovered" "uncovers" "uncovering") (why "To uncover, reveal. \"Uncover\" for the literal sense (Exodus 20:26); \"reveal\" becomes its own sense for revelation (Matthew 11:25).")))

(lemma "ἀπόκειμαι" (sense lie-in-store (verb "lie in store" "lay in store" "lain in store") (gloss "lie in store" "lay in store" "lain in store" "lies in store" "lying in store") (why "(LXX form supplied.) To be laid away, kept in store (Genesis 49:10 ἕως ἂν ἔλθῃ τὰ ἀποκείμενα αὐτῷ; Colossians 1:5; 2 Timothy 4:8; Hebrews 9:27).")))

(lemma "ἀποκλείω" (sense shut-off (verb "shut off" "shut off" "shut off") (gloss "shut off" "shuts off" "shutting off") (why "To shut, close off (Genesis 19:10 τὴν θύραν ... ἀπέκλεισαν; Luke 13:25, the master shuts the door). \"Shut off\" keeps the ἀπο- of the compound against κλείω \"shut\" and συγκλείω.")))

(lemma "ἀποκρίνομαι" (sense answer (gloss "answer" "answered" "answers" "answering") (why "To answer, reply (Genesis 18:9, 27 ὁ δὲ ἀποκριθεὶς εἶπεν; very often in the Gospels). The passive-deponent aorist is rendered active.")))

(lemma "ἀποκτείνω" (sense kill (gloss "kill" "killed" "kills" "killing") (why "To kill.")))

(lemma "ἀποκυλίω" (sense roll-away (verb "roll away" "rolled away" "rolled away") (gloss "roll away" "rolled away" "rolls away" "rolling away") (why "To roll away, roll off (Genesis 29:3, 8, 10, the stone from the mouth of the well; Matthew 28:2; Mark 16:3-4).")))

(lemma "ἀπολείπω" (sense fall-short (verb "fall short" "fell short" "fallen short") (gloss "fall short" "fell short" "fallen short" "falls short" "falling short") (why "To leave behind, leave off; of a set task, to fall short of it (Exodus 5:19 Οὐκ ἀπολείψετε τῆς πλινθίας, \"You will not fall short of the brickwork\", the genitive of the part). The New Testament's \"remain\" (Hebrews 4:6, 9 ἀπολείπεται) and \"leave behind\" (2 Timothy 4:13, 20) become senses of their own when needed."))
  (sense leave-over (verb "leave over" "left over" "left over") (gloss "leave over" "left over" "leaves over" "leaving over") (why "To leave over, leave remaining; the future middle used as a passive in Exodus 12:10 οὐκ ἀπολείψεται ἀπ’ αὐτοῦ ἕως πρωί, \"[anything] will not be left over from it until morning\", the Passover meat. \"Leave over\" keeps it apart from καταλείπω \"leave\" and ὑπολείπω \"leave behind\".")))

(lemma "ἀπολιθόω" (sense petrify (gloss "petrify" "petrified" "petrifies" "petrifying") (why "(LXX, supplied.) To turn to stone, petrify (Exodus 15:16 ἀπολιθωθήτωσαν, \"let them be petrified\", the nations struck motionless with fear); from λίθος \"stone\".")))

(lemma "ἀπόλλυμι" (sense destroy (gloss "destroy" "destroyed" "destroys" "destroying") (why "Active: to destroy (Genesis 18:24-32, ἀπολεῖς, οὐ μὴ ἀπολέσω; Matthew 10:28). The middle \"perish\" (Luke 13:3) and \"lose\" (Luke 15:4) will be their own senses."))
  (sense perish (intransitive) (gloss "perish" "perished" "perishes" "perishing") (why "The middle and the second perfect ἀπόλωλα: to perish, be lost (Exodus 10:7 ἀπόλωλεν Αἴγυπτος, \"Egypt has perished\"; Luke 13:3; 15:24). \"Perish\" because the active \"destroy\" would make Egypt the destroyer.")))

(lemma "ἀποπεμπτόω" (sense pay-fifth (verb "pay fifth" "paid fifth" "paid fifth") (gloss "pay fifth" "paid fifth" "pays fifth" "paying fifth") (why "(LXX, supplied.) To pay one fifth (πέμπτος) of the produce as a levy: Genesis 47:26, Joseph's decree that the land of Egypt pay [the] fifth to Pharaoh. \"Pay fifth\" keeps the numeral visible, as ἀποδεκατόω is \"tithe\".")))

(lemma "ἀπορρίπτω" (sense throw-away (verb "throw away" "threw away" "thrown away") (gloss "throw away" "threw away" "thrown away" "throws away" "throwing away") (why "To throw off, throw away (Exodus 22:31 τῷ κυνὶ ἀπορίψατε αὐτό, Swete's spelling with one ρ; Acts 27:43, of those who threw themselves overboard). Kept apart from ῥίπτω, the simple verb.")))

(lemma "ἀποσάσσω"(sense unload (gloss "unload" "unloaded" "unloads" "unloading") (why "(LXX, supplied.) To unpack, unload a beast (Genesis 24:32, ἀπέσαξεν τὰς καμήλους). ἀπέσαξεν may also be referred to the Attic spelling ἀποσάττω.")))

(lemma "ἀποσκευή" (sense baggage (gloss "baggage") (why "(LXX, supplied.) Baggage, movable goods, household (Genesis 14:12, Lot and his baggage; Acts 21:15 has the verb ἀποσκευάζομαι).")))

(lemma "ἀποσκηνόω" (sense decamp (gloss "decamp" "decamped" "decamps" "decamping") (why "(LXX, supplied.) To strike one's tent and move off (Genesis 13:18), from σκηνή \"tent\". \"Decamp\" keeps it apart from ἀπαίρω \"depart\" and σκηνόω \"tent\".")))

(lemma "ἀπολυτρόω" (sense ransom-off (verb "ransom off" "ransomed off" "ransomed off") (gloss "ransom off" "ransomed off" "ransoms off" "ransoming off") (why "(LXX, supplied.) To release on payment of a ransom (λύτρον), let be redeemed (Exodus 21:8, the slave girl her master does not please: ἀπολυτρώσει αὐτήν). \"Ransom off\" keeps it apart from ἀπολύω \"release\"; the noun λύτρον is \"ransom\".")))

(lemma "ἀπολύω"(sense release (gloss "release" "released" "releases" "releasing") (why "To release, let go, send away (Matthew 27:15; Luke 2:29, \"now you release your slave ... in peace\", of dying). Genesis 15:2 ἀπολύομαι ἄτεκνος, \"I am released childless\": I depart this life without children.")))

(lemma "ἀπορέω" (sense be-perplexed (verb "be perplexed" "was perplexed" "been perplexed") (gloss "be perplexed" "was perplexed" "were perplexed" "is perplexed" "been perplexed" "being perplexed") (why "To be at a loss, perplexed (Genesis 32:7 ἠπορεῖτο, Jacob hearing of Esau's four hundred men; Mark 6:20; John 13:22; 2 Corinthians 4:8). The middle is rendered active.")))

(lemma "ἀποστέλλω" (sense send (verb "send" "sent" "sent") (gloss "send" "sent" "sends" "sending") (why "To send, send off (Genesis 8:7-8, Noah sent the raven and the dove; John 3:17). \"Send\", kept apart from ἐξαποστέλλω \"send out\" (Genesis 3:23; 8:10).")))

(lemma "ἀποστερέω" (sense defraud (gloss "defraud" "defrauded" "defrauds" "defrauding") (why "To rob, withhold what is owed, defraud (Exodus 21:10, of a wife's food, clothing and company; Mark 10:19; 1 Corinthians 7:5). \"Defraud\" keeps it apart from στερέω \"deprive\". (LXX form supplied.)")))

(lemma "ἀποστρέφω"
  (sense turn-back
    (voice active)
    (gloss "turn back" "turns back" "turning back" "turned back")
    (why "(Supplied in Genesis 3:19.) To turn back, return; transitive \"turn away\" (Romans 11:26) will be its own sense. \"Turn back\" rather than \"return\" keeps the link with στρέφω \"turn\" and ἀποστροφή \"turning\" (Genesis 3:16).")))

(lemma "ἀποστροφή"
  (sense turning
    (gloss "turning")
    (why "(LXX, supplied.) A turning (away or back) to someone, recourse. Genesis 3:16 \"your turning [is] to your man\", where translations from the Hebrew have \"desire\". Same root as ἀποστρέφω (sense turn-back), as in Genesis 3:19.")))

(lemma "ἀποτείνω" (sense stretch-away (verb "stretch away" "stretched away" "stretched away") (gloss "stretch away" "stretched away" "stretches away" "stretching away") (why "(LXX, supplied.) To stretch out away, extend at length (Exodus 8:28 οὐ μακρὰν ἀποτενεῖτε πορευθῆναι, Pharaoh's \"you will not stretch away far to go\"). \"Stretch away\" keeps it apart from ἐκτείνω \"stretch out\" and παρατείνω \"extend\".")))

(lemma "ἀποτίθημι" (sense put-away (verb "put away" "put away" "put away") (gloss "put away" "puts away" "putting away") (why "To put away, lay aside, store (Exodus 16:33-34, Aaron put away the jar of manna before God; Romans 13:12 and Ephesians 4:22, putting away the works of darkness). \"Put away\" against τίθημι \"put\".")))

(lemma "ἀποτίνω" (sense make-good (verb "make good" "made good" "made good") (gloss "make good" "made good" "makes good" "making good") (why "To pay what is owed, make good a loss (Genesis 31:39 ἐγὼ ἀπετίννυον ἀπ’ ἐμαυτοῦ, from the -νυμι form ἀποτιννύω; Philemon 19 ἐγὼ ἀποτίσω). \"Make good\" because \"repay\" is ἀποδίδωμι's and \"pay back\" ἀνταποδίδωμι's.")))

(lemma "ἀποτρέχω" (sense run-off (gloss "run off" "ran off" "runs off" "running off") (why "(LXX, supplied.) To run off, go away (Genesis 12:19, Pharaoh to Abram: \"having taken, run off\"). \"Run off\" keeps the run of τρέχω and leaves \"go away\" to ἀπέρχομαι.")))

(lemma "ἅπτω"
  (sense touch
    (genitive "")
    (gloss "touch" "touched" "touches" "touching")
    (why "(Supplied in Genesis 3:3.) Middle: to touch, take hold of (Matthew 8:3; John 20:17). The active \"kindle\" (Luke 8:16) becomes its own sense.")))

(lemma "ἀπώλεια" (sense loss (gloss "loss" "losses") (why "Loss, ruin, destruction (Exodus 22:9 πάσης ἀπωλίας τῆς ἐνκαλουμένης, any loss charged, Swete's spelling ἀπωλία; Matthew 7:13; 26:8 \"waste\"; Philippians 3:19). \"Loss\" for the property law here; \"destruction\" is kept free for ὄλεθρος.")))

(lemma "ἀρά" (sense imprecation (gloss "imprecation" "imprecations") (why "A prayer calling down harm, a curse sworn into an oath (Genesis 26:28, the sworn pact between Abimelech and Isaac; Romans 3:14, quoting Psalm 9:28 LXX). \"Imprecation\" keeps it apart from καταράομαι \"curse\" and κατάρα.")))

(lemma "ἄρα" (sense then (gloss "then") (why "The inferential particle, \"then, so then\" (Genesis 18:3 εἰ ἄρα εὗρον χάριν \"if then I found grace\"; Matthew 12:28; Romans 8:1). Kept apart from οὖν \"therefore\" and τότε.")))

(lemma "ἆρα" (sense is-it (gloss "is it") (why "(LXX, supplied.) The interrogative particle (Genesis 18:13 Ἆρά γε ἀληθῶς τέξομαι; Luke 18:8; Acts 8:30), which marks a question, often doubtful. English has no particle for it; \"is it\" renders it as a word so it is not lost, and is kept apart from ἄρα \"then\". The owner may prefer another rendering.")))

(lemma "Ἀραβία" (sense name (gloss "Arabia") (why "Arabia (Galatians 1:17; 4:25). In Genesis 45:10 and 46:34 the Septuagint calls the land of Goshen Γέσεμ Ἀραβίας, \"Goshen of Arabia\".")))

(lemma "Ἄραδ" (sense name (gloss "Ard") (why "(LXX, supplied.) A son of Gera in Benjamin's line (Genesis 46:21), Greek Ἄραδ, standing where the Hebrew has Ard; traditional English Ard.")))

(lemma "Ἀρβόκ" (sense name (gloss "Arba") (why "(LXX, supplied.) ἐν πόλει Ἀρβόκ (Genesis 23:2) renders the Hebrew Kiriath-arba, \"city of Arba\": πόλει translates Kiriath, and Ἀρβόκ is the name Arba with a final κ. Traditional English Arba (Joshua 14:15), the spelling difference being small (rule 8); the owner may prefer Arbok.")))

(lemma "Ἀράδιος" (sense name (gloss "Arvadite" "Arvadites") (why "(LXX, supplied.) The people of Arvad, descended from Canaan (Genesis 10:18), Greek Ἀράδιος; traditional English Arvadite.")))

(lemma "Ἁράθ" (sense name (gloss "Hadar") (why "(LXX, supplied.) The last king of Edom in the list (Genesis 36:39); the Greek Ἁράθ is a variant spelling of the Hebrew Hadar, so the traditional English Hadar (rule 8).")))

(lemma "Ἀράμ"(sense name (gloss "Aram") (why "(Name supplied for the Septuagint.) Shem's son (Genesis 10:22-23), traditional English Aram. The New Testament table's Ἀράμ (Matthew 1:3-4) is another man, the Ram of Ruth 4:19.")))

(lemma "Ἀραράτ" (sense name (gloss "Ararat") (why "(LXX, supplied.) Genesis 8:4, τὰ ὄρη τὰ Ἀραράτ, the mountains of Ararat, where the ark settled; indeclinable. Greek and traditional English agree.")))

(lemma "ἀργία" (sense idleness (gloss "idleness") (why "(LXX, supplied.) Idleness, time lost from work (ἀ- + ἔργον; Exodus 21:19, the striker pays for the injured man's idleness).")))

(lemma "ἀργύριον"(sense silver (gloss "silver") (why "Silver, as metal and as money (Genesis 13:2, rich in silver and gold; Matthew 25:18; Acts 3:6). It shares \"silver\" with the adjective ἀργυροῦς \"of silver\"; a sense \"money\" (Matthew 28:12) may be added where the coins are meant.")))

(lemma "ἄργυρος" (sense silver (gloss "silver") (why "Silver as a metal (Exodus 27:11, the clasps and bands περιηργυρωμέναι ἀργύρῳ, \"silvered around with silver\"; Matthew 10:9; Acts 17:29; James 5:3). It shares \"silver\" with ἀργύριον (silver, money) and the adjective ἀργυροῦς: one metal; the alignment shows which Greek word stands behind it.")))

(lemma "ἀργυροῦς" (sense silver (gloss "silver") (why "Made of silver (Exodus 20:23; Acts 19:24).")))

(lemma "ἀργυρώνητος" (sense bought-with-silver (gloss "bought with silver") (why "(LXX, supplied.) Bought with silver (ἄργυρος + ὠνέομαι), of a purchased slave (Genesis 17:12-27, beside the οἰκογενής \"home-born\"). Spelled out so both parts of the compound show.")))

(lemma "ἀρέσκω" (sense please (dative "") (gloss "please" "pleased" "pleases" "pleasing") (why "To please, be pleasing to, with the dative (Genesis 19:8 καθὰ ἀρέσκῃ ὑμῖν; 20:15; Romans 15:1-3). The verb of ἀρεστός \"pleasing\".")))

(lemma "ἀρεστός"
  (sense pleasing
    (gloss "pleasing")
    (why "Pleasing, acceptable (John 8:29, the things pleasing to him). \"Pleasing\" against εὐάρεστος, which will take \"well-pleasing\".")))

(lemma "ἀρήν" (sense lamb (gloss "lamb" "lambs") (why "(LXX, supplied.) A lamb, young sheep (Genesis 30:32-35 φαιὸν ἐν τοῖς ἄρνασιν; Luke 10:3 ἄρνας). The English \"lamb\" is shared with ἀμνός (Genesis 30:40, the same flock): no other plain English word for a lamb fits, and the Greek shows which word stands.")))

(lemma "ἀριθμέω" (sense number (gloss "number" "numbered" "numbers" "numbering") (why "To number, count (Genesis 13:16; 14:14; Matthew 10:30, the hairs are numbered). Kept apart from ἐξαριθμέω \"count\".")))

(lemma "ἀριθμός" (sense number (gloss "number" "numbers") (why "A number (Genesis 34:30 ὀλιγοστός εἰμι ἐν ἀριθμῷ, \"I am fewest in number\"; John 6:10; Revelation 13:18). The noun shares the English \"number\" with its verb ἀριθμέω, as the Greek shares the root.")))

(lemma "ἀριστάω" (sense lunch (gloss "lunch" "lunched" "lunches" "lunching") (why "(LXX, supplied.) To take the first or midday meal, ἄριστον (Genesis 43:25 ἐκεῖ μέλλει ἀριστᾷν, at midday; John 21:12, 15; Luke 11:37). \"Lunch\" for the midday meal keeps it apart from δειπνέω \"dine\" (the evening meal) and ἐσθίω \"eat\".")))

(lemma "ἀριστερός" (sense left (gloss "left") (why "Left, the left hand or side (Genesis 13:9, εἰς ἀριστερά \"into left [parts]\"; 14:15; Matthew 6:3).")))

(lemma "ἀρκέω" (sense suffice (gloss "suffice" "sufficed" "suffices" "sufficing") (why "To be enough, suffice (Exodus 12:4 τὸ ἀρκοῦν αὐτῷ, \"the [thing] sufficing to him\", the share of the lamb each can eat; John 14:8; 2 Corinthians 12:9 Ἀρκεῖ σοι ἡ χάρις μου). \"Suffice\" keeps it apart from ἱκανός \"sufficient\".")))

(lemma "Ἀριώχ" (sense name (gloss "Arioch") (why "(LXX, supplied.) King of Ellasar (Genesis 14:1, 9); traditional English Arioch.")))

(lemma "ἅρμα" (sense chariot (gloss "chariot" "chariots") (why "A chariot (Genesis 41:43, Joseph in Pharaoh's second chariot; 46:29; Acts 8:28).")))

(lemma "ἀρνέομαι" (sense deny (gloss "deny" "denied" "denies" "denying") (why "To deny, disown (Genesis 18:15, Sarah denied; Matthew 26:70; Hebrews 11:24).")))

(lemma "Ἀροηδίς" (sense name (gloss "Arodi") (why "(LXX, supplied.) A son of Gad (Genesis 46:16), Greek Ἀροηδίς; traditional English Arodi.")))

(lemma "Ἀροηλείς" (sense name (gloss "Areli") (why "(LXX, supplied.) A son of Gad (Genesis 46:16), Greek Ἀροηλείς; traditional English Areli.")))

(lemma "ἀροτρίασις" (sense plowing (gloss "plowing") (why "(LXX, supplied.) Plowing, the working of the field (Genesis 45:6, five years with no plowing nor reaping).")))

(lemma "Ἀρουκαῖος" (sense name (person) (gloss "Arkite" "Arkites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:17), Greek Ἀρουκαῖος; traditional English Arkite.")))

(lemma "ἄρουρα" (sense plowland (gloss "plowland" "plowlands") (why "(LXX, supplied.) Tilled, arable land, a plowed field (Genesis 21:33 ἐφύτευσεν Ἀβραὰμ ἄρουραν), where the Hebrew has a tamarisk tree (ʾešel read differently). \"Plowland\" keeps it apart from ἀγρός \"field\".")))

(lemma "ἁρπάζω" (sense snatch (gloss "snatch" "snatched" "snatches" "snatching") (why "To seize, snatch away (Genesis 37:33 θηρίον ἥρπασεν τὸν Ἰωσήφ, \"beast snatched Joseph\"; John 10:12; 1 Thessalonians 4:17). Kept with ἅρπαξ \"ravenous\".")))

(lemma "ἀρραβών" (sense pledge (gloss "pledge" "pledges") (why "A pledge, a deposit given as security for a payment to come (Genesis 38:17-20, Judah's ring, necklace and staff left with Tamar; 2 Corinthians 1:22; 5:5; Ephesians 1:14).")))

(lemma "ἅρπαξ" (sense ravenous (gloss "ravenous") (why "(LXX form supplied.) Snatching, ravenous (Genesis 49:27 Βενιαμεὶν λύκος ἅρπαξ; Matthew 7:15 λύκοι ἅρπαγες \"ravenous wolves\"). As a noun, \"swindler\" (1 Corinthians 5:10), which will be its own sense.")))

(lemma "Ἁρράν" (sense name (gloss "Haran") (why "(LXX, supplied.) Terah's son, Lot's father (Genesis 11:26-31), traditional English Haran. It shares \"Haran\" with the city Χαρράν (Genesis 11:31), as English Bibles do; the Greek on hover tells them apart.")))

(lemma "ἀρσενικός" (sense male (gloss "male" "males") (why "(LXX, supplied.) Male, of the male sex; πᾶν ἀρσενικόν \"every male\" (Genesis 17:10-12). It shares \"male\" with ἄρσην, from which it is formed: English has no second word, and the alignment shows which Greek word stands behind it.")))

(lemma "ἄρσην"
  (sense male
    (gloss "male")
    (why "Male (Genesis 1:27; Matthew 19:4; Galatians 3:28). Against ἀνήρ \"man\".")))

(lemma "ἄρτος"
  (sense bread
    (gloss "bread" "breads")
    (why "Bread, a loaf; by extension food (Genesis 3:19). Kept as \"bread\" everywhere so \"our daily bread\" and \"you will eat your bread\" match.")))

(lemma "Ἀρφαξάδ" (sense name (gloss "Arpachshad") (why "Shem's son (Genesis 10:22-24; 11:10-13; Luke 3:36, KJV \"Arphaxad\"). The English follows the traditional Old Testament form Arpachshad, as Καινάν is \"Kenan\"; the Greek Arphaxad shows on hover, and whether to follow it is for the owner.")))

(lemma "Ἀρχάδ" (sense name (gloss "Accad") (why "(LXX, supplied.) A city of Nimrod's kingdom (Genesis 10:10), Greek Ἀρχάδ; traditional English Accad.")))

(lemma "ἀρχή"
  (sense beginning
    (gloss "beginning" "beginnings")
    (why "The start of time or of a thing, as in Genesis 1:1 (ἐν ἀρχῇ), which John 1:1 echoes word for word; one gloss in both keeps the echo visible. Also the head or source of a river (Genesis 2:10, \"four beginnings\")."))
  (sense rule
    (with-preposition "εἰς" for)
    (gloss "rule" "rules")
    (why "Rule, dominion, and (plural) rulers or powers: Genesis 1:16 εἰς ἀρχὰς τῆς ἡμέρας, \"for rules of the day\"; Luke 12:11; Ephesians 1:21; Colossians 1:16. Same English root as ἄρχω (sense rule)."))
  (sense office (gloss "office" "offices") (why "A post held under a ruler, office (Genesis 40:13, 20-21; 41:13, the cupbearer restored to his office; Jude 6, the angels who did not keep their own ἀρχήν). Chosen by word override.")))

(lemma "ἀρχηγός" (sense leader (person) (gloss "leader" "leaders") (why "One who goes first, a head of a family or people (Exodus 6:14 ἀρχηγοὶ οἴκων πατριῶν αὐτῶν, \"leaders of houses of their families\"); of Jesus in Acts 3:15; 5:31; Hebrews 2:10; 12:2. \"Leader\" keeps it apart from ἡγεμών \"chief\".")))

(lemma "ἀρχιδεσμοφύλαξ" (sense chief-jailer (person) (gloss "chief jailer" "chief jailers") (why "(LXX, supplied.) The chief keeper of prisoners (Genesis 39:21-23; 40:3). ἀρχι- \"chief\" with δεσμοφύλαξ, the jailer of Acts 16:23, 27, 36.")))

(lemma "ἀρχιδεσμώτης" (sense chief-prisoner (person) (gloss "chief prisoner" "chief prisoners") (why "(LXX, supplied.) Chief of the prisoners (δεσμώτης \"prisoner\"). Swete prints it in Genesis 40:4 where the verses around have ἀρχιδεσμοφύλαξ \"chief jailer\"; it is rendered as printed.")))

(lemma "ἀρχιμάγειρος" (sense chief-cook (person) (gloss "chief cook" "chief cooks") (why "(LXX, supplied.) Chief cook, chief butcher (μάγειρος, a cook who slaughters), the title of Pharaoh's officer Potiphar (Genesis 37:36; 39:1; 41:10-12). The literal \"chief cook\" is kept; the readable layer may say \"captain of the guard\". \"Cook\" is also πέσσω's verb.")))

(lemma "ἀρχιοινοχοΐα" (sense chief-cupbearership (gloss "chief cupbearership") (why "(LXX, supplied.) The office of chief cupbearer (Genesis 40:13), the noun of ἀρχιοινοχόος.")))

(lemma "ἀρχιοινοχόος" (sense chief-cupbearer (person) (gloss "chief cupbearer" "chief cupbearers") (why "(LXX, supplied.) Chief cupbearer, chief of the wine-pourers (οἰνοχόος, from οἶνος and χέω), Pharaoh's officer (Genesis 40:1-23; 41:9).")))

(lemma "ἀρχισιτοποιός" (sense chief-baker (person) (gloss "chief baker" "chief bakers") (why "(LXX, supplied.) Chief baker, chief of the bread-makers (σιτοποιός \"baker\"), Pharaoh's officer (Genesis 40:1-22; 41:10).")))

(lemma "ἀρχιστράτηγος" (sense commander-in-chief (person) (gloss "commander-in-chief" "commanders-in-chief") (why "(LXX, supplied.) The chief general of an army (Genesis 21:22, 32; 26:26, Phicol, Abimelech's commander). One word, \"commander-in-chief\", for the compound ἀρχι- + στρατηγός.")))

(lemma "ἀρχιτεκτονέω" (sense architect (gloss "architect" "architected" "architects" "architecting") (why "(LXX, supplied.) To be master builder, to design and direct the work (Exodus 31:4 and 35:32 διανοεῖσθαι καὶ ἀρχιτεκτονῆσαι, of Bezalel; compare ἀρχιτέκτων, 1 Corinthians 3:10). The English verb \"architect\" is the Greek word; kept apart from διανοέομαι \"think through\" and τεκτονικός \"carpentry\".")))

(lemma "ἄρχω"
  (sense rule
    (genitive "over")
    (gloss "rule" "rules" "ruled" "ruling")
    (why "Active: to rule, govern (Genesis 1:16-28; Mark 10:42; Romans 15:12). With the genitive of what is ruled; the English \"over\" belongs to that noun's segment, like any case ending."))
  (sense begin
    (gloss "begin" "began" "begun" "begins" "beginning")
    (why "Middle: to begin (Genesis 2:3; Matthew 4:17, and very often in the Gospels).")))

(lemma "ἄρχων" (sense ruler (person) (gloss "ruler" "rulers") (why "A ruler, chief, official (Genesis 12:15, Pharaoh's officials; Matthew 9:18; John 3:1): the participle of ἄρχω used as a noun, so \"ruler\" beside ἄρχω \"rule\".")))

(lemma "ἀσάλευτος" (sense unshaken (gloss "unshaken") (why "Not shaken, immovable (Exodus 13:16, ἀσάλευτον πρὸ ὀφθαλμῶν σου, where the Hebrew has frontlets; Acts 27:41, the bow stuck fast; Hebrews 12:28, a kingdom not to be shaken). From σαλεύω, to shake.")))

(lemma "Ἁσαρμώθ" (sense name (gloss "Hazarmaveth") (why "(LXX, supplied.) A son of Joktan (Genesis 10:26), Greek Ἁσαρμώθ; traditional English Hazarmaveth.")))

(lemma "Ἁσασάν" (sense name (gloss "Hazazon") (why "(LXX, supplied.) Ἁσασὰν Θαμάρ (Genesis 14:7), Hazazon-tamar: two Greek words, each glossed; traditional English Hazazon.")))

(lemma "Ἀσβάν" (sense name (gloss "Eshban") (why "(LXX, supplied.) A son of Dishon (Genesis 36:26), Greek Ἀσβάν; traditional English Eshban.")))

(lemma "Ἀσβήλ" (sense name (gloss "Ashbel") (why "(LXX, supplied.) A son of Benjamin (Genesis 46:21), Greek Ἀσβήλ; traditional English Ashbel.")))

(lemma "ἀσεβής"(sense ungodly (person) (gloss "ungodly") (why "Without reverence for God, ungodly (Genesis 18:23, 25, the righteous against the ungodly; Romans 4:5; 5:6; 1 Peter 4:18). Against δίκαιος \"righteous\".")))

(lemma "Ἀσείρ" (sense name (gloss "Assir") (why "(LXX, supplied.) A son of Korah (Exodus 6:24), Greek Ἀσείρ; traditional English Assir.")))

(lemma "Ἁσενναῖος" (sense name (person) (gloss "Sinite" "Sinites") (why "(LXX, supplied.) A people descended from Canaan (Genesis 10:17), Greek Ἁσενναῖος; traditional English Sinite.")))

(lemma "Ἀσεννέθ" (sense name (gloss "Asenath") (why "(LXX, supplied.) Joseph's wife, daughter of Potiphera (Genesis 41:45, 50; 46:20), Greek Ἀσεννέθ; traditional English Asenath.")))

(lemma "ἄσημος" (sense unmarked (gloss "unmarked") (why "(LXX, supplied.) Without a mark, unmarked (Genesis 30:42, τὰ ἄσημα, the plain animals that became Laban's, against τὰ ἐπίσημα \"the marked\"). Acts 21:39 has it of a city, \"no mean\".")))

(lemma "ἄσηπτος" (sense unrotting (gloss "unrotting") (why "(LXX, supplied.) Not rotting, not decaying (from σήπω \"rot\"): the Septuagint's name for the acacia wood of the tabernacle, ξύλα ἄσηπτα (Exodus 25:5, 10, 13, 28; 26:15, 26, 32; 27:1, 6; 30:1, 5; 35:7, 24), where the Hebrew has shittim (acacia). Tabernacle term: always \"unrotting\"; the Greek gives a quality, not a tree name, and we translate the Greek. With ξύλον chosen as sense timber.")))

(lemma "Ἀσήρ" (sense name (gloss "Asher") (why "Jacob's son by Zilpah (Genesis 30:13, named from μακαρίζουσιν \"call happy\"); Luke 2:36 and Revelation 7:6 Ἀσήρ. Traditional English Asher.")))

(lemma "ἀσθενής" (sense weak (gloss "weak") (why "Without strength, weak (Genesis 29:17, Leah's eyes; Matthew 26:41; 1 Corinthians 1:25).")))

(lemma "Ἁσιήλ" (sense name (gloss "Jahzeel") (why "(LXX, supplied.) A son of Naphtali (Genesis 46:24), Greek Ἁσιήλ; traditional English Jahzeel.")))

(lemma "ἀσκός" (sense skin (gloss "skin" "skins") (why "(LXX, supplied as to this use.) A leather bottle, a skin for water or wine (Genesis 21:14-19; Matthew 9:17 \"wineskins\"). \"Skin\" says what it is made of.")))

(lemma "Ἀσσούρ" (sense name (gloss "Asshur") (why "(LXX, supplied.) Genesis 10:11, who went out from Shinar and built Nineveh, and 10:22, Shem's son; traditional English Asshur. Against Ἀσσύριος \"Assyrian\".")))

(lemma "Ἁσόμ" (sense name (gloss "Husham") (why "(LXX, supplied.) A king of Edom from the land of the Temanites (Genesis 36:34-35), Greek Ἁσόμ; traditional English Husham.")))

(lemma "Ἀσουρίμ"(sense name (gloss "Asshurim") (why "(LXX, supplied.) A son of Dedan (Genesis 25:3), traditional English Asshurim.")))

(lemma "Ἁσρώμ" (sense name (gloss "Hezron") (why "(LXX, supplied.) A son of Perez (Genesis 46:12), Greek Ἁσρώμ (Matthew 1:3 and Luke 3:33 Ἑσρώμ); traditional English Hezron. Kept as its own lemma beside Ἁσρών, Reuben's son of the same English name, because Swete spells the two differently.")))

(lemma "Ἁσρών" (sense name (gloss "Hezron") (why "(LXX, supplied.) A son of Reuben (Genesis 46:9), Greek Ἁσρών; traditional English Hezron. Swete also prints Ἁσρών for Zebulun's second son (46:14), where the Hebrew has Elon: the Greek gives the name Hezron, so the English follows it (rule 8, as Μαθουσαλά).")))

(lemma "Ἀσσύριος"
  (sense name
    (gloss "Assyrian" "Assyrians")
    (why "(LXX, supplied.) The people name, plural in Genesis 2:14 (\"opposite [the] Assyrians\").")))

(lemma "Ἀσταρώθ" (sense name (gloss "Ashteroth") (why "(LXX, supplied.) Ἀσταρὼθ Καρνάιν (Genesis 14:5), Ashteroth-karnaim: two Greek words, each glossed; traditional English Ashteroth.")))

(lemma "ἀσπάζομαι" (sense greet (gloss "greet" "greeted" "greets" "greeting") (why "(LXX form supplied.) To greet, embrace in welcome (Exodus 18:7, Moses and Jethro ἠσπάσαντο ἀλλήλους; Matthew 5:47; Romans 16:3). Middle deponent, rendered active.")))

(lemma "ἀσπιδίσκη" (sense little-shield (gloss "little shield" "little shields") (plural "little shields") (why "(LXX, supplied.) A little shield, the diminutive of ἀσπίς \"shield\": the round gold settings on the shoulders of the shoulder-piece that hold the stones and the chains (Exodus 28:13-14, 25; 36-39). \"Little shield\" keeps the diminutive and the image. Use this English in every tabernacle chapter.")))

(lemma "ἀστεῖος" (sense comely (gloss "comely") (why "Of the town, refined, and so well-formed, comely, of a child (Exodus 2:2 ἰδόντες δὲ αὐτὸ ἀστεῖον; quoted in Acts 7:20 ἀστεῖος τῷ θεῷ and Hebrews 11:23). \"Comely\" keeps it apart from καλός \"fair\" and ὡραῖος \"beautiful\".")))

(lemma "ἀστήρ"
  (sense star
    (gloss "star" "stars")
    (why "A star (Genesis 1:16; Matthew 2:2). ἄστρον, a near synonym, will take \"constellation\" or a note if needed.")))

(lemma "ἀστραπή" (sense lightning (gloss "lightning" "lightnings") (why "A flash of lightning (Exodus 19:16, φωναὶ καὶ ἀστραπαί at Sinai; Matthew 24:27; Revelation 4:5, the same pair). (LXX form supplied.)")))

(lemma "ἄστρον" (sense star (gloss "star" "stars") (why "A star, a heavenly body (Exodus 32:13, ὡσεὶ τὰ ἄστρα τοῦ οὐρανοῦ τῷ πλήθει, the promise to Abraham; Hebrews 11:12 quoting it; Luke 21:25; Acts 27:20). It shares \"star\" with ἀστήρ: English has no other plain word, and the promise reads ἀστήρ in Genesis 15:5 and 22:17, ἄστρον here, the same stars.")))

(lemma "ἀσφαλτόπισσα"(sense asphalt-pitch (dative "with") (gloss "asphalt-pitch") (why "(LXX, supplied.) Asphalt and pitch together, bitumen-pitch (ἄσφαλτος + πίσσα), with which the basket was daubed (Exodus 2:3). The dative is the means, \"with asphalt-pitch\"; the English keeps both parts of the compound.")))

(lemma "ἄσφαλτος" (sense asphalt (dative "with") (gloss "asphalt") (why "(LXX, supplied.) Asphalt, bitumen, natural pitch (Genesis 6:14; 11:3). The dative of Genesis 6:14 is the means, \"with the asphalt\". The verb ἀσφαλτόω shares the English, as the Greek shares the word.")))

(lemma "ἀσφαλτόω" (sense asphalt (gloss "asphalt" "asphalted" "asphalts" "asphalting") (why "(LXX, supplied.) To coat with asphalt (Genesis 6:14). The verb made from ἄσφαλτος and given the same English deliberately, as in the Greek (\"you will asphalt it ... with the asphalt\").")))

(lemma "ἀσφαλῶς" (sense securely (gloss "securely") (why "Securely, safely, without risk (Genesis 34:25, Simeon and Levi entered the city securely; Mark 14:44 ἀπάγετε ἀσφαλῶς; Acts 2:36 \"assuredly\"; 16:23).")))

(lemma "Ἀσχανάζ" (sense name (gloss "Ashkenaz") (why "(LXX, supplied.) Gomer's son (Genesis 10:3), traditional English Ashkenaz.")))

(lemma "ἀσχημοσύνη" (sense shame (gloss "shame") (why "Shamefulness, the shame of nakedness (Exodus 20:26; Revelation 16:15).")))

(lemma "ἀσχήμων" (sense unseemly (gloss "unseemly") (why "Unseemly, unpresentable, disgraceful (Genesis 34:7, ἄσχημον ἐποίησεν Συχέμ, Shechem did [an] unseemly [thing]; 1 Corinthians 12:23). The adjective of ἀσχημοσύνη \"shame\".")))

(lemma "Ἀτάδ" (sense name (gloss "Atad") (why "(LXX, supplied.) The threshing floor of Atad beyond the Jordan, where Jacob was mourned (Genesis 50:10-11); traditional English Atad.")))

(lemma "ἀτεκνόω" (sense bereave (gloss "bereave" "bereaved" "bereaves" "bereaving") (why "(LXX, supplied.) To make childless, bereave; passive, to be bereaved of children (Genesis 27:45 μή ποτε ἀτεκνωθῶ ἀπὸ τῶν δύο ὑμῶν). From ἄτεκνος \"childless\" (Luke 20:28).")))

(lemma "Αὐνάν" (sense name (gloss "Onan") (why "(LXX, supplied.) Genesis 14:13, 24: the Greek gives Αὐνάν where the Hebrew has Aner. Αὐνάν is the Greek form of Judah's son Onan (Genesis 38), so the English follows the Greek name, as Θόβελ is \"Tubal\". For the owner: \"Aner\" if the traditional name of this man is preferred.")))

(lemma "ἀτμίς" (sense vapor (gloss "vapor") (why "Vapor, steam, smoke (Genesis 19:28 ὡσεὶ ἀτμὶς καμίνου; Acts 2:19 ἀτμίδα καπνοῦ; James 4:14).")))

(lemma "ἄτεκνος" (sense childless (gloss "childless") (why "Without children (Genesis 15:2; Luke 20:28-30).")))

(lemma "ἀτιμάζω" (sense dishonor (gloss "dishonor" "dishonored" "dishonors" "dishonoring") (why "To dishonor, treat with contempt (Genesis 16:4-5, Sarai slighted in Hagar's eyes; Romans 1:24; James 2:6).")))

(lemma "ἄτρυγος" (sense dregless (gloss "dregless") (why "(LXX, supplied.) Without lees or dregs (ἀ- + τρύξ \"lees\"), of the oil for the lamp (Exodus 27:20, ἔλαιον ἐξ ἐλαίων ἄτρυγον καθαρόν; Leviticus 24:2). \"Dregless\" keeps it apart from καθαρός \"clean\".")))

(lemma "αὐθάδης" (sense self-willed (gloss "self-willed") (why "(LXX form supplied.) Self-pleasing, stubborn, arrogant (Genesis 49:3, 7, of Reuben and of the fury of Simeon and Levi; Titus 1:7; 2 Peter 2:10).")))

(lemma "αὐλαία" (sense curtain (gloss "curtain" "curtains") (why "(LXX, supplied.) A curtain, hanging (from αὐλή \"court\"): the ten curtains of the tabernacle (Exodus 26:1-6; 36). Tabernacle term: \"curtain\" for αὐλαία only; καταπέτασμα is \"veil\", ἐπίσπαστρον \"screen\", ἱστίον \"sheet\", δέρρις \"skin-cloth\", κάλυμμα \"cover\".")))

(lemma "αὐλή" (sense court (gloss "court" "courts") (why "An enclosed yard, a court: the court of the tabernacle (Exodus 27:9-19; 35-40); the high priest's court (Matthew 26:3, 58, 69; John 18:15); the sheepfold (John 10:1, 16). \"Court\" for all; kept apart from πύλη \"gate\" and οἶκος \"house\".")))

(lemma "αὐξάνω"
  (sense grow
    (voice active)
    (gloss "grow" "grew" "grown" "grows" "growing")
    (why "(Supplied in Genesis 1:22, 28.) To grow, increase (Matthew 6:28; Luke 2:40; Acts 6:7). Genesis 1:22, 28 αὐξάνεσθε is \"grow\", where translations from the Hebrew have \"be fruitful\". The middle/passive forms are rendered with intransitive English \"grow\".")))

(lemma "αὔριον" (sense tomorrow (gloss "tomorrow") (why "Tomorrow, on the next day (Genesis 30:33 ἐν τῇ ἡμέρᾳ τῇ αὔριον; Matthew 6:30; James 4:13-14).")))

(lemma "αὐτός"
  (sense pronoun
    (gloss "he" "him" "his" "she" "her" "hers" "it" "its" "they" "them" "their" "theirs")
    (why "The third-person pronoun. The English form follows the Greek gender, number and case; a neuter referring to a thing is \"it\". The intensive (\"himself\") and identifying (\"the same\") uses become their own senses when they occur. A nominative αὐτός (Genesis 3:15-16) is emphatic; the literal layer still says \"he\" and the emphasis is noted, not added."))
  (sense intensive
    (gloss "himself" "herself" "itself" "themselves" "yourself" "yourselves" "myself" "ourselves")
    (why "Intensive with another pronoun, \"-self\": ὑμῖν αὐτοῖς \"to you yourselves\" (Exodus 20:23). Chosen by word override, with the English of the person it intensifies."))
  (sense same (gloss "same") (why "Identifying, with the article: ὁ αὐτός \"the same\" (Hebrews 13:8); ἐπὶ τὸ αὐτό \"upon the same [place]\", together (Genesis 29:2, the flocks at the well; Acts 2:1). Chosen by word override.")))

(lemma "αὐτοῦ" (sense right-here (gloss "right here") (why "The adverb αὐτοῦ, \"in the very place\", here or there (Genesis 22:5 Καθίσατε αὐτοῦ, as Matthew 26:36 Καθίσατε αὐτοῦ; Acts 18:19). The same spelling as the genitive of αὐτός; a word override picks it. \"Right here\" keeps it apart from ὧδε \"here\".")))

(lemma "αὐτόχθων" (sense indigenous (person) (plural "indigenous") (gloss "indigenous") (why "(LXX, supplied.) Sprung from the land itself (αὐτός + χθών \"earth\"), a native-born Israelite set beside the γιώρας or προσήλυτος (Exodus 12:19, 48). \"Indigenous\" keeps it apart from ἐγχώριος \"native\" (Exodus 12:49).")))

(lemma "ἀφαίρεμα" (sense removed-portion (gloss "removed portion" "removed portions") (plural "removed portions") (why "(LXX, supplied.) What is taken off (ἀφαιρέω \"remove\") from a larger whole and given to God or the priest, the portion the English tradition calls the heave offering: τὸν βραχίονα τοῦ ἀφαιρέματος, ὃς ... ἀφῄρηται \"the arm of the removed portion, which has been removed\" (Exodus 29:27-28; also 25:2-3; 35:5, 21, 24). \"Removed portion\" keeps the link with its verb; kept apart from ἀφόρισμα \"set-apart portion\". Use this English in every tabernacle chapter.")))

(lemma "ἀφαιρέω" (sense remove (gloss "remove" "removed" "removes" "removing") (why "To take away from, remove (Genesis 21:25, the wells which the servants removed, that is took for themselves; Luke 1:25; Matthew 26:51 ἀφεῖλεν αὐτοῦ τὸ ὠτίον). \"Remove\" keeps it apart from ἀναιρέω \"take away\".")))

(lemma "ἀφανίζω" (sense obliterate (gloss "obliterate" "obliterated" "obliterates" "obliterating") (why "To make unseen (ἀ- + φαίνω), do away with, destroy (Exodus 8:9, to obliterate the frogs; Matthew 6:19-20, where moth and rust obliterate; James 4:14, passive, a vapor obliterated). \"Obliterate\" keeps it apart from ἀπόλλυμι \"destroy\" and ἐξολεθρεύω \"destroy utterly\".")))

(lemma "Ἄφερ" (sense name (gloss "Epher") (why "(LXX, supplied.) A son of Midian (Genesis 25:4), traditional English Epher.")))

(lemma "ἄφεσις" (sense remission (gloss "remission" "remissions") (why "A letting go, release, remission: of the land left fallow in the seventh year (Exodus 23:11 τῷ δὲ ἑβδόμῳ ἄφεσιν ποιήσεις), of captives (Luke 4:18) and of sins (Matthew 26:28; Hebrews 9:22). \"Remission\" because ἀπολύω has \"release\", and it covers both the year and forgiveness.")))

(lemma "ἀφηγέομαι" (sense head (genitive "") (gloss "head" "headed" "heads" "heading") (why "(LXX, supplied.) To lead, be at the head of, with the genitive of those led (Exodus 11:8 πᾶς ὁ λαός σου οὗ σὺ ἀφηγῇ, \"all your people which you head\"). The verb \"head\" keeps it apart from ἡγέομαι and ὁδηγέω; it shares its spelling with the noun κεφαλή \"head\", a different part of speech.")))

(lemma "ἀφίημι" (sense forgive (gloss "forgive" "forgave" "forgiven" "forgives" "forgiving") (why "To let go, release, forgive. Genesis 4:13 τοῦ ἀφεθῆναί με, \"to be forgiven\"; other senses (leave, allow) become their own senses when met."))
  (sense allow (gloss "allow" "allowed" "allows" "allowing") (why "With an infinitive: to let, allow (Genesis 20:6 οὐκ ἀφῆκά σε ἅψασθαι αὐτῆς; Matthew 19:14 ἄφετε τὰ παιδία; Mark 1:34). Chosen by word override."))
  (sense let-go (verb "let go" "let go" "let go") (gloss "let go" "lets go" "letting go") (why "To let go, give up (Genesis 35:18 ἐν τῷ ἀφιέναι αὐτὴν τὴν ψυχήν, \"in her letting go the soul\", of Rachel dying; Matthew 27:50 ἀφῆκεν τὸ πνεῦμα). Chosen by word override."))
  (sense let-stay (verb "let stay" "let stay" "let stay") (gloss "let stay" "lets stay" "letting stay") (why "To leave someone where he is, let stay (Genesis 42:33 ἀδελφὸν ἕνα ἄφετε ὧδε μετ’ ἐμοῦ, the hostage brother; Matthew 5:24 ἄφες ἐκεῖ τὸ δῶρόν σου). \"Let stay\" because καταλείπω has \"leave\" and ὑπολείπω \"leave behind\". Chosen by word override.")))

(lemma "ἀφικνέομαι" (sense reach (gloss "reach" "reached" "reaches" "reaching") (why "To arrive at, reach (Genesis 28:12, the ladder whose head was reaching into heaven; Romans 16:19). (LXX form supplied.)")))

(lemma "ἀφίστημι" (sense withdraw (verb "withdraw" "withdrew" "withdrawn") (gloss "withdraw" "withdrew" "withdrawn" "withdraws" "withdrawing") (why "Intransitive (second aorist ἀπέστη): to stand off, withdraw (Genesis 12:8; Luke 4:13; Acts 12:10). \"Withdraw\" keeps it apart from ἀπαίρω \"depart\" and ἀπέρχομαι \"go away\".")))

(lemma "ἀφορίζω"
  (sense set-apart
    (gloss "set apart" "sets apart" "setting apart")
    (why "(Supplied in Genesis 2:10.) To mark off by a boundary, set apart, separate (Romans 1:1; Galatians 1:15; Matthew 25:32). \"Set apart\" keeps it apart from διαχωρίζω \"separate\". Genesis 2:10, of the river: \"from there it is being set apart into four beginnings\".")))

(lemma "ἀφόρισμα" (sense set-apart-portion (gloss "set-apart portion" "set-apart portions") (plural "set-apart portions") (why "(LXX, supplied.) What is marked off, set apart (ἀφορίζω \"set apart\") for God, the portion the English tradition calls the wave offering: ἀφοριεῖς αὐτοῖς ἀφόρισμα \"you will set apart for them set-apart portion\" (Exodus 29:24, 26-28). \"Set-apart portion\" keeps the link with its verb; kept apart from ἀφαίρεμα \"removed portion\" and μερίς \"portion\". Use this English in every tabernacle chapter.")))

(lemma "ἀφρόνως" (sense foolishly (gloss "foolishly") (why "(LXX, supplied.) Senselessly, foolishly (Genesis 31:28 νῦν δὲ ἀφρόνως ἔπραξας), the adverb of ἄφρων (Luke 12:20).")))

(lemma "ἀχάτης" (sense agate (gloss "agate" "agates") (why "(LXX, supplied.) Agate, the second stone of the oracle's third row (Exodus 28:19; 36:19). The stones of the oracle keep the names the Greek gives them, in their English forms.")))

(lemma "ἄχει" (sense sedge (gloss "sedge") (why "(LXX, supplied.) An Egyptian word for the reed grass of the Nile marshes (Genesis 41:2, 3, 18, 19, ἐν τῷ ἄχει, where the cows were feeding), kept by the Greek as a loanword; Swete spells it ἄχει, others ἄχι. \"Sedge\", a marsh grass, keeps it apart from χόρτος \"grass\".")))

(lemma "Ἀχισαμάχ" (sense name (gloss "Ahisamach") (why "(LXX, supplied.) Father of the craftsman Swete prints as Ἐλιάβ, of the tribe of Dan (Exodus 31:6; spelled Ἀχισαμάκ at 35:34 and 38:23: the same name, analyze those forms under this lemma). Traditional English Ahisamach (rule 8).")))

(lemma "Ἀχοβώρ" (sense name (gloss "Achbor") (why "(LXX, supplied.) Father of Baal-hanan, king of Edom (Genesis 36:38-39), Greek Ἀχοβώρ; traditional English Achbor.")))

(lemma "ἄχυρον"(sense straw (gloss "straw" "straws") (why "(LXX, supplied.) Straw, chaff (Genesis 24:25, 32, straw for the camels; Matthew 3:12, the chaff burned). \"Straw\" for fodder; the plural ἄχυρα stays \"straws\" in the literal layer.")))

(lemma "Ἄωδ" (sense name (gloss "Ohad") (why "(LXX, supplied.) A son of Simeon (Genesis 46:10), Greek Ἄωδ; traditional English Ohad.")))
