;; Greek Source Bible concordance, lemmas beginning with ξ (accents ignored),
;; in Greek alphabetical order. Format: gsb/translation/README.md; generator
;; fields: gsb/literal/README.md. Checked by `make gsb/lint`.

(lemma "ξηραίνω" (sense dry-up (gloss "dry up" "dried up" "dries up" "drying up") (why "To dry up; passive, to be dried up, wither (Genesis 8:7, 14, the earth was dried up; Mark 11:20-21, the fig tree dried up). \"Dry up\" keeps it apart from the adjective ξηρός \"dry\".")))

(lemma "ξηρός"
  (sense dry
    (gloss "dry")
    (why "Dry. ἡ ξηρά (feminine, understood γῆ) is \"the dry [land]\" (Genesis 1:9-10; Hebrews 11:29).")))

(lemma "ξύλον"
  (sense tree
    (gloss "tree" "trees")
    (why "A tree (Genesis 1-3; Revelation 2:7; 22:2) and in the New Testament the cross (Acts 5:30; Galatians 3:13; 1 Peter 2:24), which will keep \"tree\" so the link with the tree of life is not lost. \"Wood\" (1 Corinthians 3:12) and \"club\" (Matthew 26:47) become their own senses. A singular used collectively (\"in the midst of the tree of the paradise\", Genesis 3:8) stays singular in the literal layer."))
  (sense timber
    (gloss "timber" "timbers")
    (why "Cut wood, timber for building (Genesis 6:14, ξύλων τετραγώνων, \"squared timbers\" for the ark). \"Tree\" would mislead there.")))
